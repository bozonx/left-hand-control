msgstr "Ungültiges Makro bei „{}“."

msgid "Invalid menu action at \"{}\"."
msgstr "Ungültige Menüaktion bei „{}“."

msgid "Invalid timing at \"{}\"."
msgstr "Ungültiges Timing bei „{}“."

msgid "Invalid window condition at \"{}\"."
msgstr "Ungültige Fensterbedingung bei „{}“."

