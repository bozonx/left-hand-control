msgstr "Trigger löschen?"

msgid ""
"The trigger and all its assigned actions will be removed from the current "
"layout."
msgstr ""
"Der Auslöser und alle ihm zugewiesenen Aktionen werden aus dem aktuellen "
"Layout entfernt."

msgid "Reset {} to default"
msgstr "Setzen Sie {} auf die Standardeinstellungen zurück"

msgid "Holding activates layer: {}"
msgstr "Halten aktiviert die Ebene: {}"

msgid "Holding performs a long-hold action."
msgstr "Halten führt eine lange Halteaktion aus."

msgid "Holding keeps a key or combination pressed."
msgstr "Halten hält eine Taste oder Kombination gedrückt."

msgid "Paths"
msgstr "Wege"

