msgstr "Applicazione"

msgid "Window title"
msgstr "Titolo della finestra"

msgid "Click to switch"
msgstr "Fare clic per cambiare"

msgid "Match by app ID or process instead"
msgstr "Utilizza invece la corrispondenza per ID app o processo"

msgid "Match by window title instead"
msgstr "Abbina invece il titolo della finestra"

