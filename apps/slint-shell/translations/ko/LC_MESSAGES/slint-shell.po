msgstr "모두 선택"

msgid "Move line down"
msgstr "줄을 아래로 이동"

msgid "Down + End"
msgstr "아래로 + 끝"

msgid "Up + End"
msgstr "위로 + 끝"

msgid "Up 5 times"
msgstr "5배"

msgid "Duplicate line"
msgstr "중복된 줄"

msgid "Right + Space"
msgstr "오른쪽 + 스페이스바"

msgid "Empty line below"
msgstr "아래 빈 줄"

msgid "Cut word right from center"
msgstr "중앙에서 바로 단어 자르기"

msgid "Copy word right from center"
msgstr "중앙에서 바로 단어 복사"

msgid "Paste at line above"
msgstr "위 줄에 붙여넣기"

msgid "Replace word with buffer"
msgstr "단어를 버퍼로 교체"

msgid "Down + Home"
msgstr "아래 + 홈"

msgid "Up + Home"
msgstr "위로 + 집"

msgid "Down 5 times"
msgstr "5번 다운"

msgid "Paste at line bottom"
msgstr "줄 하단에 붙여넣기"

msgid "Cut to start"
msgstr "잘라서 시작하세요"

msgid "Cut to end"
msgstr "끝까지 잘라내기"

msgid "Cut line content"
msgstr "절단선 내용"

msgid "Cut and remove line"
msgstr "선 잘라내기 및 제거"

msgid "Select 5 lines up"
msgstr "5줄을 선택하세요."

msgid "Copy to start"
msgstr "시작하려면 복사하세요"

msgid "Copy to end"
msgstr "끝까지 복사"

