msgstr "Ошибка всплывающего меню: {}"

msgid "Choose a key or combination for the trigger"
msgstr "Выберите клавишу или сочетание для триггера"

msgid "Mouse buttons, media keys, and other triggers outside the main keyboard grid. Add a trigger, then choose its action, suppress it, or inherit its assignment from the lower layer."
msgstr "Кнопки мыши, мультимедийные клавиши и другие триггеры вне основной сетки клавиатуры. Добавьте триггер и назначьте действие, подавление или наследование назначения из нижнего слоя."

msgid "You can enter emoji, any text, or Unicode symbols here. Drag an item from the palette onto a key to assign it."
msgstr "Здесь можно вводить эмодзи, любой текст или символы Unicode. Перетащите символ из палитры на клавишу, чтобы назначить его."

msgid "Accessibility"
msgstr "Доступность"

msgid "High contrast"
msgstr "Высокая контрастность"

msgid "Pure black or white background, stronger text, borders and focus outlines. Works with the light and dark themes."
msgstr "Чисто чёрный или белый фон, более яркий текст, границы и рамка фокуса. Работает со светлой и тёмной темой."

msgid "Reduce motion"
msgstr "Уменьшить анимацию"

msgid "Turn off highlight animations in the editor."
msgstr "Отключить анимацию подсветки в редакторе."

msgid "Every control can be reached with Tab and activated with Space or Enter. Interface size follows the desktop scale factor."
msgstr "До любого элемента можно дойти клавишей Tab и нажать его пробелом или Enter. Размер интерфейса следует масштабу рабочего стола."

msgid "Always"
msgstr "Всегда"

msgid "+ Add key"
msgstr "+ Добавить клавишу"

msgid "Hold duration"
msgstr "Время удержания"

