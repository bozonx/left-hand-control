msgstr "Наследовать"

msgid "No separate action"
msgstr "Без отдельного действия"

msgid "Activate layer only"
msgstr "Только активировать слой"

msgid "Normal key behavior"
msgstr "Обычное поведение"

msgid "Suppress"
msgstr "Подавлять"

