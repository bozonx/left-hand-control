msgid_plural "Its {n} automatic rules will be deleted too."
msgstr[0] "Njegovo {n} automatsko pravilo također će biti izbrisano."
msgstr[1] "Izbrisat će se i njegova {n} automatska pravila."
msgstr[2] "Izbrisat će se i njegovih {n} automatskih pravila."

