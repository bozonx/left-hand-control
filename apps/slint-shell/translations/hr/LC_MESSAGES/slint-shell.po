msgid ""
"Rules are checked from top to bottom; the first enabled one whose conditions"
" match chooses the layout. If none matches, the default is used. “No layout”"
" leaves the keyboard unprocessed, for example in an application where the "
"layout gets in the way."
msgstr ""
"Pravila se provjeravaju odozgo prema dolje; prvi omogućeni čiji uvjeti "
"odgovaraju odabire izgled. Ako ništa ne odgovara, koristi se zadana "
"vrijednost. \"Bez rasporeda\" ostavlja tipkovnicu neobrađenu, na primjer u "
"aplikaciji gdje raspored smeta."

msgid "No rules"
msgstr "Nema pravila"

