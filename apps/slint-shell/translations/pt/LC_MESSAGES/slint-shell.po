msgstr "Já está na lista"

msgid "Choose from open windows…"
msgstr "Escolha entre as janelas abertas…"

msgid "Matches {n} open window"
msgid_plural "Matches {n} open windows"
msgstr[0] "Corresponde a {n} janela aberta"
msgstr[1] "Corresponde a {n} janelas abertas"

