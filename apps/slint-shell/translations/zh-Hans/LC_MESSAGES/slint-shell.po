msgstr "已连接：{}"

msgid "This path may change after reconnecting."
msgstr "重新连接后此路径可能会变化。"

msgid "Use the stable path"
msgstr "使用固定路径"

msgid "A path from /dev/input/by-id/ stays the same after reboots and reconnecting."
msgstr "/dev/input/by-id/ 中的路径在重启和重新连接后保持不变。"

msgid "Hold modifiers"
msgstr "保持修饰键"
