import { Palette } from "std-widgets.slint";

/// Neutral zinc surfaces with the application sky accent. Every text
/// color keeps WCAG AA contrast (4.5:1) on `surface`, `card`, `hover` and
/// `selected`; `border` keeps 3:1 for control outlines. `accent` matches what
/// the Fluent style derives from the accent color set in `apply_theme`, so
/// std-widgets primary buttons and our own controls share one color.
export global Theme {
    out property <length> page-padding: 20px;
    /// Gap between the blocks of a page (header, toolbars, content).
    out property <length> page-gap: 16px;
    /// Widest readable column of help text in settings.
    out property <length> text-column: 576px;
    /// Text width of long help tooltips.
    out property <length> text-tooltip: 320px;
    /// Stands for "no limit" in `max-width`: Slint has no infinite length,
    /// and some widgets otherwise cap their width.
    out property <length> unbounded: 100000px;
    out property <length> scrollbar-size: 12px;
    out property <length> scrollbar-gap: 4px;
    /// Corner radii: small controls and chips, controls, menus, cards and
    /// panels, dialogs, popups.
    out property <length> radius-small: 4px;
    out property <length> radius: 6px;
    out property <length> radius-large: 8px;
    out property <length> radius-panel: 10px;
    out property <length> radius-dialog: 12px;
    out property <length> radius-popup: 16px;
    /// Control heights: compact, regular, large (buttons, rows, menu items).
    out property <length> control-height-s: 28px;
    out property <length> control-height: 32px;
    out property <length> control-height-l: 36px;
    out property <length> icon-button-size: 28px;
    out property <length> badge-height: 22px;
    /// Gap between a dropdown menu and the control that opened it.
    out property <length> menu-offset: 4px;
    /// Type roles from captions to page titles.
    out property <length> font-caption: 11px;
    out property <length> font-body: 12px;
    out property <length> font-medium: 13px;
    /// Window default text and subsection titles.
    out property <length> font-default: 14px;
    out property <length> font-subtitle: 16px;
    out property <length> font-heading: 18px;
    out property <length> font-title: 22px;
    out property <length> font-page-title: 26px;
    /// Item being dragged in a list, and the floating preview of a dragged cell.
    out property <float> dragged-opacity: 0.6;
    out property <float> drag-preview-opacity: 0.95;
    /// Pointer travel that turns a press into a drag.
    out property <length> drag-threshold: 6px;
    /// How long a newly created item stays highlighted.
    out property <duration> highlight-duration: 650ms;
    /// Font weights.
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
    /// Spacing scale for layout gaps and paddings.
    out property <length> space-2xs: 2px;
    out property <length> space-xs: 4px;
    out property <length> space-s: 6px;
    out property <length> space-m: 8px;
    out property <length> space-m-plus: 10px;
    out property <length> space-l: 12px;
    out property <length> space-l-plus: 14px;
    out property <length> space-xl: 16px;
    out property <length> space-2xl: 20px;
    out property <length> space-3xl: 24px;
    out property <length> space-4xl: 32px;
    in-out property <bool> dark: true;
    in-out property <bool> eink: false;
    in-out property <bool> high-contrast: false;
    in-out property <bool> reduce-motion: false;
    property <bool> hc: high-contrast && !eink;
    /// Window background.
    out property <color> surface: eink ? #ffffff : hc ? (dark ? #000000 : #ffffff) : dark ? #141416 : #f4f4f5;
    /// Cards, bars, dialogs.
    out property <color> card: eink ? #ffffff : hc ? (dark ? #0a0a0a : #ffffff) : dark ? #1c1c1f : #ffffff;
    out property <color> text: eink ? #000000 : hc ? (dark ? #ffffff : #000000) : dark ? #f4f4f5 : #18181b;
    out property <color> placeholder: eink || hc ? muted : dark ? #71717a : #92929b;
    out property <color> muted: eink ? #333333 : hc ? (dark ? #e4e4e7 : #27272a) : dark ? #a1a1aa : #52525b;
    /// Primary action and focus color.
    out property <color> accent: eink ? #000000 : dark ? #4dccff : #0069a9;
    /// Foreground on `accent`.
    out property <color> on-accent: eink ? #ffffff : dark ? #000000 : #ffffff;
    /// Background of the selected item in lists, tabs and menus.
    out property <color> selected: eink ? #cccccc : hc ? (dark ? #003a5c : #cce7f8) : dark ? #163246 : #e0f0fb;
    out property <color> hover: eink ? #eeeeee : hc ? (dark ? #262626 : #e4e4e7) : dark ? #27272b : #ececee;
    /// Outline of inputs and controls.
    out property <color> border: eink ? #000000 : hc ? (dark ? #ffffff : #000000) : dark ? #71717a : #8a8a93;
    /// Separators and card outlines.
    out property <color> divider: eink ? #000000 : hc ? (dark ? #a1a1aa : #52525b) : dark ? #2e2e33 : #e4e4e7;
    out property <color> focus: eink ? #000000 : hc ? text : accent;
    out property <color> error: eink ? #000000 : hc ? (dark ? #ff8a80 : #8b0000) : dark ? #f87171 : #b91c1c;
    out property <color> warning: eink ? #000000 : hc ? (dark ? #ffd54f : #6b3a00) : dark ? #fbbf24 : #92400e;
    out property <color> success: eink ? #000000 : hc ? (dark ? #69f0ae : #0b5d2a) : dark ? #4ade80 : #15803d;
    /// Dimmed backdrop behind modal dialogs.
    out property <color> scrim: #00000099;
    out property <duration> motion: reduce-motion ? 0ms : 150ms;
    out property <duration> highlight-motion: reduce-motion ? 0ms : highlight-duration;
    public function apply() {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }
}
