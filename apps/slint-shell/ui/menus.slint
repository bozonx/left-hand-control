import { KeyboardFocus, NavigationFocus } from "focus.slint";
import { ElidedText } from "controls.slint";
import { ActionField, CategoryIcon } from "action-controls.slint";
import { TextField } from "controls.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { DragArea, DragAxis, DragGroups, DropMarker, PaletteDrag } from "reorder.slint";
import { PopupCell } from "popup-grid.slint";
import { ActionPicker } from "action-picker.slint";
import { Theme } from "theme.slint";
import { Message } from "i18n.slint";
import { StatusText } from "notifications.slint";
import { MenuKind, PickerCategory, PickerTarget } from "types.slint";
import { InlineTextField, Card, ConfirmDialog, DialogFrame, Divider, FieldLabel, IconButton, InfoTip, NavTab, PageLayout, PageHeader } from "controls.slint";
import { Button } from "std-widgets.slint";

/// A grid cell; `category` picks the icon of a quick action.
export struct MenuCell { key: string, value: string, name: string, category: PickerCategory }
export struct EmojiCategory { id: string, items: [string] }
export global MenuEditor {
    in-out property <MenuKind> kind;
    changed kind => { self.keyboard-source-page = -1; self.keyboard-source-cell = -1; }
    in-out property <int> keyboard-source-page: -1;
    in-out property <int> keyboard-source-cell: -1;
    /// The remembered cell is copied (Ctrl+C), not cut (Ctrl+X).
    in-out property <bool> keyboard-copy;
    /// Cut or copy: remember a cell; Paste (`drop-cell`) moves or copies it, Escape forgets it.
    public function mark-cell(cell: int, copy: bool) {
        if cell < 0 { return; }
        self.keyboard-source-page = self.selected-page; self.keyboard-source-cell = cell; self.keyboard-copy = copy;
    }
    public function cancel-mark() { self.keyboard-source-page = -1; self.keyboard-source-cell = -1; }
    public function drop-cell(cell: int) {
        if self.keyboard-source-cell < 0 || cell < 0 { return; }
        if self.keyboard-copy {
            // A copy can be pasted again into other cells.
            self.copy-cell(self.keyboard-source-page, self.keyboard-source-cell, cell);
        } else {
            self.move-cell(self.keyboard-source-page, self.keyboard-source-cell, cell);
            self.cancel-mark();
        }
    }
    /// Whether the cell at `index` of the shown page is cut and waits for Paste.
    public pure function is-marked(index: int) -> bool {
        return self.keyboard-source-cell == index && self.keyboard-source-page == self.selected-page;
    }
    in property <[string]> pages;
    in property <[MenuCell]> cells;
    in property <[EmojiCategory]> catalog;
    in-out property <int> selected-page;
    in-out property <int> selected-cell;
    in-out property <string> page-name;
    in-out property <string> value;
    in-out property <string> name;
    in property <Message> status;
    in property <bool> has-unsaved-changes;
    /// The menu has one page with no name and no cells: removing it does nothing.
    in property <bool> only-page-empty;
    callback open(MenuKind);
    callback flush-pending() -> bool;
    callback refresh();
    callback select-page(int);
    callback select-cell(int);
    callback add-page(string);
    callback remove-page();
    in-out property <bool> preview-visible;
    /// Save before opening a preview of the edited keymap.
    callback show-page() -> bool;
    /// Read `page-name`, `value` and `name` into the selected page and cell.
    callback rename-page();
    callback set-cell();
    callback set-name();
    callback set-action(int, string, string);
    callback clear-cell();
    /// Move a cell (source page, source cell) onto a cell of the shown page.
    callback move-cell(int, int, int);
    /// Copy a cell (source page, source cell) onto a cell of the shown page.
    callback copy-cell(int, int, int);
    callback reorder-page(int, int);
}

/// 5×3 grid of the left-hand hotkeys; click selects, drag moves a cell.
component HotkeyGrid inherits Rectangle {
    accessible-role: list;
    accessible-label: root.emoji ? @tr("Emoji") : @tr("Quick actions");
    in property <bool> emoji;
    in property <length> cell-height: 96px;
    callback activate(int);
    private property <int> keyboard-cell: 0;
    private property <int> selected-cell: MenuEditor.selected-cell;
    changed selected-cell => { if root.selected-cell >= 0 { root.keyboard-cell = root.selected-cell; } }
    grid-focus := FocusScope { focus-on-tab-navigation: false; }
    private property <length> pad: 12px;
    private property <length> gap: 8px;
    private property <length> cell-width: (self.width - 2 * self.pad - 4 * self.gap) / 5;
    private property <int> drag-from: -1;
    private property <int> drag-over: -1;
    private property <int> source-page: -1;
    private property <bool> dragging;
    private property <length> press-x;
    private property <length> press-y;
    private property <int> current-page: MenuEditor.selected-page;
    changed current-page => { if root.dragging { root.drag-over = root.drop-at(PaletteDrag.x - root.absolute-position.x, PaletteDrag.y - root.absolute-position.y); } }
    min-width: 5 * 64px + 2 * self.pad + 4 * self.gap;
    height: 2 * self.pad + 3 * self.cell-height + 2 * self.gap;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    /// Cell under a palette item dragged over this grid; the palette drops onto it.
    private property <int> palette-cell: PaletteDrag.active ? root.drop-at(PaletteDrag.x - root.absolute-position.x, PaletteDrag.y - root.absolute-position.y) : -1;
    changed palette-cell => { PaletteDrag.cell = self.palette-cell; }
    pure function cell-label(cell: MenuCell) -> string {
        return cell.key + " " + (cell.value == "" ? @tr("Empty") : root.emoji ? cell.value : cell.name);
    }
    pure function index-at(x: length, y: length) -> int {
        return max(0, min(2, floor((y - self.pad) / (self.cell-height + self.gap)))) * 5
            + max(0, min(4, floor((x - self.pad) / (self.cell-width + self.gap))));
    }
    pure function drop-at(x: length, y: length) -> int {
        let local-x = x - self.pad;
        let local-y = y - self.pad;
        if local-x < 0px || local-y < 0px || local-x >= 5 * (self.cell-width + self.gap) - self.gap || local-y >= 3 * (self.cell-height + self.gap) - self.gap { return -1; }
        if mod(local-x, self.cell-width + self.gap) >= self.cell-width || mod(local-y, self.cell-height + self.gap) >= self.cell-height { return -1; }
        return floor(local-y / (self.cell-height + self.gap)) * 5 + floor(local-x / (self.cell-width + self.gap));
    }
    pure function preview(index: int) -> int {
        if !self.dragging || self.source-page != MenuEditor.selected-page || self.drag-over < 0 { return index; }
        if index == self.drag-from { return self.drag-over; }
        if index == self.drag-over { return self.drag-from; }
        return index;
    }
    if root.dragging && root.drag-over >= 0: Rectangle {
        x: root.pad + mod(root.drag-over, 5) * (root.cell-width + root.gap);
        y: root.pad + floor(root.drag-over / 5) * (root.cell-height + root.gap);
        width: root.cell-width; height: root.cell-height;
        border-width: 2px; border-color: Theme.accent; border-radius: Theme.radius; background: Theme.hover;
    }
    for cell[index] in MenuEditor.cells: Rectangle {
        x: root.pad + mod(root.preview(index), 5) * (root.cell-width + root.gap);
        y: root.pad + floor(root.preview(index) / 5) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        clip: true;
        border-radius: Theme.radius;
        border-width: Theme.focus-ring(cell-focus.has-focus) ? 3px : (root.palette-cell >= 0 && root.palette-cell == root.preview(index)) || (index == MenuEditor.selected-cell && !PaletteDrag.active) || (root.dragging && root.preview(index) == root.drag-over) ? 2px : 1px;
        border-color: Theme.focus-ring(cell-focus.has-focus) ? Theme.focus : (root.palette-cell >= 0 && root.palette-cell == root.preview(index)) || (index == MenuEditor.selected-cell && !PaletteDrag.active) || (root.dragging && root.preview(index) == root.drag-over) ? Theme.accent : Theme.border;
        background: (root.palette-cell >= 0 && root.palette-cell == root.preview(index)) || (root.dragging && root.preview(index) == root.drag-over) ? Theme.hover : Theme.card;
        opacity: (root.dragging && root.source-page == MenuEditor.selected-page && index == root.drag-from) || MenuEditor.is-marked(index) ? Theme.dragged-opacity : 1.0;
        accessible-role: button;
        accessible-label: root.cell-label(cell);
        accessible-item-index: index;
        accessible-item-count: MenuEditor.cells.length;
        accessible-item-selectable: true;
        accessible-item-selected: index == MenuEditor.selected-cell;
        accessible-value: cell.value;
        accessible-action-default => { root.activate(index); }
        cell-focus := NavigationFocus {
            tab-stop: root.keyboard-cell == index;
            focus-changed-event => { if self.has-focus { root.keyboard-cell = index; } }
        key-pressed(event) => {
            if MenuEditor.cells.length == 0 { return reject; }
            if event.modifiers.control && event.text.to-lowercase() == "x" { MenuEditor.mark-cell(index, false); return accept; }
            if event.modifiers.control && event.text.to-lowercase() == "c" { MenuEditor.mark-cell(index, true); return accept; }
            if event.modifiers.control && event.text.to-lowercase() == "v" { MenuEditor.drop-cell(index); return accept; }
            if event.text == Key.Escape && MenuEditor.keyboard-source-cell >= 0 { MenuEditor.cancel-mark(); return accept; }
            if event.text == Key.Delete || event.text == Key.Backspace { MenuEditor.select-cell(index); MenuEditor.clear-cell(); return accept; }
            if event.text == Key.Return || event.text == " " { root.activate(index); return accept; }
            return self.navigate(event);
        }
        }

        VerticalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-xs;
            HorizontalLayout {
                Text { horizontal-stretch: 1; text: MenuEditor.cells[root.preview(index)].key; color: Theme.accent; font-family: "monospace"; font-size: Theme.font-body; font-weight: Theme.weight-semibold; }
                Image { width: 14px; height: 14px; source: @image-url("icons/grip.svg"); colorize: Theme.muted; accessible-label: @tr("Drag"); }
            }
            if root.emoji || cell.value == "": Text {
                font-family: cell.value == "" ? "" : "Noto Color Emoji";
                vertical-stretch: 1;
                text: cell.value == "" ? "＋" : cell.value;
                color: cell.value == "" ? Theme.muted : Theme.text;
                font-size: cell.value.character-count <= 2 ? 26px : cell.value.character-count <= 6 ? 16px : 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
            if !root.emoji && cell.value != "": HorizontalLayout {
                spacing: Theme.space-s;
                CategoryIcon { category: cell.category; }
                Text {
                    horizontal-stretch: 1;
                    text: cell.name;
                    color: Theme.text;
                    font-weight: Theme.weight-semibold;
                    // Intentionally clipped, not elided: in narrow cells an ellipsis hides 1–2 more characters.
                    overflow: clip;
                    vertical-alignment: center;
                }
            }
            // Intentionally clipped, not elided: in narrow cells an ellipsis hides 1–2 more characters.
            if !root.emoji && cell.value != "": ElidedText { overflow: clip; text: cell.value; color: Theme.muted; font-family: "monospace"; font-size: Theme.font-caption; }
            if !root.emoji && cell.value != "": Rectangle { vertical-stretch: 1; }
        }
    }
    TouchArea {
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                PaletteDrag.reset();
                root.source-page = MenuEditor.selected-page;
                root.drag-from = root.index-at(self.mouse-x, self.mouse-y);
                PaletteDrag.value = MenuEditor.cells[root.drag-from].value;
                PaletteDrag.name = MenuEditor.cells[root.drag-from].name;
                PaletteDrag.text-item = !root.emoji || PaletteDrag.value.character-count > 6;
                root.drag-over = root.drag-from;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.dragging = false;
            }
            // Escape cancelled the drag: the release neither drops nor clicks.
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-from >= 0 && PaletteDrag.cancelled {
                PaletteDrag.reset(); root.dragging = false; root.drag-from = -1; root.drag-over = -1;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-from >= 0 {
                if root.dragging { root.drag-over = root.drop-at(self.mouse-x, self.mouse-y); }
                if !root.dragging {
                    root.keyboard-cell = root.drag-from;
                    grid-focus.focus(); KeyboardFocus.focus-index(root.drag-from);
                    root.activate(root.drag-from);
                } else if root.drag-over >= 0 {
                    MenuEditor.move-cell(root.source-page, root.drag-from, root.drag-over);
                }
                PaletteDrag.reset();
                root.dragging = false;
                root.drag-from = -1;
                root.drag-over = -1;
            }
            if event.kind == PointerEventKind.cancel { PaletteDrag.reset(); root.dragging = false; root.drag-from = -1; root.drag-over = -1; }
        }
        moved => {
            if self.pressed && root.drag-from >= 0 && !PaletteDrag.cancelled {
                if abs(self.mouse-x - root.press-x) > Theme.drag-threshold || abs(self.mouse-y - root.press-y) > Theme.drag-threshold {
                    root.dragging = PaletteDrag.value != "";
                    PaletteDrag.active = root.dragging;
                }
                if root.dragging {
                    PaletteDrag.x = root.absolute-position.x + self.mouse-x;
                    PaletteDrag.y = root.absolute-position.y + self.mouse-y;
                    root.drag-over = root.drop-at(PaletteDrag.x - root.absolute-position.x, PaletteDrag.y - root.absolute-position.y);
                }
            }
        }
    }
}

component DragPreview inherits Rectangle {
    in property <Point> origin;
    visible: PaletteDrag.active;
    x: PaletteDrag.x - root.origin.x + 14px;
    y: PaletteDrag.y - root.origin.y + 14px;
    width: PaletteDrag.text-item ? 200px : 72px;
    height: PaletteDrag.text-item ? 76px : 64px;
    clip: true;
    border-radius: Theme.radius; border-width: 2px; border-color: Theme.accent;
    background: Theme.card; opacity: Theme.drag-preview-opacity;
    Text {
        x: 10px; y: 8px;
        width: parent.width - 20px; height: parent.height - 16px;
        text: PaletteDrag.name == "" ? PaletteDrag.value : PaletteDrag.name;
        font-family: PaletteDrag.text-item ? "" : "Noto Color Emoji";
        font-size: PaletteDrag.text-item ? 13px : 26px;
        color: Theme.text;
        wrap: word-wrap; overflow: elide;
        horizontal-alignment: PaletteDrag.text-item ? left : center;
        vertical-alignment: center;
    }
}

component MenuTabs inherits ScrollView {
    accessible-role: tab-list;
    accessible-label: @tr("Page:");
    in property <[string]> labels;
    in property <int> selected;
    callback select(int);
    callback add();
    height: 44px;
    viewport-height: self.visible-height;
    viewport-width: max(self.visible-width, tabs.preferred-width);
    vertical-scrollbar-policy: always-off;
    horizontal-scrollbar-policy: as-needed;
    // Reordering tabs auto-scrolls through the ScrollView; this covers a grid cell
    // dragged over the tabs, which is not a `DragDrop` drag.
    private property <bool> cell-over-tabs: PaletteDrag.active && PaletteDrag.y >= root.absolute-position.y && PaletteDrag.y < root.absolute-position.y + root.height;
    /// Edge auto-scroll for a dragged cell: tick, pointer distance from an edge, and step.
    private property <duration> cell-scroll-tick: 30ms;
    private property <length> edge-zone: 24px;
    private property <length> edge-step: 12px;
    /// How long a dragged cell hovers over a tab before the tab opens.
    private property <duration> hover-open-delay: 400ms;
    drag-scroll: true;
    Timer {
        interval: root.cell-scroll-tick;
        running: root.cell-over-tabs;
        triggered => {
            if PaletteDrag.x < root.absolute-position.x + root.edge-zone { root.viewport-x = min(0px, root.viewport-x + root.edge-step); }
            if PaletteDrag.x > root.absolute-position.x + root.width - root.edge-zone { root.viewport-x = max(root.visible-width - root.viewport-width, root.viewport-x - root.edge-step); }
        }
    }
    tabs := HorizontalLayout { spacing: Theme.space-s; alignment: start;
        for label[index] in root.labels: Rectangle {
            width: tab.preferred-width; height: 40px;
            private property <Point> position: self.absolute-position;
            private property <bool> hovered: PaletteDrag.active && PaletteDrag.x >= max(root.absolute-position.x, self.position.x) && PaletteDrag.x < min(root.absolute-position.x + root.width, self.position.x + self.width) && PaletteDrag.y >= self.position.y && PaletteDrag.y < self.position.y + self.height;
            Timer { interval: root.hover-open-delay; running: parent.hovered && index != root.selected; triggered => { root.select(index); } }
            FocusScope {
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    if event.modifiers.alt && event.text == Key.LeftArrow && index > 0 { KeyboardFocus.remember-reorder(index, index - 1); MenuEditor.reorder-page(index, index - 1); KeyboardFocus.restore-reorder(); return accept; }
                    if event.modifiers.alt && event.text == Key.RightArrow && index + 1 < root.labels.length { KeyboardFocus.remember-reorder(index, index + 1); MenuEditor.reorder-page(index, index + 1); KeyboardFocus.restore-reorder(); return accept; }
                    return reject;
                }
            tab := NavTab { accessible-id: "tecloid-menu-tab-" + index; text: label == "" ? index + 1 : (index + 1) + " · " + label; selected: index == root.selected; clicked => { root.select(index); } opacity: tab-drag.dragged ? Theme.dragged-opacity : 1; }
            }
            tab-drag := DragArea {
                width: 100%; height: 100%;
                group: DragGroups.menu-tabs; index: index; count: root.labels.length;
                axis: DragAxis.horizontal;
                cursor: MouseCursor.pointer;
                clicked => { tab.focus(); root.select(index); }
                dropped(from, to) => { MenuEditor.reorder-page(from, to); }
            }
            DropMarker { cross-size: parent.height; group: DragGroups.menu-tabs; index: index; horizontal: true; row-start: parent.x; row-size: parent.width; }
        }
        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/plus.svg"); tooltip: @tr("Add page"); primary: true; clicked => { root.add(); } } }
    }
}

/// Side card header shared by the emoji and quick action pages.
component PageEditor inherits HorizontalLayout {
    callback remove();
    spacing: Theme.space-xs;
    FieldLabel { text: @tr("Page:"); horizontal-stretch: 0; max-width: self.preferred-width; vertical-alignment: center; }
    page-name := InlineTextField { text: MenuEditor.page-name; label: @tr("Page name"); placeholder: @tr("Page name"); saved(value) => { MenuEditor.page-name = value; MenuEditor.rename-page(); return true; } }
    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: page-name.editing ? 0 : 1; }
    VerticalLayout { horizontal-stretch: 0; alignment: center; IconButton { icon: @image-url("icons/app-window.svg"); label: @tr("Preview page"); clicked => { if MenuEditor.show-page() { MenuEditor.preview-visible = true; } } } }
    VerticalLayout { horizontal-stretch: 0; alignment: center; IconButton {
        icon: @image-url("icons/trash-2.svg");
        // The only page cannot go away: removing it clears it.
        label: MenuEditor.pages.length <= 1 ? @tr("Clear page") : @tr("Delete page");
        enabled: !MenuEditor.only-page-empty;
        clicked => { root.remove(); }
    } }
}

/// Save status of the menus; an edit conflict offers to drop the draft.
component MenuStatus inherits VerticalLayout {
    spacing: Theme.space-xs;
    StatusText { status: MenuEditor.status; }
    if MenuEditor.has-unsaved-changes: HorizontalLayout {
        alignment: start;
        if MenuEditor.status.id != "config-edit-conflict": Button { text: @tr("Retry"); clicked => { MenuEditor.flush-pending(); } }
        Button { text: @tr("Discard changes"); clicked => { MenuEditor.refresh(); } }
    }
}

/// Confirms removing the selected page, or clearing the only one.
component RemovePageDialog inherits ConfirmDialog {
    private property <bool> only: MenuEditor.pages.length <= 1;
    width: 100%;
    height: 100%;
    title: root.only ? @tr("Clear page?") : @tr("Delete page?");
    body: root.only ? @tr("All cells on the page will be cleared.") : @tr("The page and all assigned cells on it will be deleted.");
    confirm-text: root.only ? @tr("Clear") : @tr("Delete");
}

component EmojiButton inherits Rectangle {
    in property <bool> tab-stop;
    callback focused();
    in property <string> item;
    // Text snippets: wider buttons with a smaller, left-aligned label.
    in property <bool> wide;
    height: 40px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 40px;
    border-radius: Theme.radius;
    border-width: Theme.focus-ring(focus.has-focus) ? 2px : 1px;
    border-color: Theme.focus-ring(focus.has-focus) ? Theme.focus : touch.has-hover ? Theme.accent : Theme.border;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.item == "\u{a0}" ? @tr("Non-breaking space") : root.item;
    accessible-action-default => { self.pick(); }
    function pick() { MenuEditor.value = root.item; MenuEditor.set-cell(); }
    Text {
        x: root.wide ? 10px : 0px;
        width: root.wide ? parent.width - 20px : parent.width;
        text: root.item == "\u{a0}" ? "⍽" : root.item;
        font-family: root.wide ? "" : "Noto Color Emoji";
        font-size: root.wide ? 13px : 20px;
        color: Theme.text;
        horizontal-alignment: root.wide ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := NavigationFocus {
        tab-stop: root.tab-stop;
        focus-changed-event => { if self.has-focus { root.focused(); } }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.pick(); return accept; }
            return self.navigate(event);
        }
    }
    touch := TouchArea {
        mouse-cursor: PaletteDrag.active ? grabbing : grab;
        moved => {
            if self.pressed && !PaletteDrag.cancelled {
                if abs(self.mouse-x - self.pressed-x) > Theme.drag-threshold || abs(self.mouse-y - self.pressed-y) > Theme.drag-threshold { PaletteDrag.active = true; }
                PaletteDrag.x = root.absolute-position.x + self.mouse-x;
                PaletteDrag.y = root.absolute-position.y + self.mouse-y;
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                PaletteDrag.reset(); PaletteDrag.value = root.item; PaletteDrag.text-item = root.wide || root.item.character-count > 6;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if PaletteDrag.active {
                    let target = PaletteDrag.cell;
                    if target >= 0 { MenuEditor.select-cell(target); root.pick(); }
                } else if !PaletteDrag.cancelled { focus.focus(); root.pick(); }
                PaletteDrag.reset();
            }
            if event.kind == PointerEventKind.cancel { PaletteDrag.reset(); }
        }
    }
}

export component EmojiPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> confirming;
    // Library snippets are literal insertion text, independent of the UI language.
    private property <[string]> kaomoji: [
        "≽^•⩊•^≼",
        "(っ◕‿◕)っ",
        "(╯ರ ~ ರ）╯︵ ┻━┻ ",
        "(ﾉ◕ヮ◕)ﾉ*:･ﾟ✧",
        "( ˘ ³˘)♥",
        "¯\\_(ツ)_/¯",
    ];
    private property <[string]> texts: [
        "TODO: ",
        "FIXME: ",
        "Continue.",
        "Thanks!",
    ];
    PageLayout {
        accessible-label: @tr("Emoji");
        PageHeader {
            title: @tr("Emoji & Symbols");
            info: @tr("Opened by the tecloid:showEmojiMenuN actions, where N is the page position: reordering pages changes which page a key opens. Each cell can hold an emoji, a UTF symbol (e.g. ≠), any other character (e.g. №), or a short phrase (e.g. \"// TODO: \").") + "\n\n" + @tr("In the popup, click a cell or press its key: the cells follow the keyboard rows Q–T, A–G and Z–B. PgUp/PgDn switch pages; digits open a page by its number.") + "\n\n" + @tr("In the editor, focus a cell and press Ctrl+X to cut it or Ctrl+C to copy it, then press Ctrl+V on another cell to paste. Escape cancels.");
        }
        HorizontalLayout {
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            MenuTabs { labels: MenuEditor.pages; selected: MenuEditor.selected-page; select(index) => { MenuEditor.select-page(index); } add => { MenuEditor.add-page(""); } }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            spacing: Theme.space-xl;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-xl;
                alignment: start;
                HotkeyGrid { emoji: true; activate(index) => { MenuEditor.select-cell(index); } }
            }
            Card {
                width: 360px;
                VerticalLayout {
                    padding: Theme.space-l-plus;
                    spacing: Theme.space-l;
                    PageEditor { remove => { root.confirming = true; } }
                    Divider {}
                    FieldLabel { text: @tr("Button {}", MenuEditor.cells[MenuEditor.selected-cell].key); }
                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        TextField {
                            text <=> MenuEditor.value;
                            placeholder-text: @tr("Emoji, symbol, or any text"); accessible-label: @tr("Emoji, symbol, or any text");
                            edited => { MenuEditor.set-cell(); }
                        }
                        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/eraser.svg"); label: @tr("Clear cell"); clicked => { MenuEditor.clear-cell(); } } }
                        InfoTip { text: @tr("You can enter emoji, any text, or Unicode symbols here. Drag an item from the palette onto a key to assign it."); }
                    }
                    if MenuEditor.status.id != "": MenuStatus {}
                    FieldLabel { text: @tr("Examples"); }
                    ScrollView {
                        min-height: 0px;
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            padding-right: Theme.space-m-plus;
                            spacing: Theme.space-s;
                            // One list for all emoji categories: a single Tab stop, and arrows cross category borders.
                            emoji-palette := VerticalLayout {
                            accessible-role: list; accessible-label: @tr("Examples");
                            property <int> keyboard-category: 0;
                            property <int> keyboard-item: 0;
                            spacing: Theme.space-s;
                            for category[category-index] in MenuEditor.catalog: VerticalLayout {
                                spacing: Theme.space-s;
                                padding-bottom: Theme.space-m;
                                Text {
                                    // Ids are checked against CATEGORY_IDS in src/pages/menus.rs.
                                    text: category.id == "smileys" ? @tr("Smileys & Emotion")
                                        : category.id == "people" ? @tr("People & Gestures")
                                        : category.id == "symbols" ? @tr("Emoji Symbols")
                                        : category.id == "work" ? @tr("Work & Objects")
                                        : category.id == "nature" ? @tr("Animals & Nature")
                                        : category.id == "food" ? @tr("Food & Drink")
                                        : category.id == "travel" ? @tr("Travel & Places")
                                        : @tr("UTF Symbols");
                                    color: Theme.muted;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-bold;
                                }
                                for row in ceil(category.items.length / 6): HorizontalLayout {
                                    spacing: Theme.space-s;
                                    for col in 6: EmojiButton {
                                        tab-stop: category-index == emoji-palette.keyboard-category && row * 6 + col == emoji-palette.keyboard-item;
                                        focused => { emoji-palette.keyboard-category = category-index; emoji-palette.keyboard-item = row * 6 + col; }
                                        item: category.items[row * 6 + col];
                                        visible: row * 6 + col < category.items.length;
                                    }
                                }
                            }
                            }
                            kaomoji-palette := VerticalLayout {
                                accessible-role: list; accessible-label: @tr("Kaomoji");
                                property <int> keyboard-item: 0;
                                spacing: Theme.space-s;
                                padding-bottom: Theme.space-m;
                                Text { text: @tr("Kaomoji"); color: Theme.muted; font-size: Theme.font-caption; font-weight: Theme.weight-bold; }
                                for row in ceil(root.kaomoji.length / 2): HorizontalLayout {
                                    spacing: Theme.space-s;
                                    for col in 2: EmojiButton {
                                        wide: true;
                                        tab-stop: row * 2 + col == kaomoji-palette.keyboard-item;
                                        focused => { kaomoji-palette.keyboard-item = row * 2 + col; }
                                        item: root.kaomoji[row * 2 + col];
                                        visible: row * 2 + col < root.kaomoji.length;
                                    }
                                }
                            }
                            texts-palette := VerticalLayout {
                                accessible-role: list; accessible-label: @tr("Texts");
                                property <int> keyboard-item: 0;
                                spacing: Theme.space-s;
                                padding-bottom: Theme.space-m;
                                Text { text: @tr("Texts"); color: Theme.muted; font-size: Theme.font-caption; font-weight: Theme.weight-bold; }
                                for row in ceil(root.texts.length / 2): HorizontalLayout {
                                    spacing: Theme.space-s;
                                    for col in 2: EmojiButton {
                                        wide: true;
                                        tab-stop: row * 2 + col == texts-palette.keyboard-item;
                                        focused => { texts-palette.keyboard-item = row * 2 + col; }
                                        item: root.texts[row * 2 + col];
                                        visible: row * 2 + col < root.texts.length;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    DragPreview { origin: root.absolute-position; }
    if root.confirming: RemovePageDialog {
        cancel => { root.confirming = false; }
        confirm => { MenuEditor.remove-page(); root.confirming = false; }
    }
}

export component QuickActionsPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> confirming;
    private property <bool> filled: MenuEditor.selected-cell >= 0 && MenuEditor.cells[MenuEditor.selected-cell].value != "";
    PageLayout {
        accessible-label: @tr("Quick actions");
        PageHeader {
            title: @tr("Quick Actions");
            info: @tr("Opened by the tecloid:showQuickMenuN actions, where N is the page position: reordering pages changes which page a key opens. Each cell can hold any action: a shortcut, macro, shell command or system action.") + "\n\n" + @tr("In the popup, click a cell or press its key: the cells follow the keyboard rows Q–T, A–G and Z–B. PgUp/PgDn switch pages; digits open a page by its number.") + "\n\n" + @tr("In the editor, focus a cell and press Ctrl+X to cut it or Ctrl+C to copy it, then press Ctrl+V on another cell to paste. Escape cancels.");
        }
        HorizontalLayout {
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            MenuTabs { labels: MenuEditor.pages; selected: MenuEditor.selected-page; select(index) => { MenuEditor.select-page(index); } add => { MenuEditor.add-page(""); } }
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            PageContent {
                alignment: start;
                Rectangle {
                    VerticalLayout {
                        padding: 0px;
                        spacing: Theme.space-xl;
                        HorizontalLayout {
                            spacing: Theme.space-xl;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Theme.space-xl;
                                alignment: start;
                                HotkeyGrid {
                                    emoji: false;
                                    activate(index) => {
                                        MenuEditor.select-cell(index);
                                    }
                                }
                            }
                            Card {
                                width: 360px;
                                VerticalLayout {
                                    padding: Theme.space-l-plus;
                                    spacing: Theme.space-l;
                                    alignment: start;
                                    PageEditor { remove => { root.confirming = true; } }
                                    Divider {}
                                    if MenuEditor.status.id != "": MenuStatus {}
                                    if MenuEditor.selected-cell >= 0: HorizontalLayout {
                                        FieldLabel { text: @tr("Button {}", MenuEditor.cells[MenuEditor.selected-cell].key); vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        IconButton { icon: @image-url("icons/eraser.svg"); label: @tr("Clear cell"); clicked => { MenuEditor.clear-cell(); } }
                                    }
                                    if root.filled: VerticalLayout {
                                        spacing: Theme.space-xs;
                                        FieldLabel { text: @tr("Label"); }
                                        TextField { text <=> MenuEditor.name; placeholder-text: @tr("e.g. Next Track"); accessible-label: @tr("Name"); edited => { MenuEditor.set-name(); } }
                                    }
                                    if MenuEditor.selected-cell >= 0: VerticalLayout {
                                        spacing: Theme.space-xs;
                                        FieldLabel { text: @tr("Action"); }
                                        HorizontalLayout {
                                            spacing: Theme.space-xs;
                                            ActionField {
                                                horizontal-stretch: 1;
                                                label: @tr("Action");
                                                value: MenuEditor.value;
                                                text-family: "monospace";
                                                text-size: Theme.font-body;
                                                clicked => { ActionPicker.open(PickerTarget.quick-action, MenuEditor.selected-cell, MenuEditor.value, false); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    DragPreview { origin: root.absolute-position; }
    if root.confirming: RemovePageDialog {
        cancel => { root.confirming = false; }
        confirm => { MenuEditor.remove-page(); root.confirming = false; }
    }
}

export component MenuPreview inherits DialogFrame {
    title: @tr("Preview page");
    subtitle: @tr("Preview only; actions are not executed.");
    card-width: MenuEditor.kind == MenuKind.emoji ? 520px : 820px;
    close => { MenuEditor.preview-visible = false; }
    if MenuEditor.page-name != "": FieldLabel { text: MenuEditor.page-name; }
    ScrollView {
        min-height: 0px;
        preferred-height: 3 * 80px + 2 * Theme.space-l;
        viewport-width: self.visible-width;
        VerticalLayout {
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            spacing: Theme.space-l;
            for row in 3: HorizontalLayout {
                spacing: Theme.space-m;
                for col in 5: PopupCell {
                    interactive: false;
                    height: 80px;
                    hotkey: MenuEditor.cells[row * 5 + col].key;
                    content: MenuEditor.kind == MenuKind.emoji
                        ? MenuEditor.cells[row * 5 + col].value
                        : MenuEditor.cells[row * 5 + col].name;
                    emoji: MenuEditor.kind == MenuKind.emoji;
                }
            }
        }
    }
}

export component MenusPage inherits Rectangle {
    vertical-stretch: 1;
    if MenuEditor.kind == MenuKind.emoji: EmojiPage { width: 100%; height: 100%; }
    if MenuEditor.kind == MenuKind.quick: QuickActionsPage { width: 100%; height: 100%; }
}
