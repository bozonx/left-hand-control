import { InlineTextArea } from "controls.slint";
import { ScrollView } from "scroll.slint";
import { DragDrop, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { MenuKind, PickerTarget } from "types.slint";
import { InlineTextField, Badge, Card, CardHeader, ConfirmDialog, FieldLabel, IconButton, InfoTip, NavTab } from "controls.slint";
import { Button, LineEdit, TextEdit } from "std-widgets.slint";

export struct MenuCell { key: string, value: string, name: string }
export struct EmojiCategory { id: string, items: [string] }
global PaletteDrag {
    in-out property <bool> active;
    in-out property <string> value;
    in-out property <string> name;
    in-out property <bool> text-item;
    public function reset() { self.active = false; self.value = ""; self.name = ""; }
    in-out property <length> x;
    in-out property <length> y;
    in-out property <length> grid-x;
    in-out property <length> grid-y;
    in-out property <length> cell-width;
    in-out property <length> cell-height;
    public pure function target(x: length, y: length) -> int {
        let local-x = x - self.grid-x - 12px;
        let local-y = y - self.grid-y - 12px;
        if local-x < 0px || local-y < 0px || local-x >= 5 * (self.cell-width + 8px) - 8px || local-y >= 3 * (self.cell-height + 8px) - 8px { return -1; }
        if mod(local-x, self.cell-width + 8px) >= self.cell-width || mod(local-y, self.cell-height + 8px) >= self.cell-height { return -1; }
        return floor(local-y / (self.cell-height + 8px)) * 5 + floor(local-x / (self.cell-width + 8px));
    }
}

export global MenuEditor {
    in-out property <MenuKind> kind;
    in property <[string]> pages;
    in property <[MenuCell]> cells;
    in property <[EmojiCategory]> catalog;
    in-out property <int> selected-page;
    in-out property <int> selected-cell;
    in-out property <string> page-name;
    in-out property <string> value;
    in-out property <string> name;
    in-out property <int> editing-count: 0;
    in property <Message> status;
    callback open(MenuKind);
    callback flush-pending();
    callback refresh();
    callback select-page(int);
    callback select-cell(int);
    callback add-page(string);
    callback remove-page();
    callback show-page();
    callback move-page(int);
    /// Read `page-name`, `value` and `name` into the selected page and cell.
    callback rename-page();
    callback set-cell();
    callback set-name();
    callback set-action(int, string, string);
    callback clear-cell();
    callback move-cell(int, int);
    callback transfer-cell(int, int, int);
    callback reorder-page(int, int);
}

/// 5×3 grid of the left-hand hotkeys; click selects, drag moves a cell.
component HotkeyGrid inherits Rectangle {
    in property <bool> emoji;
    in property <length> cell-height: 96px;
    callback activate(int);
    private property <length> pad: 12px;
    private property <length> gap: 8px;
    private property <length> cell-width: (self.width - 2 * self.pad - 4 * self.gap) / 5;
    private property <int> drag-from: -1;
    private property <int> drag-over: -1;
    private property <int> source-page: -1;
    private property <bool> dragging;
    private property <length> press-x;
    private property <length> press-y;
    private property <int> current-page: MenuEditor.selected-page;
    changed current-page => { if root.dragging { root.drag-over = root.drop-at(PaletteDrag.x - root.absolute-position.x, PaletteDrag.y - root.absolute-position.y); } }
    min-width: 5 * 64px + 2 * self.pad + 4 * self.gap;
    height: 2 * self.pad + 3 * self.cell-height + 2 * self.gap;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    private property <Point> grid-position: root.absolute-position;
    function sync-grid() {
        PaletteDrag.grid-x = root.grid-position.x;
        PaletteDrag.grid-y = root.grid-position.y;
        PaletteDrag.cell-width = root.cell-width;
        PaletteDrag.cell-height = root.cell-height;
    }
    init => { root.sync-grid(); }
    changed grid-position => { root.sync-grid(); }
    changed width => { root.sync-grid(); }
    changed cell-width => { root.sync-grid(); }
    changed cell-height => { root.sync-grid(); }
    pure function index-at(x: length, y: length) -> int {
        return max(0, min(2, floor((y - self.pad) / (self.cell-height + self.gap)))) * 5
            + max(0, min(4, floor((x - self.pad) / (self.cell-width + self.gap))));
    }
    pure function drop-at(x: length, y: length) -> int {
        let local-x = x - self.pad;
        let local-y = y - self.pad;
        if local-x < 0px || local-y < 0px || local-x >= 5 * (self.cell-width + self.gap) - self.gap || local-y >= 3 * (self.cell-height + self.gap) - self.gap { return -1; }
        if mod(local-x, self.cell-width + self.gap) >= self.cell-width || mod(local-y, self.cell-height + self.gap) >= self.cell-height { return -1; }
        return floor(local-y / (self.cell-height + self.gap)) * 5 + floor(local-x / (self.cell-width + self.gap));
    }
    pure function preview(index: int) -> int {
        if !self.dragging || self.source-page != MenuEditor.selected-page || self.drag-over < 0 { return index; }
        if index == self.drag-from { return self.drag-over; }
        if self.drag-from < self.drag-over && index > self.drag-from && index <= self.drag-over { return index - 1; }
        if self.drag-from > self.drag-over && index >= self.drag-over && index < self.drag-from { return index + 1; }
        return index;
    }
    if root.dragging && root.drag-over >= 0: Rectangle {
        x: root.pad + mod(root.drag-over, 5) * (root.cell-width + root.gap);
        y: root.pad + floor(root.drag-over / 5) * (root.cell-height + root.gap);
        width: root.cell-width; height: root.cell-height;
        border-width: 2px; border-color: Theme.link; border-radius: 6px; background: Theme.hover;
    }
    for cell[index] in MenuEditor.cells: Rectangle {
        x: root.pad + mod(root.preview(index), 5) * (root.cell-width + root.gap);
        y: root.pad + floor(root.preview(index) / 5) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        clip: true;
        border-radius: 6px;
        border-width: (PaletteDrag.active && PaletteDrag.target(PaletteDrag.x, PaletteDrag.y) == root.preview(index)) || (index == MenuEditor.selected-cell && !PaletteDrag.active) || (root.dragging && root.preview(index) == root.drag-over) ? 2px : 1px;
        border-color: (PaletteDrag.active && PaletteDrag.target(PaletteDrag.x, PaletteDrag.y) == root.preview(index)) || (index == MenuEditor.selected-cell && !PaletteDrag.active) || (root.dragging && root.preview(index) == root.drag-over) ? Theme.link : Theme.border;
        background: (PaletteDrag.active && PaletteDrag.target(PaletteDrag.x, PaletteDrag.y) == root.preview(index)) || (root.dragging && root.preview(index) == root.drag-over) ? Theme.hover : Theme.card;
        opacity: root.dragging && root.source-page == MenuEditor.selected-page && index == root.drag-from ? 0.25 : 1.0;
        accessible-role: button;
        accessible-label: cell.key + " " + (root.emoji ? cell.value : cell.name);
        accessible-action-default => { root.activate(index); }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            HorizontalLayout {
                Text { horizontal-stretch: 1; text: MenuEditor.cells[root.preview(index)].key; color: Theme.link; font-family: "monospace"; font-size: 12px; font-weight: 600; }
                Image { width: 14px; height: 14px; source: @image-url("icons/grip.svg"); colorize: Theme.muted; accessible-label: @tr("Drag"); }
            }
            if root.emoji: Text {
                font-family: "Noto Color Emoji";
                vertical-stretch: 1;
                text: cell.value == "" ? "＋" : cell.value;
                color: cell.value == "" ? Theme.muted : Theme.text;
                font-size: cell.value.character-count <= 2 ? 26px : cell.value.character-count <= 6 ? 16px : 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
            if !root.emoji: HorizontalLayout {
                spacing: 6px;
                if cell.value != "": Image { width: 16px; source: @image-url("icons/zap.svg"); colorize: Theme.muted; }
                Text {
                    horizontal-stretch: 1;
                    text: cell.value == "" ? @tr("Empty") : cell.name;
                    color: cell.value == "" ? Theme.muted : Theme.text;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if !root.emoji: Text { text: cell.value == "" ? "—" : cell.value; color: Theme.muted; font-family: "monospace"; font-size: 11px; overflow: elide; }
            if !root.emoji: Rectangle { vertical-stretch: 1; }
        }
    }
    TouchArea {
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                PaletteDrag.reset();
                root.source-page = MenuEditor.selected-page;
                root.drag-from = root.index-at(self.mouse-x, self.mouse-y);
                PaletteDrag.value = MenuEditor.cells[root.drag-from].value;
                PaletteDrag.name = MenuEditor.cells[root.drag-from].name;
                PaletteDrag.text-item = !root.emoji || PaletteDrag.value.character-count > 6;
                root.drag-over = root.drag-from;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.dragging = false;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-from >= 0 {
                if root.dragging { root.drag-over = root.drop-at(self.mouse-x, self.mouse-y); }
                if !root.dragging {
                    root.activate(root.drag-from);
                } else if root.drag-over >= 0 {
                    if root.source-page == MenuEditor.selected-page {
                        MenuEditor.move-cell(root.drag-from, root.drag-over);
                    } else {
                        MenuEditor.transfer-cell(root.source-page, root.drag-from, root.drag-over);
                    }
                }
                PaletteDrag.reset();
                root.dragging = false;
                root.drag-from = -1;
                root.drag-over = -1;
            }
            if event.kind == PointerEventKind.cancel { PaletteDrag.reset(); root.dragging = false; root.drag-from = -1; root.drag-over = -1; }
        }
        moved => {
            if self.pressed && root.drag-from >= 0 {
                if abs(self.mouse-x - root.press-x) > 6px || abs(self.mouse-y - root.press-y) > 6px {
                    root.dragging = PaletteDrag.value != "";
                    PaletteDrag.active = root.dragging;
                }
                if root.dragging {
                    root.sync-grid();
                    PaletteDrag.x = root.absolute-position.x + self.mouse-x;
                    PaletteDrag.y = root.absolute-position.y + self.mouse-y;
                    root.drag-over = root.drop-at(PaletteDrag.x - root.absolute-position.x, PaletteDrag.y - root.absolute-position.y);
                }
            }
        }
    }
}

component DragPreview inherits Rectangle {
    in property <Point> origin;
    visible: PaletteDrag.active;
    x: PaletteDrag.x - root.origin.x + 14px;
    y: PaletteDrag.y - root.origin.y + 14px;
    width: PaletteDrag.text-item ? 200px : 72px;
    height: PaletteDrag.text-item ? 76px : 64px;
    clip: true;
    border-radius: 6px; border-width: 2px; border-color: Theme.link;
    background: Theme.card; opacity: 0.95;
    Text {
        x: 10px; y: 8px;
        width: parent.width - 20px; height: parent.height - 16px;
        text: PaletteDrag.name == "" ? PaletteDrag.value : PaletteDrag.name;
        font-family: PaletteDrag.text-item ? "" : "Noto Color Emoji";
        font-size: PaletteDrag.text-item ? 13px : 26px;
        color: Theme.text;
        wrap: word-wrap; overflow: elide;
        horizontal-alignment: PaletteDrag.text-item ? left : center;
        vertical-alignment: center;
    }
}

component MenuTabs inherits ScrollView {
    in property <[string]> labels;
    in property <int> selected;
    callback select(int);
    callback add();
    height: 44px;
    viewport-height: self.visible-height;
    viewport-width: max(self.visible-width, tabs.preferred-width);
    vertical-scrollbar-policy: always-off;
    horizontal-scrollbar-policy: as-needed;
    private property <length> pointer-x;
    private property <bool> cell-over-tabs: PaletteDrag.active && PaletteDrag.y >= root.absolute-position.y && PaletteDrag.y < root.absolute-position.y + root.height;
    private property <length> scroll-pointer: root.cell-over-tabs ? PaletteDrag.x : root.pointer-x;
    Timer {
        interval: 30ms;
        running: (DragDrop.dragging && DragDrop.group == 5) || root.cell-over-tabs;
        triggered => {
            if root.scroll-pointer < root.absolute-position.x + 24px { root.viewport-x = min(0px, root.viewport-x + 12px); }
            if root.scroll-pointer > root.absolute-position.x + root.width - 24px { root.viewport-x = max(root.visible-width - root.viewport-width, root.viewport-x - 12px); }
        }
    }
    tabs := HorizontalLayout { spacing: 6px; alignment: start;
        for label[index] in root.labels: Rectangle {
            width: tab.preferred-width; height: 40px;
            private property <Point> position: self.absolute-position;
            private property <bool> hovered: PaletteDrag.active && PaletteDrag.x >= max(root.absolute-position.x, self.position.x) && PaletteDrag.x < min(root.absolute-position.x + root.width, self.position.x + self.width) && PaletteDrag.y >= self.position.y && PaletteDrag.y < self.position.y + self.height;
            init => { DragDrop.row(5, index, self.position.x, self.width); }
            changed position => { DragDrop.row(5, index, self.position.x, self.width); }
            changed width => { DragDrop.row(5, index, self.position.x, self.width); }
            Timer { interval: 400ms; running: parent.hovered && index != root.selected; triggered => { root.select(index); } }
            tab := NavTab { text: label; selected: index == root.selected; clicked => { root.select(index); } opacity: DragDrop.dragging && DragDrop.group == 5 && DragDrop.source == index ? 0.5 : 1; }
            if DragDrop.dragging && DragDrop.group == 5 && DragDrop.target == index && index != DragDrop.source: Rectangle {
                x: index > DragDrop.source ? parent.width : -3px;
                width: 3px; background: Theme.link;
            }
            Timer {
                interval: 30ms;
                running: DragDrop.dragging && DragDrop.group == 5 && DragDrop.source == index;
                triggered => { DragDrop.target = DragDrop.locate(5, index, root.pointer-x - parent.position.x - touch.pressed-x, root.labels.length); }
            }
            touch := TouchArea {
                mouse-cursor: self.pressed ? grabbing : pointer;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        DragDrop.reset(); DragDrop.group = 5; DragDrop.source = index; DragDrop.target = index;
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && DragDrop.group == 5 {
                        let from = DragDrop.source; let to = DragDrop.target; let moved = DragDrop.dragging;
                        DragDrop.reset();
                        if moved { MenuEditor.reorder-page(from, to); } else { root.select(index); }
                    }
                    if event.kind == PointerEventKind.cancel { DragDrop.reset(); }
                }
                moved => {
                    if self.pressed && DragDrop.group == 5 {
                        root.pointer-x = self.absolute-position.x + self.mouse-x;
                        DragDrop.offset = self.mouse-x - self.pressed-x;
                        if abs(DragDrop.offset) > 6px { DragDrop.dragging = true; }
                        if DragDrop.dragging { DragDrop.target = DragDrop.locate(5, DragDrop.source, DragDrop.offset, root.labels.length); }
                    }
                }
            }
        }
        IconButton { icon: @image-url("icons/plus.svg"); tooltip: @tr("Add page"); primary: root.labels.length == 0; clicked => { root.add(); } }
    }
}

/// Side card header shared by the emoji and quick action pages.
component PageEditor inherits HorizontalLayout {
    callback remove();
    spacing: 4px;
    FieldLabel { text: @tr("Page:"); horizontal-stretch: 0; max-width: self.preferred-width; vertical-alignment: center; }
    page-name := InlineTextField { clearable: false; text: MenuEditor.page-name; label: @tr("Page name"); allow-empty: false; saved(value) => { MenuEditor.page-name = value; MenuEditor.rename-page(); } }
    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: page-name.editing ? 0 : 1; }
    VerticalLayout { horizontal-stretch: 0; alignment: center; IconButton { icon: @image-url("icons/app-window.svg"); label: @tr("Open page in popup"); clicked => { MenuEditor.show-page(); } } }
    VerticalLayout { horizontal-stretch: 0; alignment: center; IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Delete page"); clicked => { root.remove(); } } }
}

component EmojiButton inherits Rectangle {
    in property <string> item;
    // Text snippets: wider buttons with a smaller, left-aligned label.
    in property <bool> wide;
    height: 40px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.text : touch.has-hover ? Theme.link : Theme.border;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.item == "\u{a0}" ? @tr("Non-breaking space") : root.item;
    accessible-action-default => { self.pick(); }
    function pick() { MenuEditor.value = root.item; MenuEditor.set-cell(); }
    Text {
        x: root.wide ? 10px : 0px;
        width: root.wide ? parent.width - 20px : parent.width;
        text: root.item == "\u{a0}" ? "⍽" : root.item;
        font-family: root.wide ? "" : "Noto Color Emoji";
        font-size: root.wide ? 13px : 20px;
        color: Theme.text;
        horizontal-alignment: root.wide ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.pick(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: PaletteDrag.active ? grabbing : grab;
        moved => {
            if self.pressed {
                if abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px { PaletteDrag.active = true; }
                PaletteDrag.x = root.absolute-position.x + self.mouse-x;
                PaletteDrag.y = root.absolute-position.y + self.mouse-y;
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                PaletteDrag.reset(); PaletteDrag.value = root.item; PaletteDrag.text-item = root.wide || root.item.character-count > 6;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                if PaletteDrag.active {
                    let target = PaletteDrag.target(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
                    if target >= 0 { MenuEditor.select-cell(target); root.pick(); }
                } else { root.pick(); }
                PaletteDrag.reset();
            }
            if event.kind == PointerEventKind.cancel { PaletteDrag.reset(); }
        }
    }
}

export component EmojiPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> confirming;
    // Common text snippets, localized so the inserted text matches the UI language.
    private property <[string]> texts: [
        "TODO: ",
        "FIXME: ",
        @tr("continue"),
        @tr("do all you recommended"),
        @tr("fix the errors above"),
        @tr("I'll call you back later"),
        @tr("Thanks!"),
        @tr("OK, got it 👍"),
    ];
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        padding-left: 8px;
        padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
        spacing: 16px;
        CardHeader {
            title: @tr("Emoji & Symbols");
            info: @tr("Opened by the app:showEmojiMenu1...5 actions. Each cell can hold an emoji, a UTF symbol (e.g. ≠), any other character (e.g. №), or a short phrase (e.g. \"// TODO: \").");
        }
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;
                alignment: start;
                    MenuTabs { labels: MenuEditor.pages; selected: MenuEditor.selected-page; select(index) => { MenuEditor.select-page(index); } add => { MenuEditor.add-page(@tr("Page {}", MenuEditor.pages.length + 1)); } }
                HotkeyGrid { emoji: true; activate(index) => { MenuEditor.select-cell(index); } }
            }
            Card {
                width: 360px;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    PageEditor { remove => { root.confirming = true; } }
                    Rectangle { height: 1px; background: Theme.divider; }
                    FieldLabel { text: @tr("Button {}", MenuEditor.cells[MenuEditor.selected-cell].key); }
                    HorizontalLayout {
                        spacing: 4px;
                        LineEdit {
                            text <=> MenuEditor.value;
                            placeholder-text: @tr("Emoji, symbol, or any text");
                            edited => { MenuEditor.set-cell(); }
                        }
                        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/eraser.svg"); label: @tr("Clear cell"); clicked => { MenuEditor.clear-cell(); } } }
                        InfoTip { text: @tr("You can enter emoji, any text, or Unicode symbols here. Drag an item from the palette onto a key to assign it."); }
                    }
                    if MenuEditor.status.id != "": Text { text: Locale.text(MenuEditor.status); color: Theme.error; wrap: word-wrap; }
                    ScrollView {
                        min-height: 0px;
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            padding-right: 10px;
                            spacing: 6px;
                            for category in MenuEditor.catalog: VerticalLayout {
                                spacing: 6px;
                                padding-bottom: 8px;
                                Text {
                                    text: category.id == "smileys" ? @tr("Smileys & Emotion")
                                        : category.id == "people" ? @tr("People & Gestures")
                                        : category.id == "symbols" ? @tr("Emoji Symbols")
                                        : category.id == "work" ? @tr("Work & Objects")
                                        : category.id == "nature" ? @tr("Animals & Nature")
                                        : category.id == "food" ? @tr("Food & Drink")
                                        : category.id == "travel" ? @tr("Travel & Places")
                                        : @tr("UTF Symbols");
                                    color: Theme.muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                                for row in ceil(category.items.length / 6): HorizontalLayout {
                                    spacing: 6px;
                                    for col in 6: EmojiButton {
                                        item: category.items[row * 6 + col];
                                        visible: row * 6 + col < category.items.length;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 6px;
                                padding-bottom: 8px;
                                Text { text: @tr("Texts"); color: Theme.muted; font-size: 11px; font-weight: 700; }
                                for row in ceil(root.texts.length / 2): HorizontalLayout {
                                    spacing: 6px;
                                    for col in 2: EmojiButton {
                                        wide: true;
                                        item: root.texts[row * 2 + col];
                                        visible: row * 2 + col < root.texts.length;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    DragPreview { origin: root.absolute-position; }
    if root.confirming: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete page?");
        body: @tr("The page and all assigned cells on it will be deleted.");
        confirm-text: @tr("Delete");
        cancel => { root.confirming = false; }
        confirm => { MenuEditor.remove-page(); root.confirming = false; }
    }
}

export component QuickActionsPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> confirming;
    private property <bool> filled: MenuEditor.selected-cell >= 0 && MenuEditor.cells[MenuEditor.selected-cell].value != "";
    VerticalLayout {
        padding: 0px;
        spacing: 16px;
        CardHeader {
            vertical-stretch: 0;
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            title: @tr("Quick Actions");
            info: @tr("Opened by the app:showQuickMenu1...5 actions.");
        }
        HorizontalLayout {
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            MenuTabs { labels: MenuEditor.pages; selected: MenuEditor.selected-page; select(index) => { MenuEditor.select-page(index); } add => { MenuEditor.add-page(@tr("Page {}", MenuEditor.pages.length + 1)); } }
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            VerticalLayout { padding: 0px;
                alignment: start;
                Rectangle {
                    VerticalLayout {
                        padding: 0px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 16px;
                                alignment: start;
                                HotkeyGrid {
                                    emoji: false;
                                    activate(index) => {
                                        if MenuEditor.cells[index].value == "" {
                                            ActionPicker.open(PickerTarget.quick-action, index, "", false);
                                        } else {
                                            MenuEditor.select-cell(index);
                                        }
                                    }
                                }
                            }
                            Card {
                                width: 360px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 12px;
                                    alignment: start;
                                    PageEditor { remove => { root.confirming = true; } }
                                    Rectangle { height: 1px; background: Theme.divider; }
                                    if MenuEditor.status.id != "": Text { text: Locale.text(MenuEditor.status); color: Theme.error; wrap: word-wrap; }
                                    if MenuEditor.selected-cell >= 0: FieldLabel { text: @tr("Button {}", MenuEditor.cells[MenuEditor.selected-cell].key); }
                                    if root.filled: VerticalLayout {
                                        spacing: 4px;
                                        FieldLabel { text: @tr("Label"); }
                                        LineEdit { text <=> MenuEditor.name; placeholder-text: @tr("e.g. Next Track"); edited => { MenuEditor.set-name(); } }
                                    }
                                    if root.filled: VerticalLayout {
                                        spacing: 4px;
                                        FieldLabel { text: @tr("Action"); }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                height: 34px;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: action-focus.has-focus ? Theme.text : Theme.border;
                                                background: action-touch.has-hover ? Theme.hover : Theme.surface;
                                                accessible-role: button;
                                                accessible-label: @tr("Action");
                                                accessible-value: MenuEditor.value;
                                                accessible-action-default => { self.pick(); }
                                                function pick() { ActionPicker.open(PickerTarget.quick-action, MenuEditor.selected-cell, MenuEditor.value, false); }
                                                Text {
                                                    x: 10px;
                                                    width: parent.width - 20px;
                                                    text: MenuEditor.value;
                                                    color: Theme.text;
                                                    font-family: "monospace";
                                                    font-size: 12px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                action-focus := FocusScope {
                                                    key-pressed(event) => {
                                                        if event.text == " " || event.text == "\n" { parent.pick(); return accept; }
                                                        return reject;
                                                    }
                                                }
                                                action-touch := TouchArea { mouse-cursor: pointer; clicked => { parent.pick(); } }
                                            }
                                            VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/eraser.svg"); label: @tr("Clear cell"); clicked => { MenuEditor.clear-cell(); } } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    DragPreview { origin: root.absolute-position; }
    if root.confirming: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete page?");
        body: @tr("The page and all assigned cells on it will be deleted.");
        confirm-text: @tr("Delete");
        cancel => { root.confirming = false; }
        confirm => { MenuEditor.remove-page(); root.confirming = false; }
    }
}

export component MenusPage inherits Rectangle {
    vertical-stretch: 1;
    if MenuEditor.kind == MenuKind.emoji: EmojiPage { width: 100%; height: 100%; }
    if MenuEditor.kind == MenuKind.quick: QuickActionsPage { width: 100%; height: 100%; }
}
