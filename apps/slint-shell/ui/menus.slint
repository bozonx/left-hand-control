import { InlineTextArea } from "controls.slint";
import { ScrollView } from "scroll.slint";
import { DragDrop, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { MenuKind, PickerTarget } from "types.slint";
import { InlineTextField, Badge, Card, CardHeader, ConfirmDialog, FieldLabel, IconButton, InfoTip, PageTabs } from "controls.slint";
import { Button, LineEdit, TextEdit } from "std-widgets.slint";

export struct MenuCell { key: string, value: string, name: string }
export struct EmojiCategory { id: string, items: [string] }
export global MenuEditor {
    in-out property <MenuKind> kind;
    in property <[string]> pages;
    in property <[MenuCell]> cells;
    in property <[EmojiCategory]> catalog;
    in-out property <int> selected-page;
    in-out property <int> selected-cell;
    in-out property <string> page-name;
    in-out property <string> value;
    in-out property <string> name;
    in-out property <int> editing-count: 0;
    in property <Message> status;
    callback open(MenuKind);
    callback refresh();
    callback select-page(int);
    callback select-cell(int);
    callback add-page(string);
    callback remove-page();
    callback show-page();
    callback move-page(int);
    /// Read `page-name`, `value` and `name` into the selected page and cell.
    callback rename-page();
    callback set-cell();
    callback set-name();
    callback set-action(int, string, string);
    callback clear-cell();
    callback move-cell(int, int);
}

/// 5×3 grid of the left-hand hotkeys; click selects, drag moves a cell.
component HotkeyGrid inherits Rectangle {
    in property <bool> emoji;
    in property <length> cell-height: 96px;
    callback activate(int);
    private property <length> pad: 12px;
    private property <length> gap: 8px;
    private property <length> cell-width: (self.width - 2 * self.pad - 4 * self.gap) / 5;
    private property <int> drag-from: -1;
    private property <int> drag-over: -1;
    private property <bool> dragging;
    private property <length> press-x;
    private property <length> press-y;
    private property <length> pointer-x;
    private property <length> pointer-y;
    min-width: 5 * 64px + 2 * self.pad + 4 * self.gap;
    height: 2 * self.pad + 3 * self.cell-height + 2 * self.gap;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    pure function index-at(x: length, y: length) -> int {
        return max(0, min(2, floor((y - self.pad) / (self.cell-height + self.gap)))) * 5
            + max(0, min(4, floor((x - self.pad) / (self.cell-width + self.gap))));
    }
    pure function preview(index: int) -> int {
        if !self.dragging { return index; }
        if index == self.drag-from { return self.drag-over; }
        if self.drag-from < self.drag-over && index > self.drag-from && index <= self.drag-over { return index - 1; }
        if self.drag-from > self.drag-over && index >= self.drag-over && index < self.drag-from { return index + 1; }
        return index;
    }
    if root.dragging: Rectangle {
        x: root.pad + mod(root.drag-over, 5) * (root.cell-width + root.gap);
        y: root.pad + floor(root.drag-over / 5) * (root.cell-height + root.gap);
        width: root.cell-width; height: root.cell-height;
        border-width: 2px; border-color: Theme.link; border-radius: 6px; background: Theme.hover;
    }
    for cell[index] in MenuEditor.cells: Rectangle {
        x: root.pad + mod(root.preview(index), 5) * (root.cell-width + root.gap);
        y: root.pad + floor(root.preview(index) / 5) * (root.cell-height + root.gap);
        width: root.cell-width;
        height: root.cell-height;
        border-radius: 6px;
        border-width: index == MenuEditor.selected-cell || (root.dragging && root.preview(index) == root.drag-over) ? 2px : 1px;
        border-color: index == MenuEditor.selected-cell || (root.dragging && root.preview(index) == root.drag-over) ? Theme.link : Theme.border;
        background: root.dragging && root.preview(index) == root.drag-over ? Theme.hover : Theme.card;
        opacity: root.dragging && index == root.drag-from ? 0.0 : 1.0;
        accessible-role: button;
        accessible-label: cell.key + " " + (root.emoji ? cell.value : cell.name);
        accessible-action-default => { root.activate(index); }
        VerticalLayout {
            padding: 8px;
            spacing: 4px;
            HorizontalLayout {
                Text { horizontal-stretch: 1; text: MenuEditor.cells[root.preview(index)].key; color: Theme.link; font-family: "monospace"; font-size: 12px; font-weight: 600; }
                Image { width: 14px; height: 14px; source: @image-url("icons/grip.svg"); colorize: Theme.muted; accessible-label: @tr("Drag"); }
            }
            if root.emoji: Text {
                font-family: "Noto Color Emoji";
                vertical-stretch: 1;
                text: cell.value == "" ? "＋" : cell.value;
                color: cell.value == "" ? Theme.muted : Theme.text;
                font-size: cell.value.character-count <= 2 ? 26px : cell.value.character-count <= 6 ? 16px : 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
            if !root.emoji: HorizontalLayout {
                spacing: 6px;
                if cell.value != "": Image { width: 16px; source: @image-url("icons/zap.svg"); colorize: Theme.muted; }
                Text {
                    horizontal-stretch: 1;
                    text: cell.value == "" ? @tr("Empty") : cell.name;
                    color: cell.value == "" ? Theme.muted : Theme.text;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if !root.emoji: Text { text: cell.value == "" ? "—" : cell.value; color: Theme.muted; font-family: "monospace"; font-size: 11px; overflow: elide; }
            if !root.emoji: Rectangle { vertical-stretch: 1; }
        }
    }
    if root.dragging: Rectangle {
        x: max(0px, min(root.width - self.width, root.pad + mod(root.drag-from, 5) * (root.cell-width + root.gap) + root.pointer-x - root.press-x));
        y: max(0px, min(root.height - self.height, root.pad + floor(root.drag-from / 5) * (root.cell-height + root.gap) + root.pointer-y - root.press-y));
        width: root.cell-width; height: root.cell-height;
        border-radius: 6px; border-width: 2px; border-color: Theme.link; background: Theme.card; opacity: 0.92;
        VerticalLayout { padding: 8px; spacing: 4px;
            Text { text: MenuEditor.cells[root.drag-from].key; color: Theme.link; }
            Text { font-family: root.emoji ? "Noto Color Emoji" : ""; text: root.emoji ? MenuEditor.cells[root.drag-from].value : MenuEditor.cells[root.drag-from].name; color: Theme.text; font-size: root.emoji ? 26px : 14px; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; vertical-stretch: 1; }
            if !root.emoji: Text { text: MenuEditor.cells[root.drag-from].value; color: Theme.muted; overflow: elide; }
        }
    }
    TouchArea {
        mouse-cursor: root.dragging ? grabbing : pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.drag-from = root.index-at(self.mouse-x, self.mouse-y);
                root.drag-over = root.drag-from;
                root.press-x = self.mouse-x;
                root.press-y = self.mouse-y;
                root.pointer-x = self.mouse-x; root.pointer-y = self.mouse-y;
                root.dragging = false;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-from >= 0 {
                if !root.dragging {
                    root.activate(root.drag-from);
                } else if root.drag-over != root.drag-from {
                    MenuEditor.move-cell(root.drag-from, root.drag-over);
                }
                root.dragging = false;
                root.drag-from = -1;
                root.drag-over = -1;
            }
            if event.kind == PointerEventKind.cancel { root.dragging = false; root.drag-from = -1; root.drag-over = -1; }
        }
        moved => {
            if self.pressed && root.drag-from >= 0 {
                root.pointer-x = self.mouse-x; root.pointer-y = self.mouse-y;
                if abs(self.mouse-x - root.press-x) > 6px || abs(self.mouse-y - root.press-y) > 6px {
                    root.dragging = true;
                }
                if root.dragging {
                    root.drag-over = root.index-at(self.mouse-x, self.mouse-y);
                }
            }
        }
    }
}

/// Side card header shared by the emoji and quick action pages.
component PageEditor inherits HorizontalLayout {
    callback remove();
    spacing: 4px;
    FieldLabel { text: @tr("Page:"); horizontal-stretch: 0; max-width: self.preferred-width; vertical-alignment: center; }
    page-name := InlineTextField { clearable: false; text: MenuEditor.page-name; label: @tr("Page name"); allow-empty: false; saved(value) => { MenuEditor.page-name = value; MenuEditor.rename-page(); } }
    Rectangle { min-width: 0px; preferred-width: 0px; horizontal-stretch: page-name.editing ? 0 : 1; }
    VerticalLayout { horizontal-stretch: 0; alignment: center; IconButton { icon: @image-url("icons/app-window.svg"); label: @tr("Open page in popup"); clicked => { MenuEditor.show-page(); } } }
    VerticalLayout { horizontal-stretch: 0; alignment: center; IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Delete page"); clicked => { root.remove(); } } }
}

component EmojiButton inherits Rectangle {
    in property <string> item;
    height: 40px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 40px;
    border-radius: 6px;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.text : touch.has-hover ? Theme.link : Theme.border;
    background: touch.has-hover ? Theme.hover : Theme.surface;
    accessible-role: button;
    accessible-label: root.item;
    accessible-action-default => { self.pick(); }
    function pick() { MenuEditor.value = root.item; MenuEditor.set-cell(); }
    Text { text: root.item; font-family: "Noto Color Emoji"; font-size: 20px; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.pick(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
}

export component EmojiPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> confirming;
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 0px;
        padding-left: 8px;
        padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
        spacing: 16px;
        CardHeader {
            title: @tr("Emoji & Symbols");
            info: @tr("Opened by the app:showEmojiMenu1...5 actions. Each cell can hold an emoji, a UTF symbol (e.g. ≠), any other character (e.g. №), or a short phrase (e.g. \"// TODO: \").");
        }
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 16px;
                alignment: start;
                    PageTabs { labels: MenuEditor.pages; selected: MenuEditor.selected-page; select(index) => { MenuEditor.select-page(index); } add => { MenuEditor.add-page(@tr("Page {}", MenuEditor.pages.length + 1)); } }
                HotkeyGrid { emoji: true; activate(index) => { MenuEditor.select-cell(index); } }
            }
            Card {
                width: 360px;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 12px;
                    PageEditor { remove => { root.confirming = true; } }
                    Rectangle { height: 1px; background: Theme.border; }
                    FieldLabel { text: @tr("Button {}", MenuEditor.cells[MenuEditor.selected-cell].key); }
                    HorizontalLayout {
                        spacing: 4px;
                        LineEdit {
                            text <=> MenuEditor.value;
                            placeholder-text: @tr("Emoji, symbol, or any text");
                            edited => { MenuEditor.set-cell(); }
                        }
                        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/eraser.svg"); label: @tr("Clear cell"); clicked => { MenuEditor.clear-cell(); } } }
                    }
                    if MenuEditor.status.id != "": Text { text: Locale.text(MenuEditor.status); color: Theme.error; wrap: word-wrap; }
                    ScrollView {
                        min-height: 0px;
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            padding-right: 10px;
                            spacing: 6px;
                            for category in MenuEditor.catalog: VerticalLayout {
                                spacing: 6px;
                                padding-bottom: 8px;
                                Text {
                                    text: category.id == "smileys" ? @tr("Smileys & Emotion")
                                        : category.id == "people" ? @tr("People & Gestures")
                                        : category.id == "symbols" ? @tr("Emoji Symbols")
                                        : category.id == "work" ? @tr("Work & Objects")
                                        : category.id == "nature" ? @tr("Animals & Nature")
                                        : category.id == "food" ? @tr("Food & Drink")
                                        : category.id == "travel" ? @tr("Travel & Places")
                                        : @tr("UTF Symbols");
                                    color: Theme.muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                                for row in ceil(category.items.length / 6): HorizontalLayout {
                                    spacing: 6px;
                                    for col in 6: EmojiButton {
                                        item: category.items[row * 6 + col];
                                        visible: row * 6 + col < category.items.length;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.confirming: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete page?");
        body: @tr("The page and all assigned cells on it will be deleted.");
        confirm-text: @tr("Delete");
        cancel => { root.confirming = false; }
        confirm => { MenuEditor.remove-page(); root.confirming = false; }
    }
}

export component QuickActionsPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> confirming;
    private property <bool> filled: MenuEditor.selected-cell >= 0 && MenuEditor.cells[MenuEditor.selected-cell].value != "";
    VerticalLayout {
        padding: 0px;
        spacing: 16px;
        CardHeader {
            vertical-stretch: 0;
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            title: @tr("Quick Actions");
            info: @tr("Opened by the app:showQuickMenu1...5 actions.");
        }
        HorizontalLayout {
            padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
            PageTabs { labels: MenuEditor.pages; selected: MenuEditor.selected-page; select(index) => { MenuEditor.select-page(index); } add => { MenuEditor.add-page(@tr("Page {}", MenuEditor.pages.length + 1)); } }
        }
        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            VerticalLayout { padding: 0px;
                alignment: start;
                Rectangle {
                    VerticalLayout {
                        padding: 0px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 16px;
                                alignment: start;
                                HotkeyGrid {
                                    emoji: false;
                                    activate(index) => {
                                        if MenuEditor.cells[index].value == "" {
                                            ActionPicker.open(PickerTarget.quick-action, index, "", false);
                                        } else {
                                            MenuEditor.select-cell(index);
                                        }
                                    }
                                }
                            }
                            Card {
                                width: 360px;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 12px;
                                    alignment: start;
                                    PageEditor { remove => { root.confirming = true; } }
                                    Rectangle { height: 1px; background: Theme.border; }
                                    if MenuEditor.status.id != "": Text { text: Locale.text(MenuEditor.status); color: Theme.error; wrap: word-wrap; }
                                    if MenuEditor.selected-cell >= 0: FieldLabel { text: @tr("Button {}", MenuEditor.cells[MenuEditor.selected-cell].key); }
                                    if root.filled: VerticalLayout {
                                        spacing: 4px;
                                        FieldLabel { text: @tr("Label"); }
                                        LineEdit { text <=> MenuEditor.name; placeholder-text: @tr("e.g. Next Track"); edited => { MenuEditor.set-name(); } }
                                    }
                                    if root.filled: VerticalLayout {
                                        spacing: 4px;
                                        FieldLabel { text: @tr("Action"); }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            Rectangle {
                                                height: 34px;
                                                border-radius: 6px;
                                                border-width: 1px;
                                                border-color: action-focus.has-focus ? Theme.text : Theme.border;
                                                background: action-touch.has-hover ? Theme.hover : Theme.surface;
                                                accessible-role: button;
                                                accessible-label: @tr("Action");
                                                accessible-value: MenuEditor.value;
                                                accessible-action-default => { self.pick(); }
                                                function pick() { ActionPicker.open(PickerTarget.quick-action, MenuEditor.selected-cell, MenuEditor.value, false); }
                                                Text {
                                                    x: 10px;
                                                    width: parent.width - 20px;
                                                    text: MenuEditor.value;
                                                    color: Theme.text;
                                                    font-family: "monospace";
                                                    font-size: 12px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                action-focus := FocusScope {
                                                    key-pressed(event) => {
                                                        if event.text == " " || event.text == "\n" { parent.pick(); return accept; }
                                                        return reject;
                                                    }
                                                }
                                                action-touch := TouchArea { mouse-cursor: pointer; clicked => { parent.pick(); } }
                                            }
                                            VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/eraser.svg"); label: @tr("Clear cell"); clicked => { MenuEditor.clear-cell(); } } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.confirming: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete page?");
        body: @tr("The page and all assigned cells on it will be deleted.");
        confirm-text: @tr("Delete");
        cancel => { root.confirming = false; }
        confirm => { MenuEditor.remove-page(); root.confirming = false; }
    }
}

export component MenusPage inherits Rectangle {
    vertical-stretch: 1;
    if MenuEditor.kind == MenuKind.emoji: EmojiPage { width: 100%; height: 100%; }
    if MenuEditor.kind == MenuKind.quick: QuickActionsPage { width: 100%; height: 100%; }
}
