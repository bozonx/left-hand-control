// Messages produced by Rust are passed as ids plus arguments and translated
// here, so every user-visible string goes through @tr and follows language
// switches without Rust re-sending them. Keep ids in sync with src/i18n.rs.
export struct Message {
    id: string,
    arg: string,
    count: int,
}

export global Locale {
    in-out property <bool> english: false;

    public pure function text(m: Message) -> string {
        if m.id == "" { return ""; }
        if m.id == "mapper-running" { return m.arg == "" ? @tr("Mapper is running") : @tr("Mapper is running: {}", m.arg); }
        if m.id == "mapper-stopped" { return m.arg == "" ? @tr("Mapper is stopped") : @tr("Mapper is stopped: {}", m.arg); }
        if m.id == "mapper-starting" { return @tr("Mapper is starting…"); }
        if m.id == "config-loaded" { return @tr("Configuration loaded: {n} rule" | "Configuration loaded: {n} rules" % m.count); }
        if m.id == "config-saved" { return @tr("Configuration saved: {n} rule" | "Configuration saved: {n} rules" % m.count); }
        if m.id == "config-reloaded" { return @tr("Configuration reloaded from disk: {n} rule" | "Configuration reloaded from disk: {n} rules" % m.count); }
        if m.id == "config-unavailable" { return @tr("Configuration unavailable: {}", m.arg); }
        if m.id == "config-external-change" { return @tr("The configuration was changed by another application and has been reloaded; repeat the change"); }
        if m.id == "config-conditional" { return @tr("Key {} only has conditional or layer rules; edit it in the full editor", m.arg); }
        if m.id == "device-saved" { return @tr("Device saved: {}", m.arg); }
        if m.id == "load-config-first" { return @tr("Load a valid configuration before starting the mapper"); }
        if m.id == "select-input-device" { return @tr("Select a keyboard device in the settings"); }
        if m.id == "worker-unavailable" { return @tr("Spell popup process unavailable: {}", m.arg); }
        if m.id == "worker-restarting" { return @tr("Spell worker is restarting"); }
        if m.id == "worker-restart-limit" { return @tr("Spell worker: restart limit exceeded (3 per minute)"); }
        if m.id == "worker-not-started" { return @tr("Spell worker is not running"); }
        if m.id == "worker-error" { return @tr("Spell worker: {}", m.arg); }
        if m.id == "action-saved" { return @tr("Action saved"); }
        if m.id == "saved-mapper-not-updated" { return @tr("Saved, but the mapper was not updated: {}", m.arg); }
        if m.id == "text-empty" { return @tr("Enter non-empty text"); }
        if m.id == "delay-range" { return @tr("Delay: an integer from 1 to 10000 ms"); }
        if m.id == "system-action-required" { return @tr("Select a system action"); }
        if m.id == "shortcut-required" { return @tr("Capture a keyboard shortcut"); }
        if m.id == "unknown-kind" { return @tr("Unknown action type"); }
        // "error" and unknown ids: untranslated detail from the core.
        return m.arg;
    }
}
