// Messages produced by Rust are passed as ids plus arguments and translated
// here, so every user-visible string goes through @tr and follows language
// switches without Rust re-sending them. Keep ids in sync with src/i18n.rs.
export struct Message {
    id: string,
    arg: string,
    count: int,
}

export global Locale {
    in-out property <bool> english: false;

    public pure function text(m: Message) -> string {
        if m.id == "capability-available" { return @tr("Available"); }
        if m.id == "capability-unavailable" { return @tr("Unavailable"); }
        if m.id == "capability-unsupported" { return @tr("Not implemented"); }
        if m.id == "game-mode-auto-disabled" { return @tr("Auto: no detection sources enabled"); }
        if m.id == "game-mode-auto-unavailable" { return @tr("Auto: detection unavailable"); }
        if m.id == "game-mode-auto-inactive" { return @tr("Auto: game mode inactive"); }
        if m.id == "game-mode-daemon-active" { return @tr("Auto: GameMode daemon active"); }
        if m.id == "game-mode-process-active" { return @tr("Auto: matched {}", m.arg); }
        if m.id == "game-mode-fullscreen-active" { return @tr("Auto: fullscreen window active"); }
        if m.id == "game-mode-excluded" { return @tr("Auto: excluded by {}", m.arg); }
        if m.id == "game-mode-manual-on" { return @tr("Game mode manually on until restart"); }
        if m.id == "game-mode-manual-off" { return @tr("Game mode manually off until restart"); }
        if m.id == "picker-action" && m.arg == "showQuickMenu" { return @tr("Show Quick Action Menu page {}", m.count); }
        if m.id == "picker-action" && m.arg == "showEmojiMenu" { return @tr("Show Emoji & Symbols menu page {}", m.count); }
        if m.id == "picker-action" && m.arg == "switchDesktop" { return @tr("Switch to desktop {}", m.count); }
        if m.id == "picker-action" && m.arg == "switchLayout" { return @tr("Switch to layout {}", m.count); }
        if m.id == "picker-action" && m.arg == "taskEntry" { return @tr("Activate task manager entry {}", m.count); }
        if m.id == "picker-action" && m.arg == "walkThroughWindowsAlternative" { return @tr("Walk Through Windows Alternative"); }
        if m.id == "picker-action" && m.arg == "walkThroughWindowsCurrentApp" { return @tr("Walk through windows of current application"); }
        if m.id == "picker-action" && m.arg == "showClipboardHistory" { return @tr("Show clipboard history"); }
        if m.id == "picker-action" && m.arg == "volumeDown" { return @tr("Decrease volume"); }
        if m.id == "picker-action" && m.arg == "volumeUp" { return @tr("Increase volume"); }
        if m.id == "picker-action" && m.arg == "muteAudio" { return @tr("Toggle mute"); }
        if m.id == "picker-action" && m.arg == "brightnessDown" { return @tr("Decrease screen brightness"); }
        if m.id == "picker-action" && m.arg == "brightnessUp" { return @tr("Increase screen brightness"); }
        if m.id == "picker-action" && m.arg == "windowClose" { return @tr("Close active window"); }
        if m.id == "picker-action" && m.arg == "windowToNextDesktop" { return @tr("Move window to next desktop"); }
        if m.id == "picker-action" && m.arg == "windowToPreviousDesktop" { return @tr("Move window to previous desktop"); }
        if m.id == "picker-action" && m.arg == "windowKeepAbove" { return @tr("Keep window above others"); }
        if m.id == "picker-action" && m.arg == "windowMaximizeVertical" { return @tr("Maximize window vertically"); }
        if m.id == "picker-action" && m.arg == "windowMaximizeHorizontal" { return @tr("Maximize window horizontally"); }
        if m.id == "picker-action" && m.arg == "screenOff" { return @tr("Turn off screen"); }
        if m.id == "picker-action" && m.arg == "launchKrunner" { return @tr("Launch KRunner"); }
        if m.id == "picker-action" && m.arg == "launchSystemMonitor" { return @tr("Launch System Monitor"); }
        if m.id == "picker-action" && m.arg == "manageActivities" { return @tr("Manage activities"); }
        if m.id == "picker-action" && m.arg == "nextActivity" { return @tr("Next activity"); }
        if m.id == "picker-action" && m.arg == "previousActivity" { return @tr("Previous activity"); }
        if m.id == "picker-action" && m.arg == "muteMicrophone" { return @tr("Mute microphone"); }
        if m.id == "picker-action" && m.arg == "showDisplayConfig" { return @tr("Show display configuration"); }
        if m.id == "picker-action" && m.arg == "toggleTouchpad" { return @tr("Toggle touchpad"); }
        if m.id == "picker-action" && m.arg == "lockSession" { return @tr("Lock session"); }
        if m.id == "picker-action" && m.arg == "logout" { return @tr("Log out"); }
        if m.id == "picker-action" && m.arg == "logoutWithoutConfirmation" { return @tr("Log out without confirmation"); }
        if m.id == "picker-action" && m.arg == "increaseKeyboardBrightness" { return @tr("Increase keyboard brightness"); }
        if m.id == "picker-action" && m.arg == "decreaseKeyboardBrightness" { return @tr("Decrease keyboard brightness"); }
        if m.id == "picker-action" && m.arg == "toggleKeyboardBacklight" { return @tr("Toggle keyboard backlight"); }
        if m.id == "picker-action" && m.arg == "activateApplicationLauncher" { return @tr("Activate application launcher"); }
        if m.id == "picker-action" && m.arg == "showDesktop" { return @tr("Show desktop"); }
        if m.id == "picker-action" && m.arg == "maximizeWindow" { return @tr("Maximize window"); }
        if m.id == "picker-action" && m.arg == "minimizeWindow" { return @tr("Minimize window"); }
        if m.id == "picker-action" && m.arg == "moveWindow" { return @tr("Move window"); }
        if m.id == "picker-action" && m.arg == "windowToNextScreen" { return @tr("Move window to next screen"); }
        if m.id == "picker-action" && m.arg == "windowToPreviousScreen" { return @tr("Move window to previous screen"); }
        if m.id == "picker-action" && m.arg == "quickTileWindowTop" { return @tr("Quick tile window to top"); }
        if m.id == "picker-action" && m.arg == "quickTileWindowBottom" { return @tr("Quick tile window to bottom"); }
        if m.id == "picker-action" && m.arg == "quickTileWindowLeft" { return @tr("Quick tile window to left"); }
        if m.id == "picker-action" && m.arg == "quickTileWindowRight" { return @tr("Quick tile window to right"); }
        if m.id == "picker-action" && m.arg == "toggleNightColor" { return @tr("Toggle night color"); }
        if m.id == "picker-action" && m.arg == "toggleGridView" { return @tr("Toggle grid view"); }
        if m.id == "picker-action" && m.arg == "toggleOverview" { return @tr("Toggle overview"); }
        if m.id == "picker-action" && m.arg == "togglePresentWindowsAllDesktops" { return @tr("Toggle present windows (all desktops)"); }
        if m.id == "picker-action" && m.arg == "togglePresentWindowsCurrentDesktop" { return @tr("Toggle present windows (current desktop)"); }
        if m.id == "picker-action" && m.arg == "windowMenu" { return @tr("Window operations menu"); }
        if m.id == "picker-action" && m.arg == "zoomIn" { return @tr("Zoom in"); }
        if m.id == "picker-action" && m.arg == "zoomOut" { return @tr("Zoom out"); }
        if m.id == "picker-action" && m.arg == "zoomActualSize" { return @tr("Zoom to actual size"); }
        if m.id == "picker-action" && m.arg == "killWindow" { return @tr("Force close window"); }
        if m.id == "picker-action" && m.arg == "windowFullscreen" { return @tr("Make window fullscreen"); }
        if m.id == "picker-action" && m.arg == "windowOnAllDesktops" { return @tr("Keep window on all desktops"); }
        if m.id == "library-saved" { return @tr("Layout library updated"); }
        if m.id == "library-select" { return @tr("Select a layout"); }
        if m.id == "library-changed" { return @tr("Layout changed on disk; select it again"); }
        if m.id == "" { return ""; }
        if m.id == "mapper-running" { return m.arg == "" ? @tr("Mapper is running") : @tr("Mapper is running: {}", m.arg); }
        if m.id == "mapper-stopped" { return m.arg == "" ? @tr("Mapper is stopped") : @tr("Mapper is stopped: {}", m.arg); }
        if m.id == "mapper-starting" { return @tr("Mapper is starting…"); }
        if m.id == "config-loaded" { return @tr("Configuration loaded: {n} rule" | "Configuration loaded: {n} rules" % m.count); }
        if m.id == "config-saved" { return @tr("Configuration saved: {n} rule" | "Configuration saved: {n} rules" % m.count); }
        if m.id == "config-reloaded" { return @tr("Configuration reloaded from disk: {n} rule" | "Configuration reloaded from disk: {n} rules" % m.count); }
        if m.id == "config-unavailable" { return @tr("Configuration unavailable: {}", m.arg); }
        if m.id == "config-external-change" { return @tr("The configuration was changed by another application and has been reloaded; repeat the change"); }
        if m.id == "config-conditional" { return @tr("Key {} only has conditional or layer rules; edit it in the full editor", m.arg); }
        if m.id == "device-saved" { return @tr("Device saved: {}", m.arg); }
        if m.id == "load-config-first" { return @tr("Load a valid configuration before starting the mapper"); }
        if m.id == "select-input-device" { return @tr("Select a keyboard device in the settings"); }
        if m.id == "worker-unavailable" { return @tr("Spell popup process unavailable: {}", m.arg); }
        if m.id == "worker-restarting" { return @tr("Spell worker is restarting"); }
        if m.id == "worker-restart-limit" { return @tr("Spell worker: restart limit exceeded (3 per minute)"); }
        if m.id == "worker-not-started" { return @tr("Spell worker is not running"); }
        if m.id == "worker-error" { return @tr("Spell worker: {}", m.arg); }
        if m.id == "action-saved" { return @tr("Action saved"); }
        if m.id == "settings-saved" { return @tr("Settings saved"); }
        if m.id == "process-name-required" { return @tr("Enter a process name"); }
        if m.id == "macro-invalid-id" { return @tr("Macro ID must contain 1–64 letters, digits, underscores or hyphens"); }
        if m.id == "macro-duplicate-id" { return @tr("Macro ID is already in use"); }
        if m.id == "macro-delay-range" { return @tr("Macro delays must be between 0 and 2000 ms"); }
        if m.id == "macro-pause-range" { return @tr("Pause must be between 0 and 10000 ms"); }
        if m.id == "macro-unknown-key" { return @tr("Unknown key or shortcut in macro step"); }
        if m.id == "macro-cycle" { return @tr("Macro references cannot form a cycle"); }
        if m.id == "menu-emoji-cell" { return @tr("Emoji cells accept at most 100 characters."); }
        if m.id == "menu-command-id" { return @tr("Command ID: 1–64 letters, digits, underscores or hyphens."); }
        if m.id == "menu-duplicate-command" { return @tr("Command IDs must be unique."); }
        if m.id == "menu-empty-command" { return @tr("Enter a shell command."); }
        if m.id == "menu-draft" { return @tr("Unsaved draft. Fix command errors to save; the draft is kept while switching tabs."); }
        if m.id == "command-completed" { return @tr("Command completed: {}", m.arg); }
        if m.id == "action-unavailable" { return @tr("Unavailable on this platform or desktop"); }
        if m.id == "command-timeout-invalid" { return @tr("Enter a command execution time between 1 and 2147483647 seconds"); }
        if m.id == "command-approval-required" { return @tr("Unblock commands on the Commands tab before running this action"); }
        if m.id == "menu-save-first" { return @tr("Fix command errors before allowing them."); }
        if m.id == "layer-saved" { return @tr("Layer saved"); }
        if m.id == "rule-saved" { return @tr("Rule saved"); }
        if m.id == "layout-empty" { return @tr("The layout file is empty"); }
        if m.id == "copy-name" { return @tr("{} (copy)", m.arg); }
        if m.id == "mapper-required" { return @tr("Start the mapper to run actions from the menus"); }
        if m.id == "layer-name-required" { return @tr("Enter a layer name"); }
        if m.id == "action-required" { return @tr("Choose a valid action."); }
        if m.id == "picker-suppress" { return @tr("Suppress"); }
        if m.id == "picker-inherit" { return @tr("Inherit"); }
        if m.id == "picker-native" { return @tr("Normal key behavior"); }
        if m.id == "picker-empty-cell" { return @tr("Empty cell"); }
        if m.id == "picker-no-action" { return @tr("No separate action"); }
        if m.id == "picker-layer-only" { return @tr("Activate layer only"); }
        if m.id == "key-code-required" { return @tr("Enter a key code"); }
        if m.id == "timeout-invalid" { return @tr("Enter a non-negative integer for each timeout"); }
        if m.id == "saved-mapper-not-updated" { return @tr("Saved, but the mapper was not updated: {}", m.arg); }
        if m.id == "text-empty" { return @tr("Enter non-empty text"); }
        if m.id == "delay-range" { return @tr("Delay: an integer from 1 to 10000 ms"); }
        if m.id == "system-action-required" { return @tr("Select a system action"); }
        if m.id == "unknown-kind" { return @tr("Unknown action type"); }
        // "error" and unknown ids: untranslated detail from the core.
        return m.arg;
    }
}
