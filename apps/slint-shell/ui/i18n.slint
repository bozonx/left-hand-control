// Messages produced by Rust are passed as ids plus arguments and translated
// here, so every user-visible string goes through @tr and follows language
// switches without Rust re-sending them. Keep ids in sync with src/i18n.rs.
export struct Message {
    id: string,
    arg: string,
    count: int,
}

export global Locale {
    in-out property <bool> english: false;

    public pure function text(m: Message) -> string {
        if m.id == "command-help-linux" { return @tr("Commands run with sh -lc in the background. The mapper does not wait for completion or collect output. An empty name uses the command itself as its label. The working directory defaults to your home folder; scripts need execute permission. Command execution must be enabled in settings."); }
        if m.id == "command-help-windows" { return @tr("Commands run with PowerShell in the background, without a console window. The mapper does not wait for completion or collect output. An empty name uses the command itself as its label. The working directory defaults to your home folder. Command execution must be enabled in settings."); }
        if m.id == "command-help-macos" { return @tr("The name is optional: an empty name uses the command itself as its label. Command execution by the mapper is not implemented on macOS."); }

        if m.id == "layout-discarded" { return @tr("Changes to layout “{}” discarded", m.arg); }
        if m.id == "copied" { return @tr("Copied to clipboard"); }
        if m.id == "layout-created" { return @tr("Layout “{}” created", m.arg); }
        if m.id == "layout-saved" { return @tr("Layout “{}” saved", m.arg); }
        if m.id == "auto-rule-deleted" { return @tr("Automatic switching rule deleted"); }
        if m.id == "layout-deleted" { return @tr("Layout “{}” deleted", m.arg); }
        if m.id == "layout-activated" { return @tr("Layout “{}” activated", m.arg); }
        if m.id == "capability-available" { return @tr("Available"); }
        if m.id == "capability-unavailable" { return @tr("Unavailable"); }
        if m.id == "capability-unsupported" { return @tr("Not implemented"); }
        if m.id == "input-discovery-failed" { return @tr("Cannot list input devices. Check device access and see the application log."); }
        if m.id == "mapper-unsupported" { return @tr("Keyboard interception is not implemented on this operating system."); }
        if m.id == "input-access-no-devices" { return @tr("No input devices were found in /dev/input."); }
        if m.id == "input-access-keyboard-missing" { return @tr("The selected keyboard is not connected. Connect it or pick another one below."); }
        if m.id == "input-access-input-denied" { return @tr("No permission to read keyboard events. Add your user to the input group (install-linux.sh permissions does this) and log in again."); }
        if m.id == "input-access-uinput-missing" { return @tr("/dev/uinput does not exist. Load the uinput kernel module: sudo modprobe uinput."); }
        if m.id == "input-access-uinput-denied" { return @tr("No permission to write to /dev/uinput. Install the application's udev rule (install-linux.sh permissions) or reinstall the package."); }
        if m.id == "game-mode-auto-disabled" { return @tr("Auto: no detection sources enabled"); }
        if m.id == "game-mode-auto-unavailable" { return @tr("Auto: detection unavailable"); }
        if m.id == "game-mode-auto-inactive" { return @tr("Auto: game mode inactive"); }
        if m.id == "game-mode-daemon-active" { return @tr("Auto: GameMode daemon active"); }
        if m.id == "game-mode-known-game-active" { return @tr("Auto: known game {}", m.arg); }
        if m.id == "game-mode-process-active" { return @tr("Auto: matched {}", m.arg); }
        if m.id == "game-mode-fullscreen-active" { return @tr("Auto: fullscreen window active"); }
        if m.id == "game-mode-excluded" { return @tr("Auto: excluded by {}", m.arg); }
        if m.id == "game-mode-window-skipped" { return @tr("Auto: {} is not counted as a game (built-in list)", m.arg); }
        if m.id == "game-mode-manual-on" { return @tr("Game mode is on (set manually)"); }
        if m.id == "game-mode-manual-off" { return @tr("Game mode is off (set manually)"); }
        if m.id == "builtin-macro" && m.arg == "moveLineDown" { return @tr("Move line down"); }
        if m.id == "builtin-macro" && m.arg == "downEnd" { return @tr("Down + End"); }
        if m.id == "builtin-macro" && m.arg == "upEnd" { return @tr("Up + End"); }
        if m.id == "builtin-macro" && m.arg == "up5Times" { return @tr("Up 5 times"); }
        if m.id == "builtin-macro" && m.arg == "duplicateLine" { return @tr("Duplicate line"); }
        if m.id == "builtin-macro" && m.arg == "rightSpace" { return @tr("Right + Space"); }
        if m.id == "builtin-macro" && m.arg == "emptyLineBelow" { return @tr("Empty line below"); }
        if m.id == "builtin-macro" && m.arg == "cutWordRightCenter" { return @tr("Cut word right from center"); }
        if m.id == "builtin-macro" && m.arg == "copyWordAfterCenter" { return @tr("Copy word right from center"); }
        if m.id == "builtin-macro" && m.arg == "pasteAtLineAbove" { return @tr("Paste at line above"); }
        if m.id == "builtin-macro" && m.arg == "replaceWordWidthBuffer" { return @tr("Replace word with buffer"); }
        if m.id == "builtin-macro" && m.arg == "downHome" { return @tr("Down + Home"); }
        if m.id == "builtin-macro" && m.arg == "upHome" { return @tr("Up + Home"); }
        if m.id == "builtin-macro" && m.arg == "down5Times" { return @tr("Down 5 times"); }
        if m.id == "builtin-macro" && m.arg == "pasteAtLineBottom" { return @tr("Paste at line bottom"); }
        if m.id == "builtin-macro" && m.arg == "cutToStart" { return @tr("Cut to start"); }
        if m.id == "builtin-macro" && m.arg == "cutToEnd" { return @tr("Cut to end"); }
        if m.id == "builtin-macro" && m.arg == "cutLineContent" { return @tr("Cut line content"); }
        if m.id == "builtin-macro" && m.arg == "cutAndRemoveLine" { return @tr("Cut and remove line"); }
        if m.id == "builtin-macro" && m.arg == "select5LinesUp" { return @tr("Select 5 lines up"); }
        if m.id == "builtin-macro" && m.arg == "copyToStart" { return @tr("Copy to start"); }
        if m.id == "builtin-macro" && m.arg == "copyToEnd" { return @tr("Copy to end"); }
        if m.id == "builtin-macro" && m.arg == "copyLine" { return @tr("Copy line"); }
        if m.id == "builtin-macro" && m.arg == "selectWholeLine" { return @tr("Select whole line"); }
        if m.id == "builtin-macro" && m.arg == "selectWordRightCenter" { return @tr("Select word right from center"); }
        if m.id == "builtin-macro" && m.arg == "replaceToStartWithBuffer" { return @tr("Replace to start with buffer"); }
        if m.id == "builtin-macro" && m.arg == "replaceToEndWithBuffer" { return @tr("Replace to end with buffer"); }
        if m.id == "builtin-macro" && m.arg == "replaceLineWidthBuffer" { return @tr("Replace line with buffer"); }
        if m.id == "builtin-macro" && m.arg == "select5LinesDown" { return @tr("Select 5 lines down"); }
        if m.id == "picker-action" && m.arg == "showQuickMenu" { return @tr("Show Quick Action Menu page {}", m.count); }
        if m.id == "picker-action" && m.arg == "showEmojiMenu" { return @tr("Show Emoji & Symbols menu page {}", m.count); }
        if m.id == "picker-action" && m.arg == "showQuickMenuLast" { return @tr("Show Quick Action Menu on the last used page"); }
        if m.id == "picker-action" && m.arg == "showEmojiMenuLast" { return @tr("Show Emoji & Symbols menu on the last used page"); }
        if m.id == "picker-action" && m.arg == "showSettings" { return @tr("Show the settings window"); }
        if m.id == "picker-action" && m.arg == "activateLayout" { return @tr("Activate layout {} (switches to Single mode)", m.count); }
        if m.id == "picker-action" && m.arg == "gameModeToggle" { return @tr("Toggle game mode"); }
        if m.id == "picker-action" && m.arg == "gameModeAuto" { return @tr("Game mode: detect automatically"); }
        if m.id == "picker-action" && m.arg == "gameModeOn" { return @tr("Game mode: always on"); }
        if m.id == "picker-action" && m.arg == "gameModeOff" { return @tr("Game mode: always off"); }
        if m.id == "picker-action" && m.arg == "windowClose" { return @tr("Close window"); }
        if m.id == "picker-action" && m.arg == "windowMinimize" { return @tr("Minimize window"); }
        if m.id == "picker-action" && m.arg == "windowMaximize" { return @tr("Maximize window"); }
        if m.id == "picker-action" && m.arg == "windowKeepAbove" { return @tr("Keep window above others"); }
        if m.id == "picker-action" && m.arg == "showDesktop" { return @tr("Show desktop"); }
        if m.id == "picker-action" && m.arg == "overview" { return @tr("Window overview"); }
        if m.id == "picker-action" && m.arg == "appLauncher" { return @tr("Open application launcher"); }
        if m.id == "picker-action" && m.arg == "screenOff" { return @tr("Turn off screen"); }
        if m.id == "picker-action" && m.arg == "switchDesktop" { return @tr("Switch to desktop {}", m.count); }
        if m.id == "picker-action" && m.arg == "switchLayout" { return @tr("Switch to layout {}", m.count); }
        if m.id == "picker-action" && m.arg == "windowToDesktop" { return @tr("Move window to desktop {}", m.count); }
        if m.id == "layout-slot-empty" { return @tr("There is no layout number {}", m.count); }
        if m.id == "library-saved" { return @tr("Layout library updated"); }
        if m.id == "library-select" { return @tr("Select a layout"); }
        if m.id == "library-changed" { return @tr("Layout changed on disk; select it again"); }
        if m.id == "" { return ""; }
        if m.id == "mapper-waiting" { return @tr("Waiting for keyboard"); }
        if m.id == "mapper-running" { return @tr("Mapper is running"); }
        if m.id == "mapper-stopped" { return @tr("Mapper is stopped"); }
        if m.id == "mapper-starting" { return @tr("Mapper is starting…"); }
        if m.id == "config-loaded" { return @tr("Configuration loaded: {n} rule" | "Configuration loaded: {n} rules" % m.count); }
        if m.id == "config-saved" { return @tr("Configuration saved: {n} rule" | "Configuration saved: {n} rules" % m.count); }
        if m.id == "config-unavailable" { return @tr("Configuration is unavailable. Check the configuration files and see the application log."); }
        if m.id == "config-edit-conflict" { return @tr("The configuration changed since editing started; repeat the change"); }
        if m.id == "config-conditional" { return @tr("Key {} only has conditional or layer rules; edit it in the full editor", m.arg); }
        if m.id == "device-saved" { return @tr("Device saved: {}", m.arg); }
        if m.id == "load-config-first" { return @tr("Load a valid configuration before starting the mapper"); }
        if m.id == "select-input-device" { return @tr("Select a keyboard device in the settings"); }
        if m.id == "worker-unavailable" { return @tr("Popup menus are unavailable. Try opening the menu again."); }
        if m.id == "worker-restarting" { return @tr("Popup menus are restarting. Try again shortly."); }
        if m.id == "worker-restart-limit" { return @tr("Popup menus could not recover. Restart the application."); }
        if m.id == "worker-not-started" { return @tr("Popup menus are not running. Try opening the menu again."); }
        if m.id == "worker-error" { return @tr("Popup menu failed. Try opening the menu again."); }
        if m.id == "action-saved" { return @tr("Action saved"); }
        if m.id == "settings-saved" { return @tr("Settings saved"); }
        if m.id == "macro-invalid-id" { return @tr("Macro ID must contain 1–64 letters, digits, underscores or hyphens"); }
        if m.id == "macro-duplicate-id" { return @tr("Macro ID is already in use"); }
        if m.id == "macro-delay-range" { return @tr("Macro delays must be between 0 and 2000 ms"); }
        if m.id == "macro-pause-range" { return @tr("Pause must be between 1 and 10000 ms"); }
        if m.id == "macro-unknown-key" { return @tr("Unknown key or shortcut in macro step"); }
        if m.id == "macro-cycle" { return @tr("Macro references cannot form a cycle"); }
        if m.id == "menu-emoji-cell" { return @tr("Emoji cells accept at most 100 characters."); }
        if m.id == "menu-command-id" { return @tr("Command ID: 1–64 letters, digits, underscores or hyphens."); }
        if m.id == "menu-duplicate-command" { return @tr("Command IDs must be unique."); }
        if m.id == "menu-empty-command" { return @tr("Enter a shell command."); }
        if m.id == "command-started" { return @tr("Command started: {}", m.arg); }
        if m.id == "command-directory-missing" { return @tr("The working directory does not exist."); }
        if m.id == "script-not-executable" { return @tr("The script file is not executable: run chmod +x on it or prefix the path with sh."); }
        if m.id == "choose-command-script" { return @tr("Choose a script"); }
        if m.id == "choose-command-directory" { return @tr("Choose a working directory"); }
        if m.id == "action-unavailable" { return @tr("Unavailable on this platform or desktop"); }
        if m.id == "action-unsupported-macos" { return @tr("This action is not supported on macOS"); }
        if m.id == "save-layout-first" { return @tr("Save layout changes before opening another layout."); }
        if m.id == "commands-disabled" { return @tr("Commands are disabled in Settings."); }
        if m.id == "layer-saved" { return @tr("Layer saved"); }
        if m.id == "config-invalid-layer-key" { return @tr("Unknown layer key at \"{}\".", m.arg); }
        if m.id == "config-invalid-layer-action" { return @tr("Invalid layer action at \"{}\".", m.arg); }
        if m.id == "config-invalid-macro-step" { return @tr("Invalid macro step at \"{}\".", m.arg); }
        if m.id == "config-macro-cycle" { return @tr("Macro call cycle at \"{}\".", m.arg); }
        if m.id == "config-invalid-macro" { return @tr("Invalid macro at \"{}\".", m.arg); }
        if m.id == "config-invalid-menu-action" { return @tr("Invalid menu action at \"{}\".", m.arg); }
        if m.id == "config-invalid-timing" { return @tr("Invalid timing at \"{}\".", m.arg); }
        if m.id == "config-invalid-condition" { return @tr("Invalid window condition at \"{}\".", m.arg); }
        if m.id == "config-invalid-hold" { return @tr("Unsupported rule combination at \"{}\".", m.arg); }
        if m.id == "rule-missing-trigger" { return @tr("Rule without a trigger is saved as a draft and will be ignored."); }
        if m.id == "rule-invalid-trigger" { return @tr("Trigger \"{}\" cannot be used for a rule.", m.arg); }
        if m.id == "rule-duplicate-trigger" { return @tr("Rules for trigger \"{}\" may overlap; the first matching rule wins.", m.arg); }
        if m.id == "rule-shadowed-trigger" { return @tr("Rule for trigger \"{}\" is covered by an earlier rule and will not run.", m.arg); }
        if m.id == "rule-unknown-layer" { return @tr("Rule \"{}\" points to a layer that no longer exists.", m.arg); }
        if m.id == "rule-invalid-tap" { return @tr("Rule \"{}\" has an invalid tap action.", m.arg); }
        if m.id == "rule-invalid-hold" { return @tr("Rule \"{}\" has an invalid hold action.", m.arg); }
        if m.id == "rule-invalid-double-tap" { return @tr("Rule \"{}\" has an invalid double-tap action.", m.arg); }
        if m.id == "rule-saved" { return @tr("Rule saved"); }
        if m.id == "layout-empty" { return @tr("The layout file is empty"); }
        if m.id == "copy-name" { return @tr("{} (copy)", m.arg); }
        if m.id == "text-missing-characters" { return @tr("The text was not typed: the keyboard layout lacks some of its characters, such as emoji. Choose a typing method with the clipboard."); }
        if m.id == "text-layout-unknown" { return @tr("The text was not typed: the active keyboard layout is unknown."); }
        if m.id == "text-backend-unavailable" { return @tr("The text was not typed: the typing method is unavailable. Restart the mapper to try again."); }
        if m.id == "text-clipboard-failed" { return @tr("The text was not typed: safe clipboard access failed. See the application log."); }
        if m.id == "text-tool-failed" { return @tr("The text was not typed: the input tool failed. See the application log."); }
        if m.id == "mapper-required" { return @tr("Start the mapper to run actions from the menus"); }
        if m.id == "layer-name-required" { return @tr("Enter a layer name"); }
        if m.id == "layer-name-taken" { return @tr("A layer with this name already exists."); }
        if m.id == "layout-name-required" { return @tr("Enter a layout name"); }
        if m.id == "layout-name-taken" { return @tr("A layout with this name already exists."); }
        if m.id == "name-invalid" { return @tr("The name contains characters that cannot be used in a file name."); }
        if m.id == "action-required" { return @tr("Choose a valid action."); }
        if m.id == "picker-suppress" { return @tr("Suppress"); }
        if m.id == "picker-inherit" { return @tr("Inherit"); }
        if m.id == "picker-native" { return @tr("Normal key behavior"); }
        if m.id == "picker-empty-cell" { return @tr("Empty cell"); }
        if m.id == "picker-no-action" { return @tr("No separate action"); }
        if m.id == "picker-layer-only" { return @tr("Activate layer only"); }
        if m.id == "key-code-required" { return @tr("Enter a key code"); }
        if m.id == "long-hold-invalid" { return @tr("Enter a long hold from 100 to 60000 ms."); }
        if m.id == "settings-timing-invalid" { return @tr("A timing value is outside the range shown in Settings."); }
        if m.id == "timeout-invalid" { return @tr("Enter a timeout from 50 to 1000 milliseconds"); }
        if m.id == "saved-mapper-not-updated" { return @tr("Changes applied, but the mapper was not updated. Restart the mapper."); }
        if m.id == "text-empty" { return @tr("Enter non-empty text"); }
        if m.id == "delay-range" { return @tr("Delay: an integer from 1 to 10000 ms"); }
        if m.id == "system-action-required" { return @tr("Select a system action"); }
        if m.id == "unknown-kind" { return @tr("Unknown action type"); }
        if m.id == "error" { return @tr("The operation failed. See the application log."); }
        if m.id == "action-failed" { return @tr("The action failed. See the application log."); }
        if m.id == "mapper-failed" { return @tr("Cannot start the mapper. Check the keyboard and device access. See the application log."); }
        if m.id == "mapper-running-error" { return @tr("Mapper is running, but an error occurred. See the application log."); }
        if m.id == "mapper-stopped-error" { return @tr("Mapper stopped because of an error. See the application log."); }
        if m.id == "config-io" { return @tr("Cannot read or save the configuration. Check file access and see the application log."); }
        if m.id == "config-parse" { return @tr("Cannot parse the configuration file. See the application log."); }
        if m.id == "config-invalid" { return @tr("The configuration contains invalid values. See the application log."); }
        if m.id == "action-invalid-syntax" { return @tr("The action has invalid syntax."); }
        if m.id == "action-pause-outside-macro" { return @tr("Pauses can only be used in macro steps."); }
        if m.id == "action-unknown-macro" { return @tr("The selected macro no longer exists."); }
        if m.id == "action-unknown-command" { return @tr("The selected command no longer exists."); }
        if m.id == "action-unknown-system" { return @tr("Unknown system action."); }
        if m.id == "action-unknown-app" { return @tr("Unknown application action."); }
        if m.id == "action-unknown-type" { return @tr("Unknown action type. It may come from a newer version of the application."); }
        // Message ids are checked against Rust at build time.
        return "";
    }
}
