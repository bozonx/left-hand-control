import { Theme } from "theme.slint";
import { InfoTip } from "controls-base.slint";

export component Card inherits Rectangle {
    in property <bool> highlighted: false;
    in property <length> radius: Theme.radius-panel;
    background: Theme.card;
    border-width: 1px;
    border-radius: root.radius;
    border-color: root.highlighted ? Theme.accent : Theme.divider;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.hover;
    height: Theme.badge-height;
    border-radius: Theme.radius-small;
    background: root.fill;
    HorizontalLayout {
        padding-left: Theme.space-s; padding-right: Theme.space-s;
        Text { min-width: 0px; overflow: elide; text: root.text; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
    }
}

export component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: Theme.font-body;
    font-weight: Theme.weight-semibold;
}

/// Heading hierarchy: section (page block), card, subsection inside a card.
export component SectionTitle inherits Text {
    vertical-stretch: 0;
    color: Theme.text;
    font-size: Theme.font-heading;
    font-weight: Theme.weight-semibold;
}

export component CardTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-subtitle;
    font-weight: Theme.weight-bold;
}

export component SubsectionTitle inherits Text {
    vertical-stretch: 0;
    color: Theme.text;
    font-size: Theme.font-default;
    font-weight: Theme.weight-semibold;
}

/// Group of settings under a large title.
export component Section inherits Rectangle {
    in property <string> title;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 0px;
    max-width: Theme.unbounded;
    height: section-content.preferred-height;
    background: transparent;
    section-content := VerticalLayout {
        padding: 0px;
        padding-top: Theme.space-xl;
        padding-bottom: Theme.space-xl;
        spacing: Theme.space-3xl;
        alignment: start;
        if root.title != "": SectionTitle { text: root.title; }
        @children
    }
}

/// A card of settings with an optional title.
export component TitledCard inherits VerticalLayout {
    in property <string> title;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    max-width: Theme.unbounded;
    Card {
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-l;
            if root.title != "": SubsectionTitle { text: root.title; }
            @children
        }
    }
}

export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> info;
    spacing: Theme.space-m;
    alignment: stretch;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.space-2xs;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            CardTitle { text: root.title; vertical-alignment: center; }
            if root.info != "": VerticalLayout { alignment: center; InfoTip { text: root.info; } }
        }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap; }
    }
    @children
}

/// Root layout of a settings page; the window provides the outer padding.
export component PageLayout inherits VerticalLayout {
    padding: 0px;
    spacing: Theme.page-gap;
    vertical-stretch: 1;
}

/// Page title row above a scrolling area: keeps actions clear of the scrollbar.
export component PageHeader inherits CardHeader {
    vertical-stretch: 0;
    padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
}

/// Placeholder text of an empty list.
export component EmptyState inherits Text {
    color: Theme.muted;
    wrap: word-wrap;
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}
