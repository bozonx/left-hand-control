import { KeyboardFocus } from "focus.slint";
import { Button } from "std-widgets.slint";
import { IconButton, ButtonGroup, DialogFrame, SearchField, TextField } from "controls.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";

/// `missing`: the saved device, not connected now. `suggested` passes the
/// keyboard or mouse heuristic; `other` and `virtual-device` show only
/// under "All devices".
export enum DeviceGroup { missing, suggested, other, virtual-device }
/// `detail` is the shortened path; `ambiguous` rows share their name with
/// another suggested row, so the path is shown there too.
export struct DeviceChoice { label: string, detail: string, path: string, group: DeviceGroup, ambiguous: bool }
/// Row a typed path opens, or -1; `exact` when it is the row's own path
/// rather than another link to the same device.
export struct DeviceMatch { index: int, exact: bool }

export global DeviceChoices {
    /// Rows matching the query: suggested ones, or every device when `all`.
    pure callback filter([DeviceChoice], string, bool) -> [DeviceChoice];
    /// Pixel offset of a row; Rust computes it from the heights below.
    pure callback offset([DeviceChoice], int) -> int;
    /// Row with this device path, or -1.
    pure callback position([DeviceChoice], string) -> int;
    /// Row for the device a typed path opens, following symlinks.
    pure callback find-device([DeviceChoice], string) -> DeviceMatch;
    out property <length> row-height: 44px;
    out property <length> heading-height: 28px;
}

/// Which device dialog is open, if any.
export global DeviceDialog {
    in-out property <bool> open;
    in-out property <bool> mouse;
}

/// Field showing the chosen device; clicking it opens the device dialog.
export component DevicePicker inherits Rectangle {
    in property <[DeviceChoice]> choices;
    in property <string> path;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    callback open();
    private property <int> position: root.path == "" ? -1 : DeviceChoices.position(root.choices, root.path);
    private property <bool> missing: root.position >= 0 && root.choices[root.position].group == DeviceGroup.missing;
    private property <string> selected-text: root.position >= 0 ? root.choices[root.position].label : root.placeholder;
    min-width: 0px;
    height: Theme.control-height-l;
    horizontal-stretch: 1;
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.focus : Theme.border;
    background: root.enabled && touch.has-hover ? Theme.hover : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.selected-text;
    accessible-description: root.missing ? @tr("Not connected") : "";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.open(); } }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: Theme.space-m-plus; padding-right: Theme.space-m-plus; spacing: Theme.space-m;
        Text {
            min-width: 0px; horizontal-stretch: 1; overflow: elide;
            text: root.selected-text;
            color: root.position >= 0 ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
        if root.missing: Text { text: @tr("Not connected"); color: Theme.warning; font-size: Theme.font-body; vertical-alignment: center; }
        VerticalLayout { alignment: center;
            Image { width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; }
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" || event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.open(); return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.open(); } }
}

/// Clickable text in the link colour.
component LinkText inherits Text {
    callback clicked();
    color: link-touch.has-hover ? Theme.accent : Theme.accent;
    vertical-alignment: center;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    link-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Modal device list with three tabs: the devices that look like a keyboard
/// (or mouse), every device, and a manual path.
export component DeviceDialogOverlay inherits DialogFrame {
    in property <[DeviceChoice]> choices;
    in property <string> current;
    in property <bool> mouse;
    /// Windows has no device paths to enter.
    in property <bool> manual-allowed: true;
    /// False while the mapper starts or stops.
    in property <bool> enabled: true;
    callback chosen(string);
    callback refresh();
    // 0: suggested, 1: all devices, 2: manual path. A device chosen from
    // "All devices" opens there again.
    private property <int> tab: root.current-group == DeviceGroup.other || root.current-group == DeviceGroup.virtual-device ? 1 : 0;
    private property <bool> all: root.tab == 1;
    private property <DeviceGroup> current-group: DeviceChoices.position(root.choices, root.current) >= 0 ? root.choices[DeviceChoices.position(root.choices, root.current)].group : DeviceGroup.missing;
    private property <string> query;
    private property <string> manual-path;
    private property <DeviceMatch> manual-match: root.tab == 2 ? DeviceChoices.find-device(root.choices, root.manual-path) : { index: -1, exact: false };
    private property <bool> manual-connected: root.manual-match.index >= 0 && root.choices[root.manual-match.index].group != DeviceGroup.missing;
    private property <bool> manual-changed: root.manual-path != "" && root.manual-path != root.current;
    // Search exists only on the "All devices" tab.
    private property <[DeviceChoice]> filtered: DeviceChoices.filter(root.choices, root.all ? root.query : "", root.all);
    private property <int> highlighted: max(0, DeviceChoices.position(root.filtered, root.current));
    private property <length> scroll-y;
    private property <length> content-height: DeviceChoices.offset(root.filtered, root.filtered.length) * 1px;
    title: root.mouse ? @tr("Choose a mouse") : @tr("Choose a keyboard");
    card-height: 540px;
    // Escape first clears the search, so the list handles it.
    close-on-escape: false;

    function choose(index: int) {
        if root.enabled && index >= 0 && index < root.filtered.length { root.chosen(root.filtered[index].path); }
    }
    function apply-manual() {
        if root.enabled && root.manual-changed { root.chosen(root.manual-path); }
    }
    function scroll-to-highlight() {
        let top = DeviceChoices.offset(root.filtered, root.highlighted) * 1px;
        let bottom = DeviceChoices.offset(root.filtered, root.highlighted + 1) * 1px;
        let visible-height = list.visible-height;
        if top < -root.scroll-y { root.scroll-y = -top; }
        if bottom > -root.scroll-y + visible-height { root.scroll-y = -(bottom - visible-height); }
    }
    function show-tab(tab: int) {
        if tab == 2 { root.manual-path = root.current; }
        root.tab = tab;
        root.highlighted = max(0, DeviceChoices.position(root.filtered, root.current));
        root.scroll-y = 0px;
        root.scroll-to-highlight();

    }
    changed query => { root.highlighted = 0; root.scroll-y = 0px; }

    keys := FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if root.tab == 2 {
                if event.text == Key.Escape { root.close(); return accept; }
                return reject;
            }
            if event.text == Key.Escape && root.all && root.query != "" { root.query = ""; return accept; }
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        VerticalLayout { spacing: Theme.space-l;
            HorizontalLayout { alignment: start; vertical-stretch: 0;
                ButtonGroup {
                    labels: root.manual-allowed
                        ? [root.mouse ? @tr("Mice") : @tr("Keyboards"), @tr("All devices"), @tr("Enter path")]
                        : [root.mouse ? @tr("Mice") : @tr("Keyboards"), @tr("All devices")];
                    selected-index: root.tab;
                    selected(index) => { root.show-tab(index); }
                }
            }
            if root.all: SearchField {
                init => { self.focus(); }
                text <=> root.query;
                placeholder-text: @tr("Search devices");
            }
            // List, its empty state and the manual path share the space left by the controls above.
            Rectangle { vertical-stretch: 1;
                list := ScrollView {
                    width: parent.width; height: parent.height;
                    visible: root.tab != 2 && root.filtered.length > 0;
                    viewport-width: self.visible-width;
                    viewport-y <=> root.scroll-y;
                    VerticalLayout { width: parent.width; spacing: 0px;
                        for choice[index] in root.filtered: Rectangle {
                            private property <bool> heading: choice.group == DeviceGroup.virtual-device && (index == 0 || root.filtered[index - 1].group != choice.group);
                            private property <bool> current: choice.path == root.current;
                            height: DeviceChoices.row-height + (self.heading ? DeviceChoices.heading-height : 0px);
                            vertical-stretch: 0;
                            if self.heading: Text {
                                x: 8px; y: 0px; height: DeviceChoices.heading-height; width: parent.width - 16px;
                                text: @tr("Virtual devices");
                                color: Theme.muted; font-size: Theme.font-body; font-weight: Theme.weight-semibold; vertical-alignment: center;
                            }
                            row := Rectangle {
                                property <bool> current: parent.current;
                                property <bool> show-detail: choice.detail != "" && choice.detail != choice.label && (root.all || choice.ambiguous);
                                y: parent.heading ? DeviceChoices.heading-height : 0px; height: DeviceChoices.row-height; width: parent.width;
                                border-radius: Theme.radius-small;
                                background: self.current ? Theme.selected : row-touch.has-hover || root.highlighted == index ? Theme.hover : transparent;
                                border-width: self.current && root.highlighted == index ? 1px : 0px;
                                border-color: Theme.accent;
                                accessible-role: button;
                                accessible-label: choice.label;
                                accessible-description: choice.group == DeviceGroup.missing ? @tr("Not connected · {}", choice.path) : choice.path;
                                accessible-checked: self.current;
                                accessible-action-default => { root.choose(index); }
                                if row.current: Rectangle { x: 0px; y: 8px; width: 3px; height: parent.height - 16px; border-radius: self.width / 2; background: Theme.accent; }
                                HorizontalLayout { padding-left: Theme.space-m + 4px; padding-right: Theme.space-m; spacing: Theme.space-m;
                                    VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: Theme.space-2xs;
                                        Text {
                                            min-width: 0px; overflow: elide;
                                            text: choice.label;
                                            color: Theme.text;
                                            font-weight: row.current ? Theme.weight-semibold : 400;
                                        }
                                        if choice.group == DeviceGroup.missing || row.show-detail: Text {
                                            min-width: 0px; overflow: elide;
                                            text: choice.group != DeviceGroup.missing ? choice.detail
                                                : row.show-detail ? @tr("Not connected · {}", choice.detail) : @tr("Not connected");
                                            color: choice.group == DeviceGroup.missing ? Theme.warning : Theme.muted;
                                            font-size: Theme.font-caption;
                                        }
                                    }
                                    if row.current: VerticalLayout { alignment: center; Image { width: 16px; height: 16px; source: @image-url("icons/check.svg"); colorize: Theme.accent; } }
                                }
                                row-focus := FocusScope {
                                    key-pressed(event) => {
                                        if event.text == Key.Return || event.text == " " { root.choose(index); return accept; }
                                        if event.text == Key.DownArrow { KeyboardFocus.step(false); return accept; }
                                        if event.text == Key.UpArrow { KeyboardFocus.step(true); return accept; }
                                        return reject;
                                    }
                                }
                                Rectangle { border-width: row-focus.has-focus ? 2px : 0px; border-color: Theme.focus; border-radius: Theme.radius-small; }
                                row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(index); } }
                            }
                        }
                    }
                }
                if root.tab != 2 && root.filtered.length == 0: VerticalLayout { width: parent.width; height: parent.height; alignment: start; spacing: Theme.space-m; padding-top: Theme.space-m;
                    Text {
                        horizontal-alignment: center; wrap: word-wrap; color: Theme.muted;
                        text: root.all && root.query != "" ? @tr("No matching items") : @tr("No devices found");
                    }
                    if !root.all: HorizontalLayout { alignment: center;
                        LinkText { text: @tr("Show all devices"); clicked => { root.show-tab(1); } }
                    }
                }
                if root.tab == 2: VerticalLayout { width: parent.width; height: parent.height; alignment: start; spacing: Theme.space-m;
                    TextField {
                        init => { self.focus(); }
                        text <=> root.manual-path;
                        placeholder-text: @tr("Device path, e.g. /dev/input/by-id/…");
                        accepted => { root.apply-manual(); }
                    }
                    // What the typed path opens right now; a missing device can still be saved.
                    if root.manual-path != "": HorizontalLayout { spacing: Theme.space-s;
                        VerticalLayout { alignment: center;
                            Image {
                                width: 14px; height: 14px;
                                source: root.manual-connected ? @image-url("icons/check.svg") : @image-url("icons/triangle-alert.svg");
                                colorize: root.manual-connected ? Theme.success : Theme.warning;
                            }
                        }
                        Text {
                            min-width: 0px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center;
                            text: root.manual-connected ? @tr("Connected: {}", root.choices[root.manual-match.index].label) : @tr("Not connected");
                            color: root.manual-connected ? Theme.text : Theme.warning;
                        }
                    }
                    if root.manual-connected && !root.manual-match.exact: HorizontalLayout { spacing: Theme.space-m;
                        Text {
                            min-width: 0px; horizontal-stretch: 1; wrap: word-wrap; vertical-alignment: center;
                            text: @tr("This path may change after reconnecting.");
                            color: Theme.muted; font-size: Theme.font-body;
                        }
                        LinkText {
                            horizontal-stretch: 0;
                            text: @tr("Use the stable path");
                            font-size: Theme.font-body;
                            clicked => { root.manual-path = root.choices[root.manual-match.index].path; }
                        }
                    }
                }
            }
            if root.tab == 2: Text {
                vertical-stretch: 0;
                text: @tr("A path from /dev/input/by-id/ stays the same after reboots and reconnecting.");
                color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap;
            }
            if root.tab == 0: Text {
                vertical-stretch: 0;
                text: @tr("Detected automatically from what each device reports, so the list may be incomplete. If your device is missing, look under All devices.");
                color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap;
            }
            HorizontalLayout { spacing: Theme.space-m; vertical-stretch: 0;
                // The manual path does not depend on the device list.
                if root.tab != 2: Button { text: @tr("Refresh"); enabled: root.enabled; clicked => { root.refresh(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Reset"); enabled: root.enabled && root.current != ""; clicked => { root.chosen(""); } }
                if root.tab != 2: Button { text: @tr("Close"); clicked => { root.close(); } }
                if root.tab == 2: Button { text: @tr("Cancel"); clicked => { root.close(); } }
                if root.tab == 2: Button { text: @tr("Apply"); primary: true; enabled: root.enabled && root.manual-changed; clicked => { root.apply-manual(); } }
            }
        }
    }
}
