import { Theme } from "theme.slint";
import { PopupCell, PopupHeader, PopupKeys } from "popup-grid.slint";

/// Emoji menu: pages of 3 × 5 cells addressed by the left-hand hotkeys.
export component EmojiPopup inherits Window {
    title: @tr("Emoji");
    width: 480px;
    height: 350px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    /// Cells of every page, 15 per page.
    in property <[string]> emojis;
    in property <[string]> page-names;
    in-out property <int> page: 0;
    in property <bool> presented: true;
    callback key(string);
    callback choose(int);
    callback dismiss();
    public function prepare() { keys.focus(); }
    keys := FocusScope {
        key-pressed(event) => { root.key(event.text); return accept; }
        Rectangle {
            visible: root.presented;
            x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
            background: Theme.surface; border-radius: 16px;
            border-width: 1px; border-color: Theme.divider;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                PopupHeader {
                    title: @tr("Emoji");
                    page-name: root.page-names.length == 0 ? "" : root.page-names[root.page];
                    page: root.page;
                    page-count: root.page-names.length;
                    dismiss => { root.dismiss(); }
                }
                for row in 3: HorizontalLayout {
                    spacing: 8px;
                    for col in 5: PopupCell {
                        height: 80px;
                        hotkey: PopupKeys.labels[row * 5 + col];
                        content: root.emojis[root.page * 15 + row * 5 + col];
                        emoji: true;
                        clicked => { root.choose(row * 5 + col); }
                    }
                }
            }
        }
    }
}
