import { Button, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
export component EmojiPopup inherits Window {
    title: "Slint Shell — Emoji";
    width: 520px;
    height: 460px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <[string]> emojis;
    in-out property <int> page: 0;
    in-out property <int> selected: 0;
    callback key(string);
    in property <bool> presented: true;
    callback choose(int);
    callback dismiss();
    public function prepare() { keys.focus(); }
    Rectangle {
        visible: root.presented;
        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        background: Theme.surface; border-radius: 16px;
        VerticalBox {
            padding: 16px;
            HorizontalBox {
                Text { text: root.page == 5 ? @tr("1500 emoji — stress") : @tr("Emoji · ") + (root.page + 1) + "/5"; color: Theme.text; }
                Button { text: "×"; clicked => { root.dismiss(); } }
            }
            HorizontalBox {
                for p in 6: Button {
                    text: p == 5 ? @tr("Stress") : "" + (p + 1);
                    clicked => { root.page = p; root.selected = 0; keys.focus(); }
                }
            }
            keys := FocusScope {
                key-pressed(event) => { root.key(event.text); return accept; }
                ScrollView {
                    viewport-y: root.page == 5 ? -max(0, floor(root.selected / 8) - 5) * 44px : 0px;
                    viewport-height: root.page == 5 ? 188 * 44px : 6 * 44px;
                    for row in (root.page == 5 ? 188 : 6): HorizontalLayout {
                        y: row * 44px; height: 44px;
                        for col in 8: Rectangle {
                            visible: root.page != 5 || row * 8 + col < 1500;
                            background: root.selected == row * 8 + col ? Theme.accent : transparent;
                            border-radius: 8px;
                            Text {
                                text: root.emojis[mod(root.page == 5 ? row * 8 + col : root.page * 48 + row * 8 + col, 240)];
                                font-family: "Noto Color Emoji"; font-size: 28px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            TouchArea { clicked => { root.choose(row * 8 + col); } }
                        }
                    }
                }
            }
            Text { text: "← ↑ ↓ → · Enter · Esc · 1–5 · 6 Stress"; color: Theme.text; }
        }
    }
}
