import { PopupGridBody } from "popup-grid.slint";

/// Emoji menu: pages of 3 × 5 cells addressed by the left-hand hotkeys.
export component EmojiPopup inherits Window {
    title: @tr("Emoji");
    // The Spell surface repeats this size (`spell.rs`).
    width: 480px;
    height: 350px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    /// Cells of every page, 15 per page.
    in property <[string]> emojis;
    in property <[string]> page-names;
    in-out property <int> page: 0;
    in property <bool> presented: true;
    callback key(string) -> bool;
    callback choose(int);
    callback dismiss();
    public function prepare() { body.prepare(); }
    body := PopupGridBody {
        width: parent.width; height: parent.height;
        title: root.title;
        presented: root.presented;
        page-names: root.page-names;
        page: root.page;
        items: root.emojis;
        item-offset: root.page * 15;
        emoji: true;
        key(text) => { return root.key(text); }
        choose(index) => { root.choose(index); }
        dismiss => { root.dismiss(); }
    }
}
