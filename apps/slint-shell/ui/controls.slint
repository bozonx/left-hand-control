import { Palette, Button, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ButtonGroup inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> selected-index;
    callback selected(int);
    spacing: 0px;
    vertical-stretch: 0;
    for label[index] in root.labels: Rectangle {
        height: 36px;
        border-top-left-radius: index == 0 ? 4px : 0px;
        border-bottom-left-radius: index == 0 ? 4px : 0px;
        border-top-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        border-bottom-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        background: root.selected-index == index ? Palette.accent-background : touch.has-hover ? Theme.hover : Theme.card;
        border-width: 1px;
        border-color: focus.has-focus ? Theme.text : root.selected-index == index ? Palette.accent-background : Theme.border;
        accessible-role: radio-button;
        accessible-label: label;
        accessible-checked: root.selected-index == index;
        accessible-action-default => { root.selected(index); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text {
                text: label;
                color: root.selected-index == index ? Palette.accent-foreground : Theme.text;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                return reject;
            }
        }
        touch := TouchArea { clicked => { focus.focus(); root.selected(index); } }
    }
}

export component InfoTip inherits Rectangle {
    in property <string> text;
    width: 18px; height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.muted;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        text: "i";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Tooltip {
        Rectangle {
            min-width: 340px;
            max-width: 340px;
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                Text { min-width: 320px; max-width: 320px; text: root.text; color: Theme.text; wrap: word-wrap; }
            }
        }
    }
}

/// Icon button; with `text` it grows into an icon + label button.
export component IconButton inherits Rectangle {
    in property <image> icon;
    /// Accessible name when there is no visible text.
    in property <string> label;
    in property <string> text;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> size: 28px;
    callback clicked();
    min-width: root.size;
    height: root.text == "" ? root.size : 32px;
    max-width: root.text == "" ? root.size : 100000px;
    border-radius: 6px;
    background: root.primary
        ? (touch.has-hover && root.enabled ? Palette.accent-background.brighter(0.15) : Palette.accent-background)
        : root.enabled && (touch.has-hover || focus.has-focus) ? Theme.hover : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: Theme.text;
    opacity: root.enabled || root.text == "" ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.label != "" ? root.label : root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.text == "" ? 0px : 10px;
        padding-right: root.text == "" ? 0px : 12px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                width: root.text == "" ? root.size * 0.55 : 16px; height: self.width;
                source: root.icon;
                colorize: !root.enabled ? Theme.muted : root.primary ? Palette.accent-foreground : root.danger ? Theme.error : Theme.text;
                opacity: root.enabled ? 1.0 : 0.4;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Palette.accent-foreground : Theme.text;
            font-weight: 600;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip {
        Rectangle {
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 6px;
                Text { text: root.tooltip; color: Theme.text; font-size: 12px; }
            }
        }
    }
}

export component Card inherits Rectangle {
    in property <bool> highlighted: false;
    in property <length> radius: 10px;
    background: Theme.card;
    border-width: 1px;
    border-radius: root.radius;
    border-color: root.highlighted ? Palette.accent-background : Theme.border;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.hover;
    height: 22px;
    border-radius: 5px;
    background: root.fill;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    }
}

export component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
}

export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> info;
    spacing: 8px;
    alignment: stretch;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            if root.info != "": VerticalLayout { alignment: center; InfoTip { text: root.info; } }
        }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    @children
}

export component PageTabs inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> selected;
    callback select(int);
    spacing: 6px;
    alignment: start;
    Text { text: @tr("Page"); color: Theme.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    for label[index] in root.labels: Rectangle {
        height: 30px;
        min-width: 44px;
        border-radius: 6px;
        border-width: 1px;
        border-color: index == root.selected ? Palette.accent-background : focus.has-focus ? Theme.text : Theme.border;
        background: index == root.selected ? Theme.accent : touch.has-hover ? Theme.hover : transparent;
        accessible-role: tab;
        accessible-label: label;
        accessible-checked: index == root.selected;
        accessible-action-default => { root.select(index); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text { text: label; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.select(index); return accept; }
                return reject;
            }
        }
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.select(index); } }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text;
    in property <string> error;
    callback confirm();
    callback cancel();
    background: #00000099;
    TouchArea { clicked => { root.cancel(); } }
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        Rectangle {
            width: min(440px, root.width - 32px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            height: dialog-layout.preferred-height;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            dialog-layout := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { vertical-stretch: 0; text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                Text { vertical-stretch: 0; text: root.body; color: Theme.text; wrap: word-wrap; }
                if root.error != "": Text { vertical-stretch: 0; text: root.error; color: Theme.error; wrap: word-wrap; }
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                    confirm-button := Button { init => { self.focus(); } text: root.confirm-text; primary: true; icon: @image-url("icons/trash-2.svg"); colorize-icon: true; clicked => { root.confirm(); } }
                }
            }
        }
    }
}

export global InlineEditors { in-out property <int> revision; }

export component InlineTextField inherits FocusScope {
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> multiline: false;
    in property <length> text-size: 14px;
    in property <int> text-weight: 400;
    in property <color> text-color: Theme.text;
    in-out property <bool> editing: false;
    private property <string> draft;
    private property <int> revision: InlineEditors.revision;
    changed revision => { root.editing = false; }
    changed text => { root.editing = false; }
    callback saved(string);
    public function begin() { root.draft = root.text; root.editing = true; }
    function save() { root.saved(root.draft); root.editing = false; }
    function cancel() { root.draft = root.text; root.editing = false; }
    vertical-stretch: 0;
    focus-on-tab-navigation: false;
    key-pressed(event) => {
        if root.editing && event.text == Key.Escape { root.cancel(); return accept; }
        if root.editing && root.multiline && event.modifiers.control && event.text == Key.Return { root.save(); return accept; }
        return reject;
    }
    HorizontalLayout {
        spacing: 4px;
        if !root.editing: Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            height: display.height + 8px + (root.multiline && measure.preferred-height > display.height ? line.preferred-height : 0px);
            border-radius: 4px;
            background: edit-touch.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: root.label;
            accessible-action-default => { root.begin(); }
            line := Text { text: "Ag"; font-size: root.text-size; font-weight: root.text-weight; visible: false; }
            measure := Text {
                width: parent.width - 8px;
                text: root.text == "" ? root.placeholder : root.text;
                font-size: root.text-size;
                font-weight: root.text-weight;
                wrap: root.multiline ? word-wrap : no-wrap;
                visible: false;
            }
            if root.multiline && measure.preferred-height > display.height: Text {
                x: 4px; y: display.height + 4px;
                text: "…"; color: root.text-color; font-size: root.text-size;
            }
            display := Text {
                x: 4px; y: 4px;
                width: parent.width - 8px;
                height: root.multiline ? min(measure.preferred-height, line.preferred-height * 5) : line.preferred-height;
                text: root.text == "" ? root.placeholder : root.text;
                color: root.text == "" ? Theme.muted : root.text-color;
                font-size: root.text-size;
                font-weight: root.text-weight;
                vertical-alignment: top;
                wrap: root.multiline ? word-wrap : no-wrap;
                overflow: elide;
            }
            edit-touch := TouchArea { mouse-cursor: pointer; clicked => { root.begin(); } }
        }
        if root.editing && !root.multiline: LineEdit {
            horizontal-stretch: 1;
            text <=> root.draft;
            placeholder-text: root.placeholder;
            accessible-label: root.label;
            init => { self.focus(); self.select-all(); }
            accepted => { root.save(); }
        }
        if root.editing && root.multiline: TextEdit {
            horizontal-stretch: 1;
            height: 80px;
            text <=> root.draft;
            accessible-label: root.label;
            init => { self.focus(); }
        }
        VerticalLayout { alignment: start;
            HorizontalLayout { spacing: 2px;
                if root.editing: IconButton { icon: @image-url("icons/check.svg"); label: @tr("Save"); clicked => { root.save(); } }
                if root.editing: IconButton { icon: @image-url("icons/x.svg"); label: @tr("Cancel"); clicked => { root.cancel(); } }
            }
        }
    }
}
