import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ButtonGroup inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> selected-index;
    callback selected(int);
    spacing: 0px;
    vertical-stretch: 0;
    for label[index] in root.labels: Rectangle {
        height: 36px;
        border-top-left-radius: index == 0 ? 4px : 0px;
        border-bottom-left-radius: index == 0 ? 4px : 0px;
        border-top-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        border-bottom-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        background: root.selected-index == index ? Palette.accent-background : touch.has-hover ? Theme.hover : Theme.card;
        border-width: 1px;
        border-color: focus.has-focus ? Theme.text : root.selected-index == index ? Palette.accent-background : Theme.border;
        accessible-role: radio-button;
        accessible-label: label;
        accessible-checked: root.selected-index == index;
        accessible-action-default => { root.selected(index); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text {
                text: label;
                color: root.selected-index == index ? Palette.accent-foreground : Theme.text;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                return reject;
            }
        }
        touch := TouchArea { clicked => { focus.focus(); root.selected(index); } }
    }
}

export component InfoTip inherits Rectangle {
    in property <string> text;
    width: 18px; height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.muted;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        text: "i";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Tooltip {
        // Slint wraps custom content in its own framed ToolTipImpl and sizes the
        // popup from the content's layout info. A fixed `width` is ignored there
        // (it would report the unwrapped text width), so constrain via min/max.
        Rectangle {
            min-width: 340px;
            max-width: 340px;
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                Text { text: root.text; color: Theme.text; wrap: word-wrap; }
            }
        }
    }
}
