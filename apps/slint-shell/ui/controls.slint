import { Button, LineEdit, TextEdit, ComboBox } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";

export component ButtonGroup inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> selected-index;
    callback selected(int);
    spacing: 0px;
    vertical-stretch: 0;
    for label[index] in root.labels: Rectangle {
        height: 36px;
        border-top-left-radius: index == 0 ? 4px : 0px;
        border-bottom-left-radius: index == 0 ? 4px : 0px;
        border-top-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        border-bottom-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        background: root.selected-index == index ? Theme.selected : touch.has-hover ? Theme.hover : Theme.card;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? Theme.focus : root.selected-index == index ? Theme.accent : Theme.border;
        accessible-role: radio-button;
        accessible-label: label;
        accessible-checked: root.selected-index == index;
        accessible-action-default => { root.selected(index); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text {
                text: label;
                color: Theme.text;
                font-weight: root.selected-index == index ? 600 : 400;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                return reject;
            }
        }
        touch := TouchArea { clicked => { focus.focus(); root.selected(index); } }
    }
}

export component InfoTip inherits Rectangle {
    in property <string> text;
    width: 18px; height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.muted;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        text: "i";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Tooltip {
        Rectangle {
            min-width: 340px;
            max-width: 340px;
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                Text { min-width: 320px; max-width: 320px; text: root.text; color: Theme.text; wrap: word-wrap; }
            }
        }
    }
}

export component SelectField inherits ComboBox {
    width: 180px;
    horizontal-stretch: 0;
}

/// Icon button; with `text` it grows into an icon + label button.
export component IconButton inherits Rectangle {
    in property <image> icon;
    /// Accessible name when there is no visible text.
    in property <string> label;
    in property <string> text;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> size: 28px;
    callback clicked();
    min-width: root.size;
    height: root.text == "" ? root.size : 32px;
    max-width: root.text == "" ? root.size : 100000px;
    border-radius: 6px;
    background: root.primary
        ? (touch.has-hover && root.enabled ? (Theme.dark ? Theme.accent.darker(0.15) : Theme.accent.brighter(0.2)) : Theme.accent)
        : root.enabled && (touch.has-hover || focus.has-focus) ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: root.primary ? Theme.text : Theme.focus;
    opacity: root.enabled || root.text == "" ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.label != "" ? root.label : root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.text == "" ? 0px : 10px;
        padding-right: root.text == "" ? 0px : 12px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                width: root.text == "" ? root.size * 0.55 : 16px; height: self.width;
                source: root.icon;
                colorize: !root.enabled ? Theme.muted : root.primary ? Theme.on-accent : root.danger ? Theme.error : Theme.text;
                opacity: root.enabled ? 1.0 : 0.4;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.text;
            font-weight: 600;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip {
        Rectangle {
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 6px;
                Text { text: root.tooltip; color: Theme.text; font-size: 12px; }
            }
        }
    }
}

// One wheel notch is 60px in the winit backend; touchpads send small pixel deltas.
global NumericWheel {
    out property <length> notch: 50px;
}

// The parent TouchArea only sees the wheel after the field rejects it, and steps only while
// the field has focus so scrolling the page over an unfocused field keeps scrolling the page.
export component NumericField inherits TouchArea {
    in property <length> field-width: 140px;
    in property <int> minimum: 0;
    in property <int> maximum: 2147483647;
    in property <float> step-size: 1;
    in property <bool> fractional: false;
    in-out property <float> value;
    callback edited(float);
    private property <length> wheel;
    width: root.field-width;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: spinbox;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step-size;
    accessible-action-increment => { root.apply(root.value + root.step-size); }
    accessible-action-decrement => { root.apply(root.value - root.step-size); }
    accessible-action-set-value(v) => { if v.is-float() { root.apply(v.to-float()); } }
    changed value => { input.text = root.value; }
    function apply(next: float) {
        let value = clamp(root.fractional ? round(next * 1000) / 1000 : round(next), root.minimum, root.maximum);
        input.text = value;
        if value != root.value { root.value = value; root.edited(value); }
    }
    scroll-event(event) => {
        if !input.has-focus || event.delta-y == 0 { return reject; }
        root.wheel += event.delta-y;
        if abs(root.wheel) >= NumericWheel.notch {
            root.apply(root.value + (root.wheel > 0 ? root.step-size : -root.step-size));
            root.wheel = 0;
        }
        accept
    }
    Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.focus : Theme.border;
        background: Theme.surface;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 2px;
            spacing: 2px;
            input := TextInput {
                min-width: 0px;
                horizontal-stretch: 1;
                text: root.value;
                input-type: root.fractional ? decimal : number;
                color: Theme.text;
                vertical-alignment: center;
                selection-background-color: Theme.selected;
                selection-foreground-color: Theme.text;
                accessible-role: none;
                edited => {
                    if self.text.is-float() && self.text.to-float() >= root.minimum && self.text.to-float() <= root.maximum && self.text.to-float() != root.value {
                        root.value = self.text.to-float();
                        root.edited(root.value);
                    }
                }
                accepted => { self.text = root.value; }
                changed has-focus => { if !self.has-focus { self.text = root.value; } }
            }
            VerticalLayout { alignment: center; IconButton { size: 24px; icon: @image-url("icons/chevron-up.svg"); label: @tr("Increase"); clicked => { root.apply(root.value + root.step-size); } } }
            VerticalLayout { alignment: center; IconButton { size: 24px; icon: @image-url("icons/chevron-down.svg"); label: @tr("Decrease"); clicked => { root.apply(root.value - root.step-size); } } }
        }
    }
}

// Text-backed numeric field: empty means "use the global default" (shown as the placeholder).
export component NumericInput inherits TouchArea {
    in property <length> field-width: 124px;
    in-out property <string> text <=> edit.text;
    in property <string> placeholder-text <=> edit.placeholder-text;
    in property <string> label;
    in property <int> minimum: 0;
    in property <int> step: 10;
    callback edited(string);
    private property <length> wheel;
    width: root.field-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    scroll-event(event) => {
        if !edit.has-focus || event.delta-y == 0 { return reject; }
        root.wheel += event.delta-y;
        if abs(root.wheel) >= NumericWheel.notch {
            let current = edit.text.is-float() ? edit.text.to-float() : edit.placeholder-text.is-float() ? edit.placeholder-text.to-float() : root.minimum;
            edit.text = max(root.minimum, round(current) + (root.wheel > 0 ? root.step : -root.step));
            root.wheel = 0;
            root.edited(edit.text);
        }
        accept
    }
    edit := LineEdit {
        width: 100%;
        input-type: number;
        accessible-label: root.label;
        edited(value) => { root.edited(value); }
    }
}

export component Card inherits Rectangle {
    in property <bool> highlighted: false;
    in property <length> radius: 10px;
    background: Theme.card;
    border-width: 1px;
    border-radius: root.radius;
    border-color: root.highlighted ? Theme.accent : Theme.divider;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.hover;
    height: 22px;
    border-radius: 5px;
    background: root.fill;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { min-width: 0px; overflow: elide; text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    }
}

export component FormLabel inherits HorizontalLayout {
    in property <string> text;
    in property <string> info;
    spacing: 6px;
    alignment: start;
    vertical-stretch: 0;
    Text {
        text: root.text;
        color: Theme.text;
        horizontal-stretch: 0;
        min-width: 0px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    if root.info != "": VerticalLayout {
        horizontal-stretch: 0;
        alignment: center;
        InfoTip { text: root.info; }
    }
}

export component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
}

export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> info;
    spacing: 8px;
    alignment: stretch;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            if root.info != "": VerticalLayout { alignment: center; InfoTip { text: root.info; } }
        }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    @children
}

/// Document tab with an accent underline; `icon` is optional.
export component NavTab inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;
    min-width: row.preferred-width;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    background: touch.has-hover && !root.selected ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: 12px; padding-right: 12px; padding-bottom: 3px;
        spacing: 7px;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image { width: 16px; height: 16px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.muted; }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.muted;
            font-weight: 600;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
    Rectangle {
        x: 6px; y: parent.height - self.height;
        width: parent.width - 12px; height: 3px;
        border-top-left-radius: 2px; border-top-right-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
    }
    Rectangle {
        border-radius: 6px;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.focus;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Top-bar section switch: quiet until selected, then a soft accent fill.
export component NavButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    horizontal-stretch: 0;
    min-width: row.preferred-width;
    border-radius: 6px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: 12px; padding-right: 12px;
        spacing: 7px;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image { width: 16px; height: 16px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.muted; }
        }
        Text { text: root.text; color: root.selected ? Theme.text : Theme.muted; font-weight: 600; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Start/stop switch of the mapper. A pill with a round state puck so it
/// reads as a global on/off switch, never as the page's primary action.
export component MapperToggle inherits Rectangle {
    in property <bool> running;
    in property <bool> busy;
    in property <string> text;
    in property <string> tooltip;
    callback toggled();
    height: 36px;
    horizontal-stretch: 0;
    min-width: max(132px, row.preferred-width);
    border-radius: self.height / 2;
    background: root.running
        ? Theme.success.transparentize(touch.has-hover ? 0.78 : 0.86)
        : touch.has-hover ? Theme.hover : Theme.card;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.focus : root.running ? Theme.success : Theme.border;
    opacity: root.busy ? 0.7 : 1;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.running;
    accessible-enabled: !root.busy;
    accessible-action-default => { if !root.busy { root.toggled(); } }
    row := HorizontalLayout {
        padding-left: 5px; padding-right: 16px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px; height: 26px;
                border-radius: 13px;
                background: root.running ? Theme.success : transparent;
                border-width: root.running ? 0px : 1px;
                border-color: Theme.success;
                Image {
                    width: 12px; height: 12px;
                    source: root.running ? @image-url("icons/square.svg") : @image-url("icons/play.svg");
                    colorize: root.running ? Theme.card : Theme.success;
                }
            }
        }
        Text { text: root.text; color: Theme.text; font-weight: 600; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: !root.busy;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggled(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: !root.busy;
        mouse-cursor: root.busy ? default : pointer;
        clicked => { root.toggled(); }
    }
    if root.tooltip != "": Tooltip {
        Rectangle {
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 6px;
                Text { text: root.tooltip; color: Theme.text; font-size: 12px; }
            }
        }
    }
}

export component PageTabs inherits ScrollView {
    in property <[string]> labels;
    in property <int> selected;
    callback select(int);
    callback add();
    height: 44px;
    viewport-height: self.visible-height;
    viewport-width: max(self.visible-width, tabs.preferred-width);
    vertical-scrollbar-policy: always-off;
    horizontal-scrollbar-policy: as-needed;
    tabs := HorizontalLayout { spacing: 6px; alignment: start;
        for label[index] in root.labels: NavTab {
            height: 40px;
            text: label;
            selected: index == root.selected;
            clicked => { root.select(index); }
        }
        IconButton { icon: @image-url("icons/plus.svg"); tooltip: @tr("Add page"); primary: root.labels.length == 0; clicked => { root.add(); } }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text;
    in property <image> confirm-icon: @image-url("icons/trash-2.svg");
    in property <string> error;
    callback confirm();
    callback cancel();
    background: #00000099;
    TouchArea { clicked => { root.cancel(); } }
    FocusScope {
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            return reject;
        }
        Rectangle {
            width: min(440px, root.width - 32px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            height: dialog-layout.preferred-height;
            background: Theme.surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea {}
            dialog-layout := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text { vertical-stretch: 0; text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                Text { vertical-stretch: 0; text: root.body; color: Theme.text; wrap: word-wrap; }
                if root.error != "": Text { vertical-stretch: 0; text: root.error; color: Theme.error; wrap: word-wrap; }
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    alignment: end;
                    Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                    confirm-button := Button { init => { self.focus(); } text: root.confirm-text; primary: true; icon: root.confirm-icon; colorize-icon: true; clicked => { root.confirm(); } }
                }
            }
        }
    }
}

export global InlineEditors {
    in-out property <int> commit-revision: 0; in-out property <int> revision; pure callback nonempty(string) -> bool;
    // Set from the winit window events: focus loss caused by switching windows must not commit.
    in-out property <bool> window-active: true;
}

export component InlineTextField inherits FocusScope {
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> allow-empty: true;
    in property <bool> clearable: false;
    in property <length> text-size: 14px;
    in property <int> text-weight: 400;
    in property <color> text-color: Theme.text;
    in-out property <bool> editing: false;
    private property <string> draft;
    private property <int> revision: InlineEditors.revision;
    private property <int> commit-revision: InlineEditors.commit-revision;
    changed commit-revision => { if root.editing { root.save(); } }
    changed revision => { root.editing = false; }
    changed text => { root.editing = false; }
    callback saved(string);
    public function begin() { root.draft = root.text; root.editing = true; }
    function save() { if root.allow-empty || InlineEditors.nonempty(root.draft) { root.saved(root.draft); root.editing = false; } }
    function cancel() { root.draft = root.text; root.editing = false; }
    function blurred() {
        if !root.editing || !InlineEditors.window-active { return; }
        if root.allow-empty || InlineEditors.nonempty(root.draft) { root.save(); } else { root.cancel(); }
    }
    vertical-stretch: 0;
    horizontal-stretch: root.editing ? 1 : 0;
    min-width: root.editing ? 92px : 0px;
    preferred-width: measure.preferred-width + 40px;
    max-width: root.editing ? 100000px : root.preferred-width;
    focus-on-tab-navigation: !root.editing;
    key-pressed(event) => {
        if root.editing && event.text == Key.Escape { root.cancel(); return accept; }
        if !root.editing && (event.text == Key.Return || event.text == " ") { root.begin(); return accept; }
        return reject;
    }
    measure := Text {
        text: root.text == "" ? root.placeholder : root.text;
        font-size: root.text-size;
        font-weight: root.text-weight;
        visible: false;
    }
    HorizontalLayout {
        spacing: 4px;
        if !root.editing: display-touch := TouchArea {
            height: max(28px, measure.preferred-height + 8px);
            mouse-cursor: MouseCursor.text;
            accessible-role: button;
            accessible-label: root.label;
            accessible-action-default => { root.begin(); }
            clicked => { root.begin(); }
            Rectangle {
                border-radius: 4px;
                background: display-touch.has-hover ? Theme.hover : transparent;
                border-width: root.has-focus ? 1px : 0px;
                border-color: Theme.focus;
                HorizontalLayout {
                    padding-left: 4px;
                    spacing: 4px;
                    Text {
                        min-width: 0px;
                        text: root.text == "" ? root.placeholder : root.text;
                        color: root.text == "" ? Theme.muted : root.text-color;
                        font-size: root.text-size;
                        font-weight: root.text-weight;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        width: 28px;
                        IconButton {
                            visible: display-touch.has-hover || root.has-focus;
                            icon: @image-url("icons/pencil.svg");
                            label: root.label;
                            clicked => { root.begin(); }
                        }
                    }
                }
            }
        }
        if root.editing && root.clearable: LineEdit {
            min-width: 0px;
            horizontal-stretch: 1;
            text <=> root.draft;
            placeholder-text: root.placeholder;
            accessible-label: root.label;
            init => { self.focus(); self.select-all(); }
            accepted => { root.save(); }
            changed has-focus => { if !self.has-focus { root.blurred(); } }
        }
        if root.editing && !root.clearable: Rectangle {
            min-width: 28px;
            horizontal-stretch: 1;
            height: 32px;
            border-radius: 4px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.focus : Theme.border;
            background: Theme.surface;
            clip: true;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Rectangle {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    clip: true;
                    input := TextInput {
                        private property <length> scroll-x;
                        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                        width: max(parent.width - self.text-cursor-width, self.preferred-width);
                        height: parent.height;
                        cursor-position-changed(position) => {
                            if position.x + self.scroll-x < 4px {
                                self.scroll-x = 4px - position.x;
                            } else if position.x + self.scroll-x > parent.width - 4px - self.text-cursor-width {
                                self.scroll-x = parent.width - position.x - 4px - self.text-cursor-width;
                            }
                        }
                        text <=> root.draft;
                        single-line: true;
                        color: Theme.text;
                        font-size: root.text-size;
                        vertical-alignment: center;
                        selection-background-color: Theme.selected;
                        selection-foreground-color: Theme.text;
                        accessible-label: root.label;
                        init => { self.focus(); self.select-all(); }
                        accepted => { root.save(); }
                        changed has-focus => { if !self.has-focus { root.blurred(); } }
                    }
                }
            }
        }
        if root.editing: IconButton { icon: @image-url("icons/check.svg"); label: @tr("Save"); enabled: root.allow-empty || InlineEditors.nonempty(root.draft); clicked => { root.save(); } }
        if root.editing: IconButton { icon: @image-url("icons/x.svg"); label: @tr("Cancel"); clicked => { root.cancel(); } }
    }
}

export component InlineTextArea inherits FocusScope {
    in property <bool> expanded: false;
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> allow-empty: true;
    in property <length> text-size: 14px;
    in property <int> text-weight: 400;
    in property <color> text-color: Theme.text;
    in-out property <bool> editing: false;
    private property <string> draft;
    private property <int> revision: InlineEditors.revision;
    private property <int> commit-revision: InlineEditors.commit-revision;
    changed commit-revision => { if root.editing { root.save(); } }
    changed revision => { root.editing = false; }
    changed text => { root.editing = false; }
    callback saved(string);
    public function begin() { root.draft = root.text; root.editing = true; }
    function save() { if root.allow-empty || InlineEditors.nonempty(root.draft) { root.saved(root.draft); root.editing = false; } }
    function cancel() { root.draft = root.text; root.editing = false; }
    function blurred() {
        if !root.editing || !InlineEditors.window-active { return; }
        if root.allow-empty || InlineEditors.nonempty(root.draft) { root.save(); } else { root.cancel(); }
    }
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 0px;
    focus-on-tab-navigation: !root.editing;
    key-pressed(event) => {
        if root.editing && event.text == Key.Escape { root.cancel(); return accept; }
        if root.editing && event.modifiers.control && event.text == Key.Return { root.save(); return accept; }
        if !root.editing && (event.text == Key.Return || event.text == " ") { root.begin(); return accept; }
        return reject;
    }
    VerticalLayout {
        spacing: 4px;
        if !root.editing: Rectangle {
            min-width: 0px;
            height: max(56px, display.height + 8px + (measure.preferred-height > display.height ? line.preferred-height : 0px));
            border-radius: 4px;
            background: edit-touch.has-hover ? Theme.hover : transparent;
            border-width: 1px;
            border-color: root.has-focus ? Theme.focus : edit-touch.has-hover ? Theme.border : transparent;
            accessible-role: button;
            accessible-label: root.label;
            accessible-action-default => { root.begin(); }
            line := Text { text: "Ag"; font-size: root.text-size; font-weight: root.text-weight; visible: false; }
            measure := Text {
                width: parent.width - 8px;
                text: root.text == "" ? root.placeholder : root.text;
                font-size: root.text-size;
                font-weight: root.text-weight;
                wrap: word-wrap;
                visible: false;
            }
            if measure.preferred-height > display.height: Text {
                x: 4px; y: display.height + 4px;
                text: "…"; color: root.text-color; font-size: root.text-size;
            }
            display := Text {
                x: 4px; y: 4px;
                width: parent.width - 8px;
                height: root.expanded ? measure.preferred-height : min(measure.preferred-height, line.preferred-height * 5);
                text: root.text == "" ? root.placeholder : root.text;
                color: root.text == "" ? Theme.muted : root.text-color;
                font-size: root.text-size;
                font-weight: root.text-weight;
                vertical-alignment: top;
                wrap: word-wrap;
                overflow: elide;
            }
            edit-touch := TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.begin(); } }
        }
        if root.editing: TextEdit {
            height: root.expanded ? 240px : 80px;
            text <=> root.draft;
            accessible-label: root.label;
            init => { self.focus(); }
            changed has-focus => { if !self.has-focus { root.blurred(); } }
        }
        if root.editing: HorizontalLayout {
            spacing: 4px;
            alignment: end;
            IconButton { icon: @image-url("icons/check.svg"); label: @tr("Save"); enabled: root.allow-empty || InlineEditors.nonempty(root.draft); clicked => { root.save(); } }
            IconButton { icon: @image-url("icons/x.svg"); label: @tr("Cancel"); clicked => { root.cancel(); } }
        }
    }
}

export global ItemStyle {
    public pure function opacity(enabled: bool) -> float { return enabled ? 1.0 : 0.35; }
}

export component Alert inherits Rectangle {
    in property <string> title;
    in property <string> text;
    vertical-stretch: 0;
    min-height: content.preferred-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.warning.transparentize(0.5);
    background: Theme.warning.transparentize(0.88);
    content := HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout { alignment: start; Image { width: 18px; height: 18px; source: @image-url("icons/triangle-alert.svg"); colorize: Theme.warning; } }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 4px;
            Text { text: root.title; color: Theme.text; font-weight: 700; wrap: word-wrap; }
            Text { text: root.text; color: Theme.muted; wrap: word-wrap; }
        }
        VerticalLayout { alignment: start; @children }
    }
}
