import { Palette, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ButtonGroup inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> selected-index;
    callback selected(int);
    spacing: 0px;
    vertical-stretch: 0;
    for label[index] in root.labels: Rectangle {
        height: 36px;
        border-top-left-radius: index == 0 ? 4px : 0px;
        border-bottom-left-radius: index == 0 ? 4px : 0px;
        border-top-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        border-bottom-right-radius: index == root.labels.length - 1 ? 4px : 0px;
        background: root.selected-index == index ? Palette.accent-background : touch.has-hover ? Theme.hover : Theme.card;
        border-width: 1px;
        border-color: focus.has-focus ? Theme.text : root.selected-index == index ? Palette.accent-background : Theme.border;
        accessible-role: radio-button;
        accessible-label: label;
        accessible-checked: root.selected-index == index;
        accessible-action-default => { root.selected(index); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text {
                text: label;
                color: root.selected-index == index ? Palette.accent-foreground : Theme.text;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                return reject;
            }
        }
        touch := TouchArea { clicked => { focus.focus(); root.selected(index); } }
    }
}

export component InfoTip inherits Rectangle {
    in property <string> text;
    width: 18px; height: 18px;
    border-radius: 9px;
    border-width: 1px;
    border-color: Theme.muted;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        text: "i";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Tooltip {
        // Slint wraps custom content in its own framed ToolTipImpl and sizes the
        // popup from the content's layout info. A fixed `width` is ignored there
        // (it would report the unwrapped text width), so constrain via min/max.
        Rectangle {
            min-width: 340px;
            max-width: 340px;
            background: Theme.card;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 10px;
                Text { text: root.text; color: Theme.text; wrap: word-wrap; }
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <length> size: 28px;
    callback clicked();
    width: root.size; height: root.size;
    border-radius: 6px;
    background: root.enabled && (touch.has-hover || focus.has-focus) ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.size * 0.55; height: self.width;
        source: root.icon;
        colorize: !root.enabled ? Theme.muted : root.danger ? Theme.error : Theme.text;
        opacity: root.enabled ? 1.0 : 0.4;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component Card inherits Rectangle {
    in property <bool> highlighted: false;
    background: Theme.card;
    border-width: 1px;
    border-radius: 10px;
    border-color: root.highlighted ? Palette.accent-background : Theme.border;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.hover;
    height: 22px;
    border-radius: 5px;
    background: root.fill;
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    }
}

export component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 600;
}

export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> info;
    spacing: 8px;
    alignment: stretch;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
            if root.info != "": VerticalLayout { alignment: center; InfoTip { text: root.info; } }
        }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
    }
    @children
}

export component PageTabs inherits HorizontalLayout {
    in property <[string]> labels;
    in property <int> selected;
    callback select(int);
    spacing: 6px;
    alignment: start;
    Text { text: @tr("Page"); color: Theme.muted; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    for label[index] in root.labels: Rectangle {
        height: 30px;
        min-width: 44px;
        border-radius: 6px;
        border-width: 1px;
        border-color: index == root.selected ? Palette.accent-background : focus.has-focus ? Theme.text : Theme.border;
        background: index == root.selected ? Theme.accent : touch.has-hover ? Theme.hover : transparent;
        accessible-role: tab;
        accessible-label: label;
        accessible-checked: index == root.selected;
        accessible-action-default => { root.select(index); }
        HorizontalLayout {
            padding-left: 12px; padding-right: 12px;
            Text { text: label; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" { root.select(index); return accept; }
                return reject;
            }
        }
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.select(index); } }
    }
}

export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text;
    callback confirm();
    callback cancel();
    background: #00000099;
    TouchArea { clicked => { root.cancel(); } }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Return { root.confirm(); return accept; }
            return reject;
        }
    }
    Rectangle {
        width: min(440px, root.width - 32px);
        height: dialog-layout.preferred-height;
        background: Theme.surface;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        TouchArea {}
        dialog-layout := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            Text { text: root.title; color: Theme.text; font-size: 16px; font-weight: 700; wrap: word-wrap; }
            Text { text: root.body; color: Theme.text; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                Button { text: root.confirm-text; primary: true; icon: @image-url("icons/trash-2.svg"); colorize-icon: true; clicked => { root.confirm(); } }
            }
        }
    }
}
