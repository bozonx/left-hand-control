import { TextField } from "controls.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { DragDrop, DragGroups, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { CategoryIcon } from "action-picker.slint";
import { InlineTextField, InlineTextArea, Card, Divider, ConfirmDialog, IconButton, InfoTip, FieldLabel, FormField } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { ActionKind, Assignment, LabelMode, LayerDialog, PickerCategory, PickerTarget } from "types.slint";
import { Button, HorizontalBox, TextEdit, Palette, VerticalBox } from "std-widgets.slint";

/// One slot of a hand grid. `index < 0` is an empty slot; otherwise it is the
/// layer key index passed back with `LayerDialog.edit-key`.
/// `holds`: the keystroke keeps its modifiers held until the layer is released.
export struct LayerKeyCell { index: int, label: string, code: string, kind: Assignment, action: string, icon: ActionKind, category: PickerCategory, emoji: bool, holds: bool }
export struct LayerExtraRow { key: string, kind: Assignment, action: string, icon: ActionKind, category: PickerCategory, holds: bool }

/// Layers of the layout being edited and their keymaps.
export global LayersEditor {
    in-out property <LabelMode> label-mode: LabelMode.label;
    in property <[string]> names;
    in-out property <int> selected: -1;
    in-out property <string> selected-id;
    in property <string> description;
    in property <[LayerKeyCell]> left-cells;
    in property <[LayerKeyCell]> right-cells;
    in property <[LayerExtraRow]> extras;
    in property <Message> status;
    in-out property <LayerDialog> dialog: LayerDialog.none;
    in-out property <int> dialog-index: -1;
    in-out property <Assignment> assignment: Assignment.transparent;
    in-out property <string> dialog-name;
    in-out property <string> dialog-description;
    in-out property <string> dialog-key;
    in-out property <string> dialog-action;
    in-out property <int> delete-extra: -1;
    callback refresh();
    callback choose(int);
    /// Open `dialog`; `index` is the key or extra row it edits, or -1.
    callback open-dialog(LayerDialog, int);
    callback apply-dialog();
    callback reorder(int, int);
    callback reorder-extra(int, int);
    /// Exchange the assignments of layer keys `from` and `to`.
    callback swap-keys(int, int);
    callback remove-extra(int);
    callback update-description(string);
    callback update-name(string);
    /// Why `name` cannot be used for a new layer or, when `renaming`, for the selected one.
    pure callback name-error(name: string, renaming: bool) -> Message;
    callback add-extra();
    callback pick-extra(int, bool);
}

/// Segmented keyboard view selector.
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> tooltips;
    in property <int> selected-index;
    callback selected(int);
    background: Theme.surface;
    border-radius: Theme.radius;
    HorizontalLayout {
        padding: Theme.space-2xs;
        spacing: Theme.space-2xs;
        for label[index] in root.labels: Rectangle {
            height: 28px;
            border-radius: Theme.radius-small;
            background: root.selected-index == index ? Theme.text : seg-touch.has-hover || seg-focus.has-focus ? Theme.hover : transparent;
            accessible-role: radio-button;
            accessible-label: label;
            accessible-checked: root.selected-index == index;
            accessible-action-default => { root.selected(index); }
            HorizontalLayout {
                padding-left: Theme.space-m-plus; padding-right: Theme.space-m-plus;
                Text {
                    text: label;
                    color: root.selected-index == index ? Theme.surface : Theme.text;
                    font-size: Theme.font-medium;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
            }
            seg-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                    if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                    if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                    return reject;
                }
            }
            seg-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected(index); } }
            if root.tooltips[index] != "": Tooltip {
                Rectangle {
                    background: Theme.card;
                    border-radius: Theme.radius-small;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout { padding: Theme.space-s; Text { text: root.tooltips[index]; color: Theme.text; font-size: Theme.font-body; } }
                }
            }
        }
    }
}

export component ActionText inherits HorizontalLayout {
    in property <Assignment> kind;
    in property <string> action;
    in property <PickerCategory> category;
    /// The action is emoji-only text, drawn with the colour emoji font.
    in property <bool> emoji;
    in property <length> text-size: 10px;
    in property <TextHorizontalAlignment> text-alignment: center;
    spacing: 3px;

    Text {
        min-width: 0px;
        horizontal-stretch: 1;
        text: root.kind == Assignment.transparent ? "" : root.kind == Assignment.swallow ? @tr("Suppress") : root.action;
        color: root.kind == Assignment.action ? Theme.text : Theme.muted;
        font-family: root.emoji ? "Noto Color Emoji" : "";
        font-size: root.emoji ? root.text-size + 3px : root.text-size;
        font-weight: root.kind == Assignment.transparent ? 400 : 500;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// Marks a layer key whose modifiers stay held until the layer is released.
component HoldsMarker inherits Rectangle {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: Theme.accent;
}

component ExtraFieldButton inherits Rectangle {
    in property <string> text;
    /// Shows the held-modifiers marker after the text.
    in property <bool> holds;
    callback clicked();
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.text : Theme.border;
    background: touch.has-hover || focus.has-focus ? Theme.hover : Theme.card;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.holds ? @tr("Keep modifiers held until the layer is released") : "";
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: Theme.space-m-plus; padding-right: Theme.space-m-plus;
        spacing: Theme.space-s;
        Text { min-width: 0px; horizontal-stretch: 1; text: root.text; color: Theme.text; font-size: Theme.font-medium; vertical-alignment: center; overflow: elide; }
        if root.holds: VerticalLayout { alignment: center; HoldsMarker { } }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    if root.holds: Tooltip {
        Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-small;
            HorizontalLayout { padding: Theme.space-m; spacing: Theme.space-s; VerticalLayout { alignment: center; HoldsMarker { } } Text { text: @tr("Keep modifiers held until the layer is released"); color: Theme.text; } }
        }
    }
}

// The row itself is the TouchArea, so it keeps `has-hover` while the pointer is over one of
// its buttons; a sibling TouchArea would lose hover there and make the buttons flicker.
component ExtraKeyLine inherits TouchArea {
    in property <int> index;
    in property <LayerExtraRow> item;
    opacity: DragDrop.dragging && DragDrop.group == DragGroups.extra-keys && DragDrop.source == root.index ? Theme.dragged-opacity : 1;
    Rectangle { background: root.has-hover ? Theme.hover.transparentize(0.6) : transparent; }
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-l;
            ExtraFieldButton { width: 200px; text: root.item.key; clicked => { LayersEditor.pick-extra(root.index, true); } }
            ExtraFieldButton {
                horizontal-stretch: 1;
                min-width: 0px;
                holds: root.item.holds && root.item.kind == Assignment.action;
                text: root.item.kind == Assignment.transparent ? @tr("Normal key behavior") : root.item.kind == Assignment.swallow ? @tr("Suppress") : root.item.action;
                clicked => { LayersEditor.pick-extra(root.index, false); }
            }
            VerticalLayout {
                width: 28px;
                alignment: center;
                DragHandle {
                    opacity: root.has-hover || (DragDrop.group == DragGroups.extra-keys && DragDrop.source == root.index) ? 1 : 0;
                    group: DragGroups.extra-keys; index: root.index; count: LayersEditor.extras.length;
                    dropped(from, to) => { LayersEditor.reorder-extra(from, to); }
                }
            }
            VerticalLayout {
                width: 32px;
                alignment: center;
                IconButton {
                    // Opacity instead of `visible`: the button stays focusable from the keyboard.
                    opacity: root.has-hover ? 1 : 0;
                    icon: @image-url("icons/trash-2.svg");
                    tooltip: @tr("Remove trigger");
                    clicked => { LayersEditor.delete-extra = root.index; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.divider; }
    }
    DropMarker { width: parent.width; group: DragGroups.extra-keys; index: root.index; row-y: root.y; row-height: root.height; }
}

component KeyCap inherits Rectangle {
    in property <LayerKeyCell> cell;
    in property <LabelMode> label-mode;
    /// Layer key index under the pointer while a key is dragged, or -1.
    in property <int> drop-target: -1;
    callback clicked();
    callback dropped(int, int);
    private property <bool> dragged: DragDrop.dragging && DragDrop.group == DragGroups.keys && DragDrop.source == root.cell.index;
    private property <bool> drop-over: DragDrop.dragging && DragDrop.group == DragGroups.keys && root.drop-target == root.cell.index && !root.dragged;
    border-radius: Theme.radius;
    border-width: root.drop-over ? 2px : 1px;
    border-color: root.drop-over ? Theme.link : (touch.has-hover && !DragDrop.dragging) || focus.has-focus ? Theme.muted : Theme.border;
    background: root.drop-over ? Theme.hover : Theme.surface;
    opacity: root.dragged ? Theme.dragged-opacity : 1;
    accessible-role: button;
    accessible-label: root.cell.label;
    accessible-description: root.cell.kind == Assignment.transparent ? @tr("Inherit") : root.cell.kind == Assignment.swallow ? @tr("Suppress") : root.cell.holds ? root.cell.action + ". " + @tr("Keep modifiers held until the layer is released") : root.cell.action;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding: Theme.space-xs;
        spacing: 3px;
        alignment: center;
        Text {
            min-width: 0px;
            text: root.label-mode == LabelMode.label ? root.cell.label : root.cell.code;
            color: Theme.link;
            font-size: Theme.font-medium;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            ActionText { min-width: 0px; kind: root.cell.kind; action: root.cell.action; category: root.cell.category; emoji: root.cell.emoji; }
        }
    }
    if root.cell.holds && root.cell.kind == Assignment.action: HoldsMarker { x: parent.width - self.width - 4px; y: 4px; }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: DragDrop.dragging && self.pressed ? grabbing : pointer;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                DragDrop.reset(); DragDrop.group = DragGroups.keys; DragDrop.source = root.cell.index; DragDrop.target = root.cell.index;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && DragDrop.group == DragGroups.keys {
                let from = DragDrop.source; let to = root.drop-target; let moved = DragDrop.dragging;
                DragDrop.reset();
                if moved { if to >= 0 && to != from { root.dropped(from, to); } }
                else if self.has-hover { root.clicked(); }
            }
            if event.kind == PointerEventKind.cancel { DragDrop.reset(); }
        }
        // While the key holds the grab, the wheel comes here instead of the ScrollView.
        scroll-event(event) => {
            if DragDrop.dragging && DragDrop.group == DragGroups.keys { DragDrop.request-scroll(event.delta-y); return accept; }
            reject
        }
        moved => {
            if self.pressed && DragDrop.group == DragGroups.keys {
                DragDrop.pointer-x = self.absolute-position.x + self.mouse-x;
                DragDrop.pointer-y = self.absolute-position.y + self.mouse-y;
                if abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px { DragDrop.dragging = true; }
            }
        }
    }
    if root.cell.kind == Assignment.action: Tooltip {
        Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-small;
            VerticalLayout { padding: Theme.space-m; spacing: Theme.space-s;
                HorizontalLayout { spacing: Theme.space-s; CategoryIcon { category: root.cell.category; } Text { text: root.cell.action; color: Theme.text; } }
                if root.cell.holds: HorizontalLayout { spacing: Theme.space-s; VerticalLayout { alignment: center; HoldsMarker { } } Text { text: @tr("Keep modifiers held until the layer is released"); color: Theme.muted; } }
            }
        }
    }
}

component HandGrid inherits VerticalLayout {
    in property <string> title;
    in property <[LayerKeyCell]> cells;
    in property <int> columns;
    in property <LabelMode> label-mode;
    in property <int> drop-target: -1;
    callback edit(int);
    callback dropped(int, int);
    private property <length> cell-width: (root.width - (root.columns - 1) * 6px) / root.columns;
    /// Layer key index at window position (`x`, `y`), or -1 outside the keys.
    public pure function key-at(x: length, y: length) -> int {
        let local-x = x - root.absolute-position.x;
        let local-y = y - root.absolute-position.y - title.height - 6px;
        if local-x < 0px || local-y < 0px || local-x >= root.width { return -1; }
        let col = floor(local-x / (root.cell-width + 6px));
        let row = floor(local-y / 52px);
        if row >= root.cells.length / root.columns { return -1; }
        return root.cells[row * root.columns + col].index;
    }
    horizontal-stretch: root.columns;
    preferred-width: 0px;
    min-width: 0px;
    spacing: Theme.space-s;
    title := Text {
        text: root.title.to-uppercase();
        color: Theme.muted;
        font-size: Theme.font-small;
        letter-spacing: 0.5px;
    }
    for row in root.cells.length / root.columns: HorizontalLayout {
        spacing: Theme.space-s;
        for col in root.columns: Rectangle {
            height: 46px;
            width: root.cell-width;
            horizontal-stretch: 0;
            if root.cells[row * root.columns + col].index >= 0: KeyCap {
                width: parent.width;
                height: parent.height;
                cell: root.cells[row * root.columns + col];
                label-mode: root.label-mode;
                drop-target: root.drop-target;
                clicked => { root.edit(self.cell.index); }
                dropped(from, to) => { root.dropped(from, to); }
            }
        }
    }
}

export component LayersPage inherits VerticalLayout {
    padding: 0px;
    in-out property <LabelMode> label-mode <=> LayersEditor.label-mode;


    vertical-stretch: 1;
    spacing: Theme.space-xl;
    HorizontalLayout {
        padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
        ScrollView { height: 52px; viewport-height: self.visible-height; vertical-scrollbar-policy: always-off; horizontal-scrollbar-policy: as-needed;
            HorizontalLayout { spacing: Theme.space-s; alignment: start;
                for name[index] in LayersEditor.names: Rectangle {
                    height: 36px; border-radius: Theme.radius; border-width: 1px;
                    border-color: DragDrop.dragging && DragDrop.group == DragGroups.layer-tabs && DragDrop.target == index ? Theme.link : Theme.border;
                    background: index == LayersEditor.selected ? Theme.selected : layer-touch.has-hover ? Theme.hover : Theme.card;
                    opacity: DragDrop.dragging && DragDrop.group == DragGroups.layer-tabs && DragDrop.source == index ? Theme.dragged-opacity : 1;
                    init => { DragDrop.row(DragGroups.layer-tabs, index, self.x, self.width); }
                    changed x => { DragDrop.row(DragGroups.layer-tabs, index, self.x, self.width); }
                    changed width => { DragDrop.row(DragGroups.layer-tabs, index, self.x, self.width); }
                    accessible-role: button;
                    accessible-label: name;
                    accessible-action-default => { LayersEditor.choose(index); }
                    HorizontalLayout {
                        padding-left: Theme.space-l; padding-right: Theme.space-l;
                        Text { text: name; color: Theme.text; font-size: Theme.font-medium; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                    }
                    FocusScope {
                        key-pressed(event) => {
                            if event.text == " " || event.text == "\n" { LayersEditor.choose(index); return accept; }
                            return reject;
                        }
                    }
                    layer-touch := TouchArea {
                        mouse-cursor: DragDrop.dragging && self.pressed ? grabbing : pointer;
                        pointer-event(event) => {
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                DragDrop.group = DragGroups.layer-tabs; DragDrop.source = index; DragDrop.target = index;
                            }
                            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && DragDrop.group == DragGroups.layer-tabs {
                                let from = DragDrop.source; let to = DragDrop.target; let moved = DragDrop.dragging;
                                DragDrop.reset();
                                if moved { if from != to { LayersEditor.reorder(from, to); } }
                                else { LayersEditor.choose(index); }
                            }
                            if event.kind == PointerEventKind.cancel { DragDrop.reset(); }
                        }
                        moved => {
                            if self.pressed && DragDrop.group == DragGroups.layer-tabs {
                                DragDrop.offset = self.mouse-x - self.pressed-x;
                                if abs(DragDrop.offset) > 6px { DragDrop.dragging = true; }
                                if DragDrop.dragging { DragDrop.target = DragDrop.locate(DragGroups.layer-tabs, index, DragDrop.offset, LayersEditor.names.length); }
                            }
                        }
                    }
                    if DragDrop.dragging && DragDrop.group == DragGroups.layer-tabs && DragDrop.target == index && DragDrop.target != DragDrop.source: Rectangle {
                        x: DragDrop.target > DragDrop.source ? parent.width + 1px : -4px;
                        width: 3px; height: parent.height; background: Theme.link;
                    }
                }
                VerticalLayout { height: 36px; alignment: center;
                    IconButton { icon: @image-url("icons/plus.svg"); tooltip: @tr("Create new layer"); primary: true; clicked => { LayersEditor.open-dialog(LayerDialog.create, -1); } }
                }
            }
        }
    }
    ScrollView {
        drag-scroll: true;
        viewport-width: self.visible-width;
        vertical-stretch: 1;
        PageContent {
            spacing: Theme.space-xl;
            // Layer toolbar
            Card {
                VerticalLayout {
                    padding: Theme.space-2xl;
                    spacing: Theme.space-l;
                    HorizontalLayout {
                        spacing: Theme.space-l;
                        Text { horizontal-stretch: 0; text: @tr("Layer") + ":"; color: Theme.text; font-size: Theme.font-medium; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            InlineTextField {
                                horizontal-stretch: 1; min-width: 0px;
                                text: LayersEditor.selected >= 0 ? LayersEditor.names[LayersEditor.selected] : @tr("No layers yet");
                                label: @tr("Name"); text-size: 13px; text-weight: 600;
                                validate(value) => { return LayersEditor.name-error(value, true); }
                                saved(value) => { LayersEditor.update-name(value); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 36px; height: 32px;
                            Button {
                                width: parent.width; height: parent.height; text: "…";
                                enabled: LayersEditor.selected >= 0;
                                clicked => { layer-menu.show(); }
                            }
                            layer-menu := PopupWindow {
                                x: parent.width - self.width; y: parent.height;
                                width: 180px;
                                Rectangle {
                                    background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: Theme.radius-large;
                                    VerticalLayout { padding: Theme.space-xs; spacing: 0px;
                                        IconButton { height: 36px; icon: @image-url("icons/copy.svg"); text: @tr("Duplicate"); clicked => { layer-menu.close(); LayersEditor.open-dialog(LayerDialog.duplicate, -1); } }
                                        IconButton { height: 36px; icon: @image-url("icons/trash-2.svg"); text: @tr("Delete layer"); clicked => { layer-menu.close(); LayersEditor.open-dialog(LayerDialog.delete, -1); } }
                                    }
                                }
                            }
                        }
                    }
                    if LayersEditor.selected >= 0: InlineTextArea {
                        text: LayersEditor.description; placeholder: @tr("Add description"); label: @tr("Layer description");
                        text-color: Theme.muted;
                        saved(value) => { LayersEditor.update-description(value); }
                    }

                }
            }

            if LayersEditor.selected < 0: Card {
                HorizontalLayout {
                    padding: Theme.space-2xl;
                    spacing: Theme.space-l;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: Theme.space-xs;
                        Text { text: @tr("No layers yet"); color: Theme.text; font-size: Theme.font-default; font-weight: Theme.weight-semibold; }
                        Text { text: @tr("Create a layer to assign its keys."); color: Theme.muted; wrap: word-wrap; }
                    }

                }
            }

            // Keyboard
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-2xl; padding-right: Theme.space-2xl; padding-top: Theme.space-l-plus; padding-bottom: Theme.space-l-plus;
                        spacing: Theme.space-m;
                        Text { text: @tr("Keyboard"); color: Theme.text; font-size: Theme.font-section; font-weight: Theme.weight-bold; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            InfoTip { text: @tr("Display modes affect labels only — the key code stays the same. “US layout” shows standard letter labels for visual reference. “LHC codes” shows app-specific codes (e.g. KeyA, ArrowLeft)."); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Segmented {
                            labels: [@tr("US layout"), @tr("LHC codes")];
                            tooltips: [@tr("Show standard QWERTY letter labels for visual reference."), @tr("Show internal key codes used in Left Hand Control profiles (e.g. KeyA, ArrowLeft).")];
                            selected-index: root.label-mode == LabelMode.code ? 1 : 0;
                            selected(index) => { root.label-mode = index == 1 ? LabelMode.code : LabelMode.label; }
                        }
                    }
                    Divider {}
                    hands := HorizontalLayout {
                        // Recomputed from the window position, so it follows auto-scroll under a still pointer.
                        property <int> key-target: !DragDrop.dragging || DragDrop.group != DragGroups.keys ? -1
                            : max(left-hand.key-at(DragDrop.pointer-x, DragDrop.pointer-y), right-hand.key-at(DragDrop.pointer-x, DragDrop.pointer-y));
                        padding: Theme.space-2xl;
                        spacing: Theme.space-3xl;
                        left-hand := HandGrid {
                            width: (root.width - 16px - 40px - 24px) / 2;
                            horizontal-stretch: 0;
                            title: @tr("Left hand");
                            cells: LayersEditor.left-cells;
                            columns: 6;
                            label-mode: root.label-mode;
                            drop-target: hands.key-target;
                            edit(index) => { LayersEditor.open-dialog(LayerDialog.edit-key, index); }
                            dropped(from, to) => { LayersEditor.swap-keys(from, to); }
                        }
                        right-hand := HandGrid {
                            width: (root.width - 16px - 40px - 24px) / 2;
                            horizontal-stretch: 0;
                            title: @tr("Right hand");
                            cells: LayersEditor.right-cells;
                            columns: 6;
                            label-mode: root.label-mode;
                            drop-target: hands.key-target;
                            edit(index) => { LayersEditor.open-dialog(LayerDialog.edit-key, index); }
                            dropped(from, to) => { LayersEditor.swap-keys(from, to); }
                        }
                    }
                }
            }

            // Extra keys
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-2xl; padding-right: Theme.space-2xl; padding-top: Theme.space-l-plus; padding-bottom: Theme.space-l-plus;
                        spacing: Theme.space-m;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.space-2xs;
                            HorizontalLayout { spacing: Theme.space-m; alignment: start;
                                Text { text: @tr("Extra keys"); color: Theme.text; font-size: Theme.font-section; font-weight: Theme.weight-bold; }
                                InfoTip { text: @tr("Mouse buttons, media keys, and other triggers outside the main keyboard grid. Add a trigger, then choose its action, suppress it, or inherit its assignment from the lower layer."); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/plus.svg");
                                text: @tr("Add");
                                primary: true;
                                clicked => { LayersEditor.add-extra(); }
                            }
                        }
                    }
                    Divider {}
                    VerticalLayout {
                        padding: Theme.space-2xl;
                        spacing: 0px;
                        if LayersEditor.extras.length == 0: Text { text: @tr("No extra keys for this layer yet."); color: Theme.muted; }
                        if LayersEditor.extras.length > 0: HorizontalLayout {
                            padding: Theme.space-m;
                            spacing: Theme.space-l;
                            FieldLabel { width: 200px; text: @tr("Key"); }
                            FieldLabel { horizontal-stretch: 1; text: @tr("Action"); }
                            Rectangle { width: 28px; }
                            Rectangle { width: 32px; }
                        }
                        if LayersEditor.extras.length > 0: Rectangle { height: 1px; background: Theme.divider; }
                        for extra[index] in LayersEditor.extras: ExtraKeyLine {
                            index: index;
                            item: extra;
                        }
                    }
                }
            }
        }
    }
}

export component LayerDialogOverlay inherits FocusScope {
    focus-on-tab-navigation: false;
    enabled: (LayersEditor.dialog != LayerDialog.none || LayersEditor.delete-extra >= 0) && !ActionPicker.opened;
    key-pressed(event) => { if event.text == Key.Escape { LayersEditor.dialog = LayerDialog.none; LayersEditor.delete-extra = -1; return accept; } return reject; }
    if LayersEditor.dialog != LayerDialog.none && LayersEditor.dialog != LayerDialog.delete: Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { LayersEditor.dialog = LayerDialog.none; } scroll-event(event) => { accept } }
        Rectangle { x: (parent.width - self.width) / 2; y: 60px; width: min(parent.width - 80px, 560px); height: min(parent.height - 120px, 500px); background: Theme.surface; border-color: Theme.border; border-width: 1px; border-radius: Theme.radius-dialog;
            TouchArea {}
            VerticalBox { padding: Theme.space-2xl; spacing: Theme.space-l;
                HorizontalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                    Text { wrap: word-wrap; horizontal-stretch: 1; min-width: 0px;
                        text: LayersEditor.dialog == LayerDialog.create ? @tr("New layer")
                        : LayersEditor.dialog == LayerDialog.duplicate ? @tr("Duplicate layer")
                        : LayersEditor.dialog == LayerDialog.delete ? @tr("Delete layer?")
                        : @tr("Edit layer key");
                        color: Theme.text; font-size: Theme.font-title; font-weight: Theme.weight-bold;
                    }
                    IconButton { icon: @image-url("icons/x.svg"); tooltip: @tr("Close"); clicked => { LayersEditor.dialog = LayerDialog.none; } }
                }
                if LayersEditor.dialog == LayerDialog.create || LayersEditor.dialog == LayerDialog.duplicate: VerticalBox { spacing: Theme.space-m;
                    FormField {
                        label: @tr("Name"); autofocus: true;
                        text <=> LayersEditor.dialog-name;
                        error: LayersEditor.name-error(LayersEditor.dialog-name, false);
                        accepted => { if LayersEditor.name-error(LayersEditor.dialog-name, false).id == "" { LayersEditor.apply-dialog(); } }
                    }
                    Text { text: @tr("Description"); color: Theme.text; }
                    TextEdit { text <=> LayersEditor.dialog-description; height: 100px; }
                }
                if LayersEditor.dialog == LayerDialog.delete: Text { text: @tr("Rules using this layer will return to the base layer."); color: Theme.muted; wrap: word-wrap; }
                if LayersEditor.dialog == LayerDialog.edit-key: VerticalBox { spacing: Theme.space-m;
                    Text { text: @tr("Behavior"); color: Theme.muted; }
                    HorizontalBox { spacing: Theme.space-m;
                        Button { text: @tr("Inherit"); primary: LayersEditor.assignment == Assignment.transparent; clicked => { LayersEditor.assignment = Assignment.transparent; } }
                        Button { text: @tr("Suppress"); primary: LayersEditor.assignment == Assignment.swallow; clicked => { LayersEditor.assignment = Assignment.swallow; } }
                        Button { text: @tr("Perform action"); primary: LayersEditor.assignment == Assignment.action; clicked => { LayersEditor.assignment = Assignment.action; } }
                    }
                    if LayersEditor.assignment != Assignment.action: Text {
                        text: LayersEditor.assignment == Assignment.swallow ? @tr("The key will not reach the application.") : @tr("Use the assignment from the lower layer or base layout."); color: Theme.muted; wrap: word-wrap;
                    }
                    if LayersEditor.assignment == Assignment.action: VerticalBox {
                        padding: 0px; spacing: Theme.space-xs; vertical-stretch: 0;
                        Text { text: @tr("Action"); color: Theme.text; }
                        HorizontalBox { vertical-stretch: 0; spacing: Theme.space-m;
                            TextField { text <=> LayersEditor.dialog-action; placeholder-text: @tr("Action code"); horizontal-stretch: 1; }
                            Button { text: @tr("Choose action"); clicked => { ActionPicker.open(PickerTarget.layer-action, 0, LayersEditor.dialog-action, false); } }
                        }
                    }
                }
                Text { text: Locale.text(LayersEditor.status); color: Theme.error; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox { vertical-stretch: 0; spacing: Theme.space-m;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { LayersEditor.dialog = LayerDialog.none; } }
                    Button { text: LayersEditor.dialog == LayerDialog.delete ? @tr("Delete") : @tr("Apply"); primary: true; enabled: ((LayersEditor.dialog != LayerDialog.create && LayersEditor.dialog != LayerDialog.duplicate) || LayersEditor.name-error(LayersEditor.dialog-name, false).id == "") && (LayersEditor.dialog != LayerDialog.edit-key || LayersEditor.assignment != Assignment.action || LayersEditor.dialog-action != ""); clicked => { LayersEditor.apply-dialog(); } }
                }
            }
        }
    }
    if LayersEditor.dialog == LayerDialog.delete: ConfirmDialog {
        title: @tr("Delete layer?"); body: @tr("Rules using this layer will return to the base layer."); confirm-text: @tr("Delete");
        confirm => { LayersEditor.apply-dialog(); } cancel => { LayersEditor.dialog = LayerDialog.none; }
    }

    if LayersEditor.delete-extra >= 0: ConfirmDialog {
        title: @tr("Delete extra key?"); body: @tr("This key assignment will be removed from the layer."); confirm-text: @tr("Delete");
        confirm => { LayersEditor.remove-extra(LayersEditor.delete-extra); LayersEditor.delete-extra = -1; }
        cancel => { LayersEditor.delete-extra = -1; }
    }

}
