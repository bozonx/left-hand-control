import { ScrollView } from "scroll.slint";
import { DragDrop, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { InlineTextField, InlineTextArea, Card, Divider, ConfirmDialog, IconButton, InfoTip } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { ActionKind, Assignment, LayerDialog, PickerTarget } from "types.slint";
import { Button, ComboBox, HorizontalBox, LineEdit, Palette, VerticalBox } from "std-widgets.slint";

/// One slot of a hand grid. `index < 0` is an empty slot; otherwise it is the
/// layer key index passed back with `LayerDialog.edit-key`.
export struct LayerKeyCell { index: int, label: string, code: string, numeric: string, kind: Assignment, action: string, icon: ActionKind }
export struct LayerExtraRow { key: string, kind: Assignment, action: string, icon: ActionKind }

/// Layers of the layout being edited and their keymaps.
export global LayersEditor {
    in-out property <int> label-mode;
    callback set-label-mode(int);
    in property <[string]> names;
    in-out property <int> selected: -1;
    in-out property <string> selected-id;
    in property <string> description;
    in property <[LayerKeyCell]> left-cells;
    in property <[LayerKeyCell]> right-cells;
    in property <[LayerExtraRow]> extras;
    in property <Message> status;
    in-out property <LayerDialog> dialog: LayerDialog.none;
    in-out property <int> dialog-index: -1;
    in-out property <Assignment> assignment: Assignment.transparent;
    in-out property <string> dialog-name;
    in-out property <string> dialog-description;
    in-out property <string> dialog-key;
    in-out property <string> dialog-action;
    callback refresh();
    callback choose(int);
    /// Open `dialog`; `index` is the key or extra row it edits, or -1.
    callback open-dialog(LayerDialog, int);
    callback apply-dialog();
    callback move-extra(int, int);
    callback reorder(int, int);
    callback remove-extra(int);
    callback update-description(string);
    callback update-name(string);
    callback add-extra();
    callback update-extra-key(int, string);
    callback pick-extra(int, bool);
}

component ActionIcon inherits Image {
    in property <ActionKind> kind;
    width: 12px;
    height: 12px;
    source: kind == ActionKind.keys ? @image-url("icons/keyboard.svg")
        : kind == ActionKind.macro ? @image-url("icons/zap.svg")
        : kind == ActionKind.command ? @image-url("icons/terminal.svg")
        : kind == ActionKind.system ? @image-url("icons/settings-2.svg")
        : kind == ActionKind.app ? @image-url("icons/app-window.svg")
        : @image-url("icons/text-cursor-input.svg");
}

/// Segmented switch in the style of the Tauri keyboard view selector.
component Segmented inherits Rectangle {
    in property <[string]> labels;
    in property <int> selected-index;
    callback selected(int);
    background: Theme.surface;
    border-radius: 6px;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for label[index] in root.labels: Rectangle {
            height: 28px;
            border-radius: 4px;
            background: root.selected-index == index ? Theme.text : seg-touch.has-hover || seg-focus.has-focus ? Theme.hover : transparent;
            accessible-role: radio-button;
            accessible-label: label;
            accessible-checked: root.selected-index == index;
            accessible-action-default => { root.selected(index); }
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                Text {
                    text: label;
                    color: root.selected-index == index ? Theme.surface : Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            seg-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                    if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                    if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                    return reject;
                }
            }
            seg-touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected(index); } }
        }
    }
}

component ActionText inherits HorizontalLayout {
    in property <Assignment> kind;
    in property <string> action;
    in property <ActionKind> icon;
    in property <length> text-size: 10px;
    in property <TextHorizontalAlignment> text-alignment: center;
    spacing: 3px;
    if root.kind != Assignment.transparent && root.icon != ActionKind.none: VerticalLayout {
        alignment: center;
        ActionIcon { kind: root.icon; colorize: Theme.link; }
    }
    Text {
        min-width: 0px;
        horizontal-stretch: 1;
        text: root.kind == Assignment.transparent ? "—" : root.kind == Assignment.swallow ? @tr("Ignore key") : root.action;
        color: root.kind == Assignment.transparent ? Theme.muted : Theme.link;
        font-size: root.text-size;
        font-weight: root.kind == Assignment.transparent ? 400 : 500;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        overflow: elide;
    }
}

component KeyCap inherits Rectangle {
    in property <LayerKeyCell> cell;
    in property <int> label-mode;
    callback clicked();
    border-radius: 6px;
    border-width: 1px;
    border-color: touch.has-hover || focus.has-focus ? Theme.muted : Theme.border;
    background: Theme.surface;
    accessible-role: button;
    accessible-label: root.cell.label;
    accessible-description: root.cell.kind == Assignment.transparent ? "" : root.cell.kind == Assignment.swallow ? @tr("Ignore key") : root.cell.action;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding: 4px;
        spacing: 3px;
        alignment: center;
        Text {
            min-width: 0px;
            text: root.label-mode == 0 ? root.cell.label : root.label-mode == 1 ? root.cell.code : root.cell.numeric;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: center;
            ActionText { min-width: 0px; kind: root.cell.kind; action: root.cell.action; icon: root.cell.icon; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component HandGrid inherits VerticalLayout {
    in property <string> title;
    in property <[LayerKeyCell]> cells;
    in property <int> columns;
    in property <int> label-mode;
    callback edit(int);
    horizontal-stretch: root.columns;
    preferred-width: 0px;
    min-width: 0px;
    spacing: 6px;
    Text {
        text: root.title.to-uppercase();
        color: Theme.muted;
        font-size: 11px;
        letter-spacing: 0.5px;
    }
    for row in root.cells.length / root.columns: HorizontalLayout {
        spacing: 6px;
        for col in root.columns: Rectangle {
            height: 46px;
            min-width: 0px;
            horizontal-stretch: 1;
            if root.cells[row * root.columns + col].index >= 0: KeyCap {
                width: parent.width;
                height: parent.height;
                cell: root.cells[row * root.columns + col];
                label-mode: root.label-mode;
                clicked => { root.edit(self.cell.index); }
            }
        }
    }
}

export component LayersPage inherits VerticalLayout {
    in-out property <int> label-mode <=> LayersEditor.label-mode;

    private property <string> test-text;

    vertical-stretch: 1;
    ScrollView {
        viewport-width: self.visible-width;
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 16px;
            ScrollView { height: 52px; viewport-height: self.visible-height; vertical-scrollbar-policy: always-off; horizontal-scrollbar-policy: as-needed;
                HorizontalLayout { spacing: 6px; alignment: start;
                    for name[index] in LayersEditor.names: Rectangle {
                        height: 36px; border-radius: 6px; border-width: 1px;
                        border-color: DragDrop.dragging && DragDrop.group == 2 && DragDrop.target == index ? Theme.link : Theme.border;
                        background: index == LayersEditor.selected ? Theme.accent : Theme.card;
                        opacity: DragDrop.dragging && DragDrop.group == 2 && DragDrop.source == index ? 0.6 : 1;
                        init => { DragDrop.row(2, index, self.x, self.width); }
                        changed x => { DragDrop.row(2, index, self.x, self.width); }
                        changed width => { DragDrop.row(2, index, self.x, self.width); }
                        HorizontalLayout { padding: 4px; spacing: 4px;
                            DragHandle { horizontal: true; group: 2; index: index; count: LayersEditor.names.length; dropped(from, to) => { LayersEditor.reorder(from, to); } }
                            Button { text: name; primary: index == LayersEditor.selected; clicked => { LayersEditor.choose(index); } }
                        }
                        if DragDrop.dragging && DragDrop.group == 2 && DragDrop.target == index && DragDrop.target != DragDrop.source: Rectangle {
                            x: DragDrop.target > DragDrop.source ? parent.width + 1px : -4px;
                            width: 3px; height: parent.height; background: Theme.link;
                        }
                    }
                }
            }
            // Layer toolbar
            Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 6px;
                            Text { text: @tr("Layer"); color: Theme.text; font-size: 13px; }
                            HorizontalLayout {
                                spacing: 4px;
                                InlineTextField {
                                    horizontal-stretch: 1;
                                    text: LayersEditor.selected >= 0 ? LayersEditor.names[LayersEditor.selected] : @tr("No layers yet");
                                    label: @tr("Name"); text-weight: 600;
                                    saved(value) => { LayersEditor.update-name(value); }
                                }
                                IconButton {
                                    icon: @image-url("icons/trash-2.svg");
                                    tooltip: @tr("Delete layer");
                                    enabled: LayersEditor.selected >= 0;
                                    clicked => { LayersEditor.open-dialog(LayerDialog.delete, -1); }
                                }
                                IconButton {
                                    icon: @image-url("icons/copy.svg");
                                    text: @tr("Duplicate");
                                    enabled: LayersEditor.selected >= 0;
                                    clicked => { LayersEditor.open-dialog(LayerDialog.duplicate, -1); }
                                }
                            }
                        }
                        HorizontalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            spacing: 4px;
                            VerticalLayout {
                                alignment: end;
                                LineEdit {
                                    width: 200px;
                                    text <=> root.test-text;
                                    placeholder-text: @tr("Type to test...");
                                }
                            }
                            VerticalLayout {
                                alignment: end;
                                IconButton {
                                    icon: @image-url("icons/x.svg");
                                    tooltip: @tr("Clear");
                                    enabled: root.test-text != "";
                                    clicked => { root.test-text = ""; }
                                }
                            }
                            Rectangle { width: 4px; }
                            VerticalLayout {
                                alignment: end;
                                IconButton {
                                    icon: @image-url("icons/plus.svg");
                                    text: @tr("New layer");
                                    tooltip: @tr("Create new layer");
                                    primary: true;
                                    clicked => { LayersEditor.open-dialog(LayerDialog.create, -1); }
                                }
                            }
                        }
                    }
                    if LayersEditor.selected >= 0: InlineTextArea {
                        text: LayersEditor.description; placeholder: @tr("Add description"); label: @tr("Layer description");
                        text-color: Theme.muted;
                        saved(value) => { LayersEditor.update-description(value); }
                    }

                }
            }

            if LayersEditor.selected < 0: Card {
                HorizontalLayout {
                    padding: 20px;
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: @tr("No layers yet"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text { text: @tr("Create a layer to assign its keys."); color: Theme.muted; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/plus.svg");
                            text: @tr("New layer");
                            primary: true;
                            clicked => { LayersEditor.open-dialog(LayerDialog.create, -1); }
                        }
                    }
                }
            }

            // Keyboard
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; padding-top: 14px; padding-bottom: 14px;
                        spacing: 8px;
                        Text { text: @tr("Keyboard"); color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            InfoTip { text: @tr("Display modes affect labels only — the key code stays the same. “US layout” shows standard letter labels for visual reference. “Internal codes” shows app-specific codes (e.g. KeyA, ArrowLeft). “System codes” shows raw system event codes."); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/eraser.svg");
                                text: @tr("Clear");
                                tooltip: @tr("Clears key bindings only. Extra keys are not affected.");
                                clicked => { LayersEditor.open-dialog(LayerDialog.clear-keys, -1); }
                            }
                        }
                        Segmented {
                            labels: [@tr("US layout"), @tr("Internal codes"), @tr("System codes")];
                            selected-index: root.label-mode;
                            selected(index) => { LayersEditor.set-label-mode(index); }
                        }
                    }
                    Divider {}
                    HorizontalLayout {
                        padding: 20px;
                        spacing: 24px;
                        HandGrid {
                            width: (root.width - 16px - 40px - 24px - 72px) / 14 * 6 + 30px;
                            horizontal-stretch: 0;
                            title: @tr("Left hand");
                            cells: LayersEditor.left-cells;
                            columns: 6;
                            label-mode: root.label-mode;
                            edit(index) => { LayersEditor.open-dialog(LayerDialog.edit-key, index); }
                        }
                        HandGrid {
                            width: (root.width - 16px - 40px - 24px - 72px) / 14 * 8 + 42px;
                            horizontal-stretch: 0;
                            title: @tr("Right hand");
                            cells: LayersEditor.right-cells;
                            columns: 8;
                            label-mode: root.label-mode;
                            edit(index) => { LayersEditor.open-dialog(LayerDialog.edit-key, index); }
                        }
                    }
                }
            }

            // Extra keys
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: 20px; padding-right: 20px; padding-top: 14px; padding-bottom: 14px;
                        spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text { text: @tr("Extra keys"); color: Theme.text; font-size: 15px; font-weight: 700; }
                            Text { text: @tr("Mouse buttons, media keys, and other triggers outside the main keyboard grid."); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        }
                        if LayersEditor.extras.length > 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/eraser.svg");
                                text: @tr("Clear");
                                clicked => { LayersEditor.open-dialog(LayerDialog.clear-extras, -1); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/plus.svg");
                                text: @tr("Add");
                                primary: true;
                                clicked => { LayersEditor.add-extra(); }
                            }
                        }
                    }
                    Divider {}
                    VerticalLayout {
                        padding: 20px;
                        spacing: 8px;
                        if LayersEditor.extras.length == 0: Text { text: @tr("No extra keys for this layer yet."); color: Theme.muted; }
                        for extra[index] in LayersEditor.extras: Rectangle {
                            opacity: DragDrop.dragging && DragDrop.group == 3 && DragDrop.source == index ? 0.6 : 1;

                            background: extra-touch.has-hover ? Theme.hover : Theme.surface;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            extra-touch := TouchArea { mouse-cursor: pointer; clicked => { LayersEditor.pick-extra(index, false); } }
                            HorizontalLayout {
                                padding: 10px;
                                padding-left: 14px;
                                spacing: 16px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    spacing: 2px;
                                    Text { text: @tr("Key"); color: Theme.muted; font-size: 11px; }
                                    Button { text: extra.key; clicked => { LayersEditor.pick-extra(index, true); } }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    spacing: 2px;
                                    Text { text: @tr("Action"); color: Theme.muted; font-size: 11px; }
                                    Rectangle {
                                        ActionText { kind: extra.kind; action: extra.action; icon: extra.icon; text-size: 13px; text-alignment: left; }
                                        TouchArea { mouse-cursor: pointer; clicked => { LayersEditor.pick-extra(index, false); } }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 2px;
                                    VerticalLayout { alignment: center;
                                        IconButton { icon: @image-url("icons/pencil.svg"); tooltip: @tr("Edit"); clicked => { LayersEditor.pick-extra(index, false); } }
                                    }
                                    VerticalLayout { alignment: center;
                                        DragHandle { group: 3; index: index; count: LayersEditor.extras.length; dropped(from, to) => { LayersEditor.move-extra(from, to); } }
                                    }
                                    VerticalLayout { alignment: center;
                                        IconButton { icon: @image-url("icons/trash-2.svg"); tooltip: @tr("Remove"); danger: true; clicked => { LayersEditor.remove-extra(index); } }
                                    }
                                }
                            }
                            DropMarker { width: parent.width; group: 3; index: index; row-y: parent.y; row-height: parent.height; }
                        }
                    }
                }
            }
        }
    }
}

export component LayerDialogOverlay inherits FocusScope {
    focus-on-tab-navigation: false;
    enabled: LayersEditor.dialog != LayerDialog.none && !ActionPicker.opened;
    key-pressed(event) => { if event.text == Key.Escape { LayersEditor.dialog = LayerDialog.none; return accept; } return reject; }
    if LayersEditor.dialog != LayerDialog.none && LayersEditor.dialog != LayerDialog.delete && LayersEditor.dialog != LayerDialog.clear-keys && LayersEditor.dialog != LayerDialog.clear-extras: Rectangle {
        background: #00000099;
        TouchArea { clicked => { LayersEditor.dialog = LayerDialog.none; } }
        Rectangle { x: (parent.width - self.width) / 2; y: 60px; width: min(parent.width - 80px, 560px); height: min(parent.height - 120px, 500px); background: Theme.surface; border-color: Theme.border; border-width: 1px; border-radius: 12px;
            TouchArea {}
            VerticalBox { padding: 20px; spacing: 12px;
                Text {
                    text: LayersEditor.dialog == LayerDialog.create ? @tr("New layer")
                        : LayersEditor.dialog == LayerDialog.duplicate ? @tr("Duplicate layer")
                        : LayersEditor.dialog == LayerDialog.delete ? @tr("Delete layer?")
                        : LayersEditor.dialog == LayerDialog.edit-key ? @tr("Edit layer key")
                        : LayersEditor.dialog == LayerDialog.extra-key ? @tr("Extra key")
                        : @tr("Clear assignments?");
                    color: Theme.text; font-size: 22px; font-weight: 700;
                }
                if LayersEditor.dialog == LayerDialog.create || LayersEditor.dialog == LayerDialog.duplicate: VerticalBox { spacing: 8px;
                    Text { text: @tr("Name"); color: Theme.text; }
                    LineEdit { text <=> LayersEditor.dialog-name; accepted => { LayersEditor.apply-dialog(); } }
                    Text { text: @tr("Description"); color: Theme.text; }
                    LineEdit { text <=> LayersEditor.dialog-description; accepted => { LayersEditor.apply-dialog(); } }
                }
                if LayersEditor.dialog == LayerDialog.delete: Text { text: @tr("Rules using this layer will return to the base layer."); color: Theme.muted; wrap: word-wrap; }
                if LayersEditor.dialog == LayerDialog.edit-key || LayersEditor.dialog == LayerDialog.extra-key: VerticalBox { spacing: 8px;
                    if LayersEditor.dialog == LayerDialog.extra-key: Text { text: @tr("Key code"); color: Theme.text; }
                    if LayersEditor.dialog == LayerDialog.extra-key: HorizontalBox { vertical-stretch: 0; spacing: 8px;
                        LineEdit { text <=> LayersEditor.dialog-key; horizontal-stretch: 1; }
                        Button { text: @tr("Choose trigger key"); clicked => { ActionPicker.open(PickerTarget.layer-key, 0, LayersEditor.dialog-key, true); } }
                    }
                    ComboBox {
                        model: LayersEditor.dialog == LayerDialog.extra-key ? [@tr("Native"), @tr("Swallow"), @tr("Action")] : [@tr("Transparent"), @tr("Swallow"), @tr("Action")];
                        current-index: LayersEditor.assignment == Assignment.swallow ? 1 : LayersEditor.assignment == Assignment.action ? 2 : 0;
                        selected(value) => { LayersEditor.assignment = self.current-index == 1 ? Assignment.swallow : self.current-index == 2 ? Assignment.action : Assignment.transparent; }
                    }
                    if LayersEditor.assignment == Assignment.action: HorizontalBox { vertical-stretch: 0; spacing: 8px;
                        LineEdit { text <=> LayersEditor.dialog-action; placeholder-text: @tr("Action code"); horizontal-stretch: 1; }
                        Button { text: @tr("Choose action"); clicked => { ActionPicker.open(PickerTarget.layer-action, 0, LayersEditor.dialog-action, false); } }
                    }
                }
                Text { text: Locale.text(LayersEditor.status); color: Theme.error; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { LayersEditor.dialog = LayerDialog.none; } }
                    Button { text: LayersEditor.dialog == LayerDialog.delete ? @tr("Delete") : @tr("Apply"); primary: true; clicked => { LayersEditor.apply-dialog(); } }
                }
            }
        }
    }
    if LayersEditor.dialog == LayerDialog.delete: ConfirmDialog {
        title: @tr("Delete layer?"); body: @tr("Rules using this layer will return to the base layer."); confirm-text: @tr("Delete");
        confirm => { LayersEditor.apply-dialog(); } cancel => { LayersEditor.dialog = LayerDialog.none; }
    }

    if LayersEditor.dialog == LayerDialog.clear-keys || LayersEditor.dialog == LayerDialog.clear-extras: ConfirmDialog {
        title: @tr("Clear assignments?"); body: @tr("The selected assignments will be cleared."); confirm-text: @tr("Clear");
        confirm => { LayersEditor.apply-dialog(); } cancel => { LayersEditor.dialog = LayerDialog.none; }
    }

}
