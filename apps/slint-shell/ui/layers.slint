import { KeyboardFocus, NavigationFocus } from "focus.slint";
import { ElidedText } from "controls.slint";
import { TextField } from "controls.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { DragArea, DragAxis, DragDrop, DragGroups, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { CategoryIcon } from "action-controls.slint";
import { ButtonGroup, InlineTextField, InlineTextArea, Card, Divider, MenuSurface, MenuItem, ConfirmDialog, DialogFrame, IconButton, InfoTip, FieldLabel, FormField, PageLayout, TooltipSurface, CardTitle, FieldButton, EmptyState } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { ActionKind, Assignment, LabelMode, LayerDialog, PickerCategory, PickerTarget } from "types.slint";
import { Button, TextEdit, Palette } from "std-widgets.slint";

/// One slot of a hand grid. `index < 0` is an empty slot; otherwise it is the
/// layer key index passed back with `LayersEditor.edit-key`.
/// `holds`: the keystroke keeps its modifiers held until the layer is released.
export struct LayerKeyCell { index: int, label: string, code: string, kind: Assignment, action: string, icon: ActionKind, category: PickerCategory, emoji: bool, holds: bool }
/// A key that activates the layer while held: its code and US-layout label.
export struct LayerTrigger { code: string, label: string }
export struct LayerExtraRow { key: string, kind: Assignment, action: string, icon: ActionKind, category: PickerCategory, holds: bool }

/// Layers of the profile being edited and their keymaps.
export global LayersEditor {
    in-out property <int> keyboard-key: -1;
    in-out property <int> keyboard-source: -1;
    in-out property <LabelMode> label-mode: LabelMode.label;
    in property <[string]> names;
    in-out property <int> selected: -1;
    in-out property <string> selected-id;
    changed selected-id => { self.keyboard-source = -1; }
    in property <string> description;
    in property <[LayerKeyCell]> left-cells;
    in property <[LayerKeyCell]> right-cells;
    in property <[LayerExtraRow]> extras;
    in property <Message> status;
    /// Enabled rule triggers that hold this layer, in rule order.
    in property <[LayerTrigger]> triggers;
    in-out property <LayerDialog> dialog: LayerDialog.none;
    in-out property <string> dialog-name;
    in-out property <string> dialog-description;
    /// Key of the extra row being edited or added.
    in-out property <string> dialog-key;
    in-out property <int> delete-extra: -1;
    callback refresh();
    callback choose(int);
    /// Open `dialog` for the selected layer (or a new one).
    callback open-dialog(LayerDialog);
    /// Choose the assignment of layer key `index`.
    callback edit-key(int);
    callback apply-dialog();
    /// Close the open dialog or confirmation without applying it.
    callback close-dialog();
    /// Move layer `from` to `to`; false when nothing moved.
    callback reorder(int, int) -> bool;
    callback reorder-extra(int, int);
    /// Exchange the assignments of layer keys `from` and `to`.
    callback swap-keys(int, int);
    callback request-remove-extra(int);
    /// Remove the extra row confirmed in `delete-extra`; closes the
    /// confirmation unless the removal failed and can be retried.
    callback remove-extra();
    callback update-description(string) -> bool;
    callback update-name(string) -> bool;
    /// Why `name` cannot be used for a new layer or, when `renaming`, for the selected one.
    pure callback name-error(name: string, renaming: bool) -> Message;
    callback add-extra();
    callback pick-extra(int, bool);
}

component ActionText inherits HorizontalLayout {
    in property <Assignment> kind;
    in property <string> action;
    /// The action is emoji-only text, drawn with the colour emoji font.
    in property <bool> emoji;
    in property <length> text-size: Theme.font-caption;
    in property <TextHorizontalAlignment> text-alignment: center;
    spacing: Theme.space-xs;

    Text {
        min-width: 0px;
        horizontal-stretch: 1;
        text: root.kind == Assignment.transparent ? "" : root.kind == Assignment.swallow ? @tr("Suppress") : root.action;
        color: root.kind == Assignment.action ? Theme.text : Theme.muted;
        font-family: root.emoji ? "Noto Color Emoji" : "";
        font-size: root.emoji ? root.text-size + 3px : root.text-size;
        font-weight: root.kind == Assignment.transparent ? 400 : 500;
        horizontal-alignment: root.text-alignment;
        vertical-alignment: center;
        // Intentionally clipped, not elided: in narrow cells an ellipsis hides 1–2 more characters.
        overflow: clip;
    }
}

/// Marks a layer key whose modifiers stay held until the layer is released.
component HoldsMarker inherits Rectangle {
    width: 6px;
    height: 6px;
    border-radius: Theme.radius-small;
    background: Theme.accent;
}

component ExtraFieldButton inherits Rectangle {
    in property <string> text;
    /// Shows the held-modifiers marker after the text.
    in property <bool> holds;
    callback clicked();
    height: Theme.control-height;
    FieldButton {
        width: 100%; height: 100%;
        accessible-label: root.text;
        accessible-description: root.holds ? @tr("Keep modifiers held until the layer is released") : "";
        clicked => { root.clicked(); }
        ElidedText { min-width: 0px; horizontal-stretch: 1; text: root.text; color: Theme.text; font-size: Theme.font-medium; vertical-alignment: center; }
        if root.holds: VerticalLayout { alignment: center; HoldsMarker { } }
    }
    if root.holds: Tooltip {
        TooltipSurface {
            HorizontalLayout { spacing: Theme.space-s; VerticalLayout { alignment: center; HoldsMarker { } } Text { text: @tr("Keep modifiers held until the layer is released"); color: Theme.text; } }
        }
    }
}

// The row itself is the TouchArea, so it keeps `has-hover` while the pointer is over one of
// its buttons; a sibling TouchArea would lose hover there and make the buttons flicker.
component ExtraKeyLine inherits TouchArea {
    in property <int> index;
    in property <LayerExtraRow> item;
    opacity: DragDrop.dragging && DragDrop.group == DragGroups.extra-keys && DragDrop.source == root.index ? Theme.dragged-opacity : 1;
    Rectangle { background: root.has-hover ? Theme.hover.transparentize(0.6) : transparent; }
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-l;
            ExtraFieldButton { width: 200px; text: root.item.key; clicked => { LayersEditor.pick-extra(root.index, true); } }
            ExtraFieldButton {
                horizontal-stretch: 1;
                min-width: 0px;
                holds: root.item.holds && root.item.kind == Assignment.action;
                // A row always has an assignment: removing it inherits.
                text: root.item.kind == Assignment.swallow ? @tr("Suppress") : root.item.action;
                clicked => { LayersEditor.pick-extra(root.index, false); }
            }
            VerticalLayout {
                width: 28px;
                alignment: center;
                DragHandle {
                    opacity: root.has-hover || Theme.focus-ring(self.has-focus) || (DragDrop.group == DragGroups.extra-keys && DragDrop.source == root.index) ? 1 : 0;
                    accessible-description: root.item.key + ". Alt+↑ / Alt+↓";
                    group: DragGroups.extra-keys; index: root.index; count: LayersEditor.extras.length;
                    dropped(from, to) => { LayersEditor.reorder-extra(from, to); }
                }
            }
            VerticalLayout {
                width: 32px;
                alignment: center;
                IconButton {
                    // Opacity instead of `visible`: the button stays focusable from the keyboard.
                    opacity: root.has-hover || Theme.focus-ring(self.has-focus) ? 1 : 0;
                    icon: @image-url("icons/trash-2.svg");
                    tooltip: @tr("Remove trigger");
                    accessible-label: @tr("Remove trigger: {}", root.item.key);
                    clicked => { LayersEditor.request-remove-extra(root.index); }
                }
            }
        }
        Divider {}
    }
    DropMarker { cross-size: parent.width; group: DragGroups.extra-keys; index: root.index; row-start: root.y; row-size: root.height; }
}

component KeyCap inherits Rectangle {
    in property <LayerKeyCell> cell;
    in property <LabelMode> label-mode;
    /// Layer key index under the pointer while a key is dragged, or -1.
    in property <int> drop-target: -1;
    callback clicked();
    callback dropped(int, int);
    private property <bool> dragged: touch.dragged;
    private property <bool> drop-over: DragDrop.dragging && DragDrop.group == DragGroups.keys && root.drop-target == root.cell.index && !root.dragged;
    border-radius: Theme.radius;
    border-width: root.drop-over || Theme.focus-ring(focus.has-focus) ? 2px : 1px;
    border-color: root.drop-over ? Theme.accent : Theme.focus-ring(focus.has-focus) ? Theme.focus : touch.has-hover && !DragDrop.dragging ? Theme.muted : Theme.border;
    background: root.drop-over ? Theme.hover : Theme.surface;
    opacity: root.dragged || LayersEditor.keyboard-source == root.cell.index ? Theme.dragged-opacity : 1;
    accessible-role: button;
    accessible-label: root.cell.label + " (" + root.cell.code + ")";
    accessible-value: root.cell.code;
    accessible-description: (root.cell.kind == Assignment.transparent ? @tr("Inherit") : root.cell.kind == Assignment.swallow ? @tr("Suppress") : root.cell.holds ? root.cell.action + ". " + @tr("Keep modifiers held until the layer is released") : root.cell.action) + ". " + @tr("Ctrl+X, then Ctrl+V on another key: swap their assignments");
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding: Theme.space-xs;
        spacing: Theme.space-xs;
        alignment: center;
        Text {
            min-width: 0px;
            text: root.label-mode == LabelMode.label ? root.cell.label : root.cell.code;
            color: Theme.accent;
            font-size: Theme.font-medium;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            // Intentionally clipped, not elided: in narrow cells an ellipsis hides 1–2 more characters.
            overflow: clip;
        }
        HorizontalLayout {
            alignment: center;
            ActionText { min-width: 0px; kind: root.cell.kind; action: root.cell.action; emoji: root.cell.emoji; }
        }
    }
    init => { if LayersEditor.keyboard-key < 0 { LayersEditor.keyboard-key = root.cell.index; } }
    if root.cell.holds && root.cell.kind == Assignment.action: HoldsMarker { x: parent.width - self.width - 4px; y: 4px; }
    focus := NavigationFocus {
        tab-stop: LayersEditor.keyboard-key == root.cell.index;
        focus-changed-event => { if self.has-focus { LayersEditor.keyboard-key = root.cell.index; } }
        key-pressed(event) => {
            if event.modifiers.control && event.text.to-lowercase() == "x" { LayersEditor.keyboard-source = root.cell.index; return accept; }
            if event.modifiers.control && event.text.to-lowercase() == "v" {
                if LayersEditor.keyboard-source >= 0 { LayersEditor.swap-keys(LayersEditor.keyboard-source, root.cell.index); LayersEditor.keyboard-source = -1; }
                return accept;
            }
            if event.text == Key.Escape && LayersEditor.keyboard-source >= 0 { LayersEditor.keyboard-source = -1; return accept; }
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return self.navigate(event);
        }
    }
    touch := DragArea {
        width: 100%; height: 100%;
        group: DragGroups.keys; index: root.cell.index;
        axis: DragAxis.free;
        free-target: root.drop-target;
        cursor: MouseCursor.pointer;
        clicked => { focus.focus(); root.clicked(); }
        dropped(from, to) => { root.dropped(from, to); }
    }
    Tooltip {
        TooltipSurface {
            VerticalLayout { spacing: Theme.space-s;
                Text { text: root.cell.code; color: Theme.text; }
                if root.cell.kind != Assignment.transparent: HorizontalLayout { spacing: Theme.space-s; CategoryIcon { category: root.cell.category; } Text { text: root.cell.kind == Assignment.swallow ? @tr("Suppress") : root.cell.action; color: Theme.text; } }
                if root.cell.holds: HorizontalLayout { spacing: Theme.space-s; VerticalLayout { alignment: center; HoldsMarker { } } Text { text: @tr("Keep modifiers held until the layer is released"); color: Theme.muted; } }
                Text { text: @tr("Ctrl+X, then Ctrl+V on another key: swap their assignments"); color: Theme.muted; font-size: Theme.font-caption; }
            }
        }
    }
}

component HandGrid inherits VerticalLayout {
    accessible-role: groupbox;
    accessible-label: root.title;
    in property <string> title;
    in property <[LayerKeyCell]> cells;
    in property <int> columns;
    in property <LabelMode> label-mode;
    in property <int> drop-target: -1;
    callback edit(int);
    callback dropped(int, int);
    private property <length> cell-height: 46px;
    private property <length> cell-width: (root.width - (root.columns - 1) * root.spacing) / root.columns;
    /// Layer key index at window position (`x`, `y`), or -1 outside the keys.
    public pure function key-at(x: length, y: length) -> int {
        let local-x = x - root.absolute-position.x;
        let local-y = y - root.absolute-position.y - title.height - root.spacing;
        if local-x < 0px || local-y < 0px || local-x >= root.width { return -1; }
        // Gaps belong to the cell before them, so the target does not flicker between keys.
        let col = floor(local-x / (root.cell-width + root.spacing));
        let row = floor(local-y / (root.cell-height + root.spacing));
        if col >= root.columns || row >= root.cells.length / root.columns { return -1; }
        return root.cells[row * root.columns + col].index;
    }
    horizontal-stretch: root.columns;
    preferred-width: 0px;
    min-width: 0px;
    spacing: Theme.space-s;
    title := Text {
        text: root.title.to-uppercase();
        color: Theme.muted;
        font-size: Theme.font-caption;
        letter-spacing: 0.5px;
    }
    for row in root.cells.length / root.columns: HorizontalLayout {
        spacing: root.spacing;
        for col in root.columns: Rectangle {
            height: root.cell-height;
            width: root.cell-width;
            horizontal-stretch: 0;
            if root.cells[row * root.columns + col].index >= 0: KeyCap {
                width: parent.width;
                height: parent.height;
                accessible-item-index: row * root.columns + col;
                accessible-item-count: root.cells.length;
                cell: root.cells[row * root.columns + col];
                label-mode: root.label-mode;
                drop-target: root.drop-target;
                clicked => { root.edit(self.cell.index); }
                dropped(from, to) => { root.dropped(from, to); }
            }
        }
    }
}

export component LayersPage inherits PageLayout {
    accessible-label: @tr("Layers");
    in-out property <LabelMode> label-mode <=> LayersEditor.label-mode;
    HorizontalLayout {
        padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
        ScrollView { accessible-role: tab-list; accessible-label: @tr("Layers"); height: 52px; viewport-height: self.visible-height; vertical-scrollbar-policy: always-off; horizontal-scrollbar-policy: as-needed; drag-scroll: true;
            HorizontalLayout { spacing: Theme.space-s; alignment: start;
                for name[index] in LayersEditor.names: Rectangle {
                    height: Theme.control-height-l; border-radius: Theme.radius; border-width: Theme.focus-ring(layer-focus.has-focus) ? 2px : 1px;
                    border-color: Theme.focus-ring(layer-focus.has-focus) ? Theme.focus : Theme.border;
                    background: index == LayersEditor.selected ? Theme.selected : layer-drag.has-hover ? Theme.hover : Theme.card;
                    opacity: layer-drag.dragged ? Theme.dragged-opacity : 1;
                    accessible-role: tab;
                    accessible-id: "tecloid-layer-tab-" + index;
                    accessible-label: name;
                    accessible-description: "Alt+← / Alt+→";
                    accessible-item-selectable: true;
                    accessible-item-selected: LayersEditor.selected == index;
                    accessible-action-default => { LayersEditor.choose(index); }
                    HorizontalLayout {
                        padding-left: Theme.space-l; padding-right: Theme.space-l;
                        // Long names are cut so one tab cannot push the others out of view.
                        ElidedText { max-width: 240px; text: name; color: Theme.text; font-size: Theme.font-medium; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                    }
                    layer-focus := NavigationFocus {
                        kind: horizontal-tabs;
                        tab-stop: LayersEditor.selected == index;
                        key-pressed(event) => {
                            if event.text == " " || event.text == "\n" { LayersEditor.choose(index); return accept; }
                            // Alt+Left/Right: keyboard alternative to dragging the tab.
                            if event.modifiers.alt && event.text == Key.LeftArrow && index > 0 { KeyboardFocus.remember-reorder(index, index - 1); if !LayersEditor.reorder(index, index - 1) { KeyboardFocus.remember-reorder(index, index); } KeyboardFocus.restore-reorder(); return accept; }
                            if event.modifiers.alt && event.text == Key.RightArrow && index + 1 < LayersEditor.names.length { KeyboardFocus.remember-reorder(index, index + 1); if !LayersEditor.reorder(index, index + 1) { KeyboardFocus.remember-reorder(index, index); } KeyboardFocus.restore-reorder(); return accept; }
                            return self.navigate(event);
                        }
                    }
                    layer-drag := DragArea {
                        width: 100%; height: 100%;
                        group: DragGroups.layer-tabs; index: index; count: LayersEditor.names.length;
                        axis: DragAxis.horizontal;
                        cursor: MouseCursor.pointer;
                        clicked => { layer-focus.focus(); LayersEditor.choose(index); }
                        dropped(from, to) => { LayersEditor.reorder(from, to); }
                    }
                    DropMarker { cross-size: parent.height; group: DragGroups.layer-tabs; index: index; horizontal: true; row-start: parent.x; row-size: parent.width; }
                }
                VerticalLayout { height: Theme.control-height-l; alignment: center;
                    IconButton { icon: @image-url("icons/plus.svg"); tooltip: @tr("Create new layer"); primary: true; clicked => { LayersEditor.open-dialog(LayerDialog.create); } }
                }
            }
        }
    }
    ScrollView {
        drag-scroll: true;
        viewport-width: self.visible-width;
        vertical-stretch: 1;
        PageContent {
            spacing: Theme.space-xl;
            // Layer toolbar
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    padding: Theme.space-2xl;
                    spacing: Theme.space-l;
                    HorizontalLayout {
                        spacing: Theme.space-l;
                        Text { horizontal-stretch: 0; text: @tr("Layer:"); color: Theme.text; font-size: Theme.font-medium; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            InlineTextField {
                                horizontal-stretch: 1; min-width: 0px;
                                text: LayersEditor.names[LayersEditor.selected];
                                label: @tr("Name"); text-size: Theme.font-medium; text-weight: Theme.weight-semibold;
                                validate(value) => { return LayersEditor.name-error(value, true); }
                                saved(value) => { return LayersEditor.update-name(value); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 36px; height: Theme.control-height;
                            Button {
                                width: parent.width; height: parent.height; text: "…"; accessible-label: @tr("Actions: {}", LayersEditor.names[LayersEditor.selected]);
                                clicked => { layer-menu.show(); }
                            }
                            layer-menu := PopupWindow {
                                x: parent.width - self.width; y: parent.height + Theme.menu-offset;
                                width: 200px;
                                MenuSurface {
                                    MenuItem { has-icon: true; icon: @image-url("icons/copy.svg"); text: @tr("Duplicate"); clicked => { layer-menu.close(); LayersEditor.open-dialog(LayerDialog.duplicate); } }
                                    MenuItem { has-icon: true; icon: @image-url("icons/trash-2.svg"); text: @tr("Delete layer"); clicked => { layer-menu.close(); LayersEditor.open-dialog(LayerDialog.delete); } }
                                }
                            }
                        }
                    }
                    InlineTextArea {
                        text: LayersEditor.description; placeholder: @tr("Add description"); label: @tr("Layer description");
                        text-color: Theme.muted;
                        saved(value) => { return LayersEditor.update-description(value); }
                    }

                }
            }

            if LayersEditor.selected < 0: Card {
                vertical-stretch: 0;
                max-height: empty-content.preferred-height;
                empty-content := VerticalLayout {
                    alignment: start;
                    padding: Theme.space-2xl;
                    spacing: Theme.space-xs;
                    Text { text: @tr("No layers yet"); color: Theme.text; font-size: Theme.font-default; font-weight: Theme.weight-semibold; }
                    Text { text: @tr("Create a layer to assign its keys."); color: Theme.muted; wrap: word-wrap; }
                }
            }

            // Keyboard
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-2xl; padding-right: Theme.space-2xl; padding-top: Theme.space-l-plus; padding-bottom: Theme.space-l-plus;
                        spacing: Theme.space-m;
                        CardTitle { text: @tr("Keyboard"); vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            InfoTip { text: @tr("Display modes affect labels only — the key code stays the same. “US layout” shows standard letter labels for visual reference. “Tecloid codes” shows app-specific codes (e.g. KeyA, ArrowLeft)."); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ButtonGroup {
                            pill: true;
                            labels: [@tr("US layout"), @tr("Tecloid codes")];
                            tooltips: [@tr("Show standard QWERTY letter labels for visual reference."), @tr("Show internal key codes used in Tecloid profiles (e.g. KeyA, ArrowLeft).")];
                            selected-index: root.label-mode == LabelMode.code ? 1 : 0;
                            selected(index) => { root.label-mode = index == 1 ? LabelMode.code : LabelMode.label; }
                        }
                    }
                    Divider {}
                    hands := HorizontalLayout {
                        accessible-role: list; accessible-label: @tr("Keyboard");
                        // Recomputed from the window position, so it follows auto-scroll under a still pointer.
                        property <int> key-target: !DragDrop.dragging || DragDrop.group != DragGroups.keys ? -1
                            : max(left-hand.key-at(DragDrop.pointer-x, DragDrop.pointer-y), right-hand.key-at(DragDrop.pointer-x, DragDrop.pointer-y));
                        padding: Theme.space-2xl;
                        spacing: Theme.space-3xl;
                        // From the page width rather than this profile's, which would depend on the grids.
                        property <length> hand-width: (root.width - Theme.scrollbar-size - Theme.scrollbar-gap - 2 * Theme.space-2xl - Theme.space-3xl) / 2;
                        left-hand := HandGrid {
                            width: hands.hand-width;
                            horizontal-stretch: 0;
                            title: @tr("Left hand");
                            cells: LayersEditor.left-cells;
                            columns: 6;
                            label-mode: root.label-mode;
                            drop-target: hands.key-target;
                            edit(index) => { LayersEditor.edit-key(index); }
                            dropped(from, to) => { LayersEditor.swap-keys(from, to); }
                        }
                        right-hand := HandGrid {
                            width: hands.hand-width;
                            horizontal-stretch: 0;
                            title: @tr("Right hand");
                            cells: LayersEditor.right-cells;
                            columns: 6;
                            label-mode: root.label-mode;
                            drop-target: hands.key-target;
                            edit(index) => { LayersEditor.edit-key(index); }
                            dropped(from, to) => { LayersEditor.swap-keys(from, to); }
                        }
                    }
                }
            }

            // Extra keys
            if LayersEditor.selected >= 0: Card {
                VerticalLayout {
                    HorizontalLayout {
                        padding-left: Theme.space-2xl; padding-right: Theme.space-2xl; padding-top: Theme.space-l-plus; padding-bottom: Theme.space-l-plus;
                        spacing: Theme.space-m;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: Theme.space-2xs;
                            HorizontalLayout { spacing: Theme.space-m; alignment: start;
                                CardTitle { text: @tr("Extra keys"); }
                                InfoTip { text: @tr("Mouse buttons, media keys, and other triggers outside the main keyboard grid. Add a trigger and choose its action or suppress it. Delete its row to inherit the assignment from the lower layer or base profile."); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/plus.svg");
                                text: @tr("Add");
                                primary: true;
                                clicked => { LayersEditor.add-extra(); }
                            }
                        }
                    }
                    Divider {}
                    VerticalLayout {
                        padding: Theme.space-2xl;
                        spacing: 0px;
                        if LayersEditor.extras.length == 0: EmptyState { text: @tr("No extra keys for this layer yet."); }
                        if LayersEditor.extras.length > 0: HorizontalLayout {
                            padding: Theme.space-m;
                            spacing: Theme.space-l;
                            FieldLabel { width: 200px; text: @tr("Key"); }
                            FieldLabel { horizontal-stretch: 1; text: @tr("Action"); }
                            Rectangle { width: 28px; }
                            Rectangle { width: 32px; }
                        }
                        if LayersEditor.extras.length > 0: Divider {}
                        for extra[index] in LayersEditor.extras: ExtraKeyLine {
                            index: index;
                            item: extra;
                        }
                    }
                }
            }
        }
    }
}

export component LayerDialogOverlay inherits FocusScope {
    focus-on-tab-navigation: false;
    enabled: (LayersEditor.dialog != LayerDialog.none || LayersEditor.delete-extra >= 0) && !ActionPicker.opened;
    key-pressed(event) => { if event.text == Key.Escape { LayersEditor.close-dialog(); return accept; } return reject; }
    if LayersEditor.dialog == LayerDialog.create || LayersEditor.dialog == LayerDialog.duplicate: DialogFrame {
        title: LayersEditor.dialog == LayerDialog.create ? @tr("New layer") : @tr("Duplicate layer");
        card-height: 500px;
        close => { LayersEditor.close-dialog(); }
        // The form scrolls in a short window; the buttons stay visible.
        ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
            preferred-height: layer-form.preferred-height;
            layer-form := VerticalLayout { alignment: start;
                if LayersEditor.dialog == LayerDialog.create || LayersEditor.dialog == LayerDialog.duplicate: VerticalLayout { padding: Theme.space-m; spacing: Theme.space-m;
                    FormField {
                        label: @tr("Name"); autofocus: true;
                        text <=> LayersEditor.dialog-name;
                        error: LayersEditor.name-error(LayersEditor.dialog-name, false);
                        accepted => { if LayersEditor.name-error(LayersEditor.dialog-name, false).id == "" { LayersEditor.apply-dialog(); } }
                    }
                    Text { text: @tr("Description"); color: Theme.text; }
                    TextEdit { text <=> LayersEditor.dialog-description; accessible-label: @tr("Layer description"); height: 100px; }
                }
                Text { accessible-live-region: polite; text: Locale.text(LayersEditor.status); color: Theme.error; wrap: word-wrap; }
            }
        }
        HorizontalLayout { padding: Theme.space-m; vertical-stretch: 0; spacing: Theme.space-m;
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { LayersEditor.close-dialog(); } }
            Button { text: @tr("Apply"); primary: true; enabled: LayersEditor.name-error(LayersEditor.dialog-name, false).id == ""; clicked => { LayersEditor.apply-dialog(); } }
        }
    }
    if LayersEditor.dialog == LayerDialog.delete: ConfirmDialog {
        title: @tr("Delete layer “{}”?", LayersEditor.names[LayersEditor.selected]);
        body: @tr("Its key assignments will be deleted. Rules that hold this layer will stop activating it."); confirm-text: @tr("Delete");
        error: Locale.text(LayersEditor.status);
        confirm => { LayersEditor.apply-dialog(); } cancel => { LayersEditor.close-dialog(); }
    }

    if LayersEditor.delete-extra >= 0: ConfirmDialog {
        title: @tr("Delete extra key “{}”?", LayersEditor.extras[LayersEditor.delete-extra].key);
        body: @tr("This key assignment will be removed from the layer."); confirm-text: @tr("Delete");
        error: Locale.text(LayersEditor.status);
        confirm => { LayersEditor.remove-extra(); }
        cancel => { LayersEditor.close-dialog(); }
    }

}
