import { ScrollView } from "scroll.slint";
import { ActionPicker } from "action-picker.slint";
import { CategoryIcon } from "action-picker.slint";
import { ConditionsForm, ApplicationsField, ConditionChoices } from "conditions.slint";
import { DragDrop, DragHandle, DropMarker } from "reorder.slint";
import { IconButton, ConfirmDialog, ItemStyle, InfoTip, Badge, NumericInput, FormLabel, SelectField } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { RuleDialog, RuleField, GameCondition } from "types.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";

export struct RuleRow { key: string, is-chord: bool, tap: string, hold: string, long-hold: string, long-hold-timeout: string, hold-mode: int, double-tap: string, layer: string, has-conditions: bool, game: GameCondition, languages: string, applications: string, excluded: string, hold-timeout: string, double-timeout: string, isolate: string, hold-for: string, enabled: bool, swallow-tap: bool, swallow-hold: bool, advanced: bool, key-category: int, tap-category: int, hold-category: int, double-category: int }
export struct RuleLayerChoice { id: string, label: string }

/// Rules of the layout being edited.
export global RulesEditor {
    in property <[RuleRow]> rows;
    in property <int> created: -1;
    in-out property <int> selected: -1;
    in property <Message> status;
    in property <string> default-hold-timeout;
    in property <string> default-long-hold-timeout;
    in property <string> default-double-timeout;
    /// Fields of the selected rule, filled by `select`.
    in-out property <string> key;
    in property <bool> is-chord;
    in-out property <string> layer;
    in-out property <string> tap;
    in-out property <string> hold;
    in-out property <string> long-hold;
    in-out property <string> long-hold-timeout;
    in-out property <string> original-long-hold-timeout;
    in-out property <int> hold-mode;
    in-out property <string> double-tap;
    in-out property <GameCondition> game-mode;
    in-out property <string> layouts;
    in-out property <string> apps-include;
    in-out property <string> apps-exclude;
    in-out property <string> isolate;
    in-out property <string> hold-for;
    in-out property <string> hold-timeout;
    in-out property <string> double-timeout;
    in-out property <string> original-isolate;
    in-out property <string> original-hold-for;
    in-out property <string> original-hold-timeout;
    in-out property <string> original-double-timeout;
    out property <bool> advanced-dirty: long-hold-timeout != original-long-hold-timeout || isolate != original-isolate || hold-for != original-hold-for || hold-timeout != original-hold-timeout || double-timeout != original-double-timeout;
    in-out property <bool> enabled: true;
    in-out property <bool> swallow-tap;
    in-out property <bool> swallow-hold;
    /// Open dialog; `none` while the action picker edits `field`.
    in-out property <RuleDialog> dialog: RuleDialog.none;
    /// Rule property that `choose` changes.
    in-out property <RuleDialog> field: RuleDialog.none;
    in-out property <string> dialog-value;
    in-out property <string> new-layer-name;
    in property <[RuleLayerChoice]> layer-items;
    in property <string> layer-id;
    in-out property <int> layer-highlight;
    callback refresh();
    callback select(int);
    callback add();
    callback remove();
    callback move(int, int);
    /// Change a property of the selected rule in place.
    callback edit(RuleField, string);
    /// Open `dialog` for rule `index`.
    callback open-dialog(int, RuleDialog);
    /// Apply `value` to `field` of the selected rule.
    callback choose(string);
    callback filter-layers(string);
    callback apply-conditions();
    callback apply-advanced();
    callback create-layer(string);
}

component RuleBadge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.hover;
    private property <string> measure: root.text;
    in property <length> available-width: 208px;
    width: min(root.available-width, measure-text.preferred-width + 14px);
    height: 22px;
    border-radius: 5px;
    background: root.fill;
    measure-text := Text { text: root.measure; visible: false; }
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        Text { min-width: 0px; horizontal-stretch: 1; overflow: elide; text: root.text; color: Theme.text; font-size: 12px; vertical-alignment: center; }
    }
}

component RuleCell inherits VerticalBox {
    padding: 0px;
    in property <string> title;
    in property <string> info;
    in property <string> value;
    in property <string> empty-text: @tr("Not set");
    in property <bool> enabled: true;
    in property <int> category: -1;
    callback clicked();
    spacing: 5px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    FormLabel { text: root.title; info: root.info; }
    Rectangle {
        min-width: 0px; height: 32px; border-radius: 5px; border-width: 1px; border-color: Theme.border; background: rule-cell-touch.has-hover ? Theme.hover : Theme.card;
        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 5px;
            if root.value != "" && root.category >= 0: CategoryIcon { category: root.category; }
            Text { min-width: 0px; horizontal-stretch: 1; text: root.value == "" ? root.empty-text : root.value; color: Theme.text; vertical-alignment: center; overflow: elide; }
        }
        rule-cell-touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    }
}

component LayerField inherits VerticalBox {
    padding: 0px;
    in property <int> rule-index;
    in property <string> value;
    private property <bool> creating;
    private property <length> scroll-y;
    private property <length> list-height: min(252px, max(72px, (RulesEditor.layer-items.length + 1) * 36px));
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    spacing: 5px;
    function close-menu() { menu.close(); RulesEditor.dialog = RuleDialog.none; field-focus.focus(); }
    function choose(index: int) {
        RulesEditor.choose(index == 0 ? "" : RulesEditor.layer-items[index - 1].id);
        if RulesEditor.dialog == RuleDialog.none { field-focus.focus(); menu.close(); }
    }
    function reveal() {
        let top = RulesEditor.layer-highlight * 36px;
        if top < -root.scroll-y { root.scroll-y = -top; }
        if top + 36px > -root.scroll-y + root.list-height { root.scroll-y = -(top + 36px - root.list-height); }
    }
    function open-menu() {
        RulesEditor.open-dialog(root.rule-index, RuleDialog.layer);
        root.creating = false;
        root.scroll-y = 0px;
        menu.show();
        root.reveal();
    }
    Text { text: @tr("Layer (hold)"); color: Theme.muted; }
    field := Rectangle {
        min-width: 0px; height: 32px; border-radius: 5px; border-width: 1px;
        border-color: field-focus.has-focus || menu.is-open ? Theme.link : Theme.border;
        background: touch.has-hover ? Theme.hover : Theme.card;
        accessible-role: combobox; accessible-label: @tr("Layer (hold)");
        accessible-value: root.value; accessible-expandable: true; accessible-expanded: menu.is-open;
        accessible-action-expand => { root.open-menu(); }
        forward-focus: field-focus;
        HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 8px;
            Text { min-width: 0px; horizontal-stretch: 1; text: root.value == "" ? @tr("No layer") : root.value; color: root.value == "" ? Theme.muted : Theme.text; vertical-alignment: center; overflow: elide; }
            VerticalLayout { alignment: center; Image { width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; } }
        }
        field-focus := FocusScope { key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow || event.text == Key.UpArrow { root.open-menu(); return accept; }
            return reject;
        } }
        touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-menu(); } }
        menu := PopupWindow {
            x: 0px; y: field.height + 4px; width: 360px;
            height: root.list-height + (root.creating ? 136px : 96px) + (RulesEditor.status.id != "" ? 40px : 0px);
            close-policy: close-on-click-outside;
            forward-focus: search;
            FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Escape { root.close-menu(); return accept; }
                    if !root.creating && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                        RulesEditor.layer-highlight = mod(RulesEditor.layer-highlight + RulesEditor.layer-items.length + 1 + (event.text == Key.DownArrow ? 1 : -1), RulesEditor.layer-items.length + 1);
                        root.reveal(); return accept;
                    }
                    if !root.creating && event.text == Key.Return { root.choose(RulesEditor.layer-highlight); return accept; }
                    return reject;
                }
                Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 8px;
                    VerticalLayout { padding: 8px; spacing: 8px;
                        search := LineEdit { text <=> RulesEditor.dialog-value; placeholder-text: @tr("Search layers"); edited => { RulesEditor.filter-layers(self.text); RulesEditor.layer-highlight = 0; root.scroll-y = 0px; } }
                        ScrollView { height: root.list-height; vertical-stretch: 0; viewport-width: self.visible-width; viewport-y <=> root.scroll-y;
                            VerticalLayout { spacing: 0px; alignment: start;
                                Rectangle { height: 36px; border-radius: 4px; background: clear-touch.has-hover || RulesEditor.layer-highlight == 0 ? Theme.hover : transparent;
                                    HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                        Text { text: @tr("No layer"); color: Theme.text; vertical-alignment: center; }
                                        if RulesEditor.layer-id == "": Text { text: "✓"; color: Theme.link; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    clear-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(0); } }
                                }
                                for item[index] in RulesEditor.layer-items: Rectangle { height: 36px; border-radius: 4px; background: row-touch.has-hover || RulesEditor.layer-highlight == index + 1 ? Theme.hover : transparent;
                                    HorizontalLayout { padding-left: 8px; padding-right: 8px;
                                        Text { min-width: 0px; horizontal-stretch: 1; text: item.label; overflow: elide; color: Theme.text; vertical-alignment: center; }
                                        if RulesEditor.layer-id == item.id: Text { text: "✓"; color: Theme.link; vertical-alignment: center; }
                                    }
                                    row-touch := TouchArea { mouse-cursor: pointer; clicked => { root.choose(index + 1); } }
                                }
                                if RulesEditor.layer-items.length == 0: Text { height: 36px; text: @tr("Layer not found"); color: Theme.muted; vertical-alignment: center; }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        Button { text: RulesEditor.dialog-value == "" ? @tr("Create new layer…") : @tr("Create “{}”", RulesEditor.dialog-value); clicked => { root.creating = true; RulesEditor.new-layer-name = RulesEditor.dialog-value; } }
                        if root.creating: HorizontalLayout { spacing: 8px;
                            name := LineEdit { init => { self.focus(); } text <=> RulesEditor.new-layer-name; placeholder-text: @tr("New layer name"); accepted => { RulesEditor.create-layer(self.text); if RulesEditor.dialog == RuleDialog.none { field-focus.focus(); menu.close(); } } }
                            Button { text: @tr("Create layer"); enabled: RulesEditor.new-layer-name != ""; clicked => { RulesEditor.create-layer(RulesEditor.new-layer-name); if RulesEditor.dialog == RuleDialog.none { field-focus.focus(); menu.close(); } } }
                        }
                        if RulesEditor.status.id != "": Text { text: Locale.text(RulesEditor.status); color: Theme.error; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}

export component RulesPage inherits VerticalBox {
    padding: 0px;
    vertical-stretch: 1;
    spacing: 12px;
    HorizontalBox { padding: 0px; vertical-stretch: 0; spacing: 8px;
        HorizontalBox { padding: 0px; spacing: 6px;
            Text { text: @tr("Rules and triggers"); color: Theme.text; font-size: 22px; font-weight: 700; }
            InfoTip { text: @tr("Define how physical keys activate layers or run actions."); }
        }
        Rectangle { horizontal-stretch: 1; }
        Button { max-height: 36px; text: @tr("+ Add rule"); clicked => { RulesEditor.add(); rule-scroll.viewport-y = 0px; } }
    }
    rule-scroll := ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
        VerticalLayout { padding: 0px; width: rule-scroll.visible-width; spacing: 10px; alignment: start;
            for rule[index] in RulesEditor.rows: Rectangle {
                vertical-stretch: 0;
                min-height: max(180px, rule-content.preferred-height);
                min-width: 0px;
                background: RulesEditor.created == index ? Theme.accent : Theme.card;
                animate background { duration: 650ms; }
                border-color: (DragDrop.dragging && DragDrop.group == 1 && DragDrop.source == index) ? Theme.accent : Theme.border;
                border-width: 1px;
                border-radius: 10px;
                opacity: ItemStyle.opacity(rule.enabled) * (DragDrop.dragging && DragDrop.group == 1 && DragDrop.source == index ? 0.6 : 1);

                rule-content := VerticalLayout { min-width: 0px; padding: 14px; spacing: 10px;
                    HorizontalLayout { spacing: 6px;
                        DragHandle { group: 1; index: index; count: RulesEditor.rows.length; dropped(from, to) => { RulesEditor.move(from, to); } }
                        CheckBox { accessible-label: @tr("Enabled"); checked: rule.enabled; toggled => { RulesEditor.select(index); RulesEditor.edit(RuleField.enabled, self.checked ? "true" : "false"); } }
                        Rectangle { horizontal-stretch: 1; }
                        if rule.hold != "" || rule.hold-timeout != "" || rule.double-timeout != "" || rule.isolate != "" || rule.hold-for != "": Text {
                            min-width: 0px; max-width: 420px; overflow: elide; vertical-alignment: center;
                            text: (rule.hold != "" ? @tr("Held key: {}", rule.hold) + (rule.hold-timeout != "" || rule.double-timeout != "" || rule.isolate != "" || rule.hold-for != "" ? " · " : "") : "")
                                + (rule.hold-timeout != "" ? @tr("Hold: {} ms", rule.hold-timeout) : "")
                                + (rule.double-timeout != "" ? (rule.hold-timeout != "" ? " · " : "") + @tr("Double tap: {} ms", rule.double-timeout) : "")
                                + (rule.isolate != "" ? ((rule.hold-timeout != "" || rule.double-timeout != "" ? " · " : "") + @tr("Release for {}", rule.isolate)) : "")
                                + (rule.hold-for != "" ? ((rule.hold-timeout != "" || rule.double-timeout != "" || rule.isolate != "" ? " · " : "") + @tr("Hold with {}", rule.hold-for)) : "");
                            color: Theme.muted;
                        }
                        IconButton { enabled: rule.key != ""; icon: @image-url("icons/settings-2.svg"); tooltip: @tr("Advanced rule options"); clicked => { RulesEditor.open-dialog(index, RuleDialog.advanced); }
                            if RulesEditor.dialog == RuleDialog.advanced && RulesEditor.selected == index && RulesEditor.advanced-dirty: Rectangle {
                                x: parent.width - 5px; y: 3px; width: 7px; height: 7px; border-radius: 4px; background: Theme.accent;
                            }
                        }
                    }
                    HorizontalLayout { min-width: 0px; spacing: 16px;
                        trigger-column := VerticalLayout { width: max(0px, min(220px, (rule-scroll.visible-width - 61px) * 0.35)); horizontal-stretch: 0; spacing: 10px; alignment: start;
                            RuleCell { title: @tr("Trigger"); info: @tr("A trigger can be a single key or a combination, such as ShiftLeft+ControlLeft. The combination works in either press order and ends when any key is released."); value: rule.key; category: rule.key-category; clicked => { RulesEditor.open-dialog(index, RuleDialog.key); } }
                            RuleCell { enabled: rule.key != ""; title: @tr("Conditions"); value: rule.has-conditions ? @tr("Set") : ""; clicked => { ConditionChoices.refresh(); RulesEditor.open-dialog(index, RuleDialog.conditions); } }
                            if rule.game != GameCondition.any: VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Game mode"); color: Theme.muted; font-size: 11px; }
                                RuleBadge { available-width: trigger-column.width; text: rule.game == GameCondition.on ? @tr("Game mode on") : @tr("Game mode off"); fill: Theme.accent; }
                            }
                            if rule.languages != "": VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Languages"); color: Theme.muted; font-size: 11px; }
                                for language in ConditionChoices.items(rule.languages): RuleBadge { available-width: trigger-column.width; text: language; }
                            }
                            if rule.applications != "": VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Applications"); color: Theme.muted; font-size: 11px; }
                                for application in ConditionChoices.items(rule.applications): RuleBadge { available-width: trigger-column.width; text: application; fill: Theme.success.transparentize(0.8); }
                            }
                            if rule.excluded != "": VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Excluded applications"); color: Theme.muted; font-size: 11px; }
                                for application in ConditionChoices.items(rule.excluded): RuleBadge { available-width: trigger-column.width; text: application; fill: Theme.error.transparentize(0.8); }
                            }
                        }
                        Rectangle { width: 1px; background: Theme.border; }
                        VerticalLayout { min-width: 0px; horizontal-stretch: 1; preferred-width: 0px; spacing: 12px; alignment: start;
                            HorizontalLayout { min-width: 0px; spacing: 12px;
                                RuleCell { title: @tr("Tap action"); value: rule.tap; category: rule.tap-category; empty-text: rule.swallow-tap ? @tr("Suppress") : @tr("Normal key behavior"); clicked => { RulesEditor.open-dialog(index, RuleDialog.tap); } }
                                if !rule.is-chord: RuleCell { title: @tr("Double-tap action"); value: rule.double-tap; category: rule.double-category; empty-text: @tr("No separate action"); clicked => { RulesEditor.open-dialog(index, RuleDialog.double-tap); } }
                            }
                            HorizontalLayout { min-width: 0px; spacing: 12px;
                                VerticalLayout { width: 160px; horizontal-stretch: 0; spacing: 5px;
                                    FormLabel { text: @tr("When held"); info: @tr("Choose a layer active until release, or an action performed once after the hold duration."); }
                                    SelectField { enabled: rule.key != ""; model: [@tr("Nothing"), @tr("Activate layer"), @tr("Run action")]; current-index: rule.hold-mode; selected(value) => { RulesEditor.select(index); RulesEditor.edit(RuleField.hold-mode, "" + self.current-index); } }
                                }
                                if rule.hold-mode == 0: Rectangle { horizontal-stretch: 1; }
                                if rule.hold-mode == 1: LayerField { width: 160px; horizontal-stretch: 0; rule-index: index; value: rule.layer; }
                                if rule.hold-mode == 1: RuleCell { title: @tr("Held key"); info: @tr("Holds the selected key or combination while the trigger is held. It can be combined with layer activation. Leave empty to activate only the layer."); value: rule.hold; category: rule.hold-category; empty-text: rule.layer != "" ? @tr("Activate layer only") : rule.swallow-hold ? @tr("Suppress") : @tr("Normal key behavior"); clicked => { RulesEditor.open-dialog(index, RuleDialog.hold); } }
                                if rule.hold-mode == 2: RuleCell { title: @tr("Long-hold action"); value: rule.long-hold; empty-text: @tr("No separate action"); clicked => { RulesEditor.open-dialog(index, RuleDialog.long-hold); } }
                            }
                            if rule.hold-mode == 2: Text { text: @tr("Runs once after {} s", rule.long-hold-timeout == "" ? RulesEditor.default-long-hold-timeout : rule.long-hold-timeout); color: Theme.muted; wrap: word-wrap; }
                        }
                    }
                }
                DropMarker { width: parent.width; group: 1; index: index; row-y: parent.y; row-height: parent.height; }
            }
        }
    }
}

export component RuleDialogOverlay inherits FocusScope {
    focus-on-tab-navigation: false;
    enabled: RulesEditor.dialog != RuleDialog.none && !ActionPicker.opened;
    key-pressed(event) => { if event.text == Key.Escape { RulesEditor.dialog = RuleDialog.none; return accept; } return reject; }
    if RulesEditor.dialog != RuleDialog.none && RulesEditor.dialog != RuleDialog.remove && RulesEditor.dialog != RuleDialog.layer: Rectangle {
        background: #00000099;
        TouchArea { clicked => { RulesEditor.dialog = RuleDialog.none; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 32px;
            width: min(parent.width - 48px, 560px);
            height: min(parent.height - 64px, 620px);
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 12px;
            TouchArea {}
            VerticalBox { padding: 22px; spacing: 10px;
                Text {
                    text: RulesEditor.dialog == RuleDialog.key ? @tr("Choose a key or combination for the trigger")
                        : RulesEditor.dialog == RuleDialog.layer ? @tr("Choose layer")
                        : RulesEditor.dialog == RuleDialog.conditions ? @tr("Conditions")
                        : RulesEditor.dialog == RuleDialog.advanced ? @tr("Advanced rule options")
                        : RulesEditor.dialog == RuleDialog.remove ? @tr("Delete rule?")
                        : @tr("Choose action");
                    color: Theme.text; font-size: 22px; font-weight: 700;
                }
                if RulesEditor.dialog == RuleDialog.conditions: ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
                    VerticalLayout { spacing: 12px;
                        ConditionsForm { game <=> RulesEditor.game-mode; languages <=> RulesEditor.layouts; applications <=> RulesEditor.apps-include; }
                        Text { text: @tr("Do not use when"); color: Theme.text; }
                        ApplicationsField { value <=> RulesEditor.apps-exclude; }
                    }
                }
                if RulesEditor.dialog == RuleDialog.advanced: ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
                    VerticalLayout { spacing: 8px; alignment: start;
                        if RulesEditor.hold-mode == 2: VerticalLayout { spacing: 8px;
                            FormLabel { text: @tr("Long-hold duration, seconds"); info: @tr("The action runs once after continuous holding. Leave empty to use the global setting: {} s", RulesEditor.default-long-hold-timeout); }
                            LineEdit { text <=> RulesEditor.long-hold-timeout; placeholder-text: @tr("Default: {} s", RulesEditor.default-long-hold-timeout); }
                        }
                        if RulesEditor.hold-mode != 2: VerticalLayout { spacing: 8px;
                            FormLabel { text: @tr("Hold timeout, ms"); info: @tr("Time before this rule becomes a hold. Leave empty to use the global setting: {} ms", RulesEditor.default-hold-timeout); }
                            HorizontalLayout { spacing: 12px; alignment: start;
                                NumericInput { text <=> RulesEditor.hold-timeout; field-width: 144px; }
                                Text { text: @tr("Global setting: {} ms", RulesEditor.default-hold-timeout); color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                        }
                        }
                        if !RulesEditor.is-chord: VerticalLayout { spacing: 8px;
                        FormLabel { text: @tr("Double-tap ms"); info: @tr("Maximum interval between two taps for this rule. Leave empty to use the global setting: {} ms", RulesEditor.default-double-timeout); }
                        HorizontalLayout { spacing: 12px; alignment: start;
                            NumericInput { text <=> RulesEditor.double-timeout; field-width: 144px; }
                            Text { text: @tr("Global setting: {} ms", RulesEditor.default-double-timeout); color: Theme.muted; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                        }
                        }
                        Text { text: @tr("Leave a timeout empty to use the global setting."); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if RulesEditor.hold-mode == 1: VerticalLayout { spacing: 8px;
                            FormLabel { text: @tr("Release held action for these keys"); info: @tr("Temporarily releases the held key or modifier while these keys are pressed in the layer. First set a hold action for this rule."); }
                            LineEdit { text <=> RulesEditor.isolate; enabled: RulesEditor.hold != "" && !RulesEditor.swallow-hold; placeholder-text: @tr("For example: KeyW, KeyE"); }
                            FormLabel { text: @tr("Activate held action only with these keys"); info: @tr("Defers the hold action until one of these keys is pressed in the layer. First set both a hold action and a layer for this rule."); }
                            LineEdit { text <=> RulesEditor.hold-for; enabled: RulesEditor.hold != "" && !RulesEditor.swallow-hold && RulesEditor.layer != ""; placeholder-text: @tr("For example: Tab"); }
                        }
                    }
                }
                if RulesEditor.dialog == RuleDialog.remove: Text { text: @tr("This rule will be removed from the current layout."); color: Theme.muted; }
                if RulesEditor.dialog == RuleDialog.hold-timeout || RulesEditor.dialog == RuleDialog.double-timeout: LineEdit {
                    text <=> RulesEditor.dialog-value;
                    placeholder-text: @tr("Milliseconds; empty uses default");
                    accepted => { RulesEditor.choose(RulesEditor.dialog-value); }
                }
                Text { text: Locale.text(RulesEditor.status); color: Theme.error; wrap: word-wrap; }
                if RulesEditor.dialog != RuleDialog.conditions && RulesEditor.dialog != RuleDialog.advanced: Rectangle { vertical-stretch: 1; }
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    if RulesEditor.dialog != RuleDialog.advanced && RulesEditor.dialog != RuleDialog.conditions: Button {
                        text: @tr("Clear");
                        enabled: RulesEditor.dialog != RuleDialog.advanced && RulesEditor.dialog != RuleDialog.conditions && RulesEditor.dialog != RuleDialog.remove;
                        clicked => { RulesEditor.choose(""); }
                    }
                    if RulesEditor.dialog == RuleDialog.advanced: Button { text: @tr("Delete rule"); clicked => { RulesEditor.dialog = RuleDialog.remove; } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { RulesEditor.dialog = RuleDialog.none; RulesEditor.refresh(); } }
                    Button {
                        text: RulesEditor.dialog == RuleDialog.remove ? @tr("Delete") : @tr("Apply");
                        primary: true;
                        clicked => {
                            if RulesEditor.dialog == RuleDialog.conditions {
                                RulesEditor.apply-conditions();
                            } else if RulesEditor.dialog == RuleDialog.remove {
                                RulesEditor.remove();
                            } else if RulesEditor.dialog == RuleDialog.advanced {
                                RulesEditor.apply-advanced();
                            } else {
                                RulesEditor.choose(RulesEditor.dialog-value);
                            }
                        }
                    }
                }
            }
        }
    }
    if RulesEditor.dialog == RuleDialog.remove: ConfirmDialog {
        title: @tr("Delete rule?"); body: @tr("This rule will be removed from the current layout."); confirm-text: @tr("Delete");
        confirm => { RulesEditor.remove(); } cancel => { RulesEditor.dialog = RuleDialog.none; }
    }

}
