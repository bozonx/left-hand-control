import { AppState } from "app-state.slint";
import { SearchField, TextField } from "controls.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { ActionPicker } from "action-picker.slint";
import { CategoryIcon } from "action-picker.slint";
import { ConditionsForm, ConditionChoices } from "conditions.slint";
import { DragDrop, DragGroups, DragHandle, DropMarker } from "reorder.slint";
import { CardHeader, ResettableField, IconButton, ConfirmDialog, DialogFrame, ItemStyle, InfoTip, Badge, SelectField, NumericInput, FormLabel, FormField, ButtonGroup, Divider, MenuSurface, MenuItem, MenuLabel, PageLayout, PageHeader, FieldButton } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { RuleDialog, HoldMode, GameCondition, PickerCategory, HoldDetection } from "types.slint";
import { Button, CheckBox, ComboBox } from "std-widgets.slint";

export struct RuleRow { key: string, is-chord: bool, tap: string, hold: string, long-hold: string, long-hold-timeout: string, hold-mode: HoldMode, double-tap: string, layer: string, has-conditions: bool, game: GameCondition, languages: string, applications: string, excluded: string, hold-timeout: string, hold-detection: HoldDetection, double-timeout: string, enabled: bool, swallow-tap: bool, swallow-hold: bool, advanced: bool, key-category: PickerCategory, tap-category: PickerCategory, hold-category: PickerCategory, double-category: PickerCategory, long-hold-category: PickerCategory }
export struct RuleLayerChoice { id: string, label: string }

/// Rules of the layout being edited.
export global RulesEditor {
    in property <[RuleRow]> rows;
    in property <int> created: -1;
    in-out property <int> selected: -1;
    in property <Message> status;
    in property <string> default-hold-timeout;
    in property <string> default-long-hold-timeout;
    in property <string> default-double-timeout;
    in property <HoldDetection> default-hold-detection: HoldDetection.release;
    /// Fields of the selected rule, filled by `select`.
    in-out property <string> key;
    in property <bool> is-chord;
    in-out property <string> layer;
    in-out property <string> tap;
    in-out property <string> hold;
    in-out property <string> long-hold;
    in-out property <string> long-hold-timeout;
    in-out property <string> original-long-hold-timeout;
    in-out property <HoldMode> hold-mode;
    in-out property <string> double-tap;
    in-out property <GameCondition> game-mode;
    in-out property <string> layouts;
    in-out property <string> apps-include;
    in-out property <string> apps-exclude;
    /// When the held key is pressed, and the layer keys this applies to
    /// (comma-separated, and as items for the chips).
    in-out property <HoldDetection> hold-detection;
    in-out property <HoldDetection> original-hold-detection;
    in-out property <string> hold-timeout;
    in-out property <string> double-timeout;
    in property <string> original-hold;
    in property <bool> original-swallow-hold;
    in-out property <string> original-hold-timeout;
    in-out property <string> original-double-timeout;
    out property <bool> advanced-dirty: hold-detection != original-hold-detection || long-hold-timeout != original-long-hold-timeout || hold != original-hold || swallow-hold != original-swallow-hold || hold-timeout != original-hold-timeout || double-timeout != original-double-timeout;
    in-out property <bool> enabled: true;
    in-out property <bool> swallow-tap;
    in-out property <bool> swallow-hold;
    /// Open dialog; `none` while the action picker edits `field`.
    in-out property <RuleDialog> dialog: RuleDialog.none;
    /// Rule property that `choose` changes.
    in-out property <RuleDialog> field: RuleDialog.none;
    in-out property <string> dialog-value;
    in-out property <string> new-layer-name;
    in property <[RuleLayerChoice]> layer-items;
    in property <string> layer-id;
    in-out property <int> layer-highlight;
    callback refresh();
    callback select(int);
    callback add();
    callback remove();
    callback move(int, int);
    /// Change a property of the selected rule in place.
    /// Enable or disable the selected rule.
    callback set-enabled(bool);
    /// Change what holding the selected rule's trigger does.
    callback set-hold-mode(HoldMode);
    /// Open `dialog` for rule `index`.
    callback open-dialog(int, RuleDialog);
    /// Apply `value` to `field` of the selected rule.
    callback choose(string);
    callback filter-layers(string);
    callback apply-conditions();
    callback apply-advanced();
    callback create-layer(string);
    /// Why `name` cannot be used for a new layer.
    pure callback layer-name-error(name: string) -> Message;
}

component ConditionChip inherits VerticalLayout {
    in property <image> icon;
    in property <string> text;
    in property <color> tint: Theme.accent;
    alignment: center;
    min-width: 0px;
    horizontal-stretch: 0;
    Rectangle {
        min-width: 0px; max-width: 260px; height: 24px; border-radius: self.height / 2;
        background: Theme.selected; border-width: Theme.eink ? 1px : 0px; border-color: Theme.divider;
        HorizontalLayout { padding-left: Theme.space-m; padding-right: Theme.space-m-plus; spacing: Theme.space-xs; min-width: 0px;
            VerticalLayout { alignment: center; Image { width: 14px; height: 14px; source: root.icon; colorize: root.tint; } }
            Text { min-width: 0px; text: root.text; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; }
        }
    }
}

/// Rule conditions as one chip per kind; the whole group opens the editor.
component ConditionsCell inherits Rectangle {
    in property <RuleRow> rule;
    in property <bool> enabled: true;
    callback clicked();
    min-width: 0px;
    horizontal-stretch: 0;
    height: Theme.control-height;
    border-radius: Theme.radius;
    background: conditions-touch.has-hover ? Theme.hover : transparent;
    accessible-role: button; accessible-label: @tr("Conditions");
    accessible-action-default => { root.clicked(); }
    HorizontalLayout { min-width: 0px; padding-left: Theme.space-s; padding-right: Theme.space-s; spacing: Theme.space-s;
        VerticalLayout { alignment: center;
            Image { width: 16px; height: 16px; source: @image-url("icons/list-filter.svg"); colorize: root.rule.has-conditions ? Theme.accent : Theme.muted; }
        }
        if !root.rule.has-conditions: Text { text: @tr("Always"); color: Theme.muted; vertical-alignment: center; }
        if root.rule.has-conditions: Text { text: @tr("If:"); color: Theme.muted; vertical-alignment: center; }
        if AppState.in-development && root.rule.game != GameCondition.any: ConditionChip { icon: @image-url("icons/gamepad-2.svg"); text: root.rule.game == GameCondition.on ? @tr("Game mode on") : @tr("Game mode off"); }
        if root.rule.languages != "": ConditionChip { icon: @image-url("icons/globe.svg"); text: root.rule.languages; }
        if root.rule.applications != "": ConditionChip { icon: @image-url("icons/app-window.svg"); text: root.rule.applications; tint: Theme.success; }
        if root.rule.excluded != "": ConditionChip { icon: @image-url("icons/ban.svg"); text: root.rule.excluded; tint: Theme.error; }
    }
    conditions-touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component RuleCell inherits VerticalLayout {
    padding: 0px;
    in property <string> title;
    in property <string> info;
    in property <string> value;
    in property <string> empty-text: @tr("Not set");
    in property <bool> enabled: true;
    in property <PickerCategory> category;
    callback clicked();
    opacity: root.enabled ? 1 : 0.5;
    spacing: Theme.space-xs;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    FormLabel { text: root.title; info: root.info; }
    FieldButton {
        enabled: root.enabled;
        accessible-label: root.title;
        accessible-value: root.value;
        clicked => { root.clicked(); }
        if root.value != "" && root.category != PickerCategory.none: CategoryIcon { category: root.category; }
        Text { min-width: 0px; horizontal-stretch: 1; text: root.value == "" ? root.empty-text : root.value; color: root.value == "" ? Theme.muted : Theme.text; vertical-alignment: center; overflow: elide; }
    }
}

/// What holding the trigger does: nothing, a layer, or a long-hold action,
/// all picked from one menu.
component HoldField inherits VerticalLayout {
    padding: 0px;
    in property <int> rule-index;
    in property <RuleRow> rule;
    in property <bool> enabled: true;
    private property <bool> creating;
    private property <length> scroll-y;
    private property <int> count: RulesEditor.layer-items.length;
    private property <int> choice-count: root.count + (AppState.in-development ? 2 : 1);
    private property <length> list-height: min(216px, max(Theme.control-height-l, root.count * Theme.control-height-l));
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    spacing: Theme.space-xs;
    function close-menu() { menu.close(); RulesEditor.dialog = RuleDialog.none; field-focus.focus(); }
    // Menu entries: 0 = nothing, 1..count = layers, count + 1 = action.
    function choose(index: int) {
        if index == 0 {
            RulesEditor.set-hold-mode(HoldMode.none);
            root.close-menu();
        } else if index <= root.count {
            RulesEditor.choose(RulesEditor.layer-items[index - 1].id);
            if RulesEditor.dialog == RuleDialog.none { field-focus.focus(); menu.close(); }
        } else if AppState.in-development {
            root.close-menu();
            RulesEditor.open-dialog(root.rule-index, RuleDialog.long-hold);
        }
    }
    function reveal() {
        if RulesEditor.layer-highlight < 1 || RulesEditor.layer-highlight > root.count { return; }
        let top = (RulesEditor.layer-highlight - 1) * Theme.control-height-l;
        if top < -root.scroll-y { root.scroll-y = -top; }
        if top + Theme.control-height-l > -root.scroll-y + root.list-height { root.scroll-y = -(top + Theme.control-height-l - root.list-height); }
    }
    function open-menu() {
        if !root.enabled { return; }
        RulesEditor.open-dialog(root.rule-index, RuleDialog.layer);
        if root.rule.hold-mode == HoldMode.none { RulesEditor.layer-highlight = 0; }
        if root.rule.hold-mode == HoldMode.action { RulesEditor.layer-highlight = AppState.in-development ? root.count + 1 : 0; }
        root.creating = false;
        root.scroll-y = 0px;
        menu.show();
        root.reveal();
    }
    FormLabel { text: @tr("When held"); info: @tr("Choose a layer active until release, or an action performed once after the hold duration."); }
    field := Rectangle {
        min-width: 0px; height: Theme.control-height; border-radius: Theme.radius;
        border-width: field-focus.has-focus || menu.is-open ? 2px : 1px;
        border-color: field-focus.has-focus ? Theme.focus : menu.is-open ? Theme.accent : Theme.border;
        background: touch.has-hover ? Theme.hover : Theme.surface;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: combobox; accessible-label: @tr("When held");
        accessible-value: value-text.text; accessible-expandable: true; accessible-expanded: menu.is-open;
        accessible-action-expand => { root.open-menu(); }
        forward-focus: field-focus;
        HorizontalLayout { padding-left: Theme.space-m-plus; padding-right: Theme.space-m-plus; spacing: Theme.space-s;
            if root.rule.hold-mode == HoldMode.layer: VerticalLayout { alignment: center; Image { width: 16px; height: 16px; source: @image-url("icons/layers.svg"); colorize: Theme.muted; } }
            if AppState.in-development && root.rule.hold-mode == HoldMode.action && root.rule.long-hold != "": CategoryIcon { category: root.rule.long-hold-category; }
            value-text := Text {
                min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide;
                text: root.rule.hold-mode == HoldMode.layer ? (root.rule.layer != "" ? root.rule.layer : @tr("Choose layer"))
                    : AppState.in-development && root.rule.hold-mode == HoldMode.action ? (root.rule.long-hold != "" ? root.rule.long-hold : @tr("Choose action"))
                    : @tr("Nothing");
                color: (root.rule.hold-mode == HoldMode.layer && root.rule.layer != "") || (AppState.in-development && root.rule.hold-mode == HoldMode.action && root.rule.long-hold != "") ? Theme.text : Theme.muted;
            }
            VerticalLayout { alignment: center; Image { width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; } }
        }
        field-focus := FocusScope { enabled: root.enabled; key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow || event.text == Key.UpArrow { root.open-menu(); return accept; }
            return reject;
        } }
        touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.open-menu(); } }
        menu := PopupWindow {
            x: 0px; y: field.height + Theme.menu-offset; width: max(field.width, 300px);
            height: popup-content.preferred-height;
            close-policy: close-on-click-outside;
            forward-focus: menu-focus;
            menu-focus := FocusScope {
                capture-key-pressed(event) => {
                    if event.text == Key.Escape { root.close-menu(); return accept; }
                    if !root.creating && (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                        RulesEditor.layer-highlight = mod(RulesEditor.layer-highlight + root.choice-count + (event.text == Key.DownArrow ? 1 : -1), root.choice-count);
                        root.reveal(); return accept;
                    }
                    if !root.creating && event.text == Key.Return { root.choose(RulesEditor.layer-highlight); return accept; }
                    return reject;
                }
                popup-content := MenuSurface { inset: Theme.space-m; gap: Theme.space-s;
                        MenuItem { text: @tr("Nothing"); checked: root.rule.hold-mode == HoldMode.none; highlighted: RulesEditor.layer-highlight == 0; clicked => { root.choose(0); } }
                        Divider {}
                        MenuLabel { text: @tr("Layers"); }
                        ScrollView { height: root.list-height; vertical-stretch: 0; viewport-width: self.visible-width; viewport-y <=> root.scroll-y;
                            VerticalLayout { spacing: 0px; alignment: start;
                                for item[index] in RulesEditor.layer-items: MenuItem {
                                    text: item.label; has-icon: true; icon: @image-url("icons/layers.svg");
                                    checked: root.rule.hold-mode == HoldMode.layer && RulesEditor.layer-id == item.id;
                                    highlighted: RulesEditor.layer-highlight == index + 1;
                                    clicked => { root.choose(index + 1); }
                                }
                                if root.count == 0: MenuItem { text: @tr("Layer not found"); enabled: false; }
                            }
                        }
                        Button { text: RulesEditor.dialog-value == "" ? @tr("Create new layer…") : @tr("Create “{}”", RulesEditor.dialog-value); clicked => { root.creating = true; RulesEditor.new-layer-name = RulesEditor.dialog-value; } }
                        if root.creating: HorizontalLayout { spacing: Theme.space-m;
                            FormField { horizontal-stretch: 1; autofocus: true; text <=> RulesEditor.new-layer-name; placeholder: @tr("New layer name"); error: RulesEditor.layer-name-error(RulesEditor.new-layer-name);
                                accepted => { if RulesEditor.layer-name-error(RulesEditor.new-layer-name).id != "" { return; } RulesEditor.create-layer(RulesEditor.new-layer-name); if RulesEditor.dialog == RuleDialog.none { field-focus.focus(); menu.close(); } } }
                            VerticalLayout { alignment: start; Button { text: @tr("Create layer"); enabled: RulesEditor.layer-name-error(RulesEditor.new-layer-name).id == ""; clicked => { RulesEditor.create-layer(RulesEditor.new-layer-name); if RulesEditor.dialog == RuleDialog.none { field-focus.focus(); menu.close(); } } } }
                        }
                        if AppState.in-development: Divider {}
                        if AppState.in-development: MenuLabel { text: @tr("Action after {} ms of holding", RulesEditor.long-hold-timeout != "" ? RulesEditor.long-hold-timeout : RulesEditor.default-long-hold-timeout); }
                        if AppState.in-development: MenuItem {
                            has-icon: true; icon: @image-url("icons/zap.svg");
                            text: root.rule.hold-mode == HoldMode.action && root.rule.long-hold != "" ? @tr("Assign action") + ": " + root.rule.long-hold : @tr("Assign action") + "…";
                            checked: root.rule.hold-mode == HoldMode.action;
                            highlighted: RulesEditor.layer-highlight == root.count + 1;
                            clicked => { root.choose(root.count + 1); }
                        }
                        if RulesEditor.status.id != "": Text { text: Locale.text(RulesEditor.status); color: Theme.error; wrap: word-wrap; }
                }
            }
        }
    }
}

export component RulesPage inherits PageLayout {
    /// Advanced options of `rule` that differ from the defaults, as one line.
    pure function summary(rule: RuleRow) -> string {
        return join(join(join(join(held-text(rule),
            rule.hold-detection == HoldDetection.release ? @tr("Hold on other key release")
                : rule.hold-detection == HoldDetection.press ? @tr("Hold on other key press") : ""),
            rule.hold-timeout != "" ? @tr("Hold after {} ms", rule.hold-timeout) : ""),
            AppState.in-development && rule.hold-mode == HoldMode.action && rule.long-hold-timeout != "" ? @tr("Long hold after {} ms", rule.long-hold-timeout) : ""),
            rule.double-timeout != "" ? @tr("Double tap: {} ms", rule.double-timeout) : "");
    }
    pure function held-text(rule: RuleRow) -> string {
        return rule.hold-mode == HoldMode.action ? ""
            : rule.hold != "" ? @tr("Holds {}", rule.hold)
            : rule.hold-mode == HoldMode.none && rule.swallow-hold ? @tr("Holds nothing") : "";
    }
    pure function join(first: string, second: string) -> string {
        return first == "" ? second : second == "" ? first : first + " · " + second;
    }
    PageHeader {
        title: @tr("Triggers");
        info: @tr("Define how physical keys behave: tap for a key or action, hold to switch layers, or double-tap for extra shortcuts.");
        VerticalLayout { alignment: center;
            Button { text: @tr("Add rule"); primary: true; icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { RulesEditor.add(); rule-scroll.viewport-y = 0px; } }
        }
    }
    rule-scroll := ScrollView { viewport-width: self.visible-width; drag-scroll: true; vertical-stretch: 1;
        PageContent { width: rule-scroll.visible-width; spacing: Theme.space-m-plus; alignment: start;
            for rule[index] in RulesEditor.rows: Rectangle {
                vertical-stretch: 0;
                min-height: rule-content.preferred-height;
                min-width: 0px;
                background: RulesEditor.created == index ? Theme.selected : Theme.card;
                animate background { duration: Theme.highlight-motion; }
                border-color: (DragDrop.dragging && DragDrop.group == DragGroups.rules && DragDrop.source == index) ? Theme.focus : Theme.divider;
                border-width: 1px;
                border-radius: Theme.radius-panel;
                opacity: ItemStyle.opacity(rule.enabled) * (DragDrop.dragging && DragDrop.group == DragGroups.rules && DragDrop.source == index ? Theme.dragged-opacity : 1);

                rule-content := VerticalLayout { min-width: 0px; padding: Theme.space-l-plus; spacing: Theme.space-m-plus;
                    rule-header := HorizontalLayout { spacing: Theme.space-s;
                        rule-drag := DragHandle { group: DragGroups.rules; index: index; count: RulesEditor.rows.length; dropped(from, to) => { RulesEditor.move(from, to); } }
                        rule-enabled := CheckBox { accessible-label: @tr("Enabled"); checked: rule.enabled; toggled => { RulesEditor.select(index); RulesEditor.set-enabled(self.checked); } }
                        if AppState.in-development: ConditionsCell {
                            // Reserve conditions before allocating space to the optional summary.
                            min-width: min(self.preferred-width, max(0px, rule-header.width - rule-drag.preferred-width - rule-enabled.preferred-width - rule-options.preferred-width - 5 * Theme.space-s - 12px));
                            enabled: rule.key != ""; rule: rule; clicked => { ConditionChoices.refresh(); RulesEditor.open-dialog(index, RuleDialog.conditions); }
                        }
                        Rectangle { horizontal-stretch: 1; min-width: 12px; }
                        if root.summary(rule) != "": Text {
                            horizontal-stretch: 0; min-width: 0px; max-width: 640px; overflow: elide; vertical-alignment: center;
                            text: root.summary(rule);
                            color: Theme.muted;
                            TouchArea { enabled: rule.key != ""; mouse-cursor: pointer; clicked => { RulesEditor.open-dialog(index, RuleDialog.advanced); } }
                        }
                        rule-options := IconButton { enabled: rule.key != ""; icon: @image-url("icons/settings-2.svg"); tooltip: @tr("Advanced rule options"); clicked => { RulesEditor.open-dialog(index, RuleDialog.advanced); }
                            if RulesEditor.dialog == RuleDialog.advanced && RulesEditor.selected == index && RulesEditor.advanced-dirty: Rectangle {
                                x: parent.width - 5px; y: 3px; width: 7px; height: 7px; border-radius: Theme.radius-small; background: Theme.accent;
                            }
                        }
                    }
                    HorizontalLayout { min-width: 0px; spacing: Theme.space-l;
                        RuleCell { width: 180px; horizontal-stretch: 0; title: @tr("Trigger"); info: @tr("A trigger can be a single key or a combination, such as ShiftLeft+ControlLeft. The combination works in either press order and ends when any key is released."); value: rule.key; category: rule.key-category; clicked => { RulesEditor.open-dialog(index, RuleDialog.key); } }
                        Rectangle { width: 1px; background: Theme.divider; }
                        RuleCell { title: @tr("Tap action"); info: @tr("Action performed when the trigger is pressed and released quickly without holding."); value: rule.tap; category: rule.tap-category; empty-text: rule.swallow-tap ? @tr("Suppress") : @tr("Do not process"); clicked => { RulesEditor.open-dialog(index, RuleDialog.tap); } }
                        HoldField { enabled: rule.key != ""; rule-index: index; rule: rule; }
                        if !rule.is-chord: RuleCell { title: @tr("Double-tap action"); info: @tr("Action performed when the trigger is pressed twice quickly within the double-tap timeout."); value: rule.double-tap; category: rule.double-category; empty-text: @tr("No separate action"); clicked => { RulesEditor.open-dialog(index, RuleDialog.double-tap); } }
                        if rule.is-chord: Rectangle { horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; }
                    }
                }
                DropMarker { cross-size: parent.width; group: DragGroups.rules; index: index; row-start: parent.y; row-size: parent.height; }
            }
        }
    }
}

export component RuleDialogOverlay inherits FocusScope {
    focus-on-tab-navigation: false;
    enabled: RulesEditor.dialog != RuleDialog.none && !ActionPicker.opened;
    key-pressed(event) => { if event.text == Key.Escape { RulesEditor.dialog = RuleDialog.none; return accept; } return reject; }
    if RulesEditor.dialog != RuleDialog.none && RulesEditor.dialog != RuleDialog.remove && RulesEditor.dialog != RuleDialog.layer: DialogFrame {
        title: RulesEditor.dialog == RuleDialog.key ? @tr("Choose a key or combination for the trigger")
            : RulesEditor.dialog == RuleDialog.conditions ? @tr("Trigger conditions")
            : RulesEditor.dialog == RuleDialog.advanced ? @tr("Advanced rule options")
            : @tr("Choose action");
        card-width: RulesEditor.dialog == RuleDialog.conditions ? 680px : 560px;
        // Conditions and advanced options fit their content; the other dialogs keep a fixed height.
        card-height: RulesEditor.dialog == RuleDialog.conditions || RulesEditor.dialog == RuleDialog.advanced ? 0px : 620px;
        close => { RulesEditor.dialog = RuleDialog.none; }
        if RulesEditor.dialog == RuleDialog.conditions: ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
            preferred-height: conditions-form.preferred-height;
            conditions-form := ConditionsForm {
                heading: @tr("If");
                show-exclusions: true;
                game <=> RulesEditor.game-mode; languages <=> RulesEditor.layouts;
                applications <=> RulesEditor.apps-include; excluded <=> RulesEditor.apps-exclude;
            }
        }
        if RulesEditor.dialog == RuleDialog.advanced: ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
            preferred-height: advanced-form.preferred-height;
            advanced-form := VerticalLayout { spacing: Theme.space-3xl; alignment: start;
                held-form := ResettableField {
                    label: @tr("Hold key or combination");
                    info: @tr("The key or combination stays pressed until you release the trigger. Choose modifiers plus one main key, for example Ctrl+KeyC.");
                    active: RulesEditor.hold-mode != HoldMode.action;
                    inactive-reason: @tr("Not used when holding performs a long-hold action.");
                    resettable: false;
                    ButtonGroup {
                        enabled: held-form.active;
                        labels: RulesEditor.hold-mode == HoldMode.none
                            ? [@tr("Trigger itself"), @tr("Don't press"), RulesEditor.hold != "" ? @tr("{} — change…", RulesEditor.hold) : @tr("Other key or combination…")]
                            : [@tr("Don't press"), RulesEditor.hold != "" ? @tr("{} — change…", RulesEditor.hold) : @tr("Other key or combination…")];
                        selected-index: RulesEditor.hold != "" ? (RulesEditor.hold-mode == HoldMode.none ? 2 : 1) : RulesEditor.hold-mode == HoldMode.none && RulesEditor.swallow-hold ? 1 : 0;
                        selected(index) => {
                            if index == (RulesEditor.hold-mode == HoldMode.none ? 2 : 1) {
                                RulesEditor.open-dialog(RulesEditor.selected, RuleDialog.hold);
                            } else {
                                RulesEditor.hold = "";
                                RulesEditor.swallow-hold = RulesEditor.hold-mode == HoldMode.none && index == 1;
                            }
                        }
                    }
                }
                detection-form := ResettableField {
                    label: @tr("Hold detection when another key is pressed");
                    info: @tr("Overrides the default hold detection for this rule. Use release detection for typing keys and press detection for dedicated layer or modifier keys. This does not change chord detection.");
                    active: !RulesEditor.is-chord && RulesEditor.hold-mode != HoldMode.action;
                    inactive-reason: @tr("Used for single-key triggers without a long-hold action.");
                    resettable: false;
                    ComboBox { enabled: detection-form.active; height: Theme.control-height; model: [@tr("Default from Settings: {}", RulesEditor.default-hold-detection == HoldDetection.press ? @tr("as soon as another key is pressed") : @tr("after another key is released")), @tr("After another key is released (better for typing)"), @tr("As soon as another key is pressed")]; current-index: RulesEditor.hold-detection == HoldDetection.release ? 1 : RulesEditor.hold-detection == HoldDetection.press ? 2 : 0; selected(value) => { RulesEditor.hold-detection = self.current-index == 1 ? HoldDetection.release : self.current-index == 2 ? HoldDetection.press : HoldDetection.inherit; } }
                }
                hold-form := ResettableField {
                    label: @tr("Hold threshold, ms");
                    info: @tr("Released earlier, the trigger counts as a tap; held longer, as a hold. Empty uses the default from Settings: {} ms.", RulesEditor.default-hold-timeout);
                    active: RulesEditor.hold-mode != HoldMode.action;
                    inactive-reason: @tr("Not used when holding performs a long-hold action.");
                    modified: RulesEditor.hold-timeout != "";
                    reset-tooltip: @tr("Use the default from Settings: {} ms", RulesEditor.default-hold-timeout);
                    reset => { RulesEditor.hold-timeout = ""; }
                    HorizontalLayout { alignment: start; NumericInput { enabled: hold-form.active; text <=> RulesEditor.hold-timeout; placeholder-text: RulesEditor.default-hold-timeout; label: hold-form.label; minimum: 50; maximum: 1000; } }
                }
                long-form := ResettableField {
                    visible: AppState.in-development;
                    label: @tr("Long-hold threshold, ms");
                    info: @tr("How long to keep holding before the action runs. Empty uses the default from Settings: {} ms.", RulesEditor.default-long-hold-timeout);
                    active: RulesEditor.hold-mode == HoldMode.action;
                    inactive-reason: @tr("Used when a long-hold action is selected.");
                    modified: RulesEditor.long-hold-timeout != "";
                    reset-tooltip: @tr("Use the default from Settings: {} ms", RulesEditor.default-long-hold-timeout);
                    reset => { RulesEditor.long-hold-timeout = ""; }
                    HorizontalLayout { alignment: start; NumericInput { enabled: long-form.active; text <=> RulesEditor.long-hold-timeout; placeholder-text: RulesEditor.default-long-hold-timeout; minimum: 100; maximum: 60000; step: 100; label: long-form.label; } }
                }
                double-form := ResettableField {
                    label: @tr("Double-tap interval, ms");
                    info: @tr("Longest pause between two taps. Empty uses the default from Settings: {} ms.", RulesEditor.default-double-timeout)
                        + "\n\n" + @tr("Applies when a double-tap action is assigned.");
                    active: !RulesEditor.is-chord;
                    inactive-reason: @tr("Double-tap actions are available only for single-key triggers.");
                    modified: RulesEditor.double-timeout != "";
                    reset-tooltip: @tr("Use the default from Settings: {} ms", RulesEditor.default-double-timeout);
                    reset => { RulesEditor.double-timeout = ""; }
                    HorizontalLayout { alignment: start; NumericInput { enabled: double-form.active; text <=> RulesEditor.double-timeout; placeholder-text: RulesEditor.default-double-timeout; label: double-form.label; minimum: 50; maximum: 1000; } }
                }
            }
        }

        if RulesEditor.dialog == RuleDialog.hold-timeout || RulesEditor.dialog == RuleDialog.double-timeout: NumericInput {
            text <=> RulesEditor.dialog-value;
            minimum: 50; maximum: 1000;
            placeholder-text: RulesEditor.dialog == RuleDialog.hold-timeout ? RulesEditor.default-hold-timeout : RulesEditor.default-double-timeout;
            label: RulesEditor.dialog == RuleDialog.hold-timeout ? @tr("Hold threshold, ms") : @tr("Double-tap window, ms");
            accepted => { RulesEditor.choose(RulesEditor.dialog-value); }
        }
        if RulesEditor.status.id != "": Text { text: Locale.text(RulesEditor.status); color: Theme.error; wrap: word-wrap; }
        if RulesEditor.dialog != RuleDialog.conditions && RulesEditor.dialog != RuleDialog.advanced: Rectangle { vertical-stretch: 1; }
        HorizontalLayout { padding: Theme.space-m; vertical-stretch: 0; spacing: Theme.space-m;
            if RulesEditor.dialog != RuleDialog.advanced && RulesEditor.dialog != RuleDialog.conditions: Button {
                text: @tr("Clear");
                clicked => { RulesEditor.choose(""); }
            }
            if RulesEditor.dialog == RuleDialog.advanced: VerticalLayout { alignment: center; IconButton { text: @tr("Delete trigger"); icon: @image-url("icons/trash-2.svg"); clicked => { RulesEditor.dialog = RuleDialog.remove; } } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { RulesEditor.dialog = RuleDialog.none; RulesEditor.refresh(); } }
            Button {
                text: @tr("Apply");
                primary: true;
                clicked => {
                    if RulesEditor.dialog == RuleDialog.conditions {
                        RulesEditor.apply-conditions();
                    } else if RulesEditor.dialog == RuleDialog.advanced {
                        RulesEditor.apply-advanced();
                    } else {
                        RulesEditor.choose(RulesEditor.dialog-value);
                    }
                }
            }
        }
    }
    if RulesEditor.dialog == RuleDialog.remove: ConfirmDialog {
        title: @tr("Delete trigger?"); body: @tr("The trigger and all its assigned actions will be removed from the current layout."); confirm-text: @tr("Delete");
        confirm => { RulesEditor.remove(); } cancel => { RulesEditor.dialog = RuleDialog.none; }
    }

}
