import { Button, ComboBox } from "std-widgets.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";

/// Bubble shown inside a `Tooltip`; `TooltipText` covers the plain-text case.
export component TooltipSurface inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-small;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        @children
    }
}

export component TooltipText inherits TooltipSurface {
    in property <string> text;
    Text { text: root.text; color: Theme.text; font-size: Theme.font-body; }
}

/// One choice out of several buttons, with arrow-key navigation.
/// `pill` draws the compact segmented style used in toolbars.
export component ButtonGroup inherits Rectangle {
    in property <[string]> labels;
    /// Tooltip per button; empty strings show none.
    in property <[string]> tooltips;
    in property <int> selected-index;
    in property <bool> enabled: true;
    in property <bool> pill;
    callback selected(int);
    vertical-stretch: 0;
    background: root.pill ? Theme.surface : transparent;
    border-radius: root.pill ? Theme.radius : 0px;
    HorizontalLayout {
        padding: root.pill ? Theme.space-2xs : 0px;
        spacing: root.pill ? Theme.space-2xs : 0px;
        for label[index] in root.labels: button := Rectangle {
            property <bool> current: root.selected-index == index;
            private property <bool> first: index == 0;
            private property <bool> last: index == root.labels.length - 1;
            height: root.pill ? 28px : 36px;
            border-top-left-radius: root.pill ? Theme.radius-small : self.first ? 4px : 0px;
            border-bottom-left-radius: root.pill ? Theme.radius-small : self.first ? 4px : 0px;
            border-top-right-radius: root.pill ? Theme.radius-small : self.last ? 4px : 0px;
            border-bottom-right-radius: root.pill ? Theme.radius-small : self.last ? 4px : 0px;
            background: root.pill
                ? (self.current ? Theme.text : touch.has-hover || focus.has-focus ? Theme.hover : transparent)
                : (self.current ? Theme.selected : touch.has-hover ? Theme.hover : Theme.card);
            opacity: root.enabled ? 1 : 0.5;
            border-width: root.pill ? 0px : focus.has-focus ? 2px : 1px;
            border-color: focus.has-focus ? Theme.focus : self.current ? Theme.accent : Theme.border;
            accessible-role: radio-button;
            accessible-label: label;
            accessible-checked: self.current;
            accessible-enabled: root.enabled;
            accessible-action-default => { if root.enabled { root.selected(index); } }
            HorizontalLayout {
                padding-left: root.pill ? Theme.space-m-plus : Theme.space-l;
                padding-right: root.pill ? Theme.space-m-plus : Theme.space-l;
                Text {
                    text: label;
                    color: root.pill && button.current ? Theme.surface : Theme.text;
                    font-size: root.pill ? Theme.font-medium : Theme.font-default;
                    font-weight: root.pill || button.current ? Theme.weight-semibold : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            focus := FocusScope {
                enabled: root.enabled;
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" { root.selected(index); return accept; }
                    if event.text == Key.RightArrow { root.selected(mod(root.selected-index + 1, root.labels.length)); return accept; }
                    if event.text == Key.LeftArrow { root.selected(mod(root.selected-index + root.labels.length - 1, root.labels.length)); return accept; }
                    return reject;
                }
            }
            touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.selected(index); } }
            if index < root.tooltips.length && root.tooltips[index] != "": Tooltip { TooltipText { text: root.tooltips[index]; } }
        }
    }
}

export component InfoTip inherits Rectangle {
    in property <string> text;
    width: 18px; height: 18px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: Theme.muted;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        text: "i";
        color: Theme.muted;
        font-size: Theme.font-body;
        font-weight: Theme.weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Tooltip {
        TooltipSurface {
            Text { width: Theme.text-tooltip; text: root.text; color: Theme.text; font-size: Theme.font-body; wrap: word-wrap; }
        }
    }
}

export component SelectField inherits ComboBox {
    width: 180px;
    horizontal-stretch: 0;
}

/// Single-line text field for form values. Unlike the standard `LineEdit`
/// its clear button is opt-in; search fields use `SearchField`.
/// Children are placed after the text.
export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <bool> read-only <=> input.read-only;
    in property <InputType> input-type <=> input.input-type;
    in property <length> font-size <=> input.font-size;
    in property <int> font-weight <=> input.font-weight;
    in property <bool> invalid: false;
    in property <bool> clearable;
    /// Shown before the text when set.
    in property <image> icon;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    /// Keys the text input does not handle; the default rejects them.
    callback key-pressed(KeyEvent) -> EventResult;
    public function select-all() { input.select-all(); }
    public function clear() { input.text = ""; root.edited(""); input.focus(); }
    min-width: 160px;
    min-height: max(32px, input.preferred-height + 8px);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: input;
    border-radius: Theme.radius-small;
    border-width: root.invalid || input.has-focus ? 2px : 1px;
    border-color: root.invalid ? Theme.error : input.has-focus ? Theme.focus : Theme.border;
    background: Theme.surface;
    opacity: root.enabled ? 1.0 : 0.55;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-action-set-value(value) => { root.text = value; root.edited(value); }
    HorizontalLayout {
        padding-left: root.icon.width > 0 ? 8px : 10px;
        padding-right: root.clearable ? 34px : 10px;
        spacing: Theme.space-s;
        if root.icon.width > 0: Image {
            width: 16px;
            source: root.icon;
            colorize: Theme.muted;
            vertical-alignment: center;
        }
        Rectangle {
            min-width: 1px;
            horizontal-stretch: 1;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                text: root.text == "" ? root.placeholder-text : "";
                font-size: input.font-size;
                font-weight: input.font-weight;
                color: Theme.placeholder;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            ContextMenuArea {
                enabled: root.enabled;
                Menu {
                    MenuItem { title: @tr("Cut"); enabled: root.enabled && !root.read-only && root.text != ""; activated => { input.cut(); } }
                    MenuItem { title: @tr("Copy"); enabled: root.text != ""; activated => { input.copy(); } }
                    MenuItem { title: @tr("Paste"); enabled: root.enabled && !root.read-only; activated => { input.paste(); } }
                    MenuItem { title: @tr("Select all"); enabled: root.text != ""; activated => { input.select-all(); } }
                }
                FocusScope {
                    focus-on-tab-navigation: false;
                    key-pressed(event) => { return root.key-pressed(event); }
                    input := TextInput {
                        private property <length> scroll-x;
                        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                        width: max(parent.width - self.text-cursor-width, self.preferred-width);
                        height: parent.height;
                        enabled: root.enabled;
                        single-line: true;
                        vertical-alignment: center;
                        color: Theme.text;
                        selection-background-color: Theme.selected;
                        selection-foreground-color: Theme.text;
                        // The field itself is the accessible node.
                        accessible-role: none;
                        cursor-position-changed(position) => {
                            if position.x + self.scroll-x < 4px {
                                self.scroll-x = 4px - position.x;
                            } else if position.x + self.scroll-x > parent.width - 4px - self.text-cursor-width {
                                self.scroll-x = parent.width - position.x - 4px - self.text-cursor-width;
                            }
                        }
                        edited => { root.edited(self.text); }
                        accepted => { root.accepted(self.text); }
                    }
                }
            }
        }
        @children
    }
    if root.clearable && root.text != "": clear-button := TouchArea {
        width: Theme.icon-button-size; height: Theme.icon-button-size;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: @tr("Clear");
        accessible-action-default => { root.clear(); }
        x: parent.width - self.width - 3px;
        y: (parent.height - self.height) / 2;
        clicked => { root.clear(); }
        Rectangle {
            width: 100%; height: 100%; border-radius: Theme.radius-small;
            background: clear-button.has-hover ? Theme.hover : transparent;
            Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 14px; height: 14px; source: @image-url("icons/x.svg"); colorize: Theme.muted; }
        }
    }
}

/// Search or filter field: a clear button is shown while it holds text,
/// and Escape clears the text before it reaches the enclosing dialog.
export component SearchField inherits TextField {
    icon: @image-url("icons/search.svg");
    key-pressed(event) => {
        if event.text == Key.Escape && root.text != "" { root.clear(); return accept; }
        return reject;
    }
    if root.text != "" && root.enabled && !root.read-only: clear-touch := TouchArea {
        width: 20px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: @tr("Clear search");
        accessible-action-default => { root.clear(); }
        clicked => { root.clear(); }
        Rectangle {
            width: 20px;
            height: 20px;
            border-radius: Theme.radius-small;
            background: clear-touch.has-hover ? Theme.hover : transparent;
            Image { width: 14px; height: 14px; source: @image-url("icons/x.svg"); colorize: Theme.muted; }
        }
    }
}

/// Outlined field showing a value; a click or Space/Enter opens its picker.
/// Children are laid out in a row inside the field.
export component FieldButton inherits Rectangle {
    in property <bool> enabled: true;
    /// The picker this field opened is showing.
    in property <bool> active: false;
    callback clicked();
    min-width: 0px;
    height: Theme.control-height;
    border-radius: Theme.radius;
    border-width: focus.has-focus || root.active ? 2px : 1px;
    border-color: focus.has-focus ? Theme.focus : root.active ? Theme.accent : Theme.border;
    background: root.enabled && touch.has-hover ? Theme.hover : Theme.surface;
    opacity: root.enabled ? 1.0 : 0.45;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Theme.space-m-plus; padding-right: Theme.space-m-plus;
        spacing: Theme.space-s;
        @children
    }
}

/// Icon button; with `text` it grows into an icon + label button.
export component IconButton inherits Rectangle {
    in property <image> icon;
    /// Accessible name when there is no visible text.
    in property <string> label;
    in property <string> text;
    in property <string> tooltip: root.text == "" ? root.label : "";
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <length> size: 28px;
    callback clicked();
    min-width: root.size;
    height: root.text == "" ? root.size : 32px;
    max-width: root.text == "" ? root.size : Theme.unbounded;
    border-radius: Theme.radius;
    background: root.primary
        ? (touch.has-hover && root.enabled ? (Theme.dark ? Theme.accent.darker(0.15) : Theme.accent.brighter(0.2)) : Theme.accent)
        : root.enabled && (touch.has-hover || focus.has-focus) ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: root.primary ? Theme.text : Theme.focus;
    opacity: root.enabled || root.text == "" ? 1.0 : 0.45;
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.label != "" ? root.label : root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: root.text == "" ? 0px : 10px;
        padding-right: root.text == "" ? 0px : 12px;
        spacing: Theme.space-s;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Image {
                width: root.text == "" ? root.size * 0.55 : 16px; height: self.width;
                source: root.icon;
                colorize: !root.enabled ? Theme.muted : root.primary ? Theme.on-accent : root.danger ? Theme.error : Theme.text;
                opacity: root.enabled ? 1.0 : 0.4;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.text;
            font-weight: Theme.weight-semibold;
            font-size: Theme.font-medium;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip { TooltipText { text: root.tooltip; } }
}

// One wheel notch is 60px in the winit backend; touchpads send small pixel deltas.
global NumericWheel {
    out property <length> notch: 50px;
}

// Text-backed numeric field: empty means "use the global default" (shown as the placeholder).
// Every numeric value in the UI uses it. The wheel changes the value while the field has focus.
export component NumericInput inherits TouchArea {
    in property <length> field-width: 124px;
    in-out property <string> text <=> edit.text;
    in property <string> placeholder-text <=> edit.placeholder-text;
    in property <string> label;
    in property <float> minimum: 0;
    in property <float> maximum: 2147483647;
    in property <float> step: 10;
    in property <bool> fractional: false;
    callback edited(string);
    callback accepted(string);
    private property <length> wheel;
    private property <bool> focused: edit.has-focus;
    changed focused => { root.wheel = 0; }
    width: root.field-width;
    height: Theme.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.current-value();
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.apply(root.current-value() + root.step); }
    accessible-action-decrement => { root.apply(root.current-value() - root.step); }
    accessible-action-set-value(value) => { if value.is-float() { root.apply(value.to-float()); } }
    function current-value() -> float {
        return root.text.is-float() ? root.text.to-float() : root.placeholder-text.is-float() ? root.placeholder-text.to-float() : root.minimum * 1.0;
    }
    function apply(next: float) {
        root.text = clamp(root.fractional ? round(next * 1000) / 1000 : round(next), root.minimum, root.maximum);
        root.edited(root.text);
    }
    scroll-event(event) => {
        if !root.enabled || !edit.has-focus || event.delta-y == 0 { return reject; }
        // A reversed direction starts a new notch instead of cancelling the partial one.
        if root.wheel != 0 && (root.wheel > 0) != (event.delta-y > 0) { root.wheel = 0; }
        root.wheel += event.delta-y;
        if abs(root.wheel) >= NumericWheel.notch {
            root.apply(root.current-value() + (root.wheel > 0 ? root.step : -root.step));
            root.wheel = 0;
        }
        accept
    }
    edit := TextField {
        enabled: root.enabled;
        width: 100%;
        input-type: root.fractional ? decimal : number;
        accessible-label: root.label;
        accepted(value) => { root.accepted(value); }
        edited(value) => {
            // Only the maximum is enforced while typing: a value below the minimum may still be
            // the start of a valid one, e.g. "0" before "0.5".
            if value.is-float() && value.to-float() > root.maximum {
                root.apply(value.to-float());
            } else {
                root.edited(value);
            }
        }
    }
}

export component Card inherits Rectangle {
    in property <bool> highlighted: false;
    in property <length> radius: Theme.radius-panel;
    background: Theme.card;
    border-width: 1px;
    border-radius: root.radius;
    border-color: root.highlighted ? Theme.accent : Theme.divider;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> fill: Theme.hover;
    height: Theme.badge-height;
    border-radius: Theme.radius-small;
    background: root.fill;
    HorizontalLayout {
        padding-left: Theme.space-s; padding-right: Theme.space-s;
        Text { min-width: 0px; overflow: elide; text: root.text; color: Theme.text; font-size: Theme.font-body; vertical-alignment: center; }
    }
}

export component FormLabel inherits HorizontalLayout {
    in property <string> text;
    in property <string> info;
    spacing: Theme.space-s;
    alignment: start;
    vertical-stretch: 0;
    Text {
        text: root.text;
        color: Theme.text;
        horizontal-stretch: 0;
        min-width: 0px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    if root.info != "": VerticalLayout {
        horizontal-stretch: 0;
        alignment: center;
        InfoTip { text: root.info; }
    }
}

export component FieldLabel inherits Text {
    color: Theme.muted;
    font-size: Theme.font-body;
    font-weight: Theme.weight-semibold;
}

/// Heading hierarchy: section (page block), card, subsection inside a card.
export component SectionTitle inherits Text {
    vertical-stretch: 0;
    color: Theme.text;
    font-size: Theme.font-heading;
    font-weight: Theme.weight-semibold;
}

export component CardTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-subtitle;
    font-weight: Theme.weight-bold;
}

export component SubsectionTitle inherits Text {
    vertical-stretch: 0;
    color: Theme.text;
    font-size: Theme.font-default;
    font-weight: Theme.weight-semibold;
}

/// Group of settings under a large title.
export component Section inherits Rectangle {
    in property <string> title;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 0px;
    max-width: Theme.unbounded;
    height: section-content.preferred-height;
    background: transparent;
    section-content := VerticalLayout {
        padding: 0px;
        padding-top: Theme.space-xl;
        padding-bottom: Theme.space-xl;
        spacing: Theme.space-3xl;
        alignment: start;
        if root.title != "": SectionTitle { text: root.title; }
        @children
    }
}

/// A card of settings with an optional title.
export component TitledCard inherits VerticalLayout {
    in property <string> title;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    max-width: Theme.unbounded;
    Card {
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-l;
            if root.title != "": SubsectionTitle { text: root.title; }
            @children
        }
    }
}

export component CardHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <string> info;
    spacing: Theme.space-m;
    alignment: stretch;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.space-2xs;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            CardTitle { text: root.title; vertical-alignment: center; }
            if root.info != "": VerticalLayout { alignment: center; InfoTip { text: root.info; } }
        }
        if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap; }
    }
    @children
}

/// Document tab with an accent underline; `icon` is optional.
/// Root layout of a settings page; the window provides the outer padding.
export component PageLayout inherits VerticalLayout {
    padding: 0px;
    spacing: Theme.page-gap;
    vertical-stretch: 1;
}

/// Page title row above a scrolling area: keeps actions clear of the scrollbar.
export component PageHeader inherits CardHeader {
    vertical-stretch: 0;
    padding-right: Theme.scrollbar-size + Theme.scrollbar-gap;
}

export component NavTab inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 0;
    min-width: row.preferred-width;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    background: touch.has-hover && !root.selected ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: Theme.space-l; padding-right: Theme.space-l; padding-bottom: Theme.space-xs;
        spacing: Theme.space-s;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image { width: 16px; height: 16px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.muted; }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.muted;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
    Rectangle {
        x: 6px; y: parent.height - self.height;
        width: parent.width - 12px; height: 3px;
        border-top-left-radius: 2px; border-top-right-radius: 2px;
        background: root.selected ? Theme.accent : transparent;
    }
    Rectangle {
        border-radius: Theme.radius;
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.focus;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Top-bar section switch: quiet until selected, then a soft accent fill.
export component NavButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 34px;
    horizontal-stretch: 0;
    min-width: row.preferred-width;
    border-radius: Theme.radius;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: Theme.space-l; padding-right: Theme.space-l;
        spacing: Theme.space-s;
        alignment: center;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Image { width: 16px; height: 16px; source: root.icon; colorize: root.selected ? Theme.accent : Theme.muted; }
        }
        Text { text: root.text; color: root.selected ? Theme.text : Theme.muted; font-weight: Theme.weight-semibold; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

/// Start/stop switch of the mapper. A pill with a round state puck so it
/// reads as a global on/off switch, never as the page's primary action.
export component MapperToggle inherits Rectangle {
    in property <bool> running;
    in property <bool> busy;
    in property <string> text;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback toggled();
    height: Theme.control-height-l;
    horizontal-stretch: 0;
    min-width: max(132px, row.preferred-width);
    border-radius: self.height / 2;
    background: root.running
        ? Theme.success.transparentize(touch.has-hover ? 0.78 : 0.86)
        : touch.has-hover ? Theme.hover : Theme.card;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.focus : root.running ? Theme.success : Theme.border;
    opacity: !root.enabled ? 0.5 : root.busy ? 0.7 : 1;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.running;
    accessible-enabled: root.enabled && !root.busy;
    accessible-action-default => { if root.enabled && !root.busy { root.toggled(); } }
    row := HorizontalLayout {
        padding-left: Theme.space-xs; padding-right: Theme.space-xl;
        spacing: Theme.space-m;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px; height: 26px;
                border-radius: self.height / 2;
                background: root.running ? Theme.success : transparent;
                border-width: root.running ? 0px : 1px;
                border-color: Theme.success;
                Image {
                    width: 12px; height: 12px;
                    source: root.running ? @image-url("icons/square.svg") : @image-url("icons/play.svg");
                    colorize: root.running ? Theme.card : Theme.success;
                }
            }
        }
        Text { text: root.text; color: Theme.text; font-weight: Theme.weight-semibold; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.enabled && !root.busy;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggled(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: root.enabled && !root.busy ? pointer : default;
        clicked => { root.toggled(); }
    }
    if root.tooltip != "": Tooltip { TooltipText { text: root.tooltip; } }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

/// Frame of a dropdown menu inside a `PopupWindow`; place it at
/// `y: <anchor>.height + Theme.menu-offset`.
export component MenuSurface inherits Rectangle {
    in property <length> inset: Theme.space-xs;
    in property <length> gap: 0px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-large;
    VerticalLayout {
        padding: root.inset;
        spacing: root.gap;
        @children
    }
}

/// One menu entry: optional icon, label and a check mark for the current
/// choice. `highlighted` marks the row selected with arrow keys by the menu.
export component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> checked: false;
    in property <bool> highlighted: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();
    height: Theme.control-height-l;
    border-radius: Theme.radius-small;
    background: root.enabled && (touch.has-hover || focus.has-focus || root.highlighted) ? Theme.hover : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: Theme.space-l; padding-right: Theme.space-l; spacing: Theme.space-m;
        opacity: root.enabled ? 1 : 0.45;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image { width: 16px; height: 16px; source: root.icon; colorize: root.danger ? Theme.error : Theme.muted; }
        }
        Text { min-width: 0px; horizontal-stretch: 1; text: root.text; overflow: elide; color: root.danger ? Theme.error : Theme.text; vertical-alignment: center; }
        if root.checked: Text { text: "✓"; color: Theme.accent; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

/// Small muted heading of a group of menu items.
export component MenuLabel inherits HorizontalLayout {
    in property <string> text;
    padding-left: Theme.space-l; padding-right: Theme.space-l;
    padding-top: Theme.space-xs; padding-bottom: Theme.space-xs;
    Text { text: root.text; color: Theme.muted; font-size: Theme.font-caption; font-weight: Theme.weight-semibold; wrap: word-wrap; }
}

/// Modal dialog frame: a scrim that closes the dialog on click, and a
/// centred card with the title, a close button and the dialog content.
/// Escape closes it while focus is inside.
export component DialogFrame inherits Rectangle {
    in property <string> title;
    /// Smaller line under the title; hidden when empty.
    in property <string> subtitle;
    /// Fill the window except a margin instead of using the card size.
    in property <bool> fill;
    in property <length> card-width: 560px;
    /// Card height; 0 fits the content.
    in property <length> card-height: 0px;
    /// Off when the content handles Escape itself.
    in property <bool> close-on-escape: true;
    callback close();
    background: Theme.scrim;
    TouchArea { clicked => { root.close(); } scroll-event(event) => { accept } }
    FocusScope {
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if root.close-on-escape && event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        card := Rectangle {
            width: root.fill ? root.width - 48px : min(root.width - 32px, root.card-width);
            height: root.fill ? root.height - 48px : min(root.height - 64px, root.card-height > 0 ? root.card-height : card-layout.preferred-height);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: Theme.radius-dialog;
            TouchArea {}
            card-layout := VerticalLayout {
                padding: Theme.space-2xl;
                spacing: Theme.space-l;
                HorizontalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                    VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: Theme.space-xs;
                        Text { vertical-stretch: 0; text: root.title; color: Theme.text; font-size: Theme.font-title; font-weight: Theme.weight-bold; wrap: word-wrap; }
                        if root.subtitle != "": Text { text: root.subtitle; color: Theme.muted; font-size: Theme.font-medium; }
                    }
                    IconButton { icon: @image-url("icons/x.svg"); tooltip: @tr("Close"); clicked => { root.close(); } }
                }
                @children
            }
        }
    }
}

export component ConfirmDialog inherits DialogFrame {
    in property <string> body;
    in property <string> confirm-text;
    in property <image> confirm-icon: @image-url("icons/trash-2.svg");
    in property <string> error;
    callback confirm();
    callback cancel();
    card-width: 440px;
    close => { root.cancel(); }
    Text { vertical-stretch: 0; text: root.body; color: Theme.text; wrap: word-wrap; }
    if root.error != "": Text { vertical-stretch: 0; text: root.error; color: Theme.error; wrap: word-wrap; }
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-m;
        alignment: end;
        Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
        Button { init => { self.focus(); } text: root.confirm-text; primary: true; icon: root.confirm-icon; colorize-icon: true; clicked => { root.confirm(); } }
    }
}

/// Single-line dialog field with its validation error under it. The error
/// shows once the field holds text or the user has typed in it, so a
/// freshly opened empty field is not flagged.
export component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    /// Why the text cannot be used; an empty id accepts it.
    in property <Message> error;
    in property <bool> autofocus: false;
    callback accepted();
    private property <bool> touched: false;
    private property <bool> show-error: root.error.id != "" && (root.touched || root.text != "");
    padding: 0px;
    spacing: Theme.space-xs;
    vertical-stretch: 0;
    if root.label != "": Text { text: root.label; color: Theme.text; }
    TextField {
        text <=> root.text;
        placeholder-text: root.placeholder;
        invalid: root.show-error;
        accessible-label: root.label != "" ? root.label : root.placeholder;
        accessible-description: root.show-error ? Locale.text(root.error) : "";
        init => { if root.autofocus { self.focus(); self.select-all(); } }
        edited => { root.touched = true; }
        accepted => { root.accepted(); }
    }
    if root.show-error: Text { text: Locale.text(root.error); color: Theme.error; font-size: Theme.font-body; wrap: word-wrap; }
}

export global ItemStyle {
    public pure function opacity(enabled: bool) -> float { return enabled ? 1.0 : 0.35; }
}

export component Alert inherits Rectangle {
    in property <string> title;
    in property <string> text;
    vertical-stretch: 0;
    min-height: content.preferred-height;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: Theme.warning.transparentize(0.5);
    background: Theme.warning.transparentize(0.88);
    content := HorizontalLayout {
        padding: Theme.space-l;
        spacing: Theme.space-m-plus;
        VerticalLayout { alignment: start; Image { width: 18px; height: 18px; source: @image-url("icons/triangle-alert.svg"); colorize: Theme.warning; } }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: Theme.space-xs;
            if root.title != "": Text { text: root.title; color: Theme.text; font-weight: Theme.weight-bold; wrap: word-wrap; }
            Text { text: root.text; color: root.title != "" ? Theme.muted : Theme.text; wrap: word-wrap; }
        }
        VerticalLayout { alignment: start; @children }
    }
}

component FieldResetSlot inherits Rectangle {
    in property <bool> modified;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback reset();
    width: Theme.icon-button-size; height: Theme.icon-button-size;
    if root.modified: IconButton {
        enabled: root.enabled;
        icon: @image-url("icons/rotate-ccw.svg");
        tooltip: root.tooltip;
        clicked => { root.reset(); }
    }
}

/// Form field with an independent reset and contextual help.
export component ResettableField inherits VerticalLayout {
    in property <string> label;
    in property <string> info;
    in property <bool> modified;
    in property <bool> active: true;
    /// Place the reset beside the input by default.
    in property <bool> inline-reset: true;
    /// Choice fields show the default as one of their options, so only free inputs get a reset.
    in property <bool> resettable: true;
    in property <string> inactive-reason;
    in property <string> reset-tooltip: @tr("Reset {} to default", root.label);
    callback reset();
    spacing: root.inline-reset ? 8px : 6px;
    alignment: start;
    vertical-stretch: 0;
    HorizontalLayout { spacing: Theme.space-s;
        FormLabel { text: root.label; info: root.info + (root.inactive-reason != "" ? "\n\n" + root.inactive-reason : ""); }
        if !root.inline-reset: Rectangle { horizontal-stretch: 1; }
        if root.resettable && !root.inline-reset: FieldResetSlot {
            modified: root.modified; enabled: root.active; tooltip: root.reset-tooltip;
            reset => { root.reset(); }
        }
    }
    HorizontalLayout { spacing: Theme.space-s; alignment: start;
        VerticalLayout {
            horizontal-stretch: root.inline-reset ? 0 : 1;
            spacing: Theme.space-s; alignment: start;
            @children
        }
        if root.resettable && root.inline-reset: FieldResetSlot {
            modified: root.modified; enabled: root.active; tooltip: root.reset-tooltip;
            reset => { root.reset(); }
        }
    }
}
