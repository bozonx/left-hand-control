import { Theme } from "theme.slint";

/// Drag groups: every reorderable list has its own id, because `DragDrop`
/// remembers row positions per group and index.
export global DragGroups {
    out property <int> layouts: 0;
    out property <int> rules: 1;
    out property <int> layer-tabs: 2;
    out property <int> extra-keys: 3;
    out property <int> macros: 4;
    out property <int> menu-tabs: 5;
    out property <int> keys: 6;
    out property <int> library-rules: 7;
    /// Steps of macro N use `macro-steps + N`.
    out property <int> macro-steps: 100;
}

export global DragDrop {
    in-out property <int> group: -1;
    in-out property <int> source: -1;
    in-out property <int> target: -1;
    in-out property <int> count;
    in-out property <length> offset;
    in-out property <bool> dragging;
    // Pointer position in window coordinates, for edge auto-scroll and 2D drop targets.
    in-out property <length> pointer-x;
    in-out property <length> pointer-y;
    // Wheel deltas from the drag handle (it holds the mouse grab), consumed by the ScrollView.
    in-out property <length> wheel;
    in-out property <int> wheel-serial;
    callback row(int, int, length, length);
    callback locate(int, int, length, int) -> int;
    public function reset() {
        self.group = -1; self.source = -1; self.target = -1; self.count = 0; self.offset = 0px; self.dragging = false;
        self.wheel = 0px;
    }
    public function request-scroll(delta: length) { self.wheel += delta; self.wheel-serial += 1; }
    // The list moved by `shift` under a stationary pointer; the next move event recomputes
    // the offset from the handle, which scrolled along with the list.
    public function scrolled(shift: length) {
        if !self.dragging || shift == 0px { return; }
        self.offset += shift;
        self.target = self.locate(self.group, self.source, self.offset, self.count);
    }
}

export component DragHandle inherits Rectangle {
    in property <int> group;
    in property <int> index;
    in property <int> count;
    in property <bool> horizontal;
    callback dropped(int, int);
    width: Theme.icon-button-size; height: Theme.icon-button-size;
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: @tr("Drag");
    Image { x: 6px; y: 6px; width: 16px; height: 16px; source: @image-url("icons/grip.svg"); colorize: Theme.muted; }
    touch := TouchArea {
        mouse-cursor: self.pressed ? grabbing : grab;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                DragDrop.group = root.group; DragDrop.source = root.index; DragDrop.target = root.index; DragDrop.count = root.count;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && DragDrop.group == root.group {
                let from = DragDrop.source; let to = DragDrop.target; let moved = DragDrop.dragging;
                DragDrop.reset();
                if moved && from != to { root.dropped(from, to); }
            }
            if event.kind == PointerEventKind.cancel { DragDrop.reset(); }
        }
        // While the handle holds the grab, the wheel comes here instead of the ScrollView.
        scroll-event(event) => {
            if DragDrop.dragging && DragDrop.group == root.group && !root.horizontal { DragDrop.request-scroll(event.delta-y); return accept; }
            reject
        }
        moved => {
            if self.pressed && DragDrop.group == root.group {
                DragDrop.pointer-y = self.absolute-position.y + self.mouse-y;
                DragDrop.offset = root.horizontal ? self.mouse-x - self.pressed-x : self.mouse-y - self.pressed-y;
                if abs(DragDrop.offset) > 6px { DragDrop.dragging = true; }
                if DragDrop.dragging { DragDrop.target = DragDrop.locate(root.group, root.index, DragDrop.offset, root.count); }
            }
        }
    }
}

export component DropMarker inherits Rectangle {
    in property <int> group;
    in property <int> index;
    in property <length> row-y;
    in property <length> row-height;
    init => { DragDrop.row(root.group, root.index, root.row-y, root.row-height); }
    changed group => { DragDrop.row(root.group, root.index, root.row-y, root.row-height); }
    changed index => { DragDrop.row(root.group, root.index, root.row-y, root.row-height); }
    changed row-y => { DragDrop.row(root.group, root.index, root.row-y, root.row-height); }
    changed row-height => { DragDrop.row(root.group, root.index, root.row-y, root.row-height); }
    visible: DragDrop.dragging && DragDrop.group == root.group && DragDrop.target == root.index && DragDrop.target != DragDrop.source;
    y: DragDrop.target > DragDrop.source ? root.row-height - 3px : 0px;
    height: 3px;
    border-radius: Theme.radius-small;
    background: Theme.accent;
}
