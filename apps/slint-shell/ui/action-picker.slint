import { ScrollView } from "scroll.slint";
import { Locale, Message } from "i18n.slint";
import { Theme } from "theme.slint";
import { PickerTarget } from "types.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, TextEdit } from "std-widgets.slint";
export struct PickerItem { value: string, label: string, category: int, notice: Message }
export component CategoryIcon inherits VerticalLayout {
    in property <int> category;
    in property <length> size: 16px;
    width: root.size; min-height: root.size; preferred-height: root.size;
    horizontal-stretch: 0; alignment: center;
    Image {
        width: root.size; height: root.size;
        image-fit: contain; colorize: Theme.muted;
        source: root.category == 1 || root.category == 11 ? @image-url("icons/text-cursor-input.svg")
            : root.category == 3 || root.category == 6 || root.category == 7 ? @image-url("icons/zap.svg")
            : root.category == 4 ? @image-url("icons/gamepad-2.svg")
            : root.category == 8 ? @image-url("icons/terminal.svg")
            : root.category == 9 ? @image-url("icons/app-window.svg")
            : root.category == 10 ? @image-url("icons/settings-2.svg")
            : root.category == 12 ? @image-url("icons/clock.svg")
            : @image-url("icons/keyboard.svg");
    }
}
export global ActionPicker {
    in-out property <bool> opened;
    in-out property <bool> layer-action;
    in-out property <bool> rule-action;
    in-out property <bool> ignore-key;
    in-out property <Message> error;
    in property <Message> notice;
    in-out property <bool> key-only;
    in-out property <bool> capturing;
    in-out property <bool> valid;
    in-out property <string> value;
    in property <int> value-category;
    in-out property <string> original;
    in-out property <string> text-content;
    in-out property <string> pause-content;
    callback begin-capture();
    in-out property <string> query;
    in-out property <int> category;
    in-out property <[PickerItem]> items;
    in-out property <[int]> counts;
    in-out property <bool> macro-step;
    /// Open for `target`; `index` is the row it edits, `value` the current
    /// value and `key-only` limits choices to plain keys.
    callback open(PickerTarget, int, string, bool);
    callback refresh();
    callback apply();
    callback dismiss-picker();
}

component PickerCell inherits Rectangle {
    in property <PickerItem> item;
    in property <bool> compact;
    private property <bool> selected: ActionPicker.value != "" && ActionPicker.value == root.item.value;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: compact ? (root.item.notice.id != "" ? 54px : 38px) : 76px;
    border-width: root.selected ? 2px : 1px; border-radius: 5px;
    border-color: root.selected || item-focus.has-focus ? Theme.link : Theme.border;
    background: root.selected ? Theme.accent : item-touch.has-hover ? Theme.hover : Theme.card;
    accessible-role: button;
    accessible-label: item.label;
    accessible-action-default => { root.pick(); }
    function pick() { ActionPicker.value = root.item.value; ActionPicker.refresh(); }
    HorizontalLayout { padding: 8px; spacing: 7px;
        if ActionPicker.query != "": CategoryIcon { category: root.item.category; }
        VerticalLayout { spacing: 2px; alignment: center;
            Text { min-width: 0px; text: root.item.label; color: Theme.text; font-weight: root.selected ? 700 : 400; wrap: root.compact ? no-wrap : word-wrap; overflow: elide; vertical-alignment: center; }
            if root.item.notice.id != "": Text { text: Locale.text(root.item.notice); color: Theme.warning; font-size: 10px; overflow: elide; }
            if !root.compact && root.item.label != root.item.value: Text { text: root.item.value; color: Theme.muted; font-size: 10px; overflow: elide; }
        }
    }
    item-focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.pick(); return accept; } return reject; } }
    item-touch := TouchArea { clicked => { root.pick(); item-focus.focus(); } }
}

component CategoryButton inherits Rectangle {
    in property <int> index;
    in property <string> title;
    in property <int> count;
    height: 32px; border-radius: 4px;
    background: ActionPicker.query == "" && ActionPicker.category == root.index ? Theme.accent : category-touch.has-hover && ActionPicker.query == "" ? Theme.hover : Theme.card;
    opacity: ActionPicker.query == "" ? 1 : 0.55;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 7px;
        CategoryIcon { category: root.index; }
        Text { text: root.title; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
        if root.index < 11: Text { text: "" + root.count; color: Theme.text; vertical-alignment: center; }
    }
    category-touch := TouchArea { clicked => { ActionPicker.category = root.index; ActionPicker.query = ""; ActionPicker.refresh(); } }
}

export component PickerOverlay inherits Rectangle {
    background: #00000099;
    TouchArea { clicked => { ActionPicker.dismiss-picker(); } }
    focus := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if ActionPicker.capturing { return accept; }
            if event.text == Key.Escape { ActionPicker.dismiss-picker(); return accept; }
            return reject;
        }
        Rectangle {
            x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
            background: Theme.surface; border-radius: 10px; border-width: 1px; border-color: Theme.border;
            TouchArea {}
            VerticalBox { padding: 18px; spacing: 10px;
                HorizontalBox { vertical-stretch: 0;
                    VerticalBox { padding: 0px; spacing: 4px; horizontal-stretch: 1;
                        Text { text: ActionPicker.key-only ? @tr("Choose trigger key") : @tr("Choose action"); color: Theme.text; font-size: 22px; font-weight: 700; }
                        Text { text: @tr("Previously selected: {}", ActionPicker.original); color: Theme.muted; overflow: elide; }
                    }
                }
                Text { text: @tr("Current value"); color: Theme.muted; }
                HorizontalBox { vertical-stretch: 0;
                    if ActionPicker.value != "": CategoryIcon { category: ActionPicker.value-category; }
                    LineEdit { text <=> ActionPicker.value; enabled: !ActionPicker.capturing; edited => { ActionPicker.refresh(); } }
                    if ActionPicker.layer-action || ActionPicker.rule-action: Button { text: ActionPicker.rule-action ? @tr("Swallow key") : @tr("Ignore key"); primary: ActionPicker.ignore-key; clicked => { ActionPicker.ignore-key = true; ActionPicker.value = ""; ActionPicker.refresh(); } }
                    Button { text: @tr("Clear"); enabled: !ActionPicker.key-only && !ActionPicker.macro-step; clicked => { ActionPicker.ignore-key = false; ActionPicker.value = ""; ActionPicker.refresh(); } }
                    Button { text: ActionPicker.capturing ? @tr("Stop capture") : @tr("Capture key"); clicked => { ActionPicker.begin-capture(); focus.focus(); } }
                }
                if ActionPicker.rule-action: Text { text: @tr("Clear restores normal key behavior. Swallow prevents the key from reaching the application."); color: Theme.muted; wrap: word-wrap; }
                if ActionPicker.capturing: Text { text: ActionPicker.key-only ? @tr("Press a key (including modifiers or Escape).") : @tr("Press a key or shortcut. Release a modifier to select it alone."); color: Theme.accent; wrap: word-wrap; }
                if ActionPicker.notice.id != "": Text { text: Locale.text(ActionPicker.notice); color: Theme.warning; wrap: word-wrap; }
                if ActionPicker.error.id != "": Text { text: Locale.text(ActionPicker.error); color: Theme.error; wrap: word-wrap; }
                if !ActionPicker.valid: Text { text: @tr("Choose a valid key or action."); color: Theme.error; }
                HorizontalBox { spacing: 12px;
                    VerticalBox { padding: 0px; spacing: 8px; width: 220px; horizontal-stretch: 0;
                        LineEdit { text <=> ActionPicker.query; placeholder-text: @tr("Search keys and actions"); edited => { ActionPicker.refresh(); } }
                        ScrollView { viewport-width: self.visible-width;
                            VerticalLayout { spacing: 0px;
                                for title[index] in [@tr("Special keys"), @tr("Letters and symbols"), @tr("Digits and numpad"), @tr("Media"), @tr("Mouse"), @tr("Other keys"), @tr("Macros"), @tr("System macros"), @tr("Commands"), @tr("Application"), @tr("System actions"), @tr("Text"), @tr("Pause")]: VerticalBox {
                                    padding: 0px; padding-bottom: 4px;
                                    if index < 6 || (!ActionPicker.key-only && (index < 12 || ActionPicker.macro-step)): CategoryButton {
                                        index: index; title: title; count: ActionPicker.counts[index];
                                    }
                                }
                            }
                        }
                    }
                    catalog := VerticalBox { padding: 0px; min-width: 0px; horizontal-stretch: 1;
                        private property <int> columns: ActionPicker.query == "" && ActionPicker.category < 6 ? min(4, max(2, floor(self.width / (ActionPicker.category == 3 ? 190px : 140px)))) : 2;
                        if ActionPicker.query == "" && ActionPicker.category == 11: VerticalBox { padding: 0px;
                            Text { text: @tr("Literal text (text: prefix is added automatically)"); color: Theme.muted; wrap: word-wrap; }
                            TextEdit { text: ActionPicker.text-content; edited => { ActionPicker.value = "text:" + self.text; ActionPicker.refresh(); } }
                        }
                        if ActionPicker.query == "" && ActionPicker.category == 12: VerticalBox { padding: 0px;
                            Text { text: @tr("Pause in milliseconds (1–10000)"); color: Theme.muted; }
                            LineEdit { text: ActionPicker.pause-content; edited => { ActionPicker.value = "pause:" + self.text; ActionPicker.refresh(); } }
                        }
                        if ActionPicker.query != "" || ActionPicker.category < 11: ScrollView { viewport-width: self.visible-width;
                            VerticalLayout { spacing: 0px;
                                for row in ceil(ActionPicker.items.length / catalog.columns): HorizontalBox { padding: 0px; padding-bottom: 6px; spacing: 6px;
                                    for col in catalog.columns: PickerCell {
                                        item: ActionPicker.items[row * catalog.columns + col];
                                        visible: row * catalog.columns + col < ActionPicker.items.length;
                                        compact: ActionPicker.query != "" || ActionPicker.category < 6;
                                    }
                                }
                            }
                        }
                        if (ActionPicker.query != "" || ActionPicker.category < 11) && ActionPicker.items.length == 0: Text { text: @tr("No matching items"); color: Theme.muted; }
                    }
                }
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    Button { width: 110px; height: 34px; horizontal-stretch: 0; text: @tr("Cancel"); clicked => { ActionPicker.dismiss-picker(); } }
                    Button { width: 125px; height: 34px; horizontal-stretch: 0; primary: true; text: @tr("Apply"); enabled: ActionPicker.valid && !ActionPicker.capturing; clicked => { ActionPicker.apply(); } }
                }
            }
        }
    }
}
