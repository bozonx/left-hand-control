import { AppState } from "app-state.slint";
import { NumericInput, SearchField, TextField } from "controls.slint";
import { ScrollView } from "scroll.slint";
import { Locale, Message } from "i18n.slint";
import { Theme } from "theme.slint";
import { InfoTip } from "controls.slint";
import { PickerBehavior, PickerCategory, PickerTarget, ShortcutDesktop } from "types.slint";
import { Button, CheckBox, VerticalBox, HorizontalBox, TextEdit } from "std-widgets.slint";
export struct PickerItem { value: string, label: string, category: PickerCategory, notice: Message }
/// Picker category in sidebar order with the number of its catalog items.
export struct PickerCategoryCount { category: PickerCategory, count: int }
export component CategoryIcon inherits VerticalLayout {
    in property <PickerCategory> category;
    in property <length> size: 16px;
    width: root.size; min-height: root.size; preferred-height: root.size;
    horizontal-stretch: 0; alignment: center;
    Image {
        width: root.size; height: root.size;
        image-fit: contain; colorize: Theme.muted;
        source: root.category == PickerCategory.modifiers ? @image-url("icons/arrow-big-up.svg")
            : root.category == PickerCategory.letters || root.category == PickerCategory.text ? @image-url("icons/text-cursor-input.svg")
            : root.category == PickerCategory.control-keys ? @image-url("icons/corner-down-left.svg")
            : root.category == PickerCategory.navigation ? @image-url("icons/move.svg")
            : root.category == PickerCategory.media ? @image-url("icons/music-2.svg")
            : root.category == PickerCategory.system-keys ? @image-url("icons/laptop.svg")
            : root.category == PickerCategory.mouse ? @image-url("icons/mouse.svg")
            : root.category == PickerCategory.other-keys ? @image-url("icons/ellipsis.svg")
            : root.category == PickerCategory.macros || root.category == PickerCategory.builtin-macros ? @image-url("icons/zap.svg")
            : root.category == PickerCategory.commands ? @image-url("icons/terminal.svg")
            : root.category == PickerCategory.app ? @image-url("icons/hand.svg")
            : root.category == PickerCategory.system-actions ? @image-url("icons/settings-2.svg")
            : root.category == PickerCategory.desktop-shortcuts ? @image-url("icons/square-function.svg")
            : root.category == PickerCategory.pause ? @image-url("icons/clock.svg")
            : @image-url("icons/keyboard.svg");
    }
}
export global ActionPicker {
    in-out property <bool> opened;
    in-out property <bool> layer-action;
    /// A layer key's keystroke keeps its modifiers pressed until the layer is released.
    in-out property <bool> hold-modifiers;
    in-out property <bool> rule-action;
    in-out property <bool> ignore-key;
    in property <bool> allow-default;
    in property <bool> allow-swallow;
    in property <bool> inherit-default;
    in property <bool> empty-default;
    in property <bool> quick-action;
    in property <bool> hold-layer;
    in property <bool> hold-action;
    in-out property <PickerBehavior> behavior: PickerBehavior.action;
    in-out property <bool> touched;
    callback select-behavior(PickerBehavior);
    in-out property <Message> error;
    in property <Message> notice;
    in-out property <bool> key-only;
    /// Key the chosen action is for, shown under the title; empty when the
    /// title says enough.
    in property <string> subject;
    in property <bool> trigger-chords;
    in-out property <bool> capturing;
    in-out property <bool> valid;
    in-out property <string> value;
    in property <PickerCategory> value-category;
    in-out property <string> original;
    in-out property <string> text-content;
    /// `text-content` on one line, and its number of lines when it has
    /// several (0 otherwise): the action field then shows the preview.
    in property <string> text-preview;
    in property <int> text-lines;
    in-out property <string> pause-content;
    in property <bool> commands-enabled;
    in-out property <string> command-name;
    in-out property <string> command-script;
    in-out property <string> command-directory;
    callback edit-command();
    /// Warning about the command draft, such as a script file that cannot run.
    in property <Message> command-notice;
    in property <Message> command-help;
    callback choose-command-file();
    callback choose-command-directory();
    /// Leave the picker for the Commands tab of the settings.
    callback open-command-settings();
    callback begin-capture();
    in-out property <string> query;
    in-out property <PickerCategory> category: PickerCategory.modifiers;
    /// Source of the desktop-shortcuts category in this session.
    in property <ShortcutDesktop> shortcut-desktop;
    in-out property <[PickerItem]> items;
    /// Every category in sidebar order; the Slint side hides those the
    /// current target does not accept.
    in-out property <[PickerCategoryCount]> categories;
    in-out property <bool> macro-step;
    in-out property <int> title-context;
    /// Open for `target`; `index` is the row it edits, `value` the current
    /// value and `key-only` limits choices to plain keys.
    callback open(PickerTarget, int, string, bool);
    callback refresh();
    in-out property <length> list-scroll;
    callback apply();
    callback dismiss-picker();

    public pure function is-key(category: PickerCategory) -> bool {
        return category == PickerCategory.modifiers || category == PickerCategory.letters
            || category == PickerCategory.control-keys || category == PickerCategory.navigation
            || category == PickerCategory.media
            || category == PickerCategory.system-keys || category == PickerCategory.mouse
            || category == PickerCategory.other-keys;
    }
    /// Whether the category is a list of catalog items rather than an editor.
    public pure function is-listed(category: PickerCategory) -> bool {
        return self.is-key(category) || category == PickerCategory.macros
            || category == PickerCategory.builtin-macros || category == PickerCategory.app
            || category == PickerCategory.system-actions || category == PickerCategory.desktop-shortcuts;
    }
    public pure function title(category: PickerCategory) -> string {
        return category == PickerCategory.modifiers ? @tr("Modifiers")
            : category == PickerCategory.letters ? @tr("Letters, digits and symbols")
            : category == PickerCategory.control-keys ? @tr("Control keys")
            : category == PickerCategory.navigation ? @tr("Navigation and numpad")
            : category == PickerCategory.media ? @tr("Media and launch")
            : category == PickerCategory.system-keys ? @tr("System")
            : category == PickerCategory.mouse ? @tr("Mouse")
            : category == PickerCategory.other-keys ? @tr("Other keys")
            : category == PickerCategory.macros ? @tr("Macros")
            : category == PickerCategory.builtin-macros ? @tr("Built-in macros")
            : category == PickerCategory.commands ? @tr("Commands")
            : category == PickerCategory.app ? @tr("Left Hand Control")
            : category == PickerCategory.system-actions ? @tr("System actions")
            : category == PickerCategory.desktop-shortcuts ? (self.shortcut-desktop == ShortcutDesktop.kde ? @tr("KDE shortcuts") : "")
            : category == PickerCategory.text ? @tr("Text")
            : category == PickerCategory.pause ? @tr("Pause")
            : "";
    }
    /// Which physical button a mouse code is: only Back and Forward are
    /// common, buttons 6–8 exist on some gaming mice.
    public pure function key-hint(value: string) -> string {
        return value == "Mouse6" || value == "Mouse7" || value == "Mouse8" ? @tr("Extra button on some gaming mice")
            : "";
    }
}

component PickerCell inherits Rectangle {
    in property <PickerItem> item;
    in property <bool> compact;
    private property <bool> selected: ActionPicker.value != "" && ActionPicker.value == root.item.value;
    min-width: 0px; preferred-width: 0px; horizontal-stretch: 1; height: compact ? (root.item.notice.id != "" || ActionPicker.key-hint(root.item.value) != "" ? 54px : 38px) : 76px;
    border-width: root.selected ? 2px : 1px; border-radius: Theme.radius-chip;
    border-color: root.selected || item-focus.has-focus ? Theme.link : Theme.border;
    background: root.selected ? Theme.selected : item-touch.has-hover ? Theme.hover : Theme.card;
    accessible-role: button;
    accessible-label: item.label;
    accessible-action-default => { root.pick(); }
    function pick() { ActionPicker.touched = true; ActionPicker.value = root.item.value; ActionPicker.refresh(); }
    HorizontalLayout { padding: Theme.space-m; spacing: 7px;
        if ActionPicker.query != "": CategoryIcon { category: root.item.category; }
        VerticalLayout { spacing: Theme.space-2xs; alignment: center;
            Text { min-width: 0px; text: root.item.label; color: Theme.text; font-weight: root.selected ? 700 : 400; wrap: root.compact ? no-wrap : word-wrap; overflow: elide; vertical-alignment: center; }
            if root.item.notice.id != "": Text { text: Locale.text(root.item.notice); color: Theme.warning; font-size: Theme.font-tiny; overflow: elide; }
            if ActionPicker.key-hint(root.item.value) != "": Text { text: ActionPicker.key-hint(root.item.value); color: Theme.muted; font-size: Theme.font-tiny; overflow: elide; }
            if !root.compact && root.item.category != PickerCategory.commands && root.item.label != root.item.value: Text { text: root.item.value; color: Theme.muted; font-size: Theme.font-tiny; overflow: elide; }
        }
    }
    item-focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.pick(); return accept; } return reject; } }
    item-touch := TouchArea { clicked => { root.pick(); item-focus.focus(); } }
}

component CategoryButton inherits Rectangle {
    in property <PickerCategory> category;
    in property <int> count;
    private property <string> title: ActionPicker.title(root.category);
    height: 32px; border-radius: Theme.radius-small;
    background: ActionPicker.query == "" && ActionPicker.category == root.category ? Theme.selected : category-touch.has-hover && ActionPicker.query == "" ? Theme.hover : Theme.card;
    opacity: ActionPicker.query == "" ? 1 : 0.55;
    HorizontalLayout {
        padding-left: Theme.space-m; padding-right: Theme.space-m; spacing: 7px;
        CategoryIcon { category: root.category; }
        Text { text: root.title; wrap: no-wrap; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
    }
    Tooltip {
        Rectangle {
            background: Theme.card; border-radius: Theme.radius-small; border-width: 1px; border-color: Theme.border;
            HorizontalLayout { padding: Theme.space-s;
                Text { text: root.title; color: Theme.text; font-size: Theme.font-body; }
            }
        }
    }
    category-touch := TouchArea { clicked => { ActionPicker.category = root.category; ActionPicker.query = ""; ActionPicker.list-scroll = 0px; ActionPicker.refresh(); } }
}

export component PickerOverlay inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { ActionPicker.dismiss-picker(); } scroll-event(event) => { accept } }
    focus := FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if ActionPicker.capturing { return accept; }
            if event.text == Key.Escape { ActionPicker.dismiss-picker(); return accept; }
            return reject;
        }
        Rectangle {
            x: 24px; y: 24px; width: parent.width - 48px; height: parent.height - 48px;
            background: Theme.surface; border-radius: Theme.radius-panel; border-width: 1px; border-color: Theme.border;
            TouchArea {}
            VerticalBox { padding: 18px; spacing: Theme.space-m;
                HorizontalBox { vertical-stretch: 0;
                    VerticalBox { padding: 0px; spacing: Theme.space-xs; horizontal-stretch: 1;
                        Text { text: ActionPicker.key-only ? (ActionPicker.trigger-chords ? @tr("Choose a key or key combination") : @tr("Choose trigger key")) : ActionPicker.title-context == 1 ? @tr("Double-tap action") : ActionPicker.title-context == 2 ? @tr("Tap action") : ActionPicker.title-context == 3 ? @tr("Hold another key / combination") : ActionPicker.title-context == 4 ? @tr("Macro step") : ActionPicker.title-context == 5 ? @tr("Long-hold action") : ActionPicker.allow-default || ActionPicker.allow-swallow ? @tr("Edit assignment") : @tr("Choose action"); color: Theme.text; font-size: Theme.font-title; font-weight: Theme.weight-bold; }
                        if ActionPicker.subject != "": Text { text: ActionPicker.subject; color: Theme.muted; font-size: Theme.font-medium; }
                    }
                }
                if ActionPicker.allow-default || ActionPicker.allow-swallow: HorizontalBox { padding: 0px; spacing: Theme.space-m; vertical-stretch: 0;
                    Text { text: @tr("Behavior:"); color: Theme.muted; vertical-alignment: center; }
                    HorizontalBox { spacing: Theme.space-m; horizontal-stretch: 1;
                        if ActionPicker.allow-default: Button {
                            text: ActionPicker.inherit-default ? @tr("Inherit") : ActionPicker.quick-action ? @tr("Empty cell") : ActionPicker.empty-default ? @tr("No separate action") : ActionPicker.hold-layer ? @tr("Activate layer only") : @tr("Do not process");
                            primary: ActionPicker.behavior == PickerBehavior.native;
                            clicked => { ActionPicker.select-behavior(PickerBehavior.native); }
                        }
                        if ActionPicker.allow-swallow: Button { text: @tr("Block"); primary: ActionPicker.behavior == PickerBehavior.swallow; clicked => { ActionPicker.select-behavior(PickerBehavior.swallow); } }
                        Button { text: ActionPicker.hold-action ? @tr("Assign held key") : @tr("Perform action"); primary: ActionPicker.behavior == PickerBehavior.action; clicked => { ActionPicker.select-behavior(PickerBehavior.action); } }
                    }
                }
                if ActionPicker.hold-layer && ActionPicker.behavior != PickerBehavior.native: Text { text: @tr("Holding also activates the selected layer."); color: Theme.muted; wrap: word-wrap; }
                if ActionPicker.behavior != PickerBehavior.action: Text {
                    text: ActionPicker.behavior == PickerBehavior.swallow ? @tr("The key press is consumed: the system and the active application will not receive it.") : ActionPicker.inherit-default ? @tr("Use the assignment from the lower layer or base layout.") : ActionPicker.quick-action ? @tr("Remove the action from this menu cell.") : ActionPicker.empty-default ? @tr("Do not assign a separate action to this gesture.") : ActionPicker.hold-layer ? @tr("Holding activates the selected layer. The original key is not sent.") : @tr("The key press passes through unchanged, as if no assignment were configured.");
                    color: Theme.muted; wrap: word-wrap;
                }
                if ActionPicker.behavior == PickerBehavior.action && ActionPicker.value-category != PickerCategory.commands: HorizontalBox { vertical-stretch: 0;
                    Text { text: ActionPicker.key-only ? @tr("Trigger key:") : @tr("Action:"); color: Theme.muted; vertical-alignment: center; }
                    if ActionPicker.value != "": CategoryIcon { category: ActionPicker.value-category; }
                    if ActionPicker.text-lines > 0: TextField { accessible-label: @tr("Action:"); read-only: true; text: "text:" + ActionPicker.text-preview; }
                    if ActionPicker.text-lines > 0: Text { text: @tr("{n} line" | "{n} lines" % ActionPicker.text-lines); color: Theme.muted; vertical-alignment: center; }
                    if ActionPicker.text-lines == 0: TextField { accessible-label: ActionPicker.key-only ? @tr("Trigger key:") : @tr("Action:"); text <=> ActionPicker.value; enabled: !ActionPicker.capturing; edited => { ActionPicker.touched = true; ActionPicker.refresh(); } }
                    Button { text: ActionPicker.capturing ? @tr("Stop") : @tr("Capture"); clicked => { ActionPicker.begin-capture(); focus.focus(); } }
                    InfoTip { text: ActionPicker.key-only ? @tr("You can enter a key combination using + between keys. Some keys depend on keyboard hardware and may be ignored by the system.") : @tr("You can assign a key combination using + between keys. Availability of special keys depends on the keyboard and desktop environment."); }
                }
                if ActionPicker.layer-action && ActionPicker.behavior == PickerBehavior.action && !ActionPicker.key-only: HorizontalBox { padding: 0px; spacing: Theme.space-s; vertical-stretch: 0; alignment: start;
                    CheckBox { text: @tr("Keep modifiers held until the layer is released"); checked <=> ActionPicker.hold-modifiers; }
                    InfoTip { text: @tr("For a combination such as Alt+Tab: Alt stays pressed while you press the key again and is released together with the layer key, so the window switcher stays open."); }
                }
                if ActionPicker.behavior == PickerBehavior.action && ActionPicker.value-category == PickerCategory.commands && !ActionPicker.commands-enabled: Text { text: ActionPicker.command-name != "" ? ActionPicker.command-name : ActionPicker.command-script; color: Theme.text; wrap: word-wrap; }
                if ActionPicker.capturing: Text { text: ActionPicker.trigger-chords ? @tr("Press one key or hold a combination, then release a key to capture it.") : ActionPicker.key-only ? @tr("Press a key (including modifiers or Escape).") : @tr("Press a key or shortcut. Release a modifier to select it alone."); color: Theme.accent; wrap: word-wrap; }
                if ActionPicker.behavior == PickerBehavior.action && ActionPicker.notice.id != "": Text { text: Locale.text(ActionPicker.notice); color: Theme.warning; wrap: word-wrap; }
                if ActionPicker.error.id != "": Text { text: Locale.text(ActionPicker.error); color: Theme.error; wrap: word-wrap; }
                if ActionPicker.touched && !ActionPicker.valid: Text { text: ActionPicker.key-only ? @tr("Choose a valid trigger key.") : @tr("Choose a valid action."); color: Theme.error; }
                if ActionPicker.behavior != PickerBehavior.action: Rectangle { background: transparent; vertical-stretch: 1; }
                if ActionPicker.behavior == PickerBehavior.action: HorizontalBox { padding: 0px; spacing: Theme.space-l; vertical-stretch: 1;
                    VerticalBox { padding: 0px; spacing: Theme.space-m; width: min(250px, parent.width * 0.35); horizontal-stretch: 0;
                        SearchField { text <=> ActionPicker.query; placeholder-text: ActionPicker.key-only ? @tr("Search keys") : @tr("Search keys and actions"); edited => { ActionPicker.list-scroll = 0px; ActionPicker.refresh(); } }
                        ScrollView { viewport-width: self.visible-width;
                            VerticalLayout { spacing: 0px;
                                for entry in ActionPicker.categories: VerticalBox {
                                    private property <bool> commands: entry.category == PickerCategory.commands;
                                    padding: 0px; padding-bottom: Theme.space-xs;
                                    if !commands || (AppState.in-development && ActionPicker.commands-enabled): VerticalBox { padding: 0px;
                                    // Section headings only when keys and actions share the sidebar.
                                    if !ActionPicker.key-only && !ActionPicker.hold-action && (entry.category == PickerCategory.letters || entry.category == PickerCategory.macros): Text {
                                        text: entry.category == PickerCategory.letters ? @tr("Keys") : @tr("Actions");
                                        color: Theme.muted; font-size: Theme.font-small; font-weight: Theme.weight-bold;
                                    }
                                    // Desktop shortcuts exist only where the session has a shortcut backend.
                                    if (ActionPicker.is-key(entry.category) && entry.count > 0) || (!ActionPicker.is-key(entry.category) && !ActionPicker.key-only && !ActionPicker.hold-action && (entry.category != PickerCategory.pause || ActionPicker.macro-step) && (entry.category != PickerCategory.desktop-shortcuts || entry.count > 0)): CategoryButton {
                                        category: entry.category; count: entry.count;
                                    }
                                    }
                                }
                            }
                        }
                    }
                    catalog := VerticalBox { padding: 0px; min-width: 0px; horizontal-stretch: 1;
                        private property <int> columns: ActionPicker.query == "" && ActionPicker.is-key(ActionPicker.category) ? 4 : 2;
                        if ActionPicker.query == "" && ActionPicker.category == PickerCategory.text: VerticalBox { padding: 0px;
                            HorizontalBox { vertical-stretch: 0;
                                Text { text: @tr("Text to type when the action is invoked:"); color: Theme.muted; wrap: word-wrap; vertical-alignment: center; }
                                InfoTip { text: @tr("Enter literal text without the text: prefix. Line breaks, spaces and tabs are preserved. On Linux, text is inserted into the active application via the desktop portal; permission may be required. Text injection by the mapper is not implemented on Windows or macOS."); }
                            }
                            TextEdit { text: ActionPicker.text-content; edited => { ActionPicker.touched = true; ActionPicker.value = "text:" + self.text; ActionPicker.refresh(); } }
                        }
                        if ActionPicker.query == "" && ActionPicker.category == PickerCategory.desktop-shortcuts: HorizontalBox { vertical-stretch: 0;
                            Text { text: @tr("Global shortcuts registered in this KDE session:"); color: Theme.muted; wrap: word-wrap; vertical-alignment: center; }
                            InfoTip { text: @tr("The list is read from the KDE global shortcut service (kglobalaccel): KWin, Plasma and applications register their actions there. The chosen action is invoked as is, as if its shortcut were pressed, even when no keys are assigned to it. Which actions exist and how they behave depends on the Plasma version and installed applications, so Left Hand Control does not guarantee them. Common window and desktop actions that also work on other platforms are in System actions."); }
                        }
                        if AppState.in-development && ActionPicker.query == "" && ActionPicker.category == PickerCategory.commands && ActionPicker.commands-enabled: VerticalBox { padding: 0px; spacing: Theme.space-m; vertical-stretch: 0;
                            HorizontalBox { vertical-stretch: 0;
                                TextField { text <=> ActionPicker.command-name; placeholder-text: @tr("Command name (optional)"); edited => { ActionPicker.edit-command(); } }
                                InfoTip { text: Locale.text(ActionPicker.command-help); }
                                Button { horizontal-stretch: 0; text: @tr("Choose script…"); clicked => { ActionPicker.choose-command-file(); } }
                            }
                            TextEdit { preferred-height: 130px; text <=> ActionPicker.command-script; placeholder-text: @tr("Shell command or path to a script, e.g. playerctl play-pause"); edited => { ActionPicker.edit-command(); } }
                            if ActionPicker.command-notice.id != "": Text { text: Locale.text(ActionPicker.command-notice); color: Theme.warning; wrap: word-wrap; }
                            HorizontalBox { padding: 0px; spacing: Theme.space-m;
                                TextField { text <=> ActionPicker.command-directory; placeholder-text: @tr("Working directory (home by default)"); edited => { ActionPicker.edit-command(); } }
                                Button { horizontal-stretch: 0; text: @tr("Choose folder…"); clicked => { ActionPicker.choose-command-directory(); } }
                            }
                        }
                        if AppState.in-development && ActionPicker.query == "" && ActionPicker.category == PickerCategory.commands && !ActionPicker.commands-enabled: VerticalBox { padding: 0px; spacing: Theme.space-m; vertical-stretch: 0;
                            Text { text: @tr("Command execution is turned off. Turn it on in the settings to assign commands."); color: Theme.muted; wrap: word-wrap; }
                            HorizontalBox { padding: 0px;
                                Button { horizontal-stretch: 0; text: @tr("Open command settings"); clicked => { ActionPicker.open-command-settings(); } }
                                Rectangle { background: transparent; }
                            }
                        }
                        if ActionPicker.query == "" && ActionPicker.category == PickerCategory.pause: VerticalBox { padding: 0px;
                            Text { text: @tr("Pause in milliseconds (1–10000)"); color: Theme.muted; }
                            NumericInput { text: ActionPicker.pause-content; minimum: 1; maximum: 10000; label: @tr("Pause (ms)"); edited(value) => { ActionPicker.touched = true; ActionPicker.value = "pause:" + value; ActionPicker.refresh(); } }
                        }
                        if (ActionPicker.query != "" || ActionPicker.is-listed(ActionPicker.category)) && ActionPicker.items.length > 0: catalog-list := ScrollView { viewport-width: self.visible-width; viewport-y <=> ActionPicker.list-scroll;
                            VerticalLayout { spacing: 0px;
                                for row in ceil(ActionPicker.items.length * 1.0 / catalog.columns): HorizontalBox { padding: 0px; padding-bottom: Theme.space-s; spacing: Theme.space-s;
                                    for col in catalog.columns: PickerCell {
                                        item: ActionPicker.items[row * catalog.columns + col];
                                        visible: row * catalog.columns + col < ActionPicker.items.length;
                                        compact: ActionPicker.query != "" || ActionPicker.is-key(ActionPicker.category);
                                    }
                                }
                            }
                        }
                        if (ActionPicker.query != "" || ActionPicker.is-listed(ActionPicker.category)) && ActionPicker.items.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text { x: 12px; y: 12px; width: parent.width - 24px; text: @tr("No matching items"); color: Theme.muted; horizontal-alignment: center; }
                        }
                    }
                }
                HorizontalBox { padding: 0px; vertical-stretch: 0; spacing: Theme.space-m;
                    Rectangle { background: transparent; horizontal-stretch: 1; }
                    Button { width: 110px; height: 34px; horizontal-stretch: 0; text: @tr("Cancel"); clicked => { ActionPicker.dismiss-picker(); } }
                    Button { width: 125px; height: 34px; horizontal-stretch: 0; primary: true; text: @tr("Apply"); enabled: ActionPicker.valid && !ActionPicker.capturing; clicked => { ActionPicker.apply(); } }
                }
            }
        }
    }
}
