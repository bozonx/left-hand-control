import { ScrollView } from "scroll.slint";
import { IconButton } from "controls.slint";
import { Locale, Message } from "i18n.slint";
import { Theme } from "theme.slint";

export enum ToastKind { success, warning, error }
export struct ToastItem { token: int, message: Message, kind: ToastKind }
export global NotificationCenter {
    in property <[ToastItem]> items;
    in-out property <bool> initialized;
    public pure function is-problem(id: string) -> bool {
        return id == "config-io" || id == "config-parse" || id == "config-invalid" || id == "mapper-failed" || id == "mapper-running-error" || id == "mapper-stopped-error" || id == "error" || id == "action-failed" || id == "saved-mapper-not-updated" || id == "config-unavailable" || id == "library-changed" || id == "config-edit-conflict";
    }
    public pure function is-warning(id: string) -> bool {
        return id == "rule-duplicate-trigger" || id == "rule-shadowed-trigger" || id == "rule-missing-trigger" || id == "action-unavailable-named" || id == "layout-slot-empty" || id == "saved-mapper-not-updated" || id == "library-changed" || id == "config-edit-conflict" || id == "worker-restarting" || id == "commands-disabled" || id == "action-unavailable" || id == "save-layout-first" || id == "select-input-device";
    }
    callback send(Message);
    callback backend(Message);
    callback dismiss(int);
    callback hover(bool);
    callback worker-recovered();
    in-out property <int> focused-token;
    out property <bool> focused: root.focused-token != 0;
}

component ToastCard inherits Rectangle {
    in property <ToastItem> item;
    property <color> accent: item.kind == ToastKind.error ? Theme.error : item.kind == ToastKind.warning ? Theme.warning : Theme.success;
    height: content.preferred-height;
    background: Theme.card;
    border-color: root.accent;
    border-width: 1px;
    border-radius: Theme.radius-large;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: Locale.text(root.item.message);
    accessible-live-region: root.item.kind == ToastKind.error ? AccessibleLiveness.assertive : AccessibleLiveness.polite;
    content := HorizontalLayout {
        padding: Theme.space-l-plus;
        spacing: Theme.space-l;
        Text { text: root.item.kind == ToastKind.error ? "!" : root.item.kind == ToastKind.warning ? "!" : "✓"; color: root.accent; font-weight: Theme.weight-bold; vertical-alignment: top; }
        VerticalLayout {
            spacing: Theme.space-xs;
            horizontal-stretch: 1;
            Text { text: Locale.text(root.item.message); color: Theme.text; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: start;
            IconButton { size: 24px; icon: @image-url("icons/x.svg"); label: @tr("Dismiss notification");
                changed has-focus => {
                    if self.has-focus { NotificationCenter.focused-token = root.item.token; }
                    else if NotificationCenter.focused-token == root.item.token { NotificationCenter.focused-token = 0; }
                }
                clicked => { NotificationCenter.dismiss(root.item.token); } }
        }
    }
}

export component ToastStack inherits TouchArea {
    in property <length> stack-height-limit: 480px;
    height: min(toast-content.preferred-height, root.stack-height-limit);
    changed has-hover => { NotificationCenter.hover(self.has-hover); }
    toast-list := ScrollView {
        width: root.width;
        height: root.height;
        viewport-width: self.visible-width;
        viewport-height: toast-content.preferred-height;
        toast-content := VerticalLayout {
            width: toast-list.visible-width;
            spacing: Theme.space-m;
            padding: 0px;
            for item in NotificationCenter.items: ToastCard { item: item; }
        }
    }
}
