import { Theme } from "theme.slint";
import { VerticalBox } from "std-widgets.slint";

/// One cap of the base keyboard grid.
export struct BaseKey { code: string, label: string, action: string }

/// Tap actions of the base keyboard (keys outside any layer).
export global KeyEditor {
    /// Rows of `columns` caps, row by row.
    in property <[BaseKey]> keys;
    in property <int> columns: 16;
    in-out property <int> selected: -1;
    /// Open the action picker for the key at `index`.
    callback edit(int);
}

export component KeyboardPage inherits VerticalLayout {
    spacing: 6px;
    VerticalBox {
        spacing: 8px;
        Text { color: Theme.text; text: @tr("Keyboard layout"); font-size: 26px; font-weight: 700; }
        Text { color: Theme.muted; text: @tr("Select a key to assign an action."); }
    }
    keys-focus := FocusScope {
        key-pressed(event) => {
            let count = KeyEditor.keys.length;
            if count == 0 { return reject; }
            if event.text == Key.Return { KeyEditor.edit(max(0, KeyEditor.selected)); return accept; }
            if event.text == Key.RightArrow { KeyEditor.selected = mod(KeyEditor.selected + 1, count); return accept; }
            if event.text == Key.LeftArrow { KeyEditor.selected = mod(KeyEditor.selected + count - 1, count); return accept; }
            return reject;
        }
        VerticalLayout {
            spacing: 6px;
            for row in KeyEditor.keys.length / KeyEditor.columns: HorizontalLayout {
                spacing: 5px;
                for col in KeyEditor.columns: Rectangle {
                    property <int> index: row * KeyEditor.columns + col;
                    height: 66px; min-width: 0px; horizontal-stretch: 1;
                    border-radius: 6px;
                    border-width: KeyEditor.selected == self.index ? 2px : 1px;
                    border-color: KeyEditor.selected == self.index ? Theme.accent : Theme.border;
                    background: key-touch.has-hover ? Theme.hover : Theme.card;
                    accessible-role: button;
                    accessible-label: KeyEditor.keys[self.index].label;
                    accessible-description: KeyEditor.keys[self.index].action;
                    accessible-action-default => { KeyEditor.edit(self.index); }
                    VerticalLayout {
                        padding: 5px;
                        Text { min-width: 0px; overflow: elide; text: KeyEditor.keys[index].label; color: Theme.text; font-size: 12px; }
                        Text { min-width: 0px; text: KeyEditor.keys[index].action == "" ? "—" : KeyEditor.keys[index].action; color: Theme.muted; font-size: 10px; overflow: elide; }
                    }
                    key-touch := TouchArea { clicked => { KeyEditor.selected = index; keys-focus.focus(); KeyEditor.edit(index); } }
                }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}
