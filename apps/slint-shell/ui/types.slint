// Enums shared by the Slint pages and the Rust bindings. They replace the
// integer codes that used to cross the Rust/Slint boundary.

/// Top-level page of the settings window.
export enum Page { keyboard, layouts, settings, rules, layers, macros, menus }

/// Tab of the settings page.
export enum SettingsTab { general, mapper, key-behavior, game-mode, commands, accessibility }

/// Which menu `MenusPage` edits.
export enum MenuKind { emoji, quick }

/// What a key does inside a layer (or an extra key).
export enum Assignment { transparent, swallow, action }

/// Type of an assigned action, shown as an icon on key caps.
export enum ActionKind { none, keys, macro, command, system, app, text }

/// Dialog of the rules page; also the rule property being edited.
export enum RuleDialog { none, key, layer, tap, hold, long-hold, double-tap, conditions, hold-timeout, double-timeout, advanced, remove, release-key }

/// When a rule's held key is pressed while its layer is active.
export enum HoldRelease { always, except }

/// Rule property changed in place (without a dialog).
export enum RuleField { enabled, hold-mode, swallow-tap, swallow-hold, isolate }

/// What key caps on the layers page show: the US-layout label or the internal key code.
export enum LabelMode { label, code }

/// Dialog of the layers page.
export enum LayerDialog { none, create, rename, duplicate, delete, edit-key }

/// Dialog of the layout library.
/// `conflict`: the working copy's library file changed since it was opened.
export enum LibraryDialog { none, create, rule, delete-rule, delete, unsaved, conflict }

/// Action on the selected library layout.
export enum LibraryAction { activate, move-up, move-down, save-details }

/// Starting point of a new layout.
export enum LayoutSource { empty, bundled, copy }

/// What runs once the unsaved-changes question is answered.
export enum PendingLayoutAction { none, edit, create }

/// Game-mode part of a condition.
export enum GameCondition { any, on, off }

export enum GameModeControl { auto, on, off }

/// Who receives the value chosen in the action picker.
export enum PickerTarget { rule, macro-step, quick-action, layer-action, extra-key, extra-action, base-key }

/// Editable field of a macro card.
export enum MacroField { id, name, step-pause, modifier-delay }

/// Category of the action picker; also the icon of an assigned value.
/// The key categories follow `key_catalog::CATEGORIES` in order.
export enum PickerCategory { none, modifiers, letters, control-keys, navigation, media, system-keys, mouse, other-keys, macros, builtin-macros, commands, app, system-actions, desktop-shortcuts, text, pause }

/// Desktop environment whose native global shortcuts fill the picker's
/// desktop-shortcuts category; `none` when it has no shortcut backend.
export enum ShortcutDesktop { none, kde }

/// What an applications-list item is matched by.
export enum AppEntryKind { application, process, title }

/// Per-rule tap/hold detection override.
export enum HoldDetection { inherit, release, press }
