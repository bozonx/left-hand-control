import { MenuSurface, MenuItem, MenuLabel, TooltipText } from "controls.slint";
import { AppState } from "app-state.slint";
import { Locale } from "i18n.slint";
import { Theme } from "theme.slint";
import { GameModeControl } from "types.slint";

export component GameModeButton inherits Rectangle {
    private property <int> highlighted: 0;
    private property <color> state-color: !AppState.game-state-available ? Theme.warning : AppState.game-active ? Theme.success : Theme.muted;
    private property <string> label: AppState.game-control == GameModeControl.auto ? @tr("Game mode control" => "Auto") : AppState.game-control == GameModeControl.on ? @tr("Game mode control" => "On") : @tr("Game mode control" => "Off");
    width: 98px; height: Theme.control-height-l; border-radius: Theme.radius;
    background: AppState.game-active ? Theme.success.transparentize(0.85) : !AppState.game-state-available ? Theme.warning.transparentize(0.9) : touch.has-hover || focus.has-focus || menu.is-open ? Theme.hover : Theme.surface;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.focus : root.state-color.transparentize(0.35);
    accessible-role: button;
    accessible-label: @tr("Game mode") + ": " + root.label + ". " + Locale.text(AppState.game-status);
    accessible-expandable: true;
    accessible-expanded: menu.is-open;
    accessible-action-default => { root.open-menu(); }
    accessible-action-expand => { root.open-menu(); }
    public function open-menu() {
        root.highlighted = AppState.game-control == GameModeControl.auto ? 0 : AppState.game-control == GameModeControl.on ? 1 : 2;
        menu.show();
    }
    HorizontalLayout {
        padding-left: Theme.space-m-plus; padding-right: Theme.space-m; spacing: Theme.space-s; alignment: center;
        VerticalLayout { alignment: center; Image { width: 18px; height: 18px; source: @image-url("icons/gamepad-2.svg"); colorize: root.state-color; } }
        Text { text: root.label; color: root.state-color; font-weight: Theme.weight-semibold; vertical-alignment: center; }
        VerticalLayout { alignment: center; Image { width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: root.state-color; transform-rotation: menu.is-open ? 180deg : 0deg; } }
    }
    forward-focus: focus;
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" || event.text == Key.DownArrow {
                root.open-menu(); return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.open-menu(); } }
    Tooltip { TooltipText { text: Locale.text(AppState.game-status) + "\n" + @tr("Click to change mode (Auto / On / Off)"); } }
    menu := PopupWindow {
        x: root.width - self.width; y: root.height + Theme.menu-offset; width: 280px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            capture-key-pressed(event) => {
                if event.text == Key.DownArrow { root.highlighted = mod(root.highlighted + 1, 3); return accept; }
                if event.text == Key.UpArrow { root.highlighted = mod(root.highlighted + 2, 3); return accept; }
                if event.text == "\n" || event.text == " " {
                    AppState.set-game-control(root.highlighted == 0 ? GameModeControl.auto : root.highlighted == 1 ? GameModeControl.on : GameModeControl.off);
                    focus.focus(); menu.close(); return accept;
                }
                if event.text == Key.Escape { focus.focus(); menu.close(); return accept; }
                return reject;
            }
            MenuSurface {
                MenuLabel { text: @tr("Game mode"); }
                for label[index] in [@tr("Auto — according to settings"), @tr("On — always"), @tr("Off — never")]: MenuItem {
                    text: label;
                    checked: AppState.game-control == (index == 0 ? GameModeControl.auto : index == 1 ? GameModeControl.on : GameModeControl.off);
                    highlighted: root.highlighted == index;
                    accessible-role: radio-button;
                    accessible-checkable: true;
                    clicked => {
                        AppState.set-game-control(index == 0 ? GameModeControl.auto : index == 1 ? GameModeControl.on : GameModeControl.off);
                        focus.focus(); menu.close();
                    }
                }
            }
        }
    }
}
