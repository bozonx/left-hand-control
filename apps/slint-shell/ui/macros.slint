import { DragDrop, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { MacroField, PickerTarget } from "types.slint";
import { InlineTextField, Badge, Card, CardHeader, ConfirmDialog, FieldLabel, IconButton, InfoTip } from "controls.slint";
import { Button, LineEdit, ScrollView } from "std-widgets.slint";

export struct MacroStepRow { action: string, pause: bool, pause-ms: string }
export struct MacroRow { id: string, name: string, step-pause: string, modifier-delay: string, usage: [string], error: Message, steps: [MacroStepRow] }
export struct SystemMacroRow { id: string, name: string, steps: string }
export global MacroEditor {
    in property <[MacroRow]> macros;
    in property <[SystemMacroRow]> system-macros;
    in property <string> default-step-pause;
    in property <string> default-modifier-delay;
    in property <bool> has-errors;
    in property <Message> status;
    in-out property <int> picker-macro: -1;
    callback refresh();
    callback add(string);
    callback clone-system(int, string);
    callback remove(int);
    callback move(int, int);
    callback set-field(int, MacroField, string);
    callback add-step(int, string);
    callback set-step(int, int, string);
    /// Pause of a step while it is typed; saved after a short delay.
    callback set-pause(int, int, string);
    callback move-step(int, int, int);
    callback remove-step(int, int);
}

component StepRow inherits HorizontalLayout {
    in property <int> macro-index;
    in property <int> index;
    in property <int> count;
    in property <MacroStepRow> step;
    callback remove();
    spacing: 8px;
    Text { width: 28px; text: "#" + (root.index + 1); color: Theme.muted; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        alignment: center;
        if !root.step.pause: Rectangle {
            height: 32px;
            border-radius: 6px;
            border-width: 1px;
            border-color: pick-focus.has-focus ? Theme.text : Theme.border;
            background: pick-touch.has-hover ? Theme.hover : Theme.surface;
            accessible-role: button;
            accessible-label: root.step.action == "" ? @tr("Pick an action") : root.step.action;
            accessible-action-default => { self.pick(); }
            function pick() {
                MacroEditor.picker-macro = root.macro-index;
                ActionPicker.open(PickerTarget.macro-step, root.index, root.step.action, false);
            }
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; spacing: 6px;
                if root.step.action == "": Image { width: 14px; source: @image-url("icons/plus.svg"); colorize: Theme.muted; }
                Text {
                    horizontal-stretch: 1;
                    text: root.step.action == "" ? @tr("Pick an action") : root.step.action;
                    color: root.step.action == "" ? Theme.muted : Theme.text;
                    font-family: "monospace";
                    font-size: 13px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            pick-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == " " || event.text == "\n" { parent.pick(); return accept; }
                    return reject;
                }
            }
            pick-touch := TouchArea { mouse-cursor: pointer; clicked => { parent.pick(); } }
        }
        if root.step.pause: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Image { width: 16px; source: @image-url("icons/clock.svg"); colorize: Theme.muted; }
            LineEdit {
                width: 110px;
                input-type: number;
                text: root.step.pause-ms;
                accessible-label: @tr("Pause (ms)");
                edited(value) => { MacroEditor.set-pause(root.macro-index, root.index, value); }
            }
            Text { text: @tr("ms"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
        }
        if !root.step.pause && root.step.action == "": Text {
            text: @tr("Empty step — pick an action or remove it.");
            color: Theme.warning;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    DragHandle { group: 100 + root.macro-index; index: root.index; count: root.count; dropped(from, to) => { MacroEditor.move-step(root.macro-index, from, to); } }
    IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Delete step"); danger: true; clicked => { root.remove(); } }
}

component MacroCard inherits Card {
    in property <int> index;
    in property <int> count;
    in property <MacroRow> item;
    opacity: DragDrop.dragging && DragDrop.group == 4 && DragDrop.source == root.index ? 0.6 : 1;
    DropMarker { width: parent.width; group: 4; index: root.index; row-y: root.y; row-height: root.height; }
    callback remove();
    callback remove-step(int);
    callback copy(string);
    HorizontalLayout {
        padding: 16px;
        spacing: 20px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FieldLabel { text: @tr("ID"); vertical-alignment: center; }
                        InfoTip { text: @tr("Unique identifier used in references like macro:<id>. To bind this macro to a key, choose that action on the Layers or Rules tab. Change the ID only when nothing uses this macro."); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        InlineTextField {
                            text: root.item.id;
                            placeholder: "id";
                            label: @tr("Macro ID");
                            saved(value) => { MacroEditor.set-field(root.index, MacroField.id, value); }
                        }
                        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/copy.svg"); label: @tr("Copy ID"); enabled: root.item.id != ""; clicked => { root.copy(root.item.id); } } }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        FieldLabel { text: @tr("Name"); vertical-alignment: center; }
                        InfoTip { text: @tr("Human-readable macro name, shown in picker lists."); }
                    }
                    InlineTextField {
                        text: root.item.name;
                        placeholder: @tr("Macro name");
                        label: @tr("Name");
                        saved(value) => { MacroEditor.set-field(root.index, MacroField.name, value); }
                    }
                }
            }
            if root.item.error.id != "": Text { text: Locale.text(root.item.error); color: Theme.error; font-size: 12px; wrap: word-wrap; }
            if root.item.usage.length > 0: HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text { text: @tr("Used in:"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                for place in root.item.usage: Badge { text: place; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                spacing: 6px;
                FieldLabel { text: @tr("Steps"); vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: @tr("Add pause"); icon: @image-url("icons/clock.svg"); colorize-icon: true; clicked => { MacroEditor.add-step(root.index, "pause:100"); } }
                Button { text: @tr("Add step"); icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { MacroEditor.add-step(root.index, ""); } }
            }
            if root.item.steps.length == 0: Text { text: @tr("No steps yet. Each step — one chord or action."); color: Theme.muted; font-italic: true; wrap: word-wrap; }
            VerticalLayout {
                spacing: 6px;
                for step[step-index] in root.item.steps: Rectangle {
                    opacity: DragDrop.dragging && DragDrop.group == 100 + root.index && DragDrop.source == step-index ? 0.6 : 1;
                    DropMarker { width: parent.width; group: 100 + root.index; index: step-index; row-y: parent.y; row-height: parent.height; }
                    HorizontalLayout { StepRow {
                    macro-index: root.index;
                    index: step-index;
                    count: root.item.steps.length;
                    step: step;
                    remove => { root.remove-step(step-index); }
                    } }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        VerticalLayout {
            min-width: 200px;
            max-width: 260px;
            horizontal-stretch: 0;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 2px;
                DragHandle { group: 4; index: root.index; count: MacroEditor.macros.length; dropped(from, to) => { MacroEditor.move(from, to); } }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Delete macro"); danger: true; clicked => { root.remove(); } }
            }
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    FieldLabel { text: @tr("Pause between steps"); vertical-alignment: center; }
                    InfoTip { text: @tr("Per-macro pause between steps. Defaults to the Settings value."); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        input-type: number;
                        text: root.item.step-pause;
                        placeholder-text: MacroEditor.default-step-pause;
                        accessible-label: @tr("Pause between steps");
                        edited(value) => { MacroEditor.set-field(root.index, MacroField.step-pause, value); }
                    }
                    Text { text: @tr("ms"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
            }
            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    FieldLabel { text: @tr("Modifier delay"); vertical-alignment: center; }
                    InfoTip { text: @tr("Time between pressing a modifier and the main key within one step. Defaults to the Settings value."); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        input-type: number;
                        text: root.item.modifier-delay;
                        placeholder-text: MacroEditor.default-modifier-delay;
                        accessible-label: @tr("Modifier delay");
                        edited(value) => { MacroEditor.set-field(root.index, MacroField.modifier-delay, value); }
                    }
                    Text { text: @tr("ms"); color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
            }
        }
    }
}

component SystemMacrosHeader inherits Rectangle {
    in-out property <bool> open;
    accessible-role: button;
    accessible-label: @tr("System macros");
    accessible-expanded: root.open;
    accessible-action-default => { root.open = !root.open; }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center; Image { width: 16px; source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); colorize: Theme.muted; } }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text { text: @tr("System macros"); color: Theme.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Badge { text: MacroEditor.system-macros.length; }
            }
            Text { text: @tr("Built-in macros that cannot be edited. To customize, create a user macro based on one."); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
    }
    header-focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.open = !root.open; return accept; }
            return reject;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; header-focus.focus(); } }
}

component SystemMacroLine inherits Rectangle {
    in property <int> index;
    in property <SystemMacroRow> item;
    callback copy(string);
    background: row-touch.has-hover ? Theme.hover.transparentize(0.6) : transparent;
    row-touch := TouchArea {}
    VerticalLayout {
        HorizontalLayout {
            padding-top: 6px; padding-bottom: 6px;
            spacing: 12px;
            HorizontalLayout {
                width: 190px;
                spacing: 4px;
                Text { text: root.item.id; color: Theme.text; font-family: "monospace"; font-size: 12px; vertical-alignment: center; overflow: elide; }
                VerticalLayout { alignment: center; IconButton { size: 24px; icon: @image-url("icons/copy.svg"); label: @tr("Copy ID"); clicked => { root.copy(root.item.id); } } }
            }
            Text { width: 200px; text: root.item.name; color: Theme.text; vertical-alignment: center; wrap: word-wrap; }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.item.steps;
                color: Theme.muted;
                font-family: "monospace";
                font-size: 12px;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            VerticalLayout {
                width: 170px;
                alignment: center;
                Button {
                    text: @tr("Create based on");
                    icon: @image-url("icons/copy-plus.svg");
                    colorize-icon: true;
                    clicked => { MacroEditor.clone-system(root.index, @tr("(copy)")); }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
    }
}

component SystemMacrosCard inherits Card {
    in-out property <bool> open;
    callback copy(string);
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        SystemMacrosHeader { open <=> root.open; }
        if root.open: VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                padding-bottom: 6px;
                spacing: 12px;
                FieldLabel { width: 190px; text: @tr("ID"); }
                FieldLabel { width: 200px; text: @tr("Name"); }
                FieldLabel { horizontal-stretch: 1; text: @tr("Steps"); }
                Rectangle { width: 170px; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            for item[index] in MacroEditor.system-macros: SystemMacroLine {
                index: index;
                item: item;
                copy(value) => { root.copy(value); }
            }
        }
    }
}

export component MacrosPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> system-open: false;
    private property <int> delete-macro: -1;
    private property <int> delete-step: -1;
    clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    function copy(value: string) { clipboard.text = value; clipboard.select-all(); clipboard.copy(); }
    ScrollView {
        width: 100%;
        height: 100%;
        viewport-width: self.visible-width;
        VerticalLayout {
            alignment: start;
            spacing: 16px;
            Rectangle {
                VerticalLayout {
                    padding: 0px;
                    spacing: 16px;
                    CardHeader {
                        title: @tr("User macros");
                        info: @tr("Build reusable sequences from key chords, text actions, commands, or system actions. Steps run in order with the configured pause between them.");
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: @tr("New macro");
                                primary: true;
                                icon: @image-url("icons/plus.svg");
                                colorize-icon: true;
                                enabled: !MacroEditor.has-errors;
                                clicked => { MacroEditor.add(@tr("New macro")); }
                            }
                        }
                    }
                    if MacroEditor.has-errors: Text { text: @tr("Fix the existing macro errors first"); color: Theme.muted; font-size: 12px; }
                    if MacroEditor.status.id != "": Text { text: Locale.text(MacroEditor.status); color: Theme.error; wrap: word-wrap; }
                    if MacroEditor.macros.length == 0: Text { text: @tr("No macros yet. Click \"New macro\" to create the first one."); color: Theme.muted; wrap: word-wrap; }
                    for item[index] in MacroEditor.macros: MacroCard {
                        index: index;
                        count: MacroEditor.macros.length;
                        item: item;
                        remove => { root.delete-step = -1; root.delete-macro = index; }
                        remove-step(step) => { root.delete-macro = index; root.delete-step = step; }
                        copy(value) => { root.copy(value); }
                    }
                }
            }
            SystemMacrosCard { open <=> root.system-open; copy(value) => { root.copy(value); } }
        }
    }
    if root.delete-macro >= 0 && root.delete-step < 0: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete macro?");
        body: @tr("The macro will be deleted. References macro:{} will stop working.", MacroEditor.macros[root.delete-macro].id);
        confirm-text: @tr("Delete");
        cancel => { root.delete-macro = -1; }
        confirm => { MacroEditor.remove(root.delete-macro); root.delete-macro = -1; }
    }
    if root.delete-macro >= 0 && root.delete-step >= 0: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete step?");
        body: @tr("This step will be removed from the macro.");
        confirm-text: @tr("Delete");
        cancel => { root.delete-macro = -1; root.delete-step = -1; }
        confirm => { MacroEditor.remove-step(root.delete-macro, root.delete-step); root.delete-macro = -1; root.delete-step = -1; }
    }
}
