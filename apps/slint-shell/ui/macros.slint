import { ActionField } from "action-controls.slint";
import { Timing } from "timing.slint";
import { NotificationCenter } from "notifications.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { DragDrop, DragGroups, DragHandle, DropMarker } from "reorder.slint";
import { ActionPicker } from "action-picker.slint";
import { CategoryIcon } from "action-controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { MacroField, PickerCategory, PickerTarget } from "types.slint";
import { InlineTextField, Badge, Card, CardHeader, ConfirmDialog, Divider, FieldLabel, IconButton, DurationInput, PageLayout, PageHeader, CardTitle, EmptyState } from "controls.slint";
import { Button } from "std-widgets.slint";

export struct MacroStepRow { action: string, pause: bool, pause-ms: string, category: PickerCategory }
export struct MacroRow { id: string, name: string, step-pause: string, modifier-delay: string, usage: [string], error: Message, steps: [MacroStepRow] }
export struct BuiltinMacroRow { id: string, name: Message, steps: string }
export global MacroEditor {
    in property <[MacroRow]> macros;
    in property <[BuiltinMacroRow]> builtin-macros;
    in property <string> default-step-pause;
    in property <string> default-modifier-delay;
    in property <bool> has-errors;
    in property <bool> has-unsaved-changes;
    in property <Message> status;
    in-out property <int> picker-macro: -1;
    callback refresh();
    callback flush-pending() -> bool;
    callback add(string);
    callback clone-builtin(int, string);
    callback remove(int);
    callback move(int, int);
    callback set-field(int, MacroField, string);
    callback add-step(int, string);
    callback set-step(int, int, string);
    /// Pause of a step while it is typed; saved after a short delay.
    callback set-pause(int, int, string);
    callback move-step(int, int, int);
    callback remove-step(int, int);
}

component StepRow inherits HorizontalLayout {
    in property <int> macro-index;
    in property <int> index;
    in property <int> count;
    in property <MacroStepRow> step;
    callback remove();
    spacing: Theme.space-m;
    Text { width: 28px; text: "#" + (root.index + 1); color: Theme.muted; font-size: Theme.font-body; horizontal-alignment: right; vertical-alignment: center; }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: Theme.space-2xs;
        alignment: center;
        if !root.step.pause: ActionField {
            label: root.step.action;
            value: root.step.action;
            category: root.step.category;
            text-family: "monospace";
            text-size: Theme.font-medium;
            clicked => {
                MacroEditor.picker-macro = root.macro-index;
                ActionPicker.open(PickerTarget.macro-step, root.index, root.step.action, false);
            }
        }
        if root.step.pause: HorizontalLayout {
            spacing: Theme.space-m;
            alignment: start;
            CategoryIcon { category: PickerCategory.pause; }
            Text { text: @tr("Pause"); color: Theme.text; vertical-alignment: center; }
            DurationInput {
                spacing: Theme.space-m;
                text: root.step.pause-ms;
                minimum: Timing.pause.minimum;
                maximum: Timing.pause.maximum;
                label: @tr("Pause (ms)");
                edited(value) => { MacroEditor.set-pause(root.macro-index, root.index, value); }
            }
        }
    }
    DragHandle { group: DragGroups.macro-steps + root.macro-index; index: root.index; count: root.count; dropped(from, to) => { MacroEditor.move-step(root.macro-index, from, to); } }
    IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Delete step"); clicked => { root.remove(); } }
}

component MacroCard inherits Card {
    in property <int> index;
    in property <int> count;
    in property <MacroRow> item;
    opacity: DragDrop.dragging && DragDrop.group == DragGroups.macros && DragDrop.source == root.index ? Theme.dragged-opacity : 1;

    callback remove();
    callback remove-step(int);
    callback copy(string);
    HorizontalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-2xl;
        VerticalLayout {
            width: 400px;
            horizontal-stretch: 0;
            spacing: Theme.space-l-plus;
            alignment: start;
            HorizontalLayout {
                spacing: Theme.space-2xs;
                DragHandle { group: DragGroups.macros; index: root.index; count: MacroEditor.macros.length; dropped(from, to) => { MacroEditor.move(from, to); } }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Delete macro"); clicked => { root.remove(); } }
            }
            HorizontalLayout {
                spacing: Theme.space-l;
                VerticalLayout {
                    width: (parent.width - 12px) / 2;
                    horizontal-stretch: 0;
                    spacing: Theme.space-xs;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        FieldLabel { text: @tr("ID"); vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        InlineTextField {
                            horizontal-stretch: 1;
                            max-width: Theme.unbounded;
                            text: root.item.id;
                            placeholder: "id";
                            label: @tr("Macro ID");
                            saved(value) => { MacroEditor.set-field(root.index, MacroField.id, value); return true; }
                        }
                        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/copy.svg"); label: @tr("Copy ID"); enabled: root.item.id != ""; clicked => { root.copy(root.item.id); } } }
                    }
                }
                VerticalLayout {
                    width: (parent.width - 12px) / 2;
                    horizontal-stretch: 0;
                    spacing: Theme.space-xs;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        FieldLabel { text: @tr("Name"); vertical-alignment: center; }
                    }
                    InlineTextField {
                        text: root.item.name;
                        placeholder: @tr("Macro name");
                        label: @tr("Name");
                        saved(value) => { MacroEditor.set-field(root.index, MacroField.name, value); return true; }
                    }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-l;
                alignment: start;
                VerticalLayout {
                    width: (parent.width - 12px) / 2;
                    horizontal-stretch: 0;
                    spacing: Theme.space-xs;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        FieldLabel { text: @tr("Pause between steps"); vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        DurationInput {
                            text: root.item.step-pause;
                            placeholder-text: MacroEditor.default-step-pause;
                            minimum: Timing.macro-delay.minimum; maximum: Timing.macro-delay.maximum;
                            label: @tr("Pause between steps");
                            edited(value) => { MacroEditor.set-field(root.index, MacroField.step-pause, value); }
                        }
                    }
                }
                VerticalLayout {
                    width: (parent.width - 12px) / 2;
                    horizontal-stretch: 0;
                    spacing: Theme.space-xs;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        FieldLabel { text: @tr("Modifier delay"); vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        DurationInput {
                            text: root.item.modifier-delay;
                            placeholder-text: MacroEditor.default-modifier-delay;
                            minimum: Timing.macro-delay.minimum; maximum: Timing.macro-delay.maximum;
                            step: 1;
                            label: @tr("Modifier delay");
                            edited(value) => { MacroEditor.set-field(root.index, MacroField.modifier-delay, value); }
                        }
                    }
                }
            }
            if root.item.error.id != "": Text { text: Locale.text(root.item.error); color: Theme.error; font-size: Theme.font-body; wrap: word-wrap; }
            if root.item.usage.length > 0: HorizontalLayout {
                spacing: Theme.space-xs;
                alignment: start;
                Text { text: @tr("Used in:"); color: Theme.muted; font-size: Theme.font-body; vertical-alignment: center; }
                for place in root.item.usage: Badge { text: place; }
            }
        }
        Rectangle { width: 1px; background: Theme.divider; }
        VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: Theme.space-l; alignment: start;
            HorizontalLayout {
                spacing: Theme.space-s;
                FieldLabel { text: @tr("Steps"); vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: @tr("Add pause"); icon: @image-url("icons/clock.svg"); colorize-icon: true; clicked => { MacroEditor.add-step(root.index, "pause:100"); } }
                Button { text: @tr("Add step"); icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { MacroEditor.add-step(root.index, ""); } }
            }
            if root.item.steps.length == 0: EmptyState { text: @tr("No steps yet. Each step — one chord or action."); }
            VerticalLayout {
                spacing: Theme.space-s;
                for step[step-index] in root.item.steps: Rectangle {
                    opacity: DragDrop.dragging && DragDrop.group == DragGroups.macro-steps + root.index && DragDrop.source == step-index ? Theme.dragged-opacity : 1;

                    HorizontalLayout { StepRow {
                    macro-index: root.index;
                    index: step-index;
                    count: root.item.steps.length;
                    step: step;
                    remove => { root.remove-step(step-index); }
                    } }
                    DropMarker { cross-size: parent.width; group: DragGroups.macro-steps + root.index; index: step-index; row-start: parent.y; row-size: parent.height; }
                }
            }
        }
    }
    DropMarker { cross-size: parent.width; group: DragGroups.macros; index: root.index; row-start: root.y; row-size: root.height; }
}

component BuiltinMacrosHeader inherits Rectangle {
    in-out property <bool> open;
    accessible-role: button;
    accessible-label: @tr("Built-in macros");
    accessible-expanded: root.open;
    accessible-action-default => { root.open = !root.open; }
    HorizontalLayout {
        spacing: Theme.space-m;
        VerticalLayout { alignment: center; Image { width: 16px; source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); colorize: Theme.muted; } }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-2xs;
            HorizontalLayout {
                spacing: Theme.space-m;
                alignment: start;
                CardTitle { text: @tr("Built-in macros"); vertical-alignment: center; }
            }
        }
    }
    header-focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.open = !root.open; return accept; }
            return reject;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; header-focus.focus(); } }
}

// The row itself is the TouchArea, so it keeps `has-hover` while the pointer is over one of
// its buttons; a sibling TouchArea would lose hover there and make the buttons flicker.
component BuiltinMacroLine inherits TouchArea {
    in property <int> index;
    in property <BuiltinMacroRow> item;
    callback copy(string);
    Rectangle { background: root.has-hover ? Theme.hover.transparentize(0.6) : transparent; }
    VerticalLayout {
        HorizontalLayout {
            padding: Theme.space-m;
            spacing: Theme.space-l;
            HorizontalLayout {
                width: 190px;
                spacing: Theme.space-xs;
                Text { text: root.item.id; color: Theme.text; font-family: "monospace"; font-size: Theme.font-body; vertical-alignment: center; overflow: elide; }
                VerticalLayout { alignment: center; IconButton { size: 24px; icon: @image-url("icons/copy.svg"); label: @tr("Copy ID"); clicked => { root.copy(root.item.id); } } }
            }
            Text { width: 200px; text: Locale.text(root.item.name); color: Theme.text; vertical-alignment: center; wrap: word-wrap; }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.item.steps;
                color: Theme.muted;
                font-family: "monospace";
                font-size: Theme.font-body;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            VerticalLayout {
                width: 170px;
                alignment: center;
                Button {
                    // Opacity instead of `visible`: the button stays focusable from the keyboard.
                    opacity: root.has-hover || self.has-focus ? 1 : 0;
                    text: @tr("Create based on");
                    icon: @image-url("icons/copy-plus.svg");
                    colorize-icon: true;
                    clicked => { MacroEditor.clone-builtin(root.index, Locale.text({ id: "copy-name", arg: Locale.text(root.item.name) })); }
                }
            }
        }
        Divider {}
    }
}

component BuiltinMacrosCard inherits Card {
    in-out property <bool> open;
    callback copy(string);
    VerticalLayout {
        padding: Theme.space-xl;
        spacing: Theme.space-l;
        BuiltinMacrosHeader { open <=> root.open; }
        if root.open: VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                padding: Theme.space-m;
                spacing: Theme.space-l;
                FieldLabel { width: 190px; text: @tr("ID"); }
                FieldLabel { width: 200px; text: @tr("Name"); }
                FieldLabel { horizontal-stretch: 1; text: @tr("Steps"); }
                Rectangle { width: 170px; }
            }
            Divider {}
            for item[index] in MacroEditor.builtin-macros: BuiltinMacroLine {
                index: index;
                item: item;
                copy(value) => { root.copy(value); }
            }
        }
    }
}

export component MacrosPage inherits Rectangle {
    vertical-stretch: 1;
    private property <bool> builtin-open: false;
    private property <int> delete-macro: -1;
    private property <int> delete-step: -1;
    clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    function copy(value: string) { clipboard.text = value; clipboard.select-all(); clipboard.copy(); NotificationCenter.send({ id: "copied" }); }
    PageLayout {
        PageHeader {
            title: @tr("User macros");
            info: @tr("Build reusable sequences of key chords, text, commands and system actions. Use a unique ID in macro:<id> references and a readable name in action lists. Assign macros on the Layers or Triggers tab; change an ID only when it is unused.\n\nThe step pause applies between steps of this macro. Modifier delay is the time between pressing a modifier and the main key. Leave delays empty to use Settings defaults.") + "\n" + @tr("Global defaults: step pause {} ms; modifier delay {} ms.", MacroEditor.default-step-pause, MacroEditor.default-modifier-delay);
            VerticalLayout {
                alignment: center;
                Button {
                    text: @tr("New macro");
                    primary: true;
                    icon: @image-url("icons/plus.svg");
                    colorize-icon: true;
                    enabled: !MacroEditor.has-errors;
                    clicked => { MacroEditor.add(@tr("New macro")); }
                }
            }
        }
        ScrollView {
            drag-scroll: true;
            viewport-width: self.visible-width;
            vertical-stretch: 1;
            PageContent {
                alignment: start;
                spacing: Theme.space-xl;
                if MacroEditor.has-errors: Text { text: @tr("Fix the existing macro errors first"); color: Theme.muted; font-size: Theme.font-body; }
                if MacroEditor.macros.length == 0: EmptyState { text: @tr("No macros yet. Click \"New macro\" to create the first one."); }
                for item[index] in MacroEditor.macros: MacroCard {
                    index: index;
                    count: MacroEditor.macros.length;
                    item: item;
                    remove => { root.delete-step = -1; root.delete-macro = index; }
                    remove-step(step) => { root.delete-macro = index; root.delete-step = step; }
                    copy(value) => { root.copy(value); }
                }
                BuiltinMacrosCard { open <=> root.builtin-open; copy(value) => { root.copy(value); } }
            }
        }
    }
    if root.delete-macro >= 0 && root.delete-step < 0: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete macro?");
        body: @tr("The macro will be deleted. References macro:{} will stop working.", MacroEditor.macros[root.delete-macro].id);
        confirm-text: @tr("Delete");
        cancel => { root.delete-macro = -1; }
        confirm => { MacroEditor.remove(root.delete-macro); root.delete-macro = -1; }
    }
    if root.delete-macro >= 0 && root.delete-step >= 0: ConfirmDialog {
        width: 100%;
        height: 100%;
        title: @tr("Delete step?");
        body: @tr("This step will be removed from the macro.");
        confirm-text: @tr("Delete");
        cancel => { root.delete-macro = -1; root.delete-step = -1; }
        confirm => { MacroEditor.remove-step(root.delete-macro, root.delete-step); root.delete-macro = -1; root.delete-step = -1; }
    }
}
