import { Theme } from "theme.slint";
import { LayerKeyCell } from "layers.slint";
import { Assignment } from "types.slint";

/// One read-only key of the hint: its label and what it does in the layer.
component HintKey inherits Rectangle {
    in property <LayerKeyCell> cell;
    in property <bool> compact;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.card;
    opacity: root.cell.kind == Assignment.action ? 1 : 0.55;
    VerticalLayout {
        padding: root.compact ? 0px : Theme.space-xs;
        spacing: root.compact ? 0px : Theme.space-2xs;
        alignment: center;
        Text {
            min-width: 0px;
            text: root.cell.label;
            color: Theme.accent;
            font-size: Theme.font-body;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
            overflow: clip;
        }
        HorizontalLayout {
            alignment: center;
            Text {
                min-width: 0px;
                horizontal-stretch: 1;
                text: root.cell.kind == Assignment.action ? root.cell.action : "";
                color: Theme.text;
                font-family: root.cell.emoji ? "Noto Color Emoji" : "";
                font-size: root.cell.emoji ? 14px : 11px;
                font-weight: Theme.weight-medium;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: clip;
            }
        }
    }
}

component HintHand inherits Rectangle {
    in property <[LayerKeyCell]> cells;
    in property <int> columns: 6;
    in property <length> key-height: 44px;
    min-width: 0px;
    horizontal-stretch: 1;
    height: (root.cells.length / root.columns) * root.key-height + max(0, root.cells.length / root.columns - 1) * Theme.space-s;
    VerticalLayout {
        spacing: Theme.space-s;
        for row in root.cells.length / root.columns: HorizontalLayout {
            spacing: Theme.space-s;
            for col in root.columns: Rectangle {
                min-width: 0px;
                horizontal-stretch: 1;
                height: root.key-height;
                if root.cells[row * root.columns + col].index >= 0: HintKey {
                    cell: root.cells[row * root.columns + col];
                    compact: root.key-height < 44px;
                }
            }
        }
    }
}

/// Keys of the held layer, shown while it is held. It never takes the
/// keyboard focus and lets the pointer through (see `spell.rs`).
export component LayerHintPopup inherits Window {
    title: @tr("Layer");
    // The Spell surface repeats this size (`spell.rs`).
    preferred-width: 1290px;
    preferred-height: 480px;
    min-width: 0px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <string> name;
    in property <[LayerKeyCell]> left-cells;
    in property <[LayerKeyCell]> right-cells;
    in property <bool> presented: true;
    panel := Rectangle {
        visible: root.presented;
        x: (parent.width - self.width) / 2; y: 8px; width: min(1274px, parent.width - 16px); height: parent.height - 16px;
        background: Theme.surface; border-radius: Theme.radius-popup;
        border-width: 1px; border-color: Theme.divider;
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-l;
            alignment: center;
            Text {
                text: root.name;
                color: Theme.text;
                font-size: Theme.font-subtitle;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                overflow: clip;
            }
            GridLayout {
                spacing: Theme.space-l;
                HintHand { row: 0; col: 0; cells: root.left-cells; key-height: panel.width < 1200px ? 34px : 44px; }
                HintHand { row: panel.width < 1200px ? 1 : 0; col: panel.width < 1200px ? 0 : 1; cells: root.right-cells; key-height: panel.width < 1200px ? 34px : 44px; }
            }
        }
    }
}
