import { TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { TextField, IconButton } from "controls-base.slint";

export global InlineEditors {
    in-out property <int> commit-revision: 0; in-out property <int> revision; pure callback nonempty(string) -> bool;
    // Set from the winit window events: focus loss caused by switching windows must not commit.
    in-out property <bool> window-active: true;
    // Buttons and other touch areas take presses without moving focus, so focus loss
    // alone misses them: an open editor also commits on a press outside its bounds.
    out property <length> press-x;
    out property <length> press-y;
    out property <int> press-revision;
    public function pointer-pressed(x: length, y: length) { root.press-x = x; root.press-y = y; root.press-revision += 1; }
    public pure function pressed-outside(x: length, y: length, width: length, height: length) -> bool {
        return root.press-x < x || root.press-x >= x + width || root.press-y < y || root.press-y >= y + height;
    }
}

export component InlineTextField inherits FocusScope {
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> allow-empty: true;
    in property <length> text-size: Theme.font-default;
    in property <int> text-weight: Theme.weight-regular;
    in property <color> text-color: Theme.text;
    in-out property <bool> editing: false;
    private property <string> draft;
    private property <int> revision: InlineEditors.revision;
    private property <int> commit-revision: InlineEditors.commit-revision;
    private property <int> press-revision: InlineEditors.press-revision;
    private property <Message> no-issue;
    // Checked only while editing: validation may read the library from disk.
    private property <Message> issue: root.editing ? root.validate(root.draft) : root.no-issue;
    private property <bool> can-save: (root.allow-empty || InlineEditors.nonempty(root.draft)) && root.issue.id == "";
    changed commit-revision => { if root.editing { root.save(); } }
    changed press-revision => {
        if InlineEditors.pressed-outside(root.absolute-position.x, root.absolute-position.y, root.width, root.height) { root.blurred(); }
    }
    changed revision => { root.editing = false; }
    changed text => { root.editing = false; }
    callback saved(string);
    /// Why the draft cannot be saved; an empty id accepts it.
    pure callback validate(string) -> Message;
    public function begin() { root.draft = root.text; root.editing = true; }
    function save() { if root.can-save { root.saved(root.draft); root.editing = false; } }
    function cancel() { root.draft = root.text; root.editing = false; }
    function blurred() {
        if !root.editing || !InlineEditors.window-active { return; }
        if root.can-save { root.save(); } else { root.cancel(); }
    }
    vertical-stretch: 0;
    horizontal-stretch: root.editing ? 1 : 0;
    min-width: root.editing ? 92px : 0px;
    preferred-width: measure.preferred-width + 40px;
    max-width: root.editing ? Theme.unbounded : root.preferred-width;
    focus-on-tab-navigation: !root.editing;
    key-pressed(event) => {
        if root.editing && event.text == Key.Escape { root.cancel(); return accept; }
        if !root.editing && (event.text == Key.Return || event.text == " ") { root.begin(); return accept; }
        return reject;
    }
    measure := Text {
        text: root.text == "" ? root.placeholder : root.text;
        font-size: root.text-size;
        font-weight: root.text-weight;
        visible: false;
    }
    VerticalLayout {
        spacing: Theme.space-2xs;
        HorizontalLayout {
            spacing: Theme.space-xs;
            if !root.editing: display-touch := TouchArea {
                height: max(28px, measure.preferred-height + 8px);
                mouse-cursor: MouseCursor.text;
                accessible-role: button;
                accessible-label: root.label;
                accessible-action-default => { root.begin(); }
                clicked => { root.begin(); }
                Rectangle {
                    border-radius: Theme.radius-small;
                    background: display-touch.has-hover ? Theme.hover : transparent;
                    border-width: root.has-focus ? 2px : 0px;
                    border-color: Theme.focus;
                    HorizontalLayout {
                        padding-left: Theme.space-xs;
                        spacing: Theme.space-xs;
                        Text {
                            min-width: 0px;
                            text: root.text == "" ? root.placeholder : root.text;
                            color: root.text == "" ? Theme.placeholder : root.text-color;
                            font-size: root.text-size;
                            font-weight: root.text-weight;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            width: 28px;
                            IconButton {
                                visible: display-touch.has-hover || root.has-focus;
                                icon: @image-url("icons/pencil.svg");
                                label: @tr("Edit: {}", root.label);
                                clicked => { root.begin(); }
                            }
                        }
                    }
                }
            }
            if root.editing: TextField {
                min-width: 28px;
                horizontal-stretch: 1;
                text <=> root.draft;
                placeholder-text: root.placeholder;
                font-size: root.text-size;
                invalid: root.issue.id != "";
                accessible-label: root.label;
                accessible-description: Locale.text(root.issue);
                init => { self.focus(); self.select-all(); }
                accepted => { root.save(); }
                changed has-focus => { if !self.has-focus { root.blurred(); } }
            }
            if root.editing: IconButton { icon: @image-url("icons/check.svg"); label: @tr("Save (Enter)"); enabled: root.can-save; clicked => { root.save(); } }
            if root.editing: IconButton { icon: @image-url("icons/x.svg"); label: @tr("Cancel (Esc)"); clicked => { root.cancel(); } }
        }
        if root.editing && root.issue.id != "": Text {
            text: Locale.text(root.issue);
            color: Theme.error;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
    }
}

export component InlineTextArea inherits FocusScope {
    in property <bool> expanded: false;
    in property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> allow-empty: true;
    in property <length> text-size: Theme.font-default;
    in property <int> text-weight: Theme.weight-regular;
    in property <color> text-color: Theme.text;
    in-out property <bool> editing: false;
    private property <string> draft;
    private property <int> revision: InlineEditors.revision;
    private property <int> commit-revision: InlineEditors.commit-revision;
    private property <int> press-revision: InlineEditors.press-revision;
    changed commit-revision => { if root.editing { root.save(); } }
    changed press-revision => {
        if InlineEditors.pressed-outside(root.absolute-position.x, root.absolute-position.y, root.width, root.height) { root.blurred(); }
    }
    changed revision => { root.editing = false; }
    changed text => { root.editing = false; }
    callback saved(string);
    public function begin() { root.draft = root.text; root.editing = true; }
    function save() { if root.allow-empty || InlineEditors.nonempty(root.draft) { root.saved(root.draft); root.editing = false; } }
    function cancel() { root.draft = root.text; root.editing = false; }
    function blurred() {
        if !root.editing || !InlineEditors.window-active { return; }
        if root.allow-empty || InlineEditors.nonempty(root.draft) { root.save(); } else { root.cancel(); }
    }
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 0px;
    focus-on-tab-navigation: !root.editing;
    key-pressed(event) => {
        if root.editing && event.text == Key.Escape { root.cancel(); return accept; }
        if root.editing && event.modifiers.control && event.text == Key.Return { root.save(); return accept; }
        if !root.editing && (event.text == Key.Return || event.text == " ") { root.begin(); return accept; }
        return reject;
    }
    VerticalLayout {
        spacing: Theme.space-xs;
        if !root.editing: Rectangle {
            min-width: 0px;
            height: max(56px, display.height + 8px + (measure.preferred-height > display.height ? line.preferred-height : 0px));
            border-radius: Theme.radius-small;
            background: edit-touch.has-hover ? Theme.hover : transparent;
            border-width: 1px;
            border-color: root.has-focus ? Theme.focus : edit-touch.has-hover ? Theme.border : transparent;
            accessible-role: button;
            accessible-label: root.label;
            accessible-action-default => { root.begin(); }
            line := Text { text: "Ag"; font-size: root.text-size; font-weight: root.text-weight; visible: false; }
            measure := Text {
                width: parent.width - 8px;
                text: root.text == "" ? root.placeholder : root.text;
                font-size: root.text-size;
                font-weight: root.text-weight;
                wrap: word-wrap;
                visible: false;
            }
            if measure.preferred-height > display.height: Text {
                x: 4px; y: display.height + 4px;
                text: "…"; color: root.text-color; font-size: root.text-size;
            }
            display := Text {
                x: 4px; y: 4px;
                width: parent.width - 8px;
                height: root.expanded ? measure.preferred-height : min(measure.preferred-height, line.preferred-height * 5);
                text: root.text == "" ? root.placeholder : root.text;
                color: root.text == "" ? Theme.placeholder : root.text-color;
                font-size: root.text-size;
                font-weight: root.text-weight;
                vertical-alignment: top;
                wrap: word-wrap;
                overflow: elide;
            }
            edit-touch := TouchArea { mouse-cursor: MouseCursor.text; clicked => { root.begin(); } }
        }
        if root.editing: TextEdit {
            height: root.expanded ? 240px : 80px;
            text <=> root.draft;
            accessible-label: root.label;
            init => { self.focus(); }
            changed has-focus => { if !self.has-focus { root.blurred(); } }
        }
        if root.editing: HorizontalLayout {
            spacing: Theme.space-xs;
            alignment: end;
            IconButton { icon: @image-url("icons/check.svg"); label: @tr("Save (Ctrl+Enter)"); enabled: root.allow-empty || InlineEditors.nonempty(root.draft); clicked => { root.save(); } }
            IconButton { icon: @image-url("icons/x.svg"); label: @tr("Cancel (Esc)"); clicked => { root.cancel(); } }
        }
    }
}

