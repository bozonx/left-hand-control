import { Theme } from "theme.slint";

/// Shared pieces of the Emoji and Quick action popups.

/// One cell of the 3 × 5 grid, labelled with its left-hand hotkey.
export component PopupCell inherits Rectangle {
    in property <string> hotkey;
    in property <string> content;
    in property <bool> emoji;
    callback clicked();
    property <bool> empty: root.content == "";
    property <int> length: root.content.character-count;
    background: area.has-hover && !root.empty ? Theme.hover : Theme.card;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.divider;
    Text {
        x: 8px; y: 5px;
        text: root.hotkey;
        color: root.empty ? Theme.divider : Theme.accent;
        font-size: Theme.font-body;
        font-weight: Theme.weight-bold;
    }
    Text {
        x: 8px; y: 18px;
        width: parent.width - 16px; height: parent.height - 22px;
        text: root.content;
        color: Theme.text;
        font-family: root.emoji ? "Noto Color Emoji" : "";
        // Emoji cells may hold text: shrink it with its length, down to 11px.
        font-size: !root.emoji ? 13px
            : root.length <= 2 ? 28px
            : root.length <= 4 ? 20px
            : root.length <= 8 ? 15px
            : root.length <= 16 ? 12px : 11px;
        wrap: root.emoji && root.length <= 4 ? no-wrap : word-wrap;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        enabled: !root.empty;
        mouse-cursor: root.empty ? default : pointer;
        clicked => { root.clicked(); }
    }
}

/// Title, current page, the Tab hint and the close button.
export component PopupHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> page-name;
    in property <int> page;
    in property <int> page-count;
    callback dismiss();
    spacing: Theme.space-m-plus;
    height: Theme.control-height;
    Text { text: root.title; color: Theme.text; font-size: Theme.font-subtitle; font-weight: Theme.weight-semibold; vertical-alignment: center; }
    if root.page-count > 0 && root.page-name != "": Text {
        text: root.page-name; color: Theme.muted; font-size: Theme.font-default;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle { horizontal-stretch: 1; }
    if root.page-count > 1: Text {
        text: @tr("Tab · {}/{}", root.page + 1, root.page-count);
        color: Theme.muted; font-size: Theme.font-body; vertical-alignment: center;
    }
    Rectangle {
        width: 28px;
        border-radius: Theme.radius;
        background: close.has-hover ? Theme.hover : transparent;
        Text { text: "×"; color: Theme.muted; font-size: Theme.font-heading; }
        close := TouchArea { clicked => { root.dismiss(); } }
    }
}

export global PopupKeys {
    out property <[string]> labels: ["Q", "W", "E", "R", "T", "A", "S", "D", "F", "G", "Z", "X", "C", "V", "B"];
}

/// Shared focus, surface and cell layout of both popup windows.
export component PopupGridBody inherits FocusScope {
    in property <bool> presented: true;
    in property <string> title;
    in property <[string]> page-names;
    in property <int> page;
    in property <[string]> items;
    in property <int> item-offset;
    in property <bool> emoji;
    callback key(string);
    callback choose(int);
    callback dismiss();
    public function prepare() { self.focus(); }
    key-pressed(event) => { root.key(event.text); return accept; }
    Rectangle {
        visible: root.presented;
        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        background: Theme.surface; border-radius: Theme.radius-popup;
        border-width: 1px; border-color: Theme.divider;
        VerticalLayout {
            padding: Theme.space-xl;
            spacing: Theme.space-l;
            PopupHeader {
                title: root.title;
                page-name: root.page-names.length == 0 ? "" : root.page-names[root.page];
                page: root.page;
                page-count: root.page-names.length;
                dismiss => { root.dismiss(); }
            }
            for row in 3: HorizontalLayout {
                spacing: Theme.space-m;
                for col in 5: PopupCell {
                    height: 80px;
                    hotkey: PopupKeys.labels[row * 5 + col];
                    content: root.items[root.item-offset + row * 5 + col];
                    emoji: root.emoji;
                    clicked => { root.choose(row * 5 + col); }
                }
            }
        }
    }
}
