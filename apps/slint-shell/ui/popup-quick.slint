import { PopupGridBody } from "popup-grid.slint";

/// Quick actions: pages of 3 × 5 cells addressed by the left-hand hotkeys.
export component QuickPopup inherits Window {
    title: @tr("Quick actions");
    // The Spell surface repeats this size (`spell.rs`).
    width: 780px;
    height: 350px;
    no-frame: true; always-on-top: true; background: transparent;
    /// Labels of the current page, 15 cells; empty cells have no action.
    in property <[string]> items;
    in property <[string]> page-names;
    in-out property <int> page;
    in property <bool> presented: true;
    callback key(string) -> bool;
    callback choose(int);
    callback dismiss();
    public function prepare() { body.prepare(); }
    body := PopupGridBody {
        width: parent.width; height: parent.height;
        title: root.title;
        presented: root.presented;
        page-names: root.page-names;
        page: root.page;
        items: root.items;
        key(text) => { return root.key(text); }
        choose(index) => { root.choose(index); }
        dismiss => { root.dismiss(); }
    }
}
