import { ScrollView } from "scroll.slint";
import { LineEdit, VerticalBox, HorizontalBox, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
export component QuickPopup inherits Window {
    title: @tr("Quick actions");
    width: 520px; height: 500px;
    no-frame: true; always-on-top: true; background: transparent;
    in property <[string]> items;
    in property <[string]> page-names;
    in-out property <int> page;
    callback change-page(int);
    in-out property <string> query;
    in-out property <bool> searching;
    in-out property <int> selected;
    callback filter(string);
    callback key(string);
    in property <bool> presented: true;
    callback choose(int);
    callback dismiss();
    public function prepare() { root.query = ""; root.searching = false; keys.focus(); }
    public function begin-search() { root.searching = true; search.focus(); }
    keys := FocusScope {
    key-pressed(event) => {
        if event.modifiers.alt && event.text >= "1" && event.text <= "9" {
            root.choose(event.text.to-float() - 1);
        } else { root.key(event.text); }
        return accept;
    }
    Rectangle {
        visible: root.presented;
        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
        background: Theme.surface; border-radius: 16px;
        VerticalBox {
            padding: 16px;
            HorizontalBox {
                Text { text: @tr("Quick actions"); color: Theme.text; font-size: 22px; }
                Button { text: @tr("Search"); clicked => { root.begin-search(); } }
                Button { text: "×"; clicked => { root.dismiss(); } }
            }
            if root.page-names.length > 0: HorizontalBox {
                Button { text: "←"; enabled: root.page > 0; clicked => { root.page -= 1; root.change-page(root.page); if root.searching { search.focus(); } else { keys.focus(); } } }
                Text { text: root.page-names[root.page]; color: Theme.text; horizontal-stretch: 1; }
                Button { text: "→"; enabled: root.page + 1 < root.page-names.length; clicked => { root.page += 1; root.change-page(root.page); if root.searching { search.focus(); } else { keys.focus(); } } }
            }
            search := LineEdit {
                visible: root.searching;
                text <=> root.query;
                placeholder-text: @tr("Filter");
                edited => { root.filter(self.text); }
                key-pressed(event) => {
                    if event.modifiers.alt && event.text >= "1" && event.text <= "9" {
                        root.choose(event.text.to-float() - 1);
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Escape || event.text == Key.Return {
                        root.key(event.text);
                        return accept;
                    }
                    return reject;
                }
            }
            ScrollView {
                viewport-height: root.items.length * 42px;
                viewport-y: -max(0, root.selected - 6) * 42px;
                for item[index] in root.items: Rectangle {
                    y: index * 42px; height: 40px;
                    background: index == root.selected ? Theme.accent : transparent;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 8px;
                        Text { text: "◆"; color: Theme.text; width: 28px; }
                        Text { text: item; color: Theme.text; }
                        Text { text: index < 9 ? "Alt+" + (index + 1) : ""; color: Theme.muted; }
                    }
                    TouchArea { clicked => { root.choose(index); } }
                }
            }
        }
    }
}
}
