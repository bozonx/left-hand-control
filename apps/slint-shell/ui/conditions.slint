import { SearchField, TextField } from "controls.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";
import { AppEntryKind, GameCondition } from "types.slint";
import { AppState } from "app-state.slint";
import { Badge, ButtonGroup, ConfirmDialog, IconButton, InfoTip } from "controls.slint";
import { Button, CheckBox, RadioGroup } from "std-widgets.slint";

export struct LanguageChoice { code: string, label: string }

/// An application with `count` open windows; `pattern` is what a
/// condition stores for it, `titles` has one title per window. `recent`
/// marks the last active application.
export struct WindowChoice { pattern: string, app-id: string, process: string, title: string, titles: [string], count: int, recent: bool }

/// An item of a game-mode list; `index` is its place among all matchers.
export struct GameAppEntry { pattern: string, window-only: bool, index: int }

export global ConditionChoices {
    in property <[LanguageChoice]> languages;
    /// Applications with open windows, the last active one first.
    in property <[WindowChoice]> open-windows;
    /// The open-window list is being collected.
    in property <bool> open-windows-loading;
    /// The open-window list has been collected at least once.
    in property <bool> open-windows-ready;
    callback refresh();
    callback refresh-open-windows();
    pure callback available(string) -> bool;
    pure callback contains(string, string) -> bool;
    pure callback toggle(string, string, bool) -> string;
    pure callback items(string) -> [string];
    pure callback unknown-languages(string, [LanguageChoice]) -> [string];
    pure callback remove(string, int) -> string;
    pure callback replace(value: string, index: int, item: string) -> string;
    pure callback add(string, string) -> string;
    pure callback is-title(string) -> bool;
    /// Text of a title pattern without its prefix.
    pure callback title-text(string) -> string;
    /// Pattern for the typed text: an app pattern, or with `title` a title pattern.
    pure callback make-pattern(string, bool) -> string;
    /// Whether a list of patterns has the pattern, ignoring case.
    pure callback has(patterns: [string], pattern: string) -> bool;
    /// The open windows by process: `pattern` is the process name,
    /// `app-id` the app ids of its windows, comma-separated.
    pure callback by-process(windows: [WindowChoice]) -> [WindowChoice];
    /// Whether the pattern names the process of an open window, not its app id.
    pure callback names-process(windows: [WindowChoice], pattern: string) -> bool;
    /// Whether the process name is a runtime many applications share, like `electron`.
    pure callback shared-runtime(name: string) -> bool;
    /// How many running processes the pattern matches.
    pure callback running-count(pattern: string) -> int;
    /// Windows whose app id, process or title contains the query.
    pure callback matching(windows: [WindowChoice], query: string) -> [WindowChoice];
    /// Running processes containing the query, without those of the windows.
    pure callback processes(windows: [WindowChoice], query: string) -> [string];
    /// How many open windows the pattern matches.
    pure callback open-count(windows: [WindowChoice], pattern: string) -> int;
    /// Text of a pattern without the title prefix.
    public pure function text(pattern: string) -> string {
        return self.is-title(pattern) ? self.title-text(pattern) : pattern;
    }
    /// How a stored pattern reads in a list.
    public pure function label(pattern: string) -> string {
        return self.is-title(pattern) ? @tr("Window title contains: {}", self.title-text(pattern)) : pattern;
    }
}

/// How many open windows a pattern matches; empty until the list is known.
component OpenCount inherits Text {
    in property <string> pattern;
    private property <int> count: ConditionChoices.open-count(ConditionChoices.open-windows, root.pattern);
    visible: ConditionChoices.open-windows-ready;
    text: root.count > 0 ? @tr("Open now: {n} window" | "Open now: {n} windows" % root.count) : @tr("Not open now");
    color: root.count > 0 ? Theme.success : Theme.muted;
    font-size: Theme.font-body;
    overflow: elide;
    min-width: 0px;
    vertical-alignment: center;
}

/// The add / edit dialog and the removal prompt of an applications list.
/// They are drawn above the dialog holding the list, so the list hands
/// over its value and applies `result` when `revision` changes.
export global AppEntryDialog {
    /// The add / edit dialog is open.
    in-out property <bool> editing;
    /// The removal prompt is open.
    in-out property <bool> removing;
    /// Which list opened the dialog: the exclusion list or the other one.
    in-out property <bool> exclusion;
    in-out property <string> value;
    /// Edited item; -1 adds a new one.
    in-out property <int> index: -1;
    in-out property <AppEntryKind> kind;
    in-out property <string> text;
    /// Opened from a game-mode list: offers running processes and the scope.
    in-out property <bool> game;
    /// Game mode: a process counts only while its window is active,
    /// otherwise while it runs. App ids and titles always need the window.
    in-out property <bool> window-only;
    out property <string> result;
    out property <int> revision;
    /// What the last `revision` did, for game-mode lists.
    out property <bool> result-removed;
    out property <string> result-pattern;
    out property <bool> result-window-only;
    private property <string> item;
    public function open(value: string, exclusion: bool, index: int) {
        root.start(value, exclusion, index, false, true);
    }
    /// `open` for a game-mode list; `value` lists all matchers.
    public function open-game(value: string, exclusion: bool, index: int, window-only: bool) {
        root.start(value, exclusion, index, true, window-only);
    }
    function start(value: string, exclusion: bool, index: int, game: bool, window-only: bool) {
        root.game = game;
        root.window-only = window-only;
        root.value = value;
        root.exclusion = exclusion;
        root.index = index;
        if index >= 0 {
            root.item = ConditionChoices.items(value)[index];
            root.kind = ConditionChoices.is-title(root.item) ? AppEntryKind.title
                : (game && !window-only) || ConditionChoices.names-process(ConditionChoices.open-windows, root.item) ? AppEntryKind.process
                : AppEntryKind.application;
            root.text = ConditionChoices.text(root.item);
        } else {
            root.kind = AppEntryKind.application;
            root.text = "";
        }
        root.removing = false;
        root.editing = true;
        ConditionChoices.refresh-open-windows();
    }
    /// Game mode: the item counts while its process runs, window or not.
    public pure function in-background() -> bool {
        return root.game && root.kind == AppEntryKind.process && !root.window-only;
    }
    public function confirm-remove(value: string, exclusion: bool, index: int) {
        root.game = false;
        root.value = value;
        root.exclusion = exclusion;
        root.index = index;
        root.editing = false;
        root.removing = true;
    }
    public function confirm-remove-game(value: string, exclusion: bool, index: int) {
        root.confirm-remove(value, exclusion, index);
        root.game = true;
    }
    public function close() { root.editing = false; root.removing = false; }
    public function save() {
        if root.valid() {
            root.result-removed = false;
            root.result-pattern = root.pattern();
            // App ids and titles belong to a window, so they always look at the active one.
            root.result-window-only = !root.in-background();
            root.finish(root.index >= 0 ? ConditionChoices.replace(root.value, root.index, root.pattern()) : ConditionChoices.add(root.value, root.pattern()));
        }
    }
    public function remove() {
        root.result-removed = true;
        root.finish(ConditionChoices.remove(root.value, root.index));
    }
    function finish(value: string) {
        root.result = value;
        root.revision += 1;
        root.close();
    }
    public pure function pattern() -> string { return ConditionChoices.make-pattern(root.text, root.kind == AppEntryKind.title); }
    /// The other items of the list, to reject duplicates.
    pure function others() -> [string] {
        return ConditionChoices.items(root.index >= 0 ? ConditionChoices.remove(root.value, root.index) : root.value);
    }
    public pure function duplicate() -> bool { return ConditionChoices.has(root.others(), root.pattern()); }
    public pure function valid() -> bool { return ConditionChoices.text(root.pattern()) != "" && !root.duplicate(); }
}

/// An item to fill the dialog field with: an application, a process or
/// a window title; `warning` marks the badge as a caution.
component WindowRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> badge;
    in property <bool> warning;
    in property <bool> selected;
    in property <image> icon: @image-url("icons/app-window.svg");
    callback clicked();
    height: row.preferred-height;
    border-radius: Theme.radius;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    row := HorizontalLayout {
        padding: 6px; spacing: 8px;
        VerticalLayout { alignment: center;
            Image { width: 16px; height: 16px; colorize: Theme.muted; source: root.icon; }
        }
        VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 2px;
            HorizontalLayout { spacing: 6px;
                Text { text: root.text; color: Theme.text; overflow: elide; min-width: 0px; horizontal-stretch: 1; vertical-alignment: center; }
                if root.badge != "": Badge { text: root.badge; fill: root.warning ? Theme.warning.transparentize(0.75) : Theme.accent.transparentize(0.75); }
            }
            if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: Theme.font-body; overflow: elide; min-width: 0px; }
        }
        if root.selected: VerticalLayout { alignment: center;
            Image { width: 16px; height: 16px; colorize: Theme.accent; source: @image-url("icons/check.svg"); }
        }
    }
}

/// The add / edit dialog and the removal prompt of `AppEntryDialog`;
/// placed over the whole settings window.
export component AppEntryOverlay inherits Rectangle {
    private property <string> typed: AppEntryDialog.pattern();
    private property <AppEntryKind> kind: AppEntryDialog.kind;
    private property <[WindowChoice]> by-process: root.kind == AppEntryKind.process ? ConditionChoices.by-process(ConditionChoices.open-windows) : [];
    /// Game mode: running processes without an open window that contain the typed text.
    private property <[string]> processes: AppEntryDialog.game && root.kind == AppEntryKind.process
        ? ConditionChoices.processes(ConditionChoices.open-windows, AppEntryDialog.text) : [];
    private property <bool> duplicate: AppEntryDialog.text != "" && AppEntryDialog.duplicate();
    /// A process in the background has no window, so it is looked up among the running ones.
    private property <int> matches: AppEntryDialog.in-background()
        ? ConditionChoices.running-count(root.typed) : ConditionChoices.open-count(ConditionChoices.open-windows, root.typed);
    private property <string> status: root.duplicate ? @tr("Already in the list")
        : AppEntryDialog.text == "" ? ""
        : AppEntryDialog.in-background()
            ? (root.matches > 0 ? @tr("Matches {n} running process" | "Matches {n} running processes" % root.matches) : @tr("Matches no running process"))
        : !ConditionChoices.open-windows-ready ? ""
        : root.matches > 0 ? @tr("Matches {n} open window" | "Matches {n} open windows" % root.matches) : @tr("Matches no open window");
    private property <bool> shared: root.kind != AppEntryKind.title && ConditionChoices.shared-runtime(AppEntryDialog.text);
    if AppEntryDialog.editing: Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { AppEntryDialog.close(); } scroll-event(event) => { accept } }
        FocusScope {
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape { AppEntryDialog.close(); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 520px);
                height: min(parent.height - 64px, 640px);
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.radius-dialog;
                TouchArea {}
                VerticalLayout { padding: 20px; spacing: 10px;
                    Text {
                        text: AppEntryDialog.index >= 0 ? @tr("Edit application") : @tr("Add application");
                        color: Theme.text; font-size: Theme.font-heading; font-weight: 700;
                    }
                    VerticalLayout { spacing: 6px;
                        Text { text: @tr("Match by"); color: Theme.muted; font-size: Theme.font-body; }
                        ButtonGroup {
                            labels: [@tr("Application"), @tr("Process"), @tr("Window title")];
                            selected-index: root.kind == AppEntryKind.application ? 0 : root.kind == AppEntryKind.process ? 1 : 2;
                            selected(index) => {
                                AppEntryDialog.kind = index == 0 ? AppEntryKind.application : index == 1 ? AppEntryKind.process : AppEntryKind.title;
                                input.focus();
                            }
                        }
                    }
                    VerticalLayout { spacing: 4px;
                        HorizontalLayout { spacing: 8px;
                            input := TextField {
                                text <=> AppEntryDialog.text;
                                placeholder-text: root.kind == AppEntryKind.title ? @tr("Text the window title contains")
                                    : root.kind == AppEntryKind.process ? @tr("Process name, * and ? allowed")
                                    : @tr("App ID, * and ? allowed");
                                invalid: root.duplicate;
                                init => { self.focus(); self.select-all(); }
                                accepted => { AppEntryDialog.save(); }
                            }
                            VerticalLayout { alignment: center;
                                InfoTip {
                                    text: (AppEntryDialog.in-background()
                                            ? @tr("The item is compared with the names of running processes. Pick one from the list below to fill in the field.")
                                            : @tr("Each item is compared with the active window. Pick a window from the list below to fill in the field."))
                                        + "\n\n" + (root.kind == AppEntryKind.title
                                            ? @tr("Window title: matches when the title contains the text, case is ignored. With * or ? the pattern must cover the whole title. A title changes with the open tab or document, and it never matches a process without a window.")
                                            : root.kind == AppEntryKind.process
                                            ? @tr("Process: the executable name, as the list below shows it. The whole name must match, case is ignored, .exe is optional. * stands for any characters and ? for one.")
                                            : @tr("Application: the app ID (Wayland app id or X11 WM_CLASS) or the process name. The whole name must match, case is ignored, .exe is optional. * stands for any characters and ? for one, e.g. steam_app_*. The ID is stable, so prefer it."));
                                }
                            }
                        }
                        // The line keeps its height, so the dialog does not jump while typing.
                        Text {
                            height: 16px;
                            text: root.status;
                            color: root.duplicate ? Theme.error : root.matches > 0 ? Theme.success : Theme.muted;
                            font-size: Theme.font-body; overflow: elide; vertical-alignment: center;
                        }
                        if root.shared: Text {
                            text: @tr("Many applications run as “{}”, so the name matches all of them. The application ID is more precise.", AppEntryDialog.text);
                            color: Theme.warning; font-size: Theme.font-body; wrap: word-wrap;
                        }
                    }
                    if AppEntryDialog.game && root.kind == AppEntryKind.process: VerticalLayout { spacing: 6px;
                        Text { text: @tr("When it counts"); color: Theme.muted; font-size: Theme.font-body; }
                        ButtonGroup {
                            labels: [@tr("While its window is active"), @tr("While the process runs")];
                            selected-index: AppEntryDialog.window-only ? 0 : 1;
                            selected(index) => { AppEntryDialog.window-only = index == 0; }
                        }
                        Text {
                            text: AppEntryDialog.window-only
                                ? @tr("Counts while a window of the application has the focus.")
                                : @tr("Counts while a process with this name runs, even without a window or in the background.");
                            color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap;
                        }
                    }
                    HorizontalLayout { spacing: 8px; padding-top: 4px;
                        Text {
                            text: root.kind == AppEntryKind.title ? @tr("Window titles") : root.kind == AppEntryKind.process ? @tr("Processes of open windows") : @tr("Open windows");
                            color: Theme.muted; font-size: Theme.font-body; vertical-alignment: center; horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: @image-url("icons/refresh-cw.svg"); label: @tr("Refresh list");
                            enabled: !ConditionChoices.open-windows-loading;
                            clicked => { ConditionChoices.refresh-open-windows(); }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-width: 1px; border-color: Theme.divider; border-radius: Theme.radius-large; background: Theme.card;
                        ScrollView { width: 100%; height: 100%; viewport-width: self.visible-width;
                            VerticalLayout { padding: 6px; spacing: 2px; alignment: start;
                                if ConditionChoices.open-windows-loading && ConditionChoices.open-windows.length == 0: Text { text: @tr("Looking for open windows…"); color: Theme.muted; }
                                if !ConditionChoices.open-windows-loading && ConditionChoices.open-windows.length == 0: Text { text: @tr("No open windows found"); color: Theme.muted; wrap: word-wrap; }
                                if root.kind == AppEntryKind.application: VerticalLayout { spacing: 2px;
                                    for window in ConditionChoices.open-windows: WindowRow {
                                        text: window.pattern;
                                        detail: window.count > 1 ? @tr("{n} window" | "{n} windows" % window.count) + " · " + window.title : window.title;
                                        badge: window.recent ? @tr("Last active") : "";
                                        selected: ConditionChoices.has([window.pattern], root.typed);
                                        clicked => { AppEntryDialog.text = window.pattern; input.focus(); }
                                    }
                                }
                                if root.kind == AppEntryKind.process: VerticalLayout { spacing: 2px;
                                    for process in root.by-process: WindowRow {
                                        text: process.pattern;
                                        detail: (process.app-id != "" ? process.app-id + " · " : "")
                                            + (process.count > 1 ? @tr("{n} window" | "{n} windows" % process.count) + " · " : "") + process.title;
                                        icon: @image-url("icons/terminal.svg");
                                        badge: ConditionChoices.shared-runtime(process.pattern) ? @tr("Shared process") : process.recent ? @tr("Last active") : "";
                                        warning: ConditionChoices.shared-runtime(process.pattern);
                                        selected: ConditionChoices.has([process.pattern], root.typed);
                                        clicked => { AppEntryDialog.text = process.pattern; input.focus(); }
                                    }
                                    if AppEntryDialog.game: VerticalLayout { spacing: 2px; padding-top: 6px;
                                        Text { text: @tr("Running without a window"); color: Theme.muted; font-size: Theme.font-body; }
                                        if AppEntryDialog.text == "": Text { text: @tr("Type a name to find processes running without a window."); color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap; }
                                        for process in root.processes: WindowRow {
                                            text: process;
                                            icon: @image-url("icons/terminal.svg");
                                            selected: ConditionChoices.has([process], root.typed);
                                            clicked => { AppEntryDialog.text = process; input.focus(); }
                                        }
                                    }
                                }
                                if root.kind == AppEntryKind.title: VerticalLayout { spacing: 2px;
                                    for window in ConditionChoices.open-windows: VerticalLayout { spacing: 2px;
                                        for title in window.titles: WindowRow {
                                            visible: title != "";
                                            height: title != "" ? self.preferred-height : 0px;
                                            text: title;
                                            detail: window.pattern;
                                            icon: @image-url("icons/text-cursor-input.svg");
                                            badge: window.recent ? @tr("Last active") : "";
                                            selected: AppEntryDialog.text == title;
                                            clicked => { AppEntryDialog.text = title; input.focus(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout { spacing: 8px; alignment: end;
                        Button { text: @tr("Cancel"); clicked => { AppEntryDialog.close(); } }
                        Button {
                            text: AppEntryDialog.index >= 0 ? @tr("Save") : @tr("Add");
                            primary: true;
                            enabled: AppEntryDialog.valid();
                            clicked => { AppEntryDialog.save(); }
                        }
                    }
                }
            }
        }
    }
    if AppEntryDialog.removing: ConfirmDialog {
        width: 100%; height: 100%;
        title: @tr("Remove application?");
        body: @tr("“{}” will be removed from the list.", ConditionChoices.label(ConditionChoices.items(AppEntryDialog.value)[AppEntryDialog.index]));
        confirm-text: @tr("Remove");
        cancel => { AppEntryDialog.close(); }
        confirm => { AppEntryDialog.remove(); }
    }
}

/// A row of an applications list: the pattern, an optional `kind` under
/// it, how many open windows it matches and a remove button; a click edits.
component AppItemRow inherits Rectangle {
    in property <string> pattern;
    in property <string> kind;
    in property <bool> show-count;
    in property <image> icon: ConditionChoices.is-title(root.pattern) ? @image-url("icons/text-cursor-input.svg") : @image-url("icons/app-window.svg");
    callback edit();
    callback remove();
    height: item-row.preferred-height; border-radius: Theme.radius;
    background: item-touch.has-hover ? Theme.hover : transparent;
    item-touch := TouchArea { mouse-cursor: pointer; clicked => { root.edit(); } }
    item-row := HorizontalLayout {
        padding-left: 8px; padding-right: 2px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
        VerticalLayout { alignment: center;
            Image { width: 16px; height: 16px; colorize: Theme.muted; source: root.icon; }
        }
        VerticalLayout { horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 2px;
            Text { text: ConditionChoices.text(root.pattern); color: Theme.text; overflow: elide; min-width: 0px; }
            HorizontalLayout { spacing: 6px;
                if root.kind != "": Text { text: root.kind; color: Theme.muted; font-size: Theme.font-body; overflow: elide; min-width: 0px; }
                if root.show-count: OpenCount { pattern: root.pattern; horizontal-stretch: 1; }
            }
        }
        VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Remove item"); clicked => { root.remove(); } } }
    }
}

/// A flat list of window patterns: each row shows whether it matches by
/// app or by title and how many open windows it matches; items are added
/// and edited in `AppEntryOverlay`, removed after a prompt.
export component ApplicationsField inherits VerticalLayout {
    in-out property <string> value;
    in property <string> label: @tr("Only in applications");
    in property <bool> exclusion;
    private property <[string]> items: ConditionChoices.items(root.value);
    private property <int> revision: AppEntryDialog.revision;
    /// Unknown until the first status counts as available.
    private property <bool> detection-available: AppState.game-window-availability.id != "capability-unavailable"
        && AppState.game-window-availability.id != "capability-unsupported";
    changed revision => {
        if !AppEntryDialog.game && AppEntryDialog.exclusion == root.exclusion { root.value = AppEntryDialog.result; }
    }
    init => { ConditionChoices.refresh-open-windows(); }
    spacing: 8px;
    HorizontalLayout { spacing: 6px;
        Text { text: root.label; color: Theme.text; vertical-alignment: center; }
        InfoTip {
            text: (root.exclusion ? @tr("A match blocks the rule, even if the window is in the allowed list.") : @tr("Any match allows the rule. An empty list allows all windows."))
                + "\n\n" + @tr("An application is matched by its ID or process name: the whole name, ignoring case, with * and ? as wildcards. A window title item matches when the title contains the text. Any matching item is enough. An empty list imposes no restrictions.");
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            icon: @image-url("icons/plus.svg"); text: @tr("Add");
            clicked => { AppEntryDialog.open(root.value, root.exclusion, -1); }
        }
    }
    Rectangle {
        border-width: 1px; border-color: Theme.divider; border-radius: Theme.radius-large; background: Theme.card;
        height: list.preferred-height;
        list := VerticalLayout {
            padding: 6px; spacing: 2px;
            if root.items.length == 0: HorizontalLayout { padding: 6px; Text {
                text: root.exclusion ? @tr("Nothing is excluded.") : @tr("No restrictions: the rule works in every window.");
                color: Theme.muted; wrap: word-wrap;
            } }
            for item[index] in root.items: AppItemRow {
                pattern: item;
                show-count: root.detection-available;
                edit => { AppEntryDialog.open(root.value, root.exclusion, index); }
                remove => { AppEntryDialog.confirm-remove(root.value, root.exclusion, index); }
            }
        }
    }
}

/// Conditions of a rule: a heading, game mode and system languages side
/// by side, then the window lists — with `show-exclusions` the allowed and
/// the excluded windows side by side.
export component ConditionsForm inherits VerticalLayout {
    in property <string> heading;
    in-out property <GameCondition> game;
    in-out property <string> languages;
    in-out property <string> applications;
    in-out property <string> excluded;
    in property <bool> show-applications: true;
    in property <bool> show-exclusions;
    /// Unknown until the first status counts as available.
    private property <bool> detection-available: AppState.game-window-availability.id != "capability-unavailable"
        && AppState.game-window-availability.id != "capability-unsupported";
    spacing: 16px;
    VerticalLayout { spacing: 12px;
        if root.heading != "": Text { text: root.heading; color: Theme.text; font-weight: 600; }
        HorizontalLayout { spacing: 24px;
            VerticalLayout { spacing: 10px; alignment: start; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                Text { text: @tr("System languages"); color: Theme.text; }
                for language in ConditionChoices.languages: CheckBox {
                    text: language.label;
                    checked: ConditionChoices.contains(root.languages, language.code);
                    toggled => { root.languages = ConditionChoices.toggle(root.languages, language.code, self.checked); }
                }
                if ConditionChoices.languages.length == 0: Text { text: @tr("No system languages detected"); color: Theme.muted; wrap: word-wrap; }
                for code in ConditionChoices.unknown-languages(root.languages, ConditionChoices.languages): CheckBox {
                    text: code;
                    checked: ConditionChoices.contains(root.languages, code);
                    toggled => { root.languages = ConditionChoices.toggle(root.languages, code, self.checked); }
                }
            }
            if AppState.in-development: VerticalLayout { spacing: 10px; alignment: start; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                Text { text: @tr("Game mode"); color: Theme.text; }
                RadioGroup {
                    orientation: vertical;
                    selected(value) => { root.game = value == @tr("Game mode on") ? GameCondition.on : value == @tr("Game mode off") ? GameCondition.off : GameCondition.any; }
                    RadioButton { text: @tr("Does not matter"); checked: root.game == GameCondition.any; }
                    RadioButton { text: @tr("Game mode on"); checked: root.game == GameCondition.on; }
                    RadioButton { text: @tr("Game mode off"); checked: root.game == GameCondition.off; }
                }
            }
        }
    }
    if root.show-applications: VerticalLayout { spacing: 10px;
        if !root.detection-available: Text {
            text: @tr("Active window detection is unavailable in this session, so application conditions do not match.");
            color: Theme.warning; wrap: word-wrap;
        }
        HorizontalLayout { spacing: 24px;
            ApplicationsField { value <=> root.applications; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
            if root.show-exclusions: ApplicationsField {
                exclusion: true; label: @tr("Except applications"); value <=> root.excluded;
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
            }
        }
    }
}

/// A game-mode list, games or with `exclusion` the exclusions: rows like
/// `ApplicationsField`, edited in `AppEntryOverlay` with the scope choice.
/// `value` lists the patterns of all matchers, for duplicate checks.
export component GameAppsField inherits VerticalLayout {
    in property <string> value;
    in property <[GameAppEntry]> entries;
    in property <string> label;
    in property <string> info;
    in property <string> empty-text;
    in property <bool> exclusion;
    private property <int> revision: AppEntryDialog.revision;
    private property <bool> detection-available: AppState.game-window-availability.id != "capability-unavailable"
        && AppState.game-window-availability.id != "capability-unsupported";
    /// `index` -1 adds an item.
    callback saved(index: int, pattern: string, window-only: bool);
    callback removed(index: int);
    changed revision => {
        if AppEntryDialog.game && AppEntryDialog.exclusion == root.exclusion {
            if AppEntryDialog.result-removed {
                root.removed(AppEntryDialog.index);
            } else {
                root.saved(AppEntryDialog.index, AppEntryDialog.result-pattern, AppEntryDialog.result-window-only);
            }
        }
    }
    spacing: 8px;
    HorizontalLayout { spacing: 6px;
        Text { text: root.label; color: Theme.text; font-weight: 600; vertical-alignment: center; }
        if root.info != "": InfoTip { text: root.info; }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            icon: @image-url("icons/plus.svg"); text: @tr("Add");
            clicked => { AppEntryDialog.open-game(root.value, root.exclusion, -1, false); }
        }
    }
    Rectangle {
        border-width: 1px; border-color: Theme.divider; border-radius: Theme.radius-large; background: Theme.card;
        height: list.preferred-height;
        list := VerticalLayout {
            padding: 6px; spacing: 2px;
            if root.entries.length == 0: HorizontalLayout { padding: 6px; Text { text: root.empty-text; color: Theme.muted; wrap: word-wrap; } }
            for entry in root.entries: AppItemRow {
                pattern: entry.pattern;
                kind: ConditionChoices.is-title(entry.pattern) ? @tr("Window title")
                    : !entry.window-only ? @tr("Process · while it runs")
                    : ConditionChoices.names-process(ConditionChoices.open-windows, entry.pattern) ? @tr("Process · while its window is active")
                    : @tr("Application · while its window is active");
                icon: ConditionChoices.is-title(entry.pattern) ? @image-url("icons/text-cursor-input.svg") : entry.window-only ? @image-url("icons/app-window.svg") : @image-url("icons/terminal.svg");
                // A process without a window is not among the open windows.
                show-count: root.detection-available && entry.window-only;
                edit => { AppEntryDialog.open-game(root.value, root.exclusion, entry.index, entry.window-only); }
                remove => { AppEntryDialog.confirm-remove-game(root.value, root.exclusion, entry.index); }
            }
        }
    }
}
