import { SearchField, TextField } from "controls.slint";
import { ScrollView } from "scroll.slint";
import { Theme } from "theme.slint";
import { GameCondition } from "types.slint";
import { AppState } from "app-state.slint";
import { Badge, ButtonGroup, ConfirmDialog, IconButton, InfoTip } from "controls.slint";
import { Button, CheckBox, RadioGroup } from "std-widgets.slint";

export struct LanguageChoice { code: string, label: string }

/// An application with `count` open windows; `pattern` is what a
/// condition stores for it, `titles` has one title per window. `recent`
/// marks the last active application.
export struct WindowChoice { pattern: string, app-id: string, process: string, title: string, titles: [string], count: int, recent: bool }

export global ConditionChoices {
    in property <[LanguageChoice]> languages;
    /// Applications with open windows, the last active one first.
    in property <[WindowChoice]> open-windows;
    /// The open-window list is being collected.
    in property <bool> open-windows-loading;
    /// The open-window list has been collected at least once.
    in property <bool> open-windows-ready;
    callback refresh();
    callback refresh-open-windows();
    pure callback available(string) -> bool;
    pure callback contains(string, string) -> bool;
    pure callback toggle(string, string, bool) -> string;
    pure callback items(string) -> [string];
    pure callback unknown-languages(string, [LanguageChoice]) -> [string];
    pure callback remove(string, int) -> string;
    pure callback replace(value: string, index: int, item: string) -> string;
    pure callback add(string, string) -> string;
    pure callback is-title(string) -> bool;
    /// Text of a title pattern without its prefix.
    pure callback title-text(string) -> string;
    /// Pattern for the typed text: an app pattern, or with `title` a title pattern.
    pure callback make-pattern(string, bool) -> string;
    /// Whether a list of patterns has the pattern, ignoring case.
    pure callback has(patterns: [string], pattern: string) -> bool;
    /// Windows whose app id, process or title contains the query.
    pure callback matching(windows: [WindowChoice], query: string) -> [WindowChoice];
    /// Running processes containing the query, without those of the windows.
    pure callback processes(windows: [WindowChoice], query: string) -> [string];
    /// How many open windows the pattern matches.
    pure callback open-count(windows: [WindowChoice], pattern: string) -> int;
    /// Text of a pattern without the title prefix.
    public pure function text(pattern: string) -> string {
        return self.is-title(pattern) ? self.title-text(pattern) : pattern;
    }
    /// How a stored pattern reads in a list.
    public pure function label(pattern: string) -> string {
        return self.is-title(pattern) ? @tr("Window title contains: {}", self.title-text(pattern)) : pattern;
    }
}

/// A checkable row of the application picker.
component PickerRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> badge;
    in property <bool> checked;
    /// Title the row can offer as a title condition.
    in property <string> title;
    callback toggled(bool);
    callback use-title(string);
    height: row.preferred-height;
    border-radius: 6px;
    background: touch.has-hover ? Theme.hover : transparent;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
    row := HorizontalLayout {
        padding: 6px; spacing: 8px;
        VerticalLayout { alignment: center; CheckBox { checked: root.checked; accessible-label: root.text; toggled => { root.toggled(self.checked); } } }
        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
            HorizontalLayout { spacing: 6px;
                Text { text: root.text; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                if root.badge != "": Badge { text: root.badge; fill: Theme.accent.transparentize(0.75); }
            }
            if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.title != "": VerticalLayout { alignment: center;
            IconButton { icon: @image-url("icons/text-cursor-input.svg"); label: @tr("Match by window title"); tooltip: @tr("Match by window title"); clicked => { root.use-title(root.title); } }
        }
    }
}

/// Pick applications for a list: open windows (the last active one first),
/// running processes and typed text. Rows are checked when `selected`
/// has their pattern; `window` tells whether a pattern came from a window.
export component AppPicker inherits Rectangle {
    in property <[string]> selected;
    in property <string> title: @tr("Choose applications");
    callback toggled(pattern: string, on: bool, window: bool);
    callback done();
    private property <string> query;
    private property <[WindowChoice]> windows: ConditionChoices.matching(ConditionChoices.open-windows, root.query);
    private property <[string]> processes: ConditionChoices.processes(ConditionChoices.open-windows, root.query);
    private property <string> typed: ConditionChoices.make-pattern(root.query, false);
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.divider;
    border-radius: 10px;
    height: body.preferred-height;
    body := VerticalLayout {
        padding: 12px; spacing: 8px;
        HorizontalLayout { spacing: 8px;
            Text { text: root.title; color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
            IconButton { text: @tr("Refresh"); enabled: !ConditionChoices.open-windows-loading; clicked => { ConditionChoices.refresh-open-windows(); } }
        }
        search := SearchField {
            text <=> root.query;
            placeholder-text: @tr("Search, or type an app ID or title text");
            accepted => {
                if root.typed != "" {
                    root.toggled(ConditionChoices.make-pattern(root.typed, false), true, false);
                    root.query = "";
                }
            }
        }
        if ConditionChoices.open-windows-loading: Text { text: @tr("Looking for open windows…"); color: Theme.muted; }
        if !ConditionChoices.open-windows-loading && root.windows.length == 0 && root.processes.length == 0: Text {
            text: root.query == "" ? @tr("No open windows found") : @tr("Nothing found");
            color: Theme.muted; wrap: word-wrap;
        }
        if root.windows.length > 0: Text { text: @tr("Open windows"); color: Theme.muted; font-size: 12px; }
        VerticalLayout { spacing: 2px;
            for window in root.windows: PickerRow {
                text: window.process == "" || window.process == window.app-id ? window.app-id : window.app-id + " · " + window.process;
                detail: window.count > 1 ? @tr("{n} window" | "{n} windows" % window.count) + " · " + window.title : window.title;
                badge: window.recent ? @tr("Last active") : "";
                checked: ConditionChoices.has(root.selected, window.pattern);
                title: window.title;
                toggled(on) => { root.toggled(window.pattern, on, true); }
                use-title(text) => { root.query = text; search.focus(); }
            }
        }
        if root.processes.length > 0: Text { text: @tr("Running processes"); color: Theme.muted; font-size: 12px; }
        VerticalLayout { spacing: 2px;
            for process in root.processes: PickerRow {
                text: process;
                checked: ConditionChoices.has(root.selected, process);
                toggled(on) => { root.toggled(process, on, false); }
            }
        }
        if root.typed != "": VerticalLayout { spacing: 2px;
            HorizontalLayout { alignment: start;
                IconButton { icon: @image-url("icons/plus.svg"); text: @tr("Add “{}” as app ID or process", root.typed); clicked => { root.toggled(ConditionChoices.make-pattern(root.typed, false), true, false); root.query = ""; } }
            }
            HorizontalLayout { alignment: start;
                IconButton { icon: @image-url("icons/plus.svg"); text: @tr("Add “{}” as window title text", root.typed); clicked => { root.toggled(ConditionChoices.make-pattern(root.typed, true), true, true); root.query = ""; } }
            }
        }
        HorizontalLayout { alignment: end; padding-top: 4px;
            Button { text: @tr("Done"); primary: true; clicked => { root.done(); } }
        }
    }
}

/// How many open windows a pattern matches; empty until the list is known.
component OpenCount inherits Text {
    in property <string> pattern;
    private property <int> count: ConditionChoices.open-count(ConditionChoices.open-windows, root.pattern);
    visible: ConditionChoices.open-windows-ready;
    text: root.count > 0 ? @tr("Open now: {n} window" | "Open now: {n} windows" % root.count) : @tr("Not open now");
    color: root.count > 0 ? Theme.success : Theme.muted;
    font-size: 12px;
    vertical-alignment: center;
}

/// Whether a pattern matches by app id / process or by window title.
component MatchKind inherits HorizontalLayout {
    in property <bool> title;
    width: 120px;
    spacing: 5px;
    VerticalLayout { alignment: center;
        Image { width: 14px; height: 14px; colorize: Theme.muted; source: root.title ? @image-url("icons/text-cursor-input.svg") : @image-url("icons/app-window.svg"); }
    }
    Text { text: root.title ? @tr("Window title") : @tr("Application"); color: Theme.muted; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
}

/// The add / edit dialog and the removal prompt of an applications list.
/// They are drawn above the dialog holding the list, so the list hands
/// over its value and applies `result` when `revision` changes.
export global AppEntryDialog {
    /// The add / edit dialog is open.
    in-out property <bool> editing;
    /// The removal prompt is open.
    in-out property <bool> removing;
    /// Which list opened the dialog: the exclusion list or the other one.
    in-out property <bool> exclusion;
    in-out property <string> value;
    /// Edited item; -1 adds a new one.
    in-out property <int> index: -1;
    in-out property <bool> title-mode;
    in-out property <string> text;
    out property <string> result;
    out property <int> revision;
    private property <string> item;
    public function open(value: string, exclusion: bool, index: int) {
        root.value = value;
        root.exclusion = exclusion;
        root.index = index;
        if index >= 0 {
            root.item = ConditionChoices.items(value)[index];
            root.title-mode = ConditionChoices.is-title(root.item);
            root.text = ConditionChoices.text(root.item);
        } else {
            root.title-mode = false;
            root.text = "";
        }
        root.removing = false;
        root.editing = true;
        ConditionChoices.refresh-open-windows();
    }
    public function confirm-remove(value: string, exclusion: bool, index: int) {
        root.value = value;
        root.exclusion = exclusion;
        root.index = index;
        root.editing = false;
        root.removing = true;
    }
    public function close() { root.editing = false; root.removing = false; }
    public function save() {
        if root.valid() {
            root.finish(root.index >= 0 ? ConditionChoices.replace(root.value, root.index, root.pattern()) : ConditionChoices.add(root.value, root.pattern()));
        }
    }
    public function remove() { root.finish(ConditionChoices.remove(root.value, root.index)); }
    function finish(value: string) {
        root.result = value;
        root.revision += 1;
        root.close();
    }
    public pure function pattern() -> string { return ConditionChoices.make-pattern(root.text, root.title-mode); }
    /// The other items of the list, to reject duplicates.
    pure function others() -> [string] {
        return ConditionChoices.items(root.index >= 0 ? ConditionChoices.remove(root.value, root.index) : root.value);
    }
    public pure function duplicate() -> bool { return ConditionChoices.has(root.others(), root.pattern()); }
    public pure function valid() -> bool { return ConditionChoices.text(root.pattern()) != "" && !root.duplicate(); }
}

/// An open window to fill the dialog field with: the application, or in
/// title mode one of its window titles.
component WindowRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> badge;
    in property <bool> selected;
    in property <image> icon: @image-url("icons/app-window.svg");
    callback clicked();
    height: row.preferred-height;
    border-radius: 6px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    row := HorizontalLayout {
        padding: 6px; spacing: 8px;
        VerticalLayout { alignment: center;
            Image { width: 16px; height: 16px; colorize: Theme.muted; source: root.icon; }
        }
        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
            HorizontalLayout { spacing: 6px;
                Text { text: root.text; color: Theme.text; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                if root.badge != "": Badge { text: root.badge; fill: Theme.accent.transparentize(0.75); }
            }
            if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.selected: VerticalLayout { alignment: center;
            Image { width: 16px; height: 16px; colorize: Theme.accent; source: @image-url("icons/check.svg"); }
        }
    }
}

/// The add / edit dialog and the removal prompt of `AppEntryDialog`;
/// placed over the whole settings window.
export component AppEntryOverlay inherits Rectangle {
    private property <string> typed: AppEntryDialog.pattern();
    if AppEntryDialog.editing: Rectangle {
        background: #00000099;
        TouchArea { clicked => { AppEntryDialog.close(); } }
        FocusScope {
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape { AppEntryDialog.close(); return accept; }
                return reject;
            }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width - 48px, 520px);
                height: min(parent.height - 64px, 600px);
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 12px;
                TouchArea {}
                VerticalLayout { padding: 20px; spacing: 10px;
                    Text {
                        text: AppEntryDialog.index >= 0 ? @tr("Edit application") : @tr("Add application");
                        color: Theme.text; font-size: 18px; font-weight: 700;
                    }
                    ButtonGroup {
                        labels: [@tr("Application"), @tr("Window title")];
                        selected-index: AppEntryDialog.title-mode ? 1 : 0;
                        selected(index) => { AppEntryDialog.title-mode = index == 1; input.focus(); }
                    }
                    input := TextField {
                        text <=> AppEntryDialog.text;
                        placeholder-text: AppEntryDialog.title-mode ? @tr("Text the window title contains") : @tr("App ID or process, * and ? allowed");
                        invalid: AppEntryDialog.text != "" && AppEntryDialog.duplicate();
                        init => { self.focus(); self.select-all(); }
                        accepted => { AppEntryDialog.save(); }
                    }
                    if AppEntryDialog.text != "" && AppEntryDialog.duplicate(): Text { text: @tr("Already in the list"); color: Theme.error; font-size: 12px; }
                    if AppEntryDialog.text != "" && !AppEntryDialog.duplicate() && ConditionChoices.open-windows-ready: Text {
                        text: ConditionChoices.open-count(ConditionChoices.open-windows, root.typed) > 0
                            ? @tr("Matches {n} open window" | "Matches {n} open windows" % ConditionChoices.open-count(ConditionChoices.open-windows, root.typed))
                            : @tr("Matches no open window");
                        color: Theme.muted; font-size: 12px;
                    }
                    HorizontalLayout { spacing: 8px; padding-top: 6px;
                        Text { text: @tr("Open windows"); color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { text: @tr("Refresh"); enabled: !ConditionChoices.open-windows-loading; clicked => { ConditionChoices.refresh-open-windows(); } }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        border-width: 1px; border-color: Theme.divider; border-radius: 8px; background: Theme.card;
                        ScrollView { viewport-width: self.visible-width;
                            VerticalLayout { padding: 6px; spacing: 2px; alignment: start;
                                if ConditionChoices.open-windows-loading && ConditionChoices.open-windows.length == 0: Text { text: @tr("Looking for open windows…"); color: Theme.muted; }
                                if !ConditionChoices.open-windows-loading && ConditionChoices.open-windows.length == 0: Text { text: @tr("No open windows found"); color: Theme.muted; wrap: word-wrap; }
                                if !AppEntryDialog.title-mode: VerticalLayout { spacing: 2px;
                                    for window in ConditionChoices.open-windows: WindowRow {
                                        text: window.process == "" || window.process == window.app-id ? window.pattern : window.app-id + " · " + window.process;
                                        detail: window.count > 1 ? @tr("{n} window" | "{n} windows" % window.count) + " · " + window.title : window.title;
                                        badge: window.recent ? @tr("Last active") : "";
                                        selected: ConditionChoices.has([window.pattern], ConditionChoices.make-pattern(AppEntryDialog.text, false));
                                        clicked => { AppEntryDialog.text = window.pattern; input.focus(); }
                                    }
                                }
                                if AppEntryDialog.title-mode: VerticalLayout { spacing: 2px;
                                    for window in ConditionChoices.open-windows: VerticalLayout { spacing: 2px;
                                        for title in window.titles: WindowRow {
                                            visible: title != "";
                                            height: title != "" ? self.preferred-height : 0px;
                                            text: title;
                                            detail: window.pattern;
                                            icon: @image-url("icons/text-cursor-input.svg");
                                            badge: window.recent ? @tr("Last active") : "";
                                            selected: AppEntryDialog.text == title;
                                            clicked => { AppEntryDialog.text = title; input.focus(); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout { spacing: 8px; alignment: end;
                        Button { text: @tr("Cancel"); clicked => { AppEntryDialog.close(); } }
                        Button {
                            text: AppEntryDialog.index >= 0 ? @tr("Save") : @tr("Add");
                            primary: true;
                            enabled: AppEntryDialog.valid();
                            clicked => { AppEntryDialog.save(); }
                        }
                    }
                }
            }
        }
    }
    if AppEntryDialog.removing: ConfirmDialog {
        width: 100%; height: 100%;
        title: @tr("Remove application?");
        body: @tr("“{}” will be removed from the list.", ConditionChoices.label(ConditionChoices.items(AppEntryDialog.value)[AppEntryDialog.index]));
        confirm-text: @tr("Remove");
        cancel => { AppEntryDialog.close(); }
        confirm => { AppEntryDialog.remove(); }
    }
}

/// A flat list of window patterns: each row shows whether it matches by
/// app or by title and how many open windows it matches; items are added
/// and edited in `AppEntryOverlay`, removed after a prompt.
export component ApplicationsField inherits VerticalLayout {
    in-out property <string> value;
    in property <string> label: @tr("Apply in windows");
    in property <bool> exclusion;
    private property <[string]> items: ConditionChoices.items(root.value);
    private property <int> revision: AppEntryDialog.revision;
    /// Unknown until the first status counts as available.
    private property <bool> detection-available: AppState.game-window-availability.id != "capability-unavailable"
        && AppState.game-window-availability.id != "capability-unsupported";
    changed revision => {
        if AppEntryDialog.exclusion == root.exclusion { root.value = AppEntryDialog.result; }
    }
    init => { ConditionChoices.refresh-open-windows(); }
    spacing: 8px;
    HorizontalLayout { spacing: 6px;
        Text { text: root.label; color: Theme.text; vertical-alignment: center; }
        InfoTip {
            text: (root.exclusion ? @tr("A match blocks the rule, even if the window is in the allowed list.") : @tr("Any match allows the rule. An empty list allows all windows."))
                + "\n\n" + @tr("An application is matched by its ID or process name: the whole name, ignoring case, with * and ? as wildcards. A window title item matches when the title contains the text. Any matching item is enough. An empty list imposes no restrictions.");
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton {
            icon: @image-url("icons/plus.svg"); text: @tr("Add");
            clicked => { AppEntryDialog.open(root.value, root.exclusion, -1); }
        }
    }
    Rectangle {
        border-width: 1px; border-color: Theme.divider; border-radius: 8px; background: Theme.card;
        height: list.preferred-height;
        list := VerticalLayout {
            padding: 6px; spacing: 2px;
            if root.items.length == 0: HorizontalLayout { padding: 6px; Text {
                text: root.exclusion ? @tr("Nothing is excluded.") : @tr("No restrictions: the rule works in every window.");
                color: Theme.muted; wrap: word-wrap;
            } }
            for item[index] in root.items: Rectangle {
                height: item-row.preferred-height; border-radius: 6px;
                background: item-touch.has-hover ? Theme.hover : transparent;
                item-touch := TouchArea { mouse-cursor: pointer; clicked => { AppEntryDialog.open(root.value, root.exclusion, index); } }
                item-row := HorizontalLayout {
                    padding-left: 6px; padding-right: 2px; padding-top: 2px; padding-bottom: 2px; spacing: 10px;
                    MatchKind { title: ConditionChoices.is-title(item); }
                    Text { text: ConditionChoices.text(item); color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
                    if root.detection-available: OpenCount { pattern: item; }
                    VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/pencil.svg"); label: @tr("Edit"); tooltip: @tr("Edit"); clicked => { AppEntryDialog.open(root.value, root.exclusion, index); } } }
                    VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Remove"); tooltip: @tr("Remove"); clicked => { AppEntryDialog.confirm-remove(root.value, root.exclusion, index); } } }
                }
            }
        }
    }
}

/// Conditions of a rule: a heading, game mode and system languages side
/// by side, then the window lists — with `show-exclusions` the allowed and
/// the excluded windows side by side.
export component ConditionsForm inherits VerticalLayout {
    in property <string> heading;
    in-out property <GameCondition> game;
    in-out property <string> languages;
    in-out property <string> applications;
    in-out property <string> excluded;
    in property <bool> show-applications: true;
    in property <bool> show-exclusions;
    /// Unknown until the first status counts as available.
    private property <bool> detection-available: AppState.game-window-availability.id != "capability-unavailable"
        && AppState.game-window-availability.id != "capability-unsupported";
    spacing: 24px;
    VerticalLayout { spacing: 12px;
        if root.heading != "": Text { text: root.heading; color: Theme.text; font-weight: 600; }
        HorizontalLayout { spacing: 24px;
            VerticalLayout { spacing: 10px; alignment: start; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                Text { text: @tr("System languages"); color: Theme.text; }
                for language in ConditionChoices.languages: CheckBox {
                    text: language.label;
                    checked: ConditionChoices.contains(root.languages, language.code);
                    toggled => { root.languages = ConditionChoices.toggle(root.languages, language.code, self.checked); }
                }
                if ConditionChoices.languages.length == 0: Text { text: @tr("No system languages detected"); color: Theme.muted; wrap: word-wrap; }
                for code in ConditionChoices.unknown-languages(root.languages, ConditionChoices.languages): CheckBox {
                    text: code;
                    checked: ConditionChoices.contains(root.languages, code);
                    toggled => { root.languages = ConditionChoices.toggle(root.languages, code, self.checked); }
                }
            }
            VerticalLayout { spacing: 10px; alignment: start; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                Text { text: @tr("Game mode"); color: Theme.text; }
                RadioGroup {
                    orientation: vertical;
                    selected(value) => { root.game = value == @tr("Game mode on") ? GameCondition.on : value == @tr("Game mode off") ? GameCondition.off : GameCondition.any; }
                    RadioButton { text: @tr("Does not matter"); checked: root.game == GameCondition.any; }
                    RadioButton { text: @tr("Game mode on"); checked: root.game == GameCondition.on; }
                    RadioButton { text: @tr("Game mode off"); checked: root.game == GameCondition.off; }
                }
            }
        }
    }
    if root.show-applications: VerticalLayout { spacing: 10px;
        if !root.detection-available: Text {
            text: @tr("Active window detection is unavailable in this session, so application conditions do not match.");
            color: Theme.warning; wrap: word-wrap;
        }
        HorizontalLayout { spacing: 24px;
            ApplicationsField { value <=> root.applications; horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
            if root.show-exclusions: ApplicationsField {
                exclusion: true; label: @tr("Do not apply in windows"); value <=> root.excluded;
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
            }
        }
    }
}
