import { Locale } from "i18n.slint";
import { Theme } from "theme.slint";
import { DragDrop } from "reorder.slint";

component ScrollBar inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> horizontal;
    in property <length> maximum;
    in property <length> page-size;
    in-out property <length> value;
    callback scrolled();
    private property <length> track: root.horizontal ? root.width : root.height;
    private property <length> thumb-size: min(root.track, max(24px, root.track * root.page-size / (root.maximum + root.page-size)));
    private property <length> travel: root.track - root.thumb-size;
    accessible-role: slider;
    accessible-label: Locale.text({ id: root.horizontal ? "scroll-horizontal" : "scroll-vertical" });
    accessible-value: (-root.value / 1px);
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum / 1px;
    accessible-value-step: 40;
    accessible-action-increment => { root.value = max(-root.maximum, root.value - 40px); root.scrolled(); }
    accessible-action-decrement => { root.value = min(0px, root.value + 40px); root.scrolled(); }
    border-width: scroll-focus.has-focus ? 2px : 0px;
    border-color: Theme.focus;
    scroll-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            let delta = event.text == Key.PageDown ? -root.page-size
                : event.text == Key.PageUp ? root.page-size
                : event.text == Key.DownArrow || event.text == Key.RightArrow ? -40px
                : event.text == Key.UpArrow || event.text == Key.LeftArrow ? 40px : 0px;
            if event.text == Key.Home { root.value = 0px; }
            else if event.text == Key.End { root.value = -root.maximum; }
            else if delta != 0px { root.value = clamp(root.value + delta, -root.maximum, 0px); }
            else { return reject; }
            root.scrolled(); return accept;
        }
    }
    background: Theme.surface;
    border-radius: Theme.radius;
    Rectangle {
        x: root.horizontal ? (-root.value / max(1px, root.maximum)) * root.travel : 3px;
        y: root.horizontal ? 3px : (-root.value / max(1px, root.maximum)) * root.travel;
        width: root.horizontal ? root.thumb-size : 6px;
        height: root.horizontal ? 6px : root.thumb-size;
        border-radius: min(self.width, self.height) / 2;
        background: touch.has-hover || touch.pressed ? Theme.muted : Theme.border;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        private property <length> pressed-position;
        private property <length> pressed-value;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.pressed-position = root.horizontal ? self.mouse-x : self.mouse-y;
                self.pressed-value = root.value;
                if self.pressed-position < -root.value / max(1px, root.maximum) * root.travel || self.pressed-position > -root.value / max(1px, root.maximum) * root.travel + root.thumb-size {
                    root.value = -clamp((self.pressed-position - root.thumb-size / 2) / max(1px, root.travel) * root.maximum, 0px, root.maximum);
                    self.pressed-value = root.value;
                    root.scrolled();
                }
            }
        }
        moved => {
            if self.pressed {
                root.value = clamp(self.pressed-value - ((root.horizontal ? self.mouse-x : self.mouse-y) - self.pressed-position) * root.maximum / max(1px, root.travel), -root.maximum, 0px);
                root.scrolled();
            }
        }
        scroll-event(event) => {
            root.value = clamp(root.value + (root.horizontal ? event.delta-x : event.delta-y), -root.maximum, 0px);
            root.scrolled();
            return accept;
        }
    }
}

/// Content of a page-level ScrollView: keeps the page gap after the last item,
/// since the page container has no bottom padding.
export component PageContent inherits VerticalLayout {
    padding: 0px;
    padding-bottom: Theme.page-padding;
}

export component ScrollView {
    in property <bool> enabled: true;
    out property <length> visible-width <=> content.width;
    out property <length> visible-height <=> content.height;
    in-out property <length> viewport-width <=> content.content-width;
    in-out property <length> viewport-height <=> content.content-height;
    in-out property <length> viewport-x <=> content.content-x;
    in-out property <length> viewport-y <=> content.content-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy: as-needed;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy: always-off;
    in property <bool> mouse-drag-pan-enabled: false;
    private property <length> scrollbar-size: Theme.scrollbar-size;
    private property <length> scrollbar-gap: Theme.scrollbar-gap;
    private property <bool> vertical: root.vertical-scrollbar-policy == ScrollBarPolicy.always-on || (root.vertical-scrollbar-policy == ScrollBarPolicy.as-needed && root.viewport-height > root.visible-height);
    private property <bool> horizontal: root.horizontal-scrollbar-policy == ScrollBarPolicy.always-on || (root.horizontal-scrollbar-policy == ScrollBarPolicy.as-needed && root.viewport-width > root.visible-width);
    // Scroll under an active drag: wheel events forwarded by the drag source and
    // auto-scroll while the pointer is near an edge. A ScrollView without a vertical
    // scrollbar (tab strips) follows horizontal drags along x; the others follow
    // vertical and free drags along y.
    in property <bool> drag-scroll: false;
    private property <bool> drag-x: root.vertical-scrollbar-policy == ScrollBarPolicy.always-off;
    private property <bool> drag-active: root.drag-scroll && DragDrop.dragging && DragDrop.horizontal == root.drag-x;
    private property <length> drag-edge: 48px;
    /// Edge auto-scroll while dragging: fastest step and its tick (one frame at 60 Hz).
    private property <length> drag-max-step: 16px;
    private property <duration> drag-tick: 16ms;
    private property <length> drag-pointer: root.drag-x ? DragDrop.pointer-x - root.absolute-position.x : DragDrop.pointer-y - root.absolute-position.y;
    private property <length> drag-extent: root.drag-x ? content.width : content.height;
    private property <length> drag-speed: !root.drag-active ? 0px
        : root.drag-pointer < root.drag-edge ? root.drag-max-step * min(1, (root.drag-edge - root.drag-pointer) / root.drag-edge)
        : root.drag-pointer > root.drag-extent - root.drag-edge ? -root.drag-max-step * min(1, (root.drag-pointer - root.drag-extent + root.drag-edge) / root.drag-edge)
        : 0px;
    private property <int> drag-wheel: DragDrop.wheel-serial;
    // Every ScrollView sees the serial change; only the one hosting the drag may consume it.
    changed drag-wheel => {
        if !root.drag-active || root.drag-x { return; }
        let delta = DragDrop.wheel;
        DragDrop.wheel = 0px;
        root.drag-scroll-by(delta);
    }
    function drag-scroll-by(delta: length) {
        if root.drag-x {
            let before = content.content-x;
            content.content-x = clamp(before + delta, min(0px, content.width - content.content-width), 0px);
            if content.content-x != before {
                DragDrop.scrolled(before - content.content-x);
                root.scrolled();
            }
        } else {
            let before = content.content-y;
            content.content-y = clamp(before + delta, min(0px, content.height - content.content-height), 0px);
            if content.content-y != before {
                DragDrop.scrolled(before - content.content-y);
                root.scrolled();
            }
        }
    }
    callback scrolled();
    min-width: 50px;
    min-height: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    content := Flickable {
        x: 0px;
        y: 0px;
        width: max(0px, root.width - (root.vertical-scrollbar-policy != ScrollBarPolicy.always-off ? root.scrollbar-size + root.scrollbar-gap : 0px));
        height: max(0px, root.height - (root.horizontal ? root.scrollbar-size + root.scrollbar-gap : 0px));
        interactive: root.mouse-drag-pan-enabled;
        flicked => { root.scrolled(); }
        @children
    }
    Timer {
        interval: root.drag-tick;
        running: root.drag-speed != 0px;
        triggered => { root.drag-scroll-by(root.drag-speed); }
    }
    if root.vertical: ScrollBar {
        y: 0px;
        x: content.width + root.scrollbar-gap;
        width: root.scrollbar-size;
        height: content.height;
        enabled: root.enabled;
        maximum: max(0px, root.viewport-height - content.height);
        page-size: content.height;
        value <=> root.viewport-y;
        scrolled => { root.scrolled(); }
    }
    if root.horizontal: ScrollBar {
        x: 0px;
        y: content.height + root.scrollbar-gap;
        height: root.scrollbar-size;
        width: content.width;
        horizontal: true;
        enabled: root.enabled;
        maximum: max(0px, root.viewport-width - content.width);
        page-size: content.width;
        value <=> root.viewport-x;
        scrolled => { root.scrolled(); }
    }
}
