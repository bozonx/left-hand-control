import { ScrollView } from "scroll.slint";
import { AppState } from "app-state.slint";
import { Card } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, SpinBox, VerticalBox } from "std-widgets.slint";

export struct CapabilityRow { supported: bool, available: bool, status: Message, detail: string }

export struct ProcessRow { name: string, only-active: bool, blacklist: bool }

export global SettingsEditor {
    in-out property <bool> keyboard-manual;
    in-out property <bool> mouse-manual;
    out property <string> manual-label: @tr("Enter device path manually");
    in-out property <bool> launch-on-startup;
    in-out property <int> appearance-index;
    in-out property <int> locale-index;
    in-out property <int> tap-decision-index;
    in-out property <string> hold-timeout;
    in-out property <string> double-tap-timeout;
    in-out property <string> macro-pause;
    in-out property <string> modifier-delay;
    in-out property <bool> use-gamemoded: true;
    in-out property <bool> use-fullscreen;
    in property <[ProcessRow]> process-matchers;
    in-out property <string> process-name;
    in-out property <bool> process-only-active;
    in-out property <bool> process-blacklist;
    in-out property <int> selected-process: -1;
    in property <[string]> text-modes;
    in-out property <int> text-mode-index;
    in-out property <string> ydotool-path;
    in-out property <string> xdotool-path;
    in-out property <string> keyboard-device-path;
    in property <[string]> input-devices;
    in-out property <int> selected-device: -1;
    in-out property <string> mouse-device-path;
    in property <[string]> mouse-devices;
    in property <[string]> mouse-paths;
    in-out property <int> selected-mouse;
    in property <string> settings-dir;
    in property <string> layouts-dir;
    in property <string> platform-summary;
    in property <[CapabilityRow]> capabilities;
    in property <bool> platform-busy;
    callback refresh-platform();
    in property <Message> message;
    callback save();
    callback schedule-save();
    callback refresh-devices();
    callback select-device(int);
    callback add-process();
    callback select-process(int);
    callback update-process();
    callback delete-process();
}

component Section inherits Card {
    in property <string> title;
    VerticalBox { padding: 16px; spacing: 10px;
        Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 600; }
        @children
    }
}

export component SettingsPage inherits VerticalBox {
    spacing: 10px;
    path-clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    function copy-path(value: string) { path-clipboard.text = value; path-clipboard.select-all(); path-clipboard.copy(); }
    Text { color: Theme.text; text: @tr("Settings"); font-size: 26px; font-weight: 700; }
    ScrollView {
        viewport-width: self.visible-width;
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 12px;
            Section {
                title: @tr("Mapper");
                HorizontalBox { vertical-stretch: 0;
                    Text { text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Running") : @tr("Stopped"); color: Theme.muted; horizontal-stretch: 1; }
                    Button { text: @tr("Refresh devices"); enabled: !AppState.mapper-running; clicked => { SettingsEditor.refresh-devices(); } }
                }
                Text { text: @tr("Keyboard device"); color: Theme.text; }
                ComboBox { enabled: !AppState.mapper-running; model: SettingsEditor.input-devices; current-index: SettingsEditor.selected-device; selected(value) => { SettingsEditor.select-device(self.current-index); } }
                if SettingsEditor.keyboard-manual: LineEdit { enabled: !AppState.mapper-running; text <=> SettingsEditor.keyboard-device-path; placeholder-text: @tr("Keyboard device path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                Text { text: @tr("Mouse device path"); color: Theme.text; }
                ComboBox { enabled: !AppState.mapper-running; model: SettingsEditor.mouse-devices; current-index: SettingsEditor.selected-mouse; selected(value) => { SettingsEditor.selected-mouse = self.current-index; SettingsEditor.mouse-manual = self.current-index == SettingsEditor.mouse-devices.length - 1; if self.current-index < SettingsEditor.mouse-paths.length { SettingsEditor.mouse-device-path = SettingsEditor.mouse-paths[self.current-index]; SettingsEditor.save(); } } }
                if SettingsEditor.mouse-manual: LineEdit { enabled: !AppState.mapper-running; text <=> SettingsEditor.mouse-device-path; placeholder-text: @tr("Optional device path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                Button { text: AppState.mapper-running ? @tr("Stop") : @tr("Start"); enabled: !AppState.mapper-busy && (AppState.mapper-running || SettingsEditor.keyboard-device-path != ""); clicked => { AppState.toggle-mapper(); } }

            }
            Section {
                title: @tr("General");
                if AppState.is-linux: CheckBox { text: @tr("Launch on startup"); checked <=> SettingsEditor.launch-on-startup; toggled => { SettingsEditor.save(); } }
                HorizontalBox { vertical-stretch: 0; spacing: 24px;
                    VerticalBox { horizontal-stretch: 1; preferred-width: 0px; spacing: 8px;
                    Text { text: @tr("Theme"); color: Theme.text; vertical-alignment: center; }
                    ComboBox { model: [@tr("System"), @tr("Light"), @tr("Dark"), @tr("E-ink")]; current-index: SettingsEditor.appearance-index; selected(value) => { SettingsEditor.appearance-index = self.current-index; SettingsEditor.save(); } }
                    }
                    VerticalBox { horizontal-stretch: 1; preferred-width: 0px; spacing: 8px;
                    Text { text: @tr("Language"); color: Theme.text; vertical-alignment: center; }
                    ComboBox { model: [@tr("Automatic"), "English", "Русский"]; current-index: SettingsEditor.locale-index; selected(value) => { SettingsEditor.locale-index = self.current-index; SettingsEditor.save(); } }
                    }
                }
            }
            Section {
                title: @tr("Key behavior");
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    Text { text: @tr("Tap decision"); color: Theme.text; vertical-alignment: center; }
                    ComboBox { model: [@tr("Permissive hold"), @tr("Hold on other key press")]; current-index: SettingsEditor.tap-decision-index; selected(value) => { SettingsEditor.tap-decision-index = self.current-index; SettingsEditor.save(); } }
                }
                Text { text: SettingsEditor.tap-decision-index == 0 ? @tr("Hold after another key is pressed and released; otherwise tap.") : @tr("Hold as soon as another key is pressed."); color: Theme.muted; wrap: word-wrap; }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalBox { vertical-stretch: 0; spacing: 24px;
                    VerticalBox { horizontal-stretch: 1; preferred-width: 0px; spacing: 8px;
                    Text { text: @tr("Hold timeout (ms)"); color: Theme.text; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 2147483647; value: SettingsEditor.hold-timeout.to-float(); edited(value) => { SettingsEditor.hold-timeout = "" + self.value; SettingsEditor.schedule-save(); } }
                    Text { text: @tr("Time before a key press becomes a hold."); color: Theme.muted; wrap: word-wrap; }
                    }
                    VerticalBox { horizontal-stretch: 1; preferred-width: 0px; spacing: 8px;
                    Text { text: @tr("Double tap timeout (ms)"); color: Theme.text; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 2147483647; value: SettingsEditor.double-tap-timeout.to-float(); edited(value) => { SettingsEditor.double-tap-timeout = "" + self.value; SettingsEditor.schedule-save(); } }
                    Text { text: @tr("Maximum interval between two taps."); color: Theme.muted; wrap: word-wrap; }
                    }
                }
                HorizontalBox { vertical-stretch: 0; spacing: 24px;
                    VerticalBox { horizontal-stretch: 1; preferred-width: 0px; spacing: 8px;
                    Text { text: @tr("Macro step pause (ms)"); color: Theme.text; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 2147483647; value: SettingsEditor.macro-pause.to-float(); edited(value) => { SettingsEditor.macro-pause = "" + self.value; SettingsEditor.schedule-save(); } }
                    Text { text: @tr("Default pause between macro steps."); color: Theme.muted; wrap: word-wrap; }
                    }
                    VerticalBox { horizontal-stretch: 1; preferred-width: 0px; spacing: 8px;
                    Text { text: @tr("Modifier delay (ms)"); color: Theme.text; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 2147483647; value: SettingsEditor.modifier-delay.to-float(); edited(value) => { SettingsEditor.modifier-delay = "" + self.value; SettingsEditor.schedule-save(); } }
                    Text { text: @tr("Delay after pressing macro modifiers."); color: Theme.muted; wrap: word-wrap; }
                    }
                }
            }
            Section {
                title: @tr("Game mode");
                Text { text: @tr("Choose Auto, On or Off in the top bar. These settings configure Auto."); color: Theme.muted; wrap: word-wrap; }
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    if AppState.is-linux: CheckBox { text: @tr("Use GameMode daemon"); checked <=> SettingsEditor.use-gamemoded; toggled => { SettingsEditor.save(); } }
                    CheckBox { text: @tr("Detect fullscreen"); checked <=> SettingsEditor.use-fullscreen; toggled => { SettingsEditor.save(); } enabled: AppState.game-fullscreen-availability.id != "capability-unsupported"; }
                }
                if AppState.is-linux: Text { text: @tr("GameMode daemon: ") + Locale.text(AppState.game-daemon-availability); color: Theme.muted; }
                Text { text: @tr("Fullscreen detection: ") + Locale.text(AppState.game-fullscreen-availability); color: Theme.muted; }
                if AppState.game-fullscreen-availability.id == "capability-unsupported": Text { text: @tr("Fullscreen detection is not supported in this session. Use process rules or On/Off."); color: Theme.warning; wrap: word-wrap; }
                if AppState.game-fullscreen-availability.id == "capability-unavailable": Text { text: @tr("Fullscreen detection tools are missing or could not query the session."); color: Theme.warning; wrap: word-wrap; }
                Text { text: @tr("Process rules"); color: Theme.text; font-weight: 600; }
                Text { text: @tr("Exact process name or app ID; use * and ? for patterns. Window titles are not matched."); color: Theme.muted; wrap: word-wrap; }
                Text { text: @tr("Running processes: ") + Locale.text(AppState.game-processes-availability) + " · " + @tr("Active window: ") + Locale.text(AppState.game-window-availability); color: Theme.muted; wrap: word-wrap; }
                for item[index] in SettingsEditor.process-matchers: Rectangle {
                    height: 30px; background: SettingsEditor.selected-process == index ? Theme.accent : Theme.card;
                    Text { x: 8px; text: (item.blacklist ? @tr("Exclude: ") : @tr("Include: ")) + item.name; color: Theme.text; vertical-alignment: center; }
                    TouchArea { clicked => { SettingsEditor.select-process(index); } }
                }
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    LineEdit { text <=> SettingsEditor.process-name; placeholder-text: @tr("Process name"); }
                    CheckBox { text: @tr("Active window only"); checked <=> SettingsEditor.process-only-active; enabled: AppState.game-window-availability.id != "capability-unsupported"; }
                    CheckBox { text: @tr("Exclude"); checked <=> SettingsEditor.process-blacklist; }
                }
                HorizontalBox { vertical-stretch: 0; spacing: 8px;
                    Button { text: @tr("Add process"); clicked => { SettingsEditor.add-process(); } }
                    Button { text: @tr("Update selected"); enabled: SettingsEditor.selected-process >= 0; clicked => { SettingsEditor.update-process(); } }
                    Button { text: @tr("Remove selected"); enabled: SettingsEditor.selected-process >= 0; clicked => { SettingsEditor.delete-process(); } }
                }
            }
            if AppState.is-linux: Section {
                title: @tr("Linux text injection");
                ComboBox { model: SettingsEditor.text-modes; current-index: SettingsEditor.text-mode-index; selected(value) => { SettingsEditor.text-mode-index = self.current-index; SettingsEditor.save(); } }
                if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "ydotool": LineEdit { text <=> SettingsEditor.ydotool-path; edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } placeholder-text: @tr("ydotool path"); }
                if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "xdotool": LineEdit { text <=> SettingsEditor.xdotool-path; edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } placeholder-text: @tr("xdotool path"); }
            }
            Section {
                title: @tr("Configuration and system");
                HorizontalBox {
                    Text { text: SettingsEditor.platform-summary; color: Theme.muted; horizontal-stretch: 1; }
                    Button { text: @tr("Refresh status"); enabled: !SettingsEditor.platform-busy; clicked => { SettingsEditor.refresh-platform(); } }
                }
                for capability[index] in SettingsEditor.capabilities: VerticalBox {
                    HorizontalBox {
                        Text { text: [@tr("Key interception"), @tr("Text injection"), @tr("Layout detection"), @tr("System actions")][index]; color: Theme.text; horizontal-stretch: 1; }
                        Text { text: Locale.text(capability.status); color: capability.available ? Theme.link : Theme.muted; }
                    }
                    if capability.detail != "": Text { text: capability.detail; color: Theme.muted; wrap: word-wrap; }
                }
                HorizontalBox { vertical-stretch: 0;
                    Text { text: @tr("Settings directory: ") + SettingsEditor.settings-dir; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                    Button { text: @tr("Copy path"); clicked => { root.copy-path(SettingsEditor.settings-dir); } }
                }
                HorizontalBox { vertical-stretch: 0;
                    Text { text: @tr("Layouts directory: ") + SettingsEditor.layouts-dir; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                    Button { text: @tr("Copy path"); clicked => { root.copy-path(SettingsEditor.layouts-dir); } }
                }
            }
        }
    }
}
