import { NotificationCenter } from "notifications.slint";
import { ScrollView } from "scroll.slint";
import { AppState } from "app-state.slint";
import { Badge, CardHeader, IconButton } from "controls.slint";
import { LayoutLibrary } from "library.slint";
import { DeviceChoice, DevicePicker } from "device-picker.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { Button, CheckBox, HorizontalBox, LineEdit, RadioGroup, VerticalBox } from "std-widgets.slint";
import { FormLabel, NumericField, SelectField } from "controls.slint";

/// `kind`: 0 rule, 1 layer key, 2 macro step, 3 quick action.
export struct CommandPlaceRow { kind: int, layer: string, name: string }
/// `first` marks the first row of a layout, which shows its header.
export struct CommandAssignmentRow { layout-id: string, layout-name: string, current: bool, first: bool, command-id: string, name: string, script: string, directory: string, places: [CommandPlaceRow] }

export struct CapabilityRow { supported: bool, available: bool, status: Message, detail: string }

export struct ProcessRow { name: string, only-active: bool, blacklist: bool }

export global SettingsEditor {
    in-out property <bool> keyboard-manual;
    in-out property <bool> mouse-manual;
    in-out property <bool> launch-on-startup;
    in-out property <int> appearance-index;
    in-out property <bool> high-contrast;
    in-out property <bool> reduce-motion;
    in-out property <int> locale-index;
    in-out property <int> tap-decision-index;
    in-out property <string> hold-timeout;
    in-out property <string> long-hold-timeout;
    in-out property <string> double-tap-timeout;
    in-out property <string> macro-pause;
    in-out property <string> modifier-delay;
    in-out property <bool> commands-enabled;
    in property <[CommandAssignmentRow]> command-assignments;
    callback edit-command(string, string);
    /// Selected settings tab; 5 is Commands.
    in-out property <int> tab;
    in-out property <bool> use-gamemoded: true;
    in-out property <bool> use-fullscreen;
    in property <[ProcessRow]> process-matchers;
    in-out property <string> process-name;
    in-out property <bool> process-only-active;
    in-out property <bool> process-blacklist;
    /// Running processes whose names contain the typed text.
    in property <[string]> process-suggestions;
    /// Seconds left until the focused window is read; 0 when idle.
    in property <int> pick-countdown;
    in-out property <bool> remember-game-control;
    in-out property <bool> block-game-popups;
    /// Enabled rules of the current layout with a game-mode condition.
    in property <int> game-rule-count;
    /// Enabled automatic layout rules with a game-mode condition.
    in property <int> game-auto-rule-count;
    in property <[string]> text-modes;
    in-out property <int> text-mode-index;
    in-out property <string> ydotool-path;
    in-out property <string> xdotool-path;
    in-out property <string> keyboard-device-path;
    in property <[DeviceChoice]> input-devices;
    in-out property <int> selected-device: -1;
    in-out property <string> mouse-device-path;
    in property <[DeviceChoice]> mouse-devices;
    in-out property <int> selected-mouse;
    in property <string> settings-dir;
    in property <string> layouts-dir;
    in property <string> platform-summary;
    in property <[CapabilityRow]> capabilities;
    in property <bool> platform-busy;
    callback refresh-platform();
    in property <Message> message;
    callback save();
    callback schedule-save();
    callback refresh-devices();
    callback select-device(int);
    callback select-mouse(int);
    callback add-process();
    callback process-name-edited(string);
    /// Row index, only-active-window, exclude.
    callback set-process-flags(int, bool, bool);
    callback delete-process(int);
    callback pick-active-window();
}

component Section inherits Rectangle {
    in property <string> title;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 0px;
    max-width: 100000px;
    height: section-content.preferred-height;
    background: transparent;
    section-content := VerticalLayout {
        padding: 0px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 16px;
        alignment: start;
        if root.title != "": Text { text: root.title; color: Theme.text; font-size: 18px; font-weight: 600; vertical-stretch: 0; }
        @children
    }
}

export component SettingsPage inherits VerticalBox {
    padding: 0px;
    spacing: 10px;
    horizontal-stretch: 1;
    max-width: 100000px;
    path-clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    function copy-path(value: string) { path-clipboard.text = value; path-clipboard.select-all(); path-clipboard.copy(); NotificationCenter.send({ id: "copied" }); }
    Text { color: Theme.text; text: @tr("Settings"); font-size: 26px; font-weight: 700; }
    if SettingsEditor.message.id != "": Text { text: Locale.text(SettingsEditor.message); color: Theme.error; wrap: word-wrap; }
    HorizontalBox {
        padding: 0px;
        spacing: 16px;
        vertical-stretch: 1;
        VerticalBox {
            padding: 0px;
            spacing: 6px;
            width: 180px;
            horizontal-stretch: 0;
            alignment: start;
            for label[index] in [@tr("Main"), @tr("Accessibility"), @tr("Keyboard"), @tr("Game mode"), @tr("System"), @tr("Commands")]: Rectangle {
                height: 38px;
                border-radius: 6px;
                border-width: focus.has-focus ? 2px : 0px;
                border-color: Theme.focus;
                background: SettingsEditor.tab == index ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
                accessible-role: tab;
                accessible-label: label;
                accessible-checked: SettingsEditor.tab == index;
                accessible-action-default => { SettingsEditor.tab = index; content.viewport-y = 0px; }
                Rectangle {
                    x: 0px; y: 8px; width: 3px; height: parent.height - 16px;
                    border-radius: 2px;
                    background: SettingsEditor.tab == index ? Theme.accent : transparent;
                }
                Text {
                    x: 14px;
                    width: parent.width - 26px;
                    text: label;
                    color: SettingsEditor.tab == index ? Theme.text : Theme.muted;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == " " || event.text == "\n" {
                            SettingsEditor.tab = index;
                            content.viewport-y = 0px;
                            return accept;
                        }
                        return reject;
                    }
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { focus.focus(); SettingsEditor.tab = index; content.viewport-y = 0px; }
                }
            }
        }
        Rectangle { width: 1px; horizontal-stretch: 0; background: Theme.divider; }
        content := ScrollView {
            viewport-width: self.visible-width;
            viewport-height: settings-content.preferred-height;
            viewport-x: 0px;
            horizontal-stretch: 1;
            max-width: 100000px;
            vertical-stretch: 1;
            settings-content := VerticalLayout {
                x: 0px;
                y: 0px;
                padding: 0px;
                width: content.visible-width;
                alignment: start;
                min-width: 0px;
                max-width: 100000px;
                spacing: 0px;
                if SettingsEditor.tab == 0: Section {
                    title: @tr("General");
                    if AppState.is-linux: CheckBox { text: @tr("Launch on startup"); checked <=> SettingsEditor.launch-on-startup; toggled => { SettingsEditor.save(); } }
                    VerticalLayout { vertical-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Theme"); color: Theme.text; }
                        HorizontalLayout { alignment: start;
                            RadioGroup {
                                vertical-stretch: 0;
                                horizontal-stretch: 0;
                                orientation: horizontal;
                                selected(value) => { SettingsEditor.appearance-index = value == @tr("System") ? 0 : value == @tr("Light") ? 1 : value == @tr("Dark") ? 2 : 3; SettingsEditor.save(); }
                                RadioButton { text: @tr("System"); checked: SettingsEditor.appearance-index == 0; }
                                RadioButton { text: @tr("Light"); checked: SettingsEditor.appearance-index == 1; }
                                RadioButton { text: @tr("Dark"); checked: SettingsEditor.appearance-index == 2; }
                                RadioButton { text: @tr("E-ink"); checked: SettingsEditor.appearance-index == 3; }
                            }
                        }
                    }
                    VerticalLayout { vertical-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Language"); color: Theme.text; }
                        SelectField { width: 280px; height: 32px; vertical-stretch: 0; model: [@tr("Automatic"), "English", "Русский"]; current-index: SettingsEditor.locale-index; selected(value) => { SettingsEditor.locale-index = self.current-index; SettingsEditor.save(); } }
                    }
                }
                if SettingsEditor.tab == 1: Section {
                    title: @tr("Accessibility");
                    VerticalLayout { vertical-stretch: 0; spacing: 8px;
                        CheckBox { text: @tr("High contrast"); enabled: SettingsEditor.appearance-index != 3; checked <=> SettingsEditor.high-contrast; toggled => { SettingsEditor.save(); } }
                        Text { text: @tr("Pure black or white background, stronger text, borders and focus outlines. Works with the light and dark themes."); color: Theme.muted; wrap: word-wrap; }
                    }
                    VerticalLayout { vertical-stretch: 0; spacing: 8px;
                        CheckBox { text: @tr("Reduce motion"); checked <=> SettingsEditor.reduce-motion; toggled => { SettingsEditor.save(); } }
                        Text { text: @tr("Turn off highlight animations in the editor."); color: Theme.muted; wrap: word-wrap; }
                    }
                    Text { vertical-stretch: 0; text: @tr("Every control can be reached with Tab and activated with Space or Enter. Interface size follows the desktop scale factor."); color: Theme.muted; wrap: word-wrap; }
                }
                if SettingsEditor.tab == 5: Section {
                    title: "";
                    CheckBox { text: @tr("Allow command execution"); checked <=> SettingsEditor.commands-enabled; toggled => { SettingsEditor.save(); } }
                    Text { vertical-stretch: 0; text: SettingsEditor.commands-enabled ? @tr("Commands run with sh -lc in the background and are not awaited. Edit one to change its script or working directory.") : @tr("Commands stay off until you allow execution. Review below what your layouts would run."); color: Theme.muted; wrap: word-wrap; }
                    VerticalBox { padding: 0px; spacing: 16px;
                        if SettingsEditor.command-assignments.length == 0: Text { vertical-stretch: 0; text: @tr("No commands are assigned."); color: Theme.muted; }
                        for item in SettingsEditor.command-assignments: VerticalLayout {
                            spacing: 8px;
                            if item.first: Text {
                                text: (item.layout-name != "" ? item.layout-name : @tr("Custom layout")) + (item.current ? " · " + @tr("editing now") : "");
                                color: Theme.text; font-weight: 600; wrap: word-wrap;
                            }
                            if item.first: HorizontalLayout {
                                spacing: 16px;
                                Text { width: 32%; text: @tr("Assigned to"); color: Theme.muted; font-size: 12px; }
                                Text { horizontal-stretch: 1; text: @tr("Command"); color: Theme.muted; font-size: 12px; }
                            }
                            Rectangle { height: 1px; vertical-stretch: 0; background: Theme.divider; }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    width: 32%;
                                    spacing: 4px;
                                    for place in item.places: Text {
                                        text: (place.kind == 0 ? (place.layer != "" ? @tr("Rule in {}", place.layer) : @tr("Rule"))
                                            : place.kind == 1 ? @tr("Layer {}", place.layer)
                                            : place.kind == 2 ? @tr("Macro")
                                            : @tr("Quick action")) + " · " + place.name;
                                        color: Theme.text; wrap: word-wrap;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    if item.name != "" && item.name != item.script: Text { text: item.name; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                    Text { text: item.script; color: Theme.text; font-family: "monospace"; font-size: 12px; wrap: word-wrap; }
                                    Text { text: @tr("Folder: {}", item.directory != "" ? item.directory : "~"); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout { alignment: start;
                                    Button { text: @tr("Edit"); enabled: SettingsEditor.commands-enabled; clicked => { SettingsEditor.edit-command(item.layout-id, item.command-id); } }
                                }
                            }
                        }
                    }
                }
                if SettingsEditor.tab == 2: Section {
                    title: "";
                    VerticalBox { padding: 0px; spacing: 16px;
                        CardHeader { vertical-stretch: 0;
                            title: @tr("Mapper");
                            info: @tr("Pick the physical device whose events should be intercepted.") + "\n\n" + @tr("Select the mouse so the mapper can see extra buttons and clicks. Pointer movement is not affected.") + "\n\n" + @tr("The mouse is not fully intercepted yet: a remapped extra button can emit the new action, but its native system or app action may still run. If that gets in the way, disable the native action for that button in your system, browser, or driver settings.") + "\n\n" + @tr("The mapper reads from /dev/input/eventX and emits through uinput. If Start fails, grant access to those devices: usually the input group plus a udev rule for /dev/uinput.");
                            VerticalLayout { alignment: center;
                                Badge { text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Running") : @tr("Stopped"); fill: AppState.mapper-running ? Theme.success.transparentize(0.85) : Theme.hover; }
                            }
                            Button { text: @tr("Refresh device list"); enabled: !AppState.mapper-running && !AppState.mapper-busy; clicked => { SettingsEditor.refresh-devices(); } }
                        }
                        HorizontalBox { padding: 0px; vertical-stretch: 0; max-width: 576px; spacing: 16px;
                            VerticalBox { padding: 0px; width: 280px; horizontal-stretch: 0; spacing: 6px; alignment: start;
                                Text { vertical-stretch: 0; text: @tr("Keyboard device"); color: Theme.text; }
                                DevicePicker { label: @tr("Keyboard device"); placeholder: @tr("Not selected"); suggested-label: @tr("Looks like a keyboard"); enabled: !AppState.mapper-running && !AppState.mapper-busy; choices: SettingsEditor.input-devices; selected-index: SettingsEditor.selected-device; selected(index) => { SettingsEditor.select-device(index); } }
                                if SettingsEditor.keyboard-manual: LineEdit { enabled: !AppState.mapper-running; text <=> SettingsEditor.keyboard-device-path; placeholder-text: @tr("Keyboard device path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                            }
                            VerticalBox { padding: 0px; width: 280px; horizontal-stretch: 0; spacing: 6px; alignment: start;
                                Text { vertical-stretch: 0; text: @tr("Mouse (optional)"); color: Theme.text; }
                                DevicePicker { label: @tr("Mouse (optional)"); placeholder: @tr("Not selected (no mouse support)"); suggested-label: @tr("Looks like a mouse"); enabled: !AppState.mapper-running && !AppState.mapper-busy; choices: SettingsEditor.mouse-devices; selected-index: SettingsEditor.selected-mouse; selected(index) => { SettingsEditor.select-mouse(index); } }
                                if SettingsEditor.mouse-manual: LineEdit { enabled: !AppState.mapper-running; text <=> SettingsEditor.mouse-device-path; placeholder-text: @tr("Optional device path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                            }
                        }
                        HorizontalBox { padding: 0px; vertical-stretch: 0; alignment: end;
                            Button { text: AppState.mapper-running ? @tr("Stop") : @tr("Start"); primary: !AppState.mapper-running; icon: AppState.mapper-running ? @image-url("icons/square.svg") : @image-url("icons/play.svg"); colorize-icon: true; enabled: !AppState.mapper-busy && (AppState.mapper-running || SettingsEditor.keyboard-device-path != ""); clicked => { if AppState.mapper-running { AppState.toggle-mapper(); } else { SettingsEditor.save(); if SettingsEditor.message.id == "" { AppState.toggle-mapper(); } } } }
                        }
                    }
                }
                if SettingsEditor.tab == 2: Rectangle { height: 1px; vertical-stretch: 0; background: Theme.divider; }
                if SettingsEditor.tab == 2: Section {
                    title: @tr("Key behavior");
                    VerticalBox { padding: 0px; vertical-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Tap decision"); color: Theme.text; vertical-alignment: center; }
                        SelectField { width: 280px; height: 32px; vertical-stretch: 0; model: [@tr("Permissive hold"), @tr("Hold on other key press")]; current-index: SettingsEditor.tap-decision-index; selected(value) => { SettingsEditor.tap-decision-index = self.current-index; SettingsEditor.save(); } }
                        Text { vertical-stretch: 0; text: SettingsEditor.tap-decision-index == 0 ? @tr("Hold after another key is pressed and released; otherwise tap.") : @tr("Hold as soon as another key is pressed."); color: Theme.muted; wrap: word-wrap; }
                    }
                    VerticalLayout { vertical-stretch: 0; spacing: 8px;
                        FormLabel { text: @tr("Long-hold duration (seconds)"); info: @tr("Default delay before a rule runs its long-hold action once. Each rule can override it in advanced options."); }
                        NumericField { minimum: 0; maximum: 2147483; step-size: 0.1; fractional: true; value: SettingsEditor.long-hold-timeout.to-float(); edited(value) => { SettingsEditor.long-hold-timeout = "" + self.value; SettingsEditor.schedule-save(); } }
                    }
                    HorizontalBox { padding: 0px; vertical-stretch: 0; max-width: 576px; spacing: 16px;
                        VerticalBox { padding: 0px; width: 280px; horizontal-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Hold timeout (ms)"); color: Theme.text; vertical-alignment: center; }
                        NumericField { minimum: 0; maximum: 2147483647; step-size: 10; value: SettingsEditor.hold-timeout.to-float(); edited(value) => { SettingsEditor.hold-timeout = "" + self.value; SettingsEditor.schedule-save(); } }
                        Text { vertical-stretch: 0; text: @tr("Time before a key press becomes a hold."); color: Theme.muted; wrap: word-wrap; }
                        }
                        VerticalBox { padding: 0px; width: 280px; horizontal-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Double tap timeout (ms)"); color: Theme.text; vertical-alignment: center; }
                        NumericField { minimum: 0; maximum: 2147483647; step-size: 10; value: SettingsEditor.double-tap-timeout.to-float(); edited(value) => { SettingsEditor.double-tap-timeout = "" + self.value; SettingsEditor.schedule-save(); } }
                        Text { vertical-stretch: 0; text: @tr("Maximum interval between two taps."); color: Theme.muted; wrap: word-wrap; }
                        }
                    }
                    HorizontalBox { padding: 0px; vertical-stretch: 0; max-width: 576px; spacing: 16px;
                        VerticalBox { padding: 0px; width: 280px; horizontal-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Macro step pause (ms)"); color: Theme.text; vertical-alignment: center; }
                        NumericField { minimum: 0; maximum: 2147483647; step-size: 10; value: SettingsEditor.macro-pause.to-float(); edited(value) => { SettingsEditor.macro-pause = "" + self.value; SettingsEditor.schedule-save(); } }
                        Text { vertical-stretch: 0; text: @tr("Default pause between macro steps."); color: Theme.muted; wrap: word-wrap; }
                        }
                        VerticalBox { padding: 0px; width: 280px; horizontal-stretch: 0; spacing: 8px;
                        Text { vertical-stretch: 0; text: @tr("Modifier delay (ms)"); color: Theme.text; vertical-alignment: center; }
                        NumericField { minimum: 0; maximum: 2147483647; value: SettingsEditor.modifier-delay.to-float(); edited(value) => { SettingsEditor.modifier-delay = "" + self.value; SettingsEditor.schedule-save(); } }
                        Text { vertical-stretch: 0; text: @tr("Delay after pressing macro modifiers."); color: Theme.muted; wrap: word-wrap; }
                        }
                    }
                }
                if SettingsEditor.tab == 3: Section {
                    title: @tr("Game mode");
                    Text { vertical-stretch: 0; text: @tr("Game mode turns on rules and automatic layout rules that have a game-mode condition. Switch between Auto, On and Off in the top bar, in the tray menu or with a key bound to a game mode action."); color: Theme.muted; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 0; height: now-row.preferred-height; border-radius: 6px;
                        background: AppState.game-active ? Theme.success.transparentize(0.85) : Theme.surface;
                        border-width: 1px; border-color: AppState.game-active ? Theme.success : Theme.border;
                        now-row := HorizontalLayout {
                            padding: 10px; spacing: 8px;
                            VerticalLayout { alignment: center; Image { width: 18px; height: 18px; source: @image-url("icons/gamepad-2.svg"); colorize: AppState.game-active ? Theme.success : Theme.muted; } }
                            Text { text: Locale.text(AppState.game-status); color: Theme.text; font-weight: 600; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                    }
                    if SettingsEditor.game-rule-count + SettingsEditor.game-auto-rule-count == 0: Text { vertical-stretch: 0; text: @tr("Nothing uses game mode yet: no rule or automatic layout rule has a game-mode condition, so turning it on changes nothing."); color: Theme.warning; wrap: word-wrap; }
                    if SettingsEditor.game-rule-count + SettingsEditor.game-auto-rule-count == 0: HorizontalLayout { vertical-stretch: 0; alignment: start; Button { text: @tr("Add automatic rule: no layout in games"); clicked => { LayoutLibrary.add-game-rule(); } } }
                    if SettingsEditor.game-rule-count + SettingsEditor.game-auto-rule-count > 0: Text {
                        vertical-stretch: 0; color: Theme.muted; wrap: word-wrap;
                        text: @tr("Rules of the current layout with a game-mode condition: {}. Automatic layout rules with a game-mode condition: {}.", SettingsEditor.game-rule-count, SettingsEditor.game-auto-rule-count);
                    }
                    if SettingsEditor.game-auto-rule-count > 0 && !LayoutLibrary.automatic: Text { vertical-stretch: 0; text: @tr("Automatic layout rules apply only when the layout is chosen automatically (Layouts page)."); color: Theme.warning; wrap: word-wrap; }
                    CheckBox { text: @tr("Remember On and Off after restart"); checked <=> SettingsEditor.remember-game-control; toggled => { SettingsEditor.save(); } }
                    CheckBox { text: @tr("Ignore popup hotkeys while game mode is on"); checked <=> SettingsEditor.block-game-popups; toggled => { SettingsEditor.save(); } }

                    Text { vertical-stretch: 0; text: @tr("Automatic detection"); color: Theme.text; font-weight: 600; }
                    if AppState.is-linux: VerticalBox {
                        padding: 0px; spacing: 4px; vertical-stretch: 0;
                        CheckBox { text: @tr("Use GameMode daemon"); checked <=> SettingsEditor.use-gamemoded; toggled => { SettingsEditor.save(); } }
                        Text { text: @tr("GameMode daemon: ") + Locale.text(AppState.game-daemon-availability); color: Theme.muted; }
                        Text { text: @tr("Turns on while a game runs through gamemoderun or requests GameMode itself. In Steam set the launch options to “gamemoderun %command%”."); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if AppState.game-daemon-availability.id == "capability-unavailable": Text { text: @tr("GameMode is not installed: install the gamemode package."); color: Theme.warning; wrap: word-wrap; }
                    }
                    VerticalBox {
                        padding: 0px; spacing: 4px; vertical-stretch: 0;
                        CheckBox { text: @tr("Detect fullscreen"); checked <=> SettingsEditor.use-fullscreen; toggled => { SettingsEditor.save(); } enabled: AppState.game-fullscreen-availability.id != "capability-unsupported"; }
                        Text { text: @tr("Fullscreen detection: ") + Locale.text(AppState.game-fullscreen-availability); color: Theme.muted; }
                        Text { text: @tr("Borderless windows covering the screen count too. Browsers, video players and presentations are ignored."); color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                        if AppState.game-fullscreen-availability.id == "capability-unsupported": Text { text: @tr("Fullscreen detection is not supported in this session. Use process rules or On/Off."); color: Theme.warning; wrap: word-wrap; }
                    }
                    if AppState.game-missing-tool != "": Text { vertical-stretch: 0; text: @tr("Install {} to detect the active window and fullscreen windows. It is also needed for application conditions in rules.", AppState.game-missing-tool); color: Theme.warning; wrap: word-wrap; }
                    if AppState.game-missing-tool == "" && AppState.game-fullscreen-availability.id == "capability-unavailable": Text { vertical-stretch: 0; text: @tr("Fullscreen detection tools are missing or could not query the session."); color: Theme.warning; wrap: word-wrap; }

                    Text { vertical-stretch: 0; text: @tr("Games and exclusions"); color: Theme.text; font-weight: 600; }
                    Text { vertical-stretch: 0; text: @tr("Exact process name or app ID; use * and ? for patterns. Window titles are not matched. Steam games have the app ID steam_app_<number>; Proton games are also found by their .exe name. An exclusion keeps game mode off while it matches."); color: Theme.muted; wrap: word-wrap; }
                    Text { vertical-stretch: 0; text: @tr("Running processes: ") + Locale.text(AppState.game-processes-availability) + " · " + @tr("Active window: ") + Locale.text(AppState.game-window-availability); color: Theme.muted; wrap: word-wrap; }
                    for item[index] in SettingsEditor.process-matchers: Rectangle {
                        vertical-stretch: 0; height: process-row.preferred-height; border-radius: 4px; background: Theme.card;
                        process-row := HorizontalLayout {
                            padding-left: 8px; padding-right: 4px; padding-top: 2px; padding-bottom: 2px; spacing: 12px;
                            Text { text: (item.blacklist ? @tr("Exclude: ") : @tr("Include: ")) + item.name; color: item.blacklist ? Theme.muted : Theme.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            CheckBox { text: @tr("Active window only"); checked: item.only-active; enabled: AppState.game-window-availability.id != "capability-unsupported"; toggled => { SettingsEditor.set-process-flags(index, self.checked, item.blacklist); } }
                            CheckBox { text: @tr("Exclude"); checked: item.blacklist; toggled => { SettingsEditor.set-process-flags(index, item.only-active, self.checked); } }
                            VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/trash-2.svg"); label: @tr("Remove"); tooltip: @tr("Remove"); danger: true; clicked => { SettingsEditor.delete-process(index); } } }
                        }
                    }
                    VerticalBox {
                        padding: 0px; spacing: 8px; vertical-stretch: 0;
                        FormLabel { text: @tr("Process name"); }
                        LineEdit {
                            text <=> SettingsEditor.process-name; accessible-label: @tr("Process name");
                            placeholder-text: @tr("Type to search running processes");
                            edited(text) => { SettingsEditor.process-name-edited(text); }
                            accepted => { SettingsEditor.add-process(); }
                        }
                        for suggestion in SettingsEditor.process-suggestions: Rectangle {
                            height: 26px; border-radius: 4px; background: suggestion-touch.has-hover ? Theme.hover : transparent;
                            Text { x: 8px; text: suggestion; color: Theme.text; vertical-alignment: center; }
                            suggestion-touch := TouchArea { mouse-cursor: pointer; clicked => { SettingsEditor.process-name = suggestion; SettingsEditor.process-name-edited(suggestion); } }
                        }
                    }
                    HorizontalBox { padding: 0px; vertical-stretch: 0; spacing: 8px;
                        CheckBox { text: @tr("Active window only"); checked <=> SettingsEditor.process-only-active; enabled: AppState.game-window-availability.id != "capability-unsupported"; }
                        CheckBox { text: @tr("Exclude"); checked <=> SettingsEditor.process-blacklist; }
                    }
                    HorizontalBox { padding: 0px; vertical-stretch: 0; spacing: 8px; alignment: start;
                        Button { text: @tr("Add process"); enabled: SettingsEditor.process-name != ""; clicked => { SettingsEditor.add-process(); } }
                        Button {
                            text: SettingsEditor.pick-countdown > 0 ? @tr("Switch to the game window… {}", SettingsEditor.pick-countdown) : @tr("Take from the active window");
                            enabled: SettingsEditor.pick-countdown == 0 && AppState.game-window-availability.id == "capability-available";
                            clicked => { SettingsEditor.pick-active-window(); }
                        }
                    }
                }
                if SettingsEditor.tab == 4 && AppState.is-linux: Section {
                    title: @tr("Linux text injection");
                    VerticalBox {
                        padding: 0px; spacing: 8px;
                        FormLabel { text: @tr("Text injection method"); }
                        SelectField { width: 280px; height: 32px; vertical-stretch: 0; model: SettingsEditor.text-modes; current-index: SettingsEditor.text-mode-index; selected(value) => { SettingsEditor.text-mode-index = self.current-index; SettingsEditor.save(); } }
                    }
                    if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "ydotool": VerticalBox {
                        padding: 0px; spacing: 8px;
                        FormLabel { text: @tr("ydotool path"); }
                        LineEdit { text <=> SettingsEditor.ydotool-path; accessible-label: @tr("ydotool path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                    }
                    if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "xdotool": VerticalBox {
                        padding: 0px; spacing: 8px;
                        FormLabel { text: @tr("xdotool path"); }
                        LineEdit { text <=> SettingsEditor.xdotool-path; accessible-label: @tr("xdotool path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                    }
                }
                if SettingsEditor.tab == 4 && AppState.is-linux: Rectangle { height: 1px; vertical-stretch: 0; background: Theme.divider; }
                if SettingsEditor.tab == 4: Section {
                    title: @tr("Configuration and system");
                    HorizontalBox { padding: 0px; spacing: 8px; vertical-stretch: 0;
                        Text { text: SettingsEditor.platform-summary; color: Theme.muted; horizontal-stretch: 1; }
                        Button { text: @tr("Refresh status"); enabled: !SettingsEditor.platform-busy; clicked => { SettingsEditor.refresh-platform(); } }
                    }
                    for capability[index] in SettingsEditor.capabilities: VerticalBox { padding: 0px; spacing: 8px; vertical-stretch: 0;
                        HorizontalBox { padding: 0px; spacing: 8px; vertical-stretch: 0;
                            Text { text: [@tr("Key interception"), @tr("Text injection"), @tr("Layout detection"), @tr("System actions")][index]; color: Theme.text; horizontal-stretch: 1; }
                            Text { text: Locale.text(capability.status); color: capability.available ? Theme.link : Theme.muted; }
                        }
                        if capability.detail != "": Text { text: capability.detail; color: Theme.muted; wrap: word-wrap; }
                    }
                    HorizontalBox { padding: 0px; vertical-stretch: 0;
                        Text { vertical-stretch: 0; text: @tr("Settings directory: ") + SettingsEditor.settings-dir; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                        Button { text: @tr("Copy path"); clicked => { root.copy-path(SettingsEditor.settings-dir); } }
                    }
                    HorizontalBox { padding: 0px; vertical-stretch: 0;
                        Text { vertical-stretch: 0; text: @tr("Layouts directory: ") + SettingsEditor.layouts-dir; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                        Button { text: @tr("Copy path"); clicked => { root.copy-path(SettingsEditor.layouts-dir); } }
                    }
                }
            }
        }
    }
}
