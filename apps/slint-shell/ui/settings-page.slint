import { ResettableField, TextField } from "controls.slint";
import { NotificationCenter } from "notifications.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { AppState } from "app-state.slint";
import { Alert, Badge, Card, CardHeader, Divider, FieldLabel, IconButton, InfoTip, ButtonGroup } from "controls.slint";
import { LayoutLibrary } from "library.slint";
import { DeviceChoice, DeviceDialog, DevicePicker } from "device-picker.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { Button, CheckBox, RadioGroup } from "std-widgets.slint";
import { DialogFrame, FormLabel, NumericInput, SelectField, PageLayout, Section, SubsectionTitle, TitledCard, SectionTitle } from "controls.slint";
import { GameAppEntry, GameAppsField } from "conditions.slint";
import { AppearanceChoice, CommandPlace, GameModeControl, SettingsTab } from "types.slint";

/// `enabled` is false for a disabled rule.
export struct CommandPlaceRow { kind: CommandPlace, layer: string, name: string, enabled: bool }
/// `first` marks the first row of a layout, which shows its header.
export struct CommandAssignmentRow { layout-name: string, first: bool, name: string, script: string, places: [CommandPlaceRow] }

export global SettingsEditor {
    in-out property <bool> in-development;
    in-out property <bool> launch-on-startup;
    in-out property <bool> start-mapper-on-launch;
    in-out property <AppearanceChoice> appearance;
    in-out property <bool> high-contrast;
    in-out property <bool> reduce-motion;
    in-out property <bool> layout-osd;
    in-out property <bool> layer-hint;
    /// The layer hint can be shown: layer-shell is available.
    in property <bool> layer-hint-available;
    /// Index into `LOCALES` (src/pages/mod.rs); the language list below follows its order.
    in-out property <int> locale-index;
    /// Index into `TAP_DECISIONS` (src/pages/settings.rs).
    in-out property <int> tap-decision-index;
    in-out property <string> hold-timeout;
    in-out property <string> long-hold-timeout;
    in-out property <string> double-tap-timeout;
    in-out property <string> trigger-chord-timeout;
    in-out property <string> macro-pause;
    in-out property <string> modifier-delay;
    in-out property <string> macro-timeout;
    /// Standard values of the key behavior fields, for reset and tooltips.
    in property <string> default-hold-timeout;
    in property <string> default-long-hold-timeout;
    in property <string> default-double-tap-timeout;
    in property <string> default-trigger-chord-timeout;
    in property <string> default-macro-pause;
    in property <string> default-modifier-delay;
    in property <string> default-macro-timeout;
    /// The advanced key behavior settings are shown.
    in-out property <bool> commands-enabled;
    in property <[CommandAssignmentRow]> command-assignments;
    /// The command shown in full in a dialog; empty when it is closed.
    in-out property <string> full-command;
    in-out property <string> full-command-name;
    in-out property <SettingsTab> tab;
    in-out property <bool> use-gamemoded: true;
    in-out property <bool> use-fullscreen;
    in-out property <bool> use-steam: true;
    in-out property <bool> use-lutris: true;
    in-out property <bool> use-heroic: true;
    in-out property <bool> use-umu: true;
    in-out property <bool> use-gamescope: true;
    in-out property <bool> use-app-category: true;
    in-out property <bool> use-game-bar: true;
    in-out property <bool> game-foreground-only: true;
    /// Built-in lists, comma-separated: applications whose fullscreen
    /// windows are not games, and launchers that never count as games.
    in property <string> fullscreen-non-games;
    in property <string> game-launchers;
    /// Game-mode matchers: the games, the exclusions and all patterns as a list value.
    in property <[GameAppEntry]> game-processes;
    in property <[GameAppEntry]> excluded-processes;
    in property <string> process-value;
    /// Enabled rules of the current layout with a game-mode condition.
    in property <int> game-rule-count;
    /// Enabled automatic layout rules with a game-mode condition.
    in property <int> game-auto-rule-count;
    in property <[string]> text-modes;
    in-out property <int> text-mode-index;
    /// Same order as PasteShortcut::ALL in lhc-core.
    in-out property <int> paste-shortcut-index;
    /// 0 follows paste-shortcut-index, then PasteShortcut::ALL.
    in-out property <int> terminal-paste-shortcut-index;
    in-out property <string> ydotool-path;
    in-out property <string> xdotool-path;
    in-out property <string> keyboard-device-path;
    in property <[DeviceChoice]> input-devices;
    in-out property <string> mouse-device-path;
    in property <[DeviceChoice]> mouse-devices;
    in property <string> settings-dir;
    in property <string> layouts-dir;
    /// Why the mapper cannot use the input devices; empty when it can.
    in property <[Message]> input-issues;
    in property <Message> device-discovery-error;
    in property <Message> message;
    callback save();
    callback schedule-save();
    callback refresh-devices();
    callback refresh-commands();
    in property <int> commands-revision;
    in property <bool> commands-loading;
    in property <bool> commands-loaded;
    in property <Message> commands-error;
    /// Choose the keyboard or mouse by device path; empty clears it.
    callback select-device(string);
    callback select-mouse(string);
    /// Add (`index` -1) or change a matcher.
    callback save-process(index: int, pattern: string, window-only: bool, blacklist: bool);
    callback delete-process(int);
}

/// A built-in list behind a disclosure button, so users can see what the
/// application decides on its own.
component BuiltinList inherits VerticalLayout {
    in property <string> title;
    in property <string> items;
    private property <bool> expanded;
    spacing: Theme.space-xs;
    vertical-stretch: 0;
    HorizontalLayout {
        alignment: start;
        IconButton {
            icon: root.expanded ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg");
            text: root.title;
            clicked => { root.expanded = !root.expanded; }
        }
    }
    if root.expanded: Text { text: root.items; color: Theme.muted; wrap: word-wrap; }
    if root.expanded: Text { text: @tr("Built-in list. To count one of these anyway, add it to Always a game under Your rules."); color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap; }
}

/// One game-detection source: a check box, its explanation and, when the
/// session cannot read it, a note. Children add settings of the source.
component GameSourceOption inherits VerticalLayout {
    in property <string> text;
    in property <string> info;
    in property <Message> availability;
    in-out property <bool> checked;
    callback toggled();
    padding: 0px;
    spacing: Theme.space-xs;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: Theme.space-s; alignment: start;
        CheckBox { text: root.text; checked <=> root.checked; toggled => { root.toggled(); } }
        VerticalLayout { alignment: center; InfoTip { text: root.info; } }
    }
    if root.availability.id == "capability-unavailable": Text { text: "⚠ " + @tr("Not available in this session."); color: root.checked ? Theme.warning : Theme.muted; wrap: word-wrap; }
    @children
}

/// Millisecond setting with an info tooltip, and a reset button while it
/// differs from its standard value.
component TimingField inherits VerticalLayout {
    in property <string> label;
    in property <string> info;
    in property <string> standard;
    in property <float> minimum: 0;
    in property <float> maximum: 2147483647;
    in property <float> step: 10;
    in-out property <string> value;
    callback edited();
    callback reset();
    min-width: 0px;
    preferred-width: 260px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    ResettableField {
        inline-reset: true;
        label: root.label;
        info: root.info;
        modified: root.value != root.standard;
        reset-tooltip: @tr("Reset to {} ms", root.standard);
        reset => { root.value = root.standard; root.reset(); }
        HorizontalLayout { spacing: Theme.space-s; alignment: start;
            NumericInput { field-width: 100px; label: root.label; minimum: root.minimum; maximum: root.maximum; step: root.step; text <=> root.value; edited => { root.edited(); } }
            Text { text: @tr("ms"); color: Theme.muted; font-size: Theme.font-body; vertical-alignment: center; }
        }
    }
}

/// Label column with an icon and a note, and the device controls on the right.
component DeviceField inherits HorizontalLayout {
    in property <image> icon;
    in property <string> label;
    in property <string> note;
    vertical-stretch: 0;
    max-width: Theme.text-column;
    spacing: Theme.space-xl;
    VerticalLayout { width: 160px; horizontal-stretch: 0; alignment: start; padding-top: Theme.space-m; spacing: Theme.space-2xs;
        HorizontalLayout { spacing: Theme.space-m; alignment: start;
            VerticalLayout { alignment: center; Image { width: 16px; height: 16px; source: root.icon; colorize: Theme.text; } }
            Text { text: root.label; color: Theme.text; vertical-alignment: center; }
        }
        if root.note != "": Text { text: root.note; color: Theme.muted; font-size: Theme.font-body; }
    }
    VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: Theme.space-s; alignment: start;
        @children
    }
}

/// Mapper state with the one action that changes it.
component MapperStatusCard inherits Rectangle {
    private property <bool> running: AppState.mapper-running;
    private property <bool> busy: AppState.mapper-busy;
    private property <bool> failed: !root.running && !root.busy && AppState.mapper-error.id != "";
    private property <bool> ready: AppState.mapper-supported && SettingsEditor.keyboard-device-path != "";
    /// The mapper had been running and stopped by itself.
    private property <bool> crashed: root.failed && AppState.mapper-ran >= 0;
    /// A known cause replaces the generic failure text.
    private property <bool> has-issues: !root.running && !root.busy && SettingsEditor.input-issues.length > 0;
    private property <color> tone: root.busy ? Theme.warning : root.running ? Theme.success : root.failed ? Theme.error : Theme.muted;
    vertical-stretch: 0;
    max-width: Theme.text-column;
    min-height: content.preferred-height;
    border-radius: Theme.radius-large;
    border-width: 1px;
    border-color: root.failed ? Theme.error.transparentize(0.5) : root.running ? Theme.success.transparentize(0.5) : Theme.divider;
    background: root.failed ? Theme.error.transparentize(0.9) : root.running ? Theme.success.transparentize(0.9) : Theme.card;
    function duration(minutes: int) -> string {
        return minutes < 1 ? @tr("less than a minute")
            : minutes < 60 ? @tr("{} min", minutes)
            : @tr("{} h {} min", Math.floor(minutes / 60), Math.mod(minutes, 60));
    }
    content := HorizontalLayout {
        padding: Theme.space-l;
        padding-left: Theme.space-l-plus;
        spacing: Theme.space-l;
        VerticalLayout { alignment: start; padding-top: Theme.space-xs;
            Rectangle { width: 10px; height: 10px; border-radius: self.height / 2; background: root.tone; }
        }
        VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: Theme.space-xs; alignment: center;
            Text {
                text: root.busy ? @tr("Please wait…") : root.running ? @tr("Running") : root.crashed ? @tr("Stopped unexpectedly") : root.failed ? @tr("Failed to start") : @tr("Stopped");
                color: Theme.text; font-weight: Theme.weight-bold;
            }
            if !root.busy && !(root.failed && root.has-issues): Text {
                text: !AppState.mapper-supported ? Locale.text({ id: "mapper-unsupported" })
                    : root.running ? @tr("Running for {}", root.duration(Math.max(AppState.mapper-uptime, 0)))
                    : root.crashed ? Locale.text({ id: "mapper-stopped-error" })
                    : root.failed ? Locale.text(AppState.mapper-error)
                    : root.ready ? @tr("Keys work as usual. Start the mapper to apply your layouts.")
                    : @tr("Select a keyboard below to start the mapper.");
                color: root.failed ? Theme.text : Theme.muted; font-size: Theme.font-body; wrap: word-wrap;
            }
            if root.crashed: Text {
                text: @tr("Stopped {} ago after running for {}.", root.duration(AppState.mapper-stopped-ago), root.duration(AppState.mapper-ran));
                color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap;
            }
            // Directly in this layout: a nested one would size wrapped lines for the unwrapped width.
            for issue in (root.has-issues ? SettingsEditor.input-issues : []): Text {
                text: "⚠ " + Locale.text(issue);
                color: Theme.warning; font-size: Theme.font-body; wrap: word-wrap;
            }
        }
        VerticalLayout { alignment: center;
            Button {
                text: root.running ? @tr("Stop") : @tr("Start");
                primary: !root.running;
                icon: root.running ? @image-url("icons/square.svg") : @image-url("icons/play.svg");
                colorize-icon: true;
                enabled: !root.busy && (root.running || root.ready);
                clicked => { if root.running { AppState.toggle-mapper(); } else { SettingsEditor.save(); if SettingsEditor.message.id == "" { AppState.toggle-mapper(); } } }
            }
        }
    }
}

export component SettingsPage inherits PageLayout {
    init => { SettingsEditor.refresh-commands(); }
    private property <SettingsTab> commands-tab: SettingsEditor.tab;
    changed commands-tab => { SettingsEditor.refresh-commands(); }
    horizontal-stretch: 1;
    max-width: Theme.unbounded;
    path-clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    /// A running mapper keeps the devices it started with: restart it once the new ones are saved.
    function apply-devices() { if SettingsEditor.message.id == "" { AppState.devices-changed(); } }
    function copy-path(value: string) { path-clipboard.text = value; path-clipboard.select-all(); path-clipboard.copy(); NotificationCenter.send({ id: "copied" }); }
    if SettingsEditor.message.id != "": Text { text: Locale.text(SettingsEditor.message); color: Theme.error; wrap: word-wrap; }
    HorizontalLayout {
        padding: 0px;
        spacing: Theme.space-xl;
        vertical-stretch: 1;
        VerticalLayout {
            padding: 0px;
            spacing: Theme.space-s;
            width: 180px;
            horizontal-stretch: 0;
            alignment: start;
            for label[index] in [@tr("Main"), @tr("Mapper"), @tr("Key behavior"), @tr("Game mode"), @tr("Commands"), @tr("Accessibility")]: Rectangle {
                property <SettingsTab> tab-id: [SettingsTab.general, SettingsTab.mapper, SettingsTab.key-behavior, SettingsTab.game-mode, SettingsTab.commands, SettingsTab.accessibility][index];
                visible: (tab-id != SettingsTab.game-mode && tab-id != SettingsTab.commands) || AppState.in-development;
                height: self.visible ? 38px : 0px;
                border-radius: Theme.radius;
                border-width: focus.has-focus ? 2px : 0px;
                border-color: Theme.focus;
                background: SettingsEditor.tab == tab-id ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
                accessible-role: tab;
                accessible-label: label;
                accessible-checked: SettingsEditor.tab == tab-id;
                accessible-action-default => { SettingsEditor.tab = tab-id; content.viewport-y = 0px; }
                Rectangle {
                    x: 0px; y: 8px; width: 3px; height: parent.height - 16px;
                    border-radius: Theme.radius-small;
                    background: SettingsEditor.tab == tab-id ? Theme.accent : transparent;
                }
                Text {
                    x: 14px;
                    width: parent.width - 26px;
                    text: label;
                    color: SettingsEditor.tab == tab-id ? Theme.text : Theme.muted;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                    overflow: elide;
                }
                focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == " " || event.text == "\n" {
                            SettingsEditor.tab = tab-id;
                            content.viewport-y = 0px;
                            return accept;
                        }
                        return reject;
                    }
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { focus.focus(); SettingsEditor.tab = tab-id; content.viewport-y = 0px; }
                }
            }
        }
        Rectangle { width: 1px; horizontal-stretch: 0; background: Theme.divider; }
        content := ScrollView {
            viewport-width: self.visible-width;
            viewport-height: settings-content.preferred-height;
            viewport-x: 0px;
            horizontal-stretch: 1;
            max-width: Theme.unbounded;
            vertical-stretch: 1;
            settings-content := PageContent {
                x: 0px;
                y: 0px;
                width: content.visible-width;
                alignment: start;
                min-width: 0px;
                max-width: Theme.unbounded;
                spacing: 0px;
                if SettingsEditor.tab == SettingsTab.general: Section {
                    Card {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: Theme.space-xl;
                            spacing: Theme.space-2xl;
                            VerticalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                                HorizontalLayout { vertical-stretch: 0; alignment: start; spacing: Theme.space-s;
                                    VerticalLayout { alignment: center; Image { width: 16px; height: 16px; colorize: Theme.text; source: @image-url("icons/globe.svg"); } }
                                    Text { text: @tr("Language"); color: Theme.text; vertical-alignment: center; }
                                }
                                SelectField { width: 280px; height: Theme.control-height; vertical-stretch: 0; model: [@tr("Automatic"), "English", "Русский", "Deutsch", "Français", "Español", "Italiano", "Português", "Polski", "Türkçe", "Українська", "Čeština", "Magyar", "Română", "Ελληνικά", "Hrvatski", "ქართული", "Қазақша", "简体中文", "繁體中文", "日本語", "한국어"]; current-index: SettingsEditor.locale-index; selected(value) => { SettingsEditor.locale-index = self.current-index; SettingsEditor.save(); } }
                            }
                            VerticalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                                Text { vertical-stretch: 0; text: @tr("Theme"); color: Theme.text; }
                                HorizontalLayout { alignment: start;
                                    RadioGroup {
                                        // RadioGroup reports only the label, so each label is defined once.
                                        property <string> system-label: @tr("System");
                                        property <string> light-label: @tr("Light");
                                        property <string> dark-label: @tr("Dark");
                                        vertical-stretch: 0;
                                        horizontal-stretch: 0;
                                        orientation: horizontal;
                                        selected(value) => { SettingsEditor.appearance = value == self.system-label ? AppearanceChoice.system : value == self.light-label ? AppearanceChoice.light : value == self.dark-label ? AppearanceChoice.dark : AppearanceChoice.e-ink; SettingsEditor.save(); }
                                        RadioButton { text: parent.system-label; checked: SettingsEditor.appearance == AppearanceChoice.system; }
                                        RadioButton { text: parent.light-label; checked: SettingsEditor.appearance == AppearanceChoice.light; }
                                        RadioButton { text: parent.dark-label; checked: SettingsEditor.appearance == AppearanceChoice.dark; }
                                        RadioButton { visible: AppState.in-development; text: @tr("E-ink"); checked: SettingsEditor.appearance == AppearanceChoice.e-ink; }
                                    }
                                }
                            }
                        }
                    }
                    if (AppState.in-development && AppState.is-linux) || AppState.autostart-supported: Card {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: Theme.space-xl;
                            spacing: Theme.space-2xl;
                            if AppState.autostart-supported: CheckBox { text: @tr("Launch on startup"); checked <=> SettingsEditor.launch-on-startup; toggled => { SettingsEditor.save(); } }
                            if AppState.in-development && AppState.is-linux: CheckBox { text: @tr("Show the Left Hand Control layout name when it changes"); checked <=> SettingsEditor.layout-osd; toggled => { SettingsEditor.save(); } }
                            if AppState.in-development && AppState.is-linux: HorizontalLayout { vertical-stretch: 0; alignment: start; spacing: Theme.space-s;
                                CheckBox { horizontal-stretch: 0; text: @tr("Show the keys of a layer while it is held"); checked <=> SettingsEditor.layer-hint; toggled => { SettingsEditor.save(); } }
                                VerticalLayout { visible: !SettingsEditor.layer-hint-available || AppState.in-development; alignment: center; InfoTip { text: SettingsEditor.layer-hint-available ? @tr("The hint appears 2 seconds after the layer activates. Pressing a layer key hides or cancels it until the trigger is released, including in game mode.") : @tr("Unavailable: build with the spell feature and use a Wayland compositor with layer-shell (KDE Plasma, Sway, Hyprland)."); } }
                            }
                        }
                    }
                    Card {
                        vertical-stretch: 0;
                        VerticalLayout {
                            padding: Theme.space-xl;
                            spacing: Theme.space-2xl;
                            CardHeader { vertical-stretch: 0; title: @tr("Paths"); }
                            HorizontalLayout { spacing: Theme.space-m; padding: 0px; vertical-stretch: 0;
                                Text { vertical-stretch: 0; text: @tr("Settings directory: ") + SettingsEditor.settings-dir; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                                Button { text: @tr("Copy path"); clicked => { root.copy-path(SettingsEditor.settings-dir); } }
                            }
                            Divider {}
                            HorizontalLayout { spacing: Theme.space-m; padding: 0px; vertical-stretch: 0;
                                Text { vertical-stretch: 0; text: @tr("Layouts directory: ") + SettingsEditor.layouts-dir; color: Theme.muted; wrap: word-wrap; horizontal-stretch: 1; }
                                Button { text: @tr("Copy path"); clicked => { root.copy-path(SettingsEditor.layouts-dir); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        height: Theme.control-height; vertical-stretch: 0;
                        Rectangle { horizontal-stretch: 1; }
                        if SettingsEditor.in-development: CheckBox {
                            text: @tr("In development features");
                            checked <=> SettingsEditor.in-development;
                            toggled => { SettingsEditor.save(); }
                        }
                        if !SettingsEditor.in-development: TouchArea {
                            width: 32px; height: Theme.control-height; horizontal-stretch: 0;
                            clicked => { SettingsEditor.in-development = true; SettingsEditor.save(); }
                        }
                    }
                }
                if SettingsEditor.tab == SettingsTab.accessibility: Section {
                    VerticalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                        CheckBox { text: @tr("High contrast"); enabled: SettingsEditor.appearance != AppearanceChoice.e-ink; checked <=> SettingsEditor.high-contrast; toggled => { SettingsEditor.save(); } }
                    }
                    VerticalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                        CheckBox { text: @tr("Disable animations"); checked <=> SettingsEditor.reduce-motion; toggled => { SettingsEditor.save(); } }
                    }
                }
                if AppState.in-development && SettingsEditor.tab == SettingsTab.commands: Section {
                    title: "";
                    HorizontalLayout { alignment: start; spacing: Theme.space-s;
                        CheckBox { horizontal-stretch: 0; text: @tr("Allow command execution"); checked <=> SettingsEditor.commands-enabled; toggled => { SettingsEditor.save(); } }
                        VerticalLayout { alignment: center; InfoTip { text: (AppState.is-windows ? @tr("Commands run with PowerShell in the background and are not awaited.") : @tr("Commands run with sh -lc in the background and are not awaited.")) + "\n" + @tr("Commands stay off until you allow execution. Review below what your layouts would run."); } }
                    }
                    VerticalLayout { padding: 0px; spacing: Theme.space-xl;
                        if SettingsEditor.commands-loading: Text { text: @tr("Please wait…"); color: Theme.muted; }
                        if SettingsEditor.commands-error.id != "": HorizontalLayout {
                            Text { text: Locale.text(SettingsEditor.commands-error); color: Theme.error; wrap: word-wrap; horizontal-stretch: 1; }
                            Button { text: @tr("Refresh"); enabled: !SettingsEditor.commands-loading; clicked => { SettingsEditor.refresh-commands(); } }
                        }
                        if SettingsEditor.commands-loaded && SettingsEditor.command-assignments.length == 0: Text { vertical-stretch: 0; text: @tr("No commands are assigned."); color: Theme.muted; }
                        for item in SettingsEditor.command-assignments: VerticalLayout {
                            spacing: Theme.space-m;
                            if item.first: Text {
                                text: item.layout-name != "" ? item.layout-name : @tr("Custom layout");
                                color: Theme.text; font-weight: Theme.weight-semibold; wrap: word-wrap;
                            }
                            if item.first: HorizontalLayout {
                                spacing: Theme.space-xl;
                                Text { width: 30%; text: @tr("Assigned to"); color: Theme.muted; font-size: Theme.font-body; }
                                Text { width: 20%; text: @tr("Name"); color: Theme.muted; font-size: Theme.font-body; }
                                Text { horizontal-stretch: 1; text: @tr("Command"); color: Theme.muted; font-size: Theme.font-body; }
                            }
                            Rectangle { height: 1px; vertical-stretch: 0; background: Theme.divider; }
                            HorizontalLayout {
                                spacing: Theme.space-xl;
                                VerticalLayout {
                                    width: 30%;
                                    alignment: start;
                                    spacing: Theme.space-xs;
                                    for place in item.places: Text {
                                        text: (place.kind == CommandPlace.rule-tap ? @tr("Rule {} · tap", place.name)
                                            : place.kind == CommandPlace.rule-hold ? @tr("Rule {} · hold", place.name)
                                            : place.kind == CommandPlace.rule-long-hold ? @tr("Rule {} · long hold", place.name)
                                            : place.kind == CommandPlace.rule-double-tap ? @tr("Rule {} · double tap", place.name)
                                            : place.kind == CommandPlace.layer-key ? @tr("Layer {}", place.layer) + " · " + place.name
                                            : place.kind == CommandPlace.macro ? @tr("Macro") + " · " + place.name
                                            : @tr("Quick action") + " · " + place.name)
                                            + (place.enabled ? "" : " · " + @tr("disabled"));
                                        color: place.enabled ? Theme.text : Theme.muted; wrap: word-wrap;
                                    }
                                }
                                Text {
                                    width: 20%;
                                    vertical-alignment: top;
                                    // An empty name shows the command itself as the label.
                                    text: item.name != "" && item.name != item.script ? item.name : "—";
                                    color: item.name != "" && item.name != item.script ? Theme.text : Theme.muted;
                                    font-weight: Theme.weight-semibold; wrap: word-wrap;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: start;
                                    spacing: Theme.space-xs;
                                    // At most five lines; the rest opens in a dialog.
                                    private property <length> limit: 5 * line.preferred-height;
                                    Rectangle {
                                        clip: true;
                                        height: min(script.preferred-height, parent.limit);
                                        line := Text { visible: false; text: "X"; font-family: "monospace"; font-size: Theme.font-body; }
                                        script := Text { x: 0px; y: 0px; width: parent.width; text: item.script; color: Theme.text; font-family: "monospace"; font-size: Theme.font-body; wrap: word-wrap; vertical-alignment: top; }
                                    }
                                    // Collapsed rather than conditional: a conditional child would make
                                    // the column width depend on the text height.
                                    Rectangle {
                                        property <bool> overflow: script.preferred-height > parent.limit + 1px;
                                        height: self.overflow ? show-all.preferred-height : 0px;
                                        visible: self.overflow;
                                        clip: true;
                                        show-all := Button {
                                            x: 0px; y: 0px;
                                            text: @tr("Show all");
                                            clicked => { SettingsEditor.full-command-name = item.name != item.script ? item.name : ""; SettingsEditor.full-command = item.script; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if SettingsEditor.tab == SettingsTab.mapper: Section {
                    title: "";
                    VerticalLayout { padding: 0px; spacing: Theme.space-xl;
                        HorizontalLayout { vertical-stretch: 0; spacing: Theme.space-m;
                            MapperStatusCard { horizontal-stretch: 1; }
                            // Takes only what is left once the card reaches its max width.
                            Rectangle { horizontal-stretch: 0.0001; min-width: 0px; }
                            VerticalLayout { alignment: center; InfoTip { text: @tr("The mapper intercepts keyboard input, applies layers, rules and macros, and emits output through a virtual device.") + "\n\n" + @tr("Select the mouse so the mapper can see extra buttons and clicks. Pointer movement is not affected.") + "\n\n" + @tr("The mouse is not fully intercepted yet: a remapped extra button can emit the new action, but its native system or app action may still run. If that gets in the way, disable the native action for that button in your system, browser, or driver settings."); } }
                        }
                        if AppState.mapper-supported && SettingsEditor.device-discovery-error.id != "": Text {
                            text: Locale.text(SettingsEditor.device-discovery-error);
                            color: Theme.warning; wrap: word-wrap;
                        }
                        if AppState.mapper-supported: CheckBox { text: @tr("Start the mapper on launch"); checked <=> SettingsEditor.start-mapper-on-launch; toggled => { SettingsEditor.save(); } }
                        VerticalLayout { vertical-stretch: 0; max-width: Theme.text-column; spacing: Theme.space-xs; padding-top: Theme.space-m;
                            HorizontalLayout { spacing: Theme.space-s; height: 28px;
                                SubsectionTitle { horizontal-stretch: 1; text: @tr("Devices"); vertical-alignment: center; }
                            }
                        }
                        DeviceField {
                            icon: @image-url("icons/keyboard.svg");
                            label: @tr("Keyboard");
                            if !AppState.is-windows: DevicePicker { label: @tr("Keyboard device"); placeholder: @tr("Not selected"); enabled: AppState.mapper-supported && !AppState.mapper-busy; choices: SettingsEditor.input-devices; path: SettingsEditor.keyboard-device-path; open => { DeviceDialog.mouse = false; DeviceDialog.open = true; } }
                            if !AppState.is-windows && SettingsEditor.keyboard-device-path != "": Text { text: SettingsEditor.keyboard-device-path; color: Theme.muted; font-size: Theme.font-body; overflow: elide; }
                            // Windows hooks see the whole session, not single devices.
                            if AppState.is-windows: CheckBox { text: @tr("Intercept all keyboards"); enabled: AppState.mapper-supported && !AppState.mapper-busy; checked: SettingsEditor.keyboard-device-path == "windows:keyboard"; toggled => { SettingsEditor.select-device(self.checked ? "windows:keyboard" : ""); apply-devices(); } }
                            if AppState.is-windows: Text { text: @tr("Windows does not tell input devices apart, so all of them are intercepted."); color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap; }
                        }
                        if AppState.in-development: DeviceField {
                            icon: @image-url("icons/mouse.svg");
                            label: @tr("Mouse");
                            note: @tr("Optional");
                            if !AppState.is-windows: DevicePicker { label: @tr("Mouse (optional)"); placeholder: @tr("Not selected (no mouse support)"); enabled: AppState.mapper-supported && !AppState.mapper-busy; choices: SettingsEditor.mouse-devices; path: SettingsEditor.mouse-device-path; open => { DeviceDialog.mouse = true; DeviceDialog.open = true; } }
                            if !AppState.is-windows && SettingsEditor.mouse-device-path != "": Text { text: SettingsEditor.mouse-device-path; color: Theme.muted; font-size: Theme.font-body; overflow: elide; }
                            if AppState.is-windows: CheckBox { text: @tr("Intercept buttons of all mice"); enabled: AppState.mapper-supported && !AppState.mapper-busy; checked: SettingsEditor.mouse-device-path == "windows:mouse"; toggled => { SettingsEditor.select-mouse(self.checked ? "windows:mouse" : ""); apply-devices(); } }
                        }
                    }
                }
                if SettingsEditor.tab == SettingsTab.mapper && AppState.is-linux: Rectangle { height: 1px; vertical-stretch: 0; background: Theme.divider; }
                if SettingsEditor.tab == SettingsTab.mapper && AppState.is-linux: Section {
                    title: @tr("Text input");
                    VerticalLayout {
                        padding: 0px; spacing: Theme.space-m;
                        FormLabel { text: @tr("Typing method"); }
                        // Same order as TextMode::ALL in lhc-core.
                        SelectField { width: 320px; height: Theme.control-height; vertical-stretch: 0; model: [@tr("libei + clipboard fallback (recommended)"), "libei", "NotifyKeyboardKeycode", @tr("Paste from clipboard"), @tr("ydotool"), @tr("xdotool")]; current-index: SettingsEditor.text-mode-index; selected(value) => { SettingsEditor.text-mode-index = self.current-index; SettingsEditor.save(); } }
                        Text {
                            vertical-stretch: 0; max-width: Theme.text-column; color: Theme.muted; wrap: word-wrap;
                            text: [
                                @tr("Types with the current layout, or pastes the whole text when a character is unavailable. Paste requires clipboard access and support for the paste shortcut. Preserves clipboard formats and cancels if the destination changes. Requires portal permission and active-window detection."),
                                @tr("Types only through libei using the current keyboard layout and Caps Lock state. Skips text with unavailable characters. Requires portal permission and active-window detection. Cancels if the destination changes."),
                                @tr("Types only through NotifyKeyboardKeycode using the KDE layout and readable keyboard state. Skips text with unavailable characters. Requires portal permission and active-window detection. Cancels if the destination changes."),
                                @tr("Pastes with the paste shortcut through the portal. Requires clipboard access, active-window detection and an app supporting that shortcut. Preserves all clipboard formats; a new user copy takes precedence. Reports an error if no text transfer is observed."),
                                @tr("Runs \"ydotool type\" only. Needs ydotool and its ydotoold service running. Reliable for Latin text only. On an error, stops without switching methods."),
                                @tr("Runs \"xdotool type\" only. Works only in X11 sessions and XWayland windows. On an error, stops without switching methods."),
                            ][SettingsEditor.text-mode-index];
                        }
                    }
                    if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "libei" || SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "clipboard": VerticalLayout {
                        padding: 0px; spacing: Theme.space-m;
                        FormLabel { text: @tr("Paste shortcut"); info: @tr("Sent to the focused app to paste the text."); }
                        // Same order as PasteShortcut::ALL in lhc-core.
                        SelectField { width: 320px; height: Theme.control-height; vertical-stretch: 0; model: ["Shift+Insert", "Ctrl+V", "Ctrl+Shift+V"]; current-index: SettingsEditor.paste-shortcut-index; selected(value) => { SettingsEditor.paste-shortcut-index = self.current-index; SettingsEditor.save(); } }
                    }
                    if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "libei" || SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "clipboard": VerticalLayout {
                        padding: 0px; spacing: Theme.space-m;
                        FormLabel { text: @tr("Paste shortcut in terminals"); info: @tr("Used instead when the focused window is a terminal, such as Konsole, kitty or Alacritty. Ctrl+V does not paste in terminals, and some of them paste the mouse selection on Shift+Insert."); }
                        // The main shortcut, then the order of PasteShortcut::ALL in lhc-core.
                        SelectField { width: 320px; height: Theme.control-height; vertical-stretch: 0; model: [@tr("Same as in other apps"), "Shift+Insert", "Ctrl+V", "Ctrl+Shift+V"]; current-index: SettingsEditor.terminal-paste-shortcut-index; selected(value) => { SettingsEditor.terminal-paste-shortcut-index = self.current-index; SettingsEditor.save(); } }
                    }
                    if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "ydotool": VerticalLayout {
                        padding: 0px; spacing: Theme.space-m;
                        FormLabel { text: @tr("ydotool path"); }
                        TextField { text <=> SettingsEditor.ydotool-path; placeholder-text: @tr("ydotool from PATH"); accessible-label: @tr("ydotool path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                    }
                    if SettingsEditor.text-modes[SettingsEditor.text-mode-index] == "xdotool": VerticalLayout {
                        padding: 0px; spacing: Theme.space-m;
                        FormLabel { text: @tr("xdotool path"); }
                        TextField { text <=> SettingsEditor.xdotool-path; placeholder-text: @tr("xdotool from PATH"); accessible-label: @tr("xdotool path"); edited => { SettingsEditor.schedule-save(); } accepted => { SettingsEditor.save(); } }
                    }
                }
                if SettingsEditor.tab == SettingsTab.key-behavior: Section {
                    TitledCard {
                        HorizontalLayout { vertical-stretch: 0; spacing: Theme.space-xl; alignment: start;
                            TimingField {
                                label: @tr("Simultaneous presses");
                                info: @tr("For rules triggered by several keys pressed together, such as KeyJ+KeyK. All keys must go down within this time, in any order. Until then the first key is held back; if the combination does not complete, it is typed as usual. Modifiers are never held back.")
                                    + "\n\n" + @tr("Higher: the combination is easier to hit, but typing with these keys lags slightly. Applies to all rules; a rule cannot override it.")
                                    + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-trigger-chord-timeout);
                                minimum: 10; maximum: 500;
                                value <=> SettingsEditor.trigger-chord-timeout;
                                standard: SettingsEditor.default-trigger-chord-timeout;
                                edited => { SettingsEditor.schedule-save(); }
                                reset => { SettingsEditor.save(); }
                            }
                            TimingField {
                                label: @tr("Macro time limit");
                                info: @tr("A macro still running after this time is stopped and counts as finished. A macro started while another one runs waits for it; up to 3 runs can wait, further presses are ignored.")
                                    + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-macro-timeout);
                                minimum: 1000; maximum: 600000; step: 1000;
                                value <=> SettingsEditor.macro-timeout;
                                standard: SettingsEditor.default-macro-timeout;
                                edited => { SettingsEditor.schedule-save(); }
                                reset => { SettingsEditor.save(); }
                            }
                        }
                    }
                }
                if SettingsEditor.tab == SettingsTab.key-behavior: Section {
                    title: @tr("Defaults");
                    TitledCard {
                        SubsectionTitle { text: @tr("Tap"); }
                        TimingField {
                            label: @tr("Double-tap window");
                            info: @tr("A second tap within this time after the first release counts as a double tap.")
                                + "\n\n" + @tr("A single tap on a key with a double-tap action runs only after this window ends, so a large value makes such keys feel slow. Keys without a double-tap action are not delayed.")
                                + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-double-tap-timeout);
                            minimum: 50; maximum: 1000;
                            value <=> SettingsEditor.double-tap-timeout;
                            standard: SettingsEditor.default-double-tap-timeout;
                            edited => { SettingsEditor.schedule-save(); }
                            reset => { SettingsEditor.save(); }
                        }
                        Divider { vertical-stretch: 0; }
                        SubsectionTitle { text: @tr("Hold"); }
                        VerticalLayout { padding: 0px; vertical-stretch: 0; spacing: Theme.space-m;
                            FormLabel {
                                text: @tr("Hold detection");
                                info: @tr("Decides when a dual-role key counts as a hold if another key is pressed. Rules can override this default in advanced options. Chord detection is configured separately.")
                                    + "\n\n" + @tr("After another key is released: the key becomes a hold once another key is pressed and released while it is down, or when the hold threshold passes. Fast rolls while typing stay taps.")
                                    + "\n\n" + @tr("As soon as another key is pressed: useful for dedicated layer or modifier keys. Reacts faster, but overlapping letters while typing can trigger the hold by mistake.");
                            }
                            HorizontalLayout { alignment: start;
                                SelectField { width: 500px; height: Theme.control-height; vertical-stretch: 0; model: [@tr("After another key is released (better for typing)"), @tr("As soon as another key is pressed")]; current-index: SettingsEditor.tap-decision-index; selected(value) => { SettingsEditor.tap-decision-index = self.current-index; SettingsEditor.save(); } }
                            }
                        }
                        HorizontalLayout { vertical-stretch: 0; spacing: Theme.space-xl; alignment: start;
                            TimingField {
                                label: @tr("Hold threshold");
                                info: @tr("How long to hold a rule key before it counts as a hold: its layer or hold action. Released earlier, the key runs its tap action.")
                                    + "\n\n" + @tr("Lower: layers turn on faster, but fast typing may trigger them by mistake. Higher: fewer false holds, but a longer wait. Usually 150–250 ms.")
                                    + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-hold-timeout);
                                minimum: 50; maximum: 1000;
                                value <=> SettingsEditor.hold-timeout;
                                standard: SettingsEditor.default-hold-timeout;
                                edited => { SettingsEditor.schedule-save(); }
                                reset => { SettingsEditor.save(); }
                            }
                            if AppState.in-development: TimingField {
                                label: @tr("Long hold");
                                info: @tr("How long to keep holding a rule key before its long-hold action runs once. Applies to rules whose hold runs an action instead of a layer.")
                                    + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-long-hold-timeout);
                                minimum: 100; maximum: 60000; step: 100;
                                value <=> SettingsEditor.long-hold-timeout;
                                standard: SettingsEditor.default-long-hold-timeout;
                                edited => { SettingsEditor.schedule-save(); }
                                reset => { SettingsEditor.save(); }
                            }
                        }
                        Divider { vertical-stretch: 0; }
                        SubsectionTitle { text: @tr("Macros"); }
                        HorizontalLayout { vertical-stretch: 0; spacing: Theme.space-xl; alignment: start;
                            TimingField {
                                label: @tr("Pause between steps");
                                info: @tr("Pause between consecutive steps of a macro. Increase it if an application misses keystrokes.")
                                    + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-macro-pause);
                                maximum: 2000;
                                value <=> SettingsEditor.macro-pause;
                                standard: SettingsEditor.default-macro-pause;
                                edited => { SettingsEditor.schedule-save(); }
                                reset => { SettingsEditor.save(); }
                            }
                            TimingField {
                                label: @tr("Modifier delay");
                                info: @tr("Wait between pressing modifiers (Shift, Ctrl, …) and the main key of a macro step. Increase it if an application receives the shortcut without its modifier. Default for macros that leave the field empty.")
                                    + "\n\n" + @tr("Standard value: {} ms.", SettingsEditor.default-modifier-delay);
                                maximum: 2000; step: 1;
                                value <=> SettingsEditor.modifier-delay;
                                standard: SettingsEditor.default-modifier-delay;
                                edited => { SettingsEditor.schedule-save(); }
                                reset => { SettingsEditor.save(); }
                            }
                        }
                    }
                }
                if AppState.in-development && SettingsEditor.tab == SettingsTab.game-mode: Section {
                    HorizontalLayout {
                        vertical-stretch: 0; spacing: Theme.space-m;
                        ButtonGroup {
                            horizontal-stretch: 0;
                            labels: [@tr("Game mode control" => "Auto"), @tr("Game mode control" => "On"), @tr("Game mode control" => "Off")];
                            selected-index: AppState.game-control == GameModeControl.auto ? 0 : AppState.game-control == GameModeControl.on ? 1 : 2;
                            selected(index) => { AppState.set-game-control(index == 0 ? GameModeControl.auto : index == 1 ? GameModeControl.on : GameModeControl.off); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; InfoTip { text: @tr("Game mode turns on rules and automatic layout rules that have a game-mode condition. Automatic layout rules apply only when the layout is chosen automatically (Layouts page). Auto uses the detection sources and custom rules below; On and Off set the state manually. “Never a game” takes priority over automatic detection and “Always a game”. You can also change the mode in the top bar, in the tray menu or with a key bound to a game mode action."); } }
                    }

                    TitledCard {
                        title: @tr("Automatic game detection");
                        if AppState.game-control != GameModeControl.auto: Text { vertical-stretch: 0; text: @tr("Works only in Auto mode."); color: Theme.muted; wrap: word-wrap; }
                        // Exact sources: the system or a launcher reports the running game; no built-in list applies.
                        if AppState.is-linux || AppState.game-gamescope-availability.id != "capability-unsupported": FieldLabel { text: @tr("System signals"); }
                        if AppState.is-linux: VerticalLayout {
                            padding: 0px; spacing: Theme.space-xs; vertical-stretch: 0;
                            HorizontalLayout {
                                spacing: Theme.space-s; alignment: start;
                                CheckBox { text: @tr("Use GameMode daemon"); checked <=> SettingsEditor.use-gamemoded; toggled => { SettingsEditor.save(); } }
                                VerticalLayout { alignment: center; InfoTip { text: @tr("Turns on while a game runs through gamemoderun or requests GameMode itself. In Steam set the launch options to “gamemoderun %command%”."); } }
                            }
                            // Status is shown only when there is a problem; it is a warning only while the option is on.
                            if AppState.game-daemon-availability.id == "capability-unavailable": Text { text: "⚠ " + @tr("GameMode daemon unavailable: check the gamemode package and session D-Bus."); color: SettingsEditor.use-gamemoded ? Theme.warning : Theme.muted; wrap: word-wrap; }
                        }
                        // Each OS shows only the sources it has.
                        if AppState.game-gamescope-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Gamescope sessions");
                            info: @tr("Turns on while the active window is a nested gamescope session.");
                            availability: AppState.game-gamescope-availability;
                            checked <=> SettingsEditor.use-gamescope;
                            toggled => { SettingsEditor.save(); }
                        }
                        Divider { vertical-stretch: 0; }
                        FieldLabel { text: @tr("Launchers"); }
                        if AppState.game-steam-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Steam games");
                            info: AppState.is-linux
                                ? @tr("Turns on while Steam runs a game: Steam starts every game through reaper SteamLaunch, and game windows have the ID steam_app_<number>.")
                                : @tr("Turns on while Steam reports a running game.");
                            availability: AppState.game-steam-availability;
                            checked <=> SettingsEditor.use-steam;
                            toggled => { SettingsEditor.save(); }
                        }
                        if AppState.game-lutris-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Lutris games");
                            info: @tr("Turns on while a game started by Lutris runs: Lutris starts every game through lutris-wrapper.");
                            availability: AppState.game-lutris-availability;
                            checked <=> SettingsEditor.use-lutris;
                            toggled => { SettingsEditor.save(); }
                        }
                        if AppState.game-heroic-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Heroic games");
                            info: @tr("Turns on while a game started by Heroic Games Launcher runs (Epic, GOG, Amazon and added games): Heroic passes HEROIC_APP_NAME to every game it starts.");
                            availability: AppState.game-heroic-availability;
                            checked <=> SettingsEditor.use-heroic;
                            toggled => { SettingsEditor.save(); }
                        }
                        if AppState.game-umu-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Games run through umu-launcher");
                            info: @tr("Turns on while a game runs through umu-run. Heroic, Lutris, Faugus Launcher and other launchers use it to start Windows games with Proton.");
                            availability: AppState.game-umu-availability;
                            checked <=> SettingsEditor.use-umu;
                            toggled => { SettingsEditor.save(); }
                        }
                        HorizontalLayout {
                            spacing: Theme.space-s; alignment: start; vertical-stretch: 0;
                            CheckBox { text: @tr("Only while the game is in front"); checked <=> SettingsEditor.game-foreground-only; toggled => { SettingsEditor.save(); } }
                            VerticalLayout { alignment: center; InfoTip { text: @tr("Games that launchers or the system report count only while their window is active, so switching to a browser turns game mode off. Steam on Windows does not tell which program is the game, so its games always count."); } }
                        }
                        Divider { vertical-stretch: 0; }
                        // Heuristics: each skips its built-in list.
                        FieldLabel { text: @tr("Guesses — can be wrong"); }
                        if AppState.game-bar-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Games from the Game Bar list");
                            info: @tr("Turns on while a program that Windows recognized as a game (the Game Bar list) runs. Launchers are listed there too, so they are skipped.");
                            availability: AppState.game-bar-availability;
                            checked <=> SettingsEditor.use-game-bar;
                            toggled => { SettingsEditor.save(); }
                            if SettingsEditor.use-game-bar: BuiltinList { title: @tr("Launchers and game tools — not counted as games"); items: SettingsEditor.game-launchers; }
                        }
                        if AppState.game-category-availability.id != "capability-unsupported": GameSourceOption {
                            text: @tr("Applications of the Game category");
                            info: AppState.is-linux
                                ? @tr("Turns on while the active window belongs to an application whose .desktop file lists the Game category. Launchers are tagged as games too, so they are skipped.")
                                : @tr("Turns on while the active application declares the Games category in its Info.plist. Launchers are skipped.");
                            availability: AppState.game-category-availability;
                            checked <=> SettingsEditor.use-app-category;
                            toggled => { SettingsEditor.save(); }
                            if SettingsEditor.use-app-category: BuiltinList { title: @tr("Launchers and game tools — not counted as games"); items: SettingsEditor.game-launchers; }
                        }
                        VerticalLayout {
                            padding: 0px; spacing: Theme.space-xs; vertical-stretch: 0;
                            HorizontalLayout {
                                spacing: Theme.space-s; alignment: start;
                                CheckBox { text: @tr("Detect fullscreen"); checked <=> SettingsEditor.use-fullscreen; toggled => { SettingsEditor.save(); } enabled: AppState.game-fullscreen-availability.id != "capability-unsupported"; }
                                VerticalLayout { alignment: center; InfoTip { text: @tr("Borderless windows covering the screen count too. Browsers, video players and presentations are ignored."); } }
                            }
                            if AppState.game-fullscreen-availability.id == "capability-unsupported": Text { text: @tr("Fullscreen detection is not supported in this session. Use process rules or On/Off."); color: Theme.muted; wrap: word-wrap; }
                            if AppState.game-missing-tool == "" && AppState.game-fullscreen-availability.id == "capability-unavailable": Text { text: "⚠ " + @tr("Fullscreen detection tools are missing or could not query the session."); color: SettingsEditor.use-fullscreen ? Theme.warning : Theme.muted; wrap: word-wrap; }
                            if SettingsEditor.use-fullscreen: BuiltinList { title: @tr("Ignored in fullscreen"); items: SettingsEditor.fullscreen-non-games; }
                        }
                        if AppState.game-missing-tool != "": Text { vertical-stretch: 0; text: "⚠ " + @tr("Install {} to detect the active window and fullscreen windows. It is also needed for application conditions in rules.", AppState.game-missing-tool); color: Theme.warning; wrap: word-wrap; }
                    }

                    TitledCard {
                        title: @tr("Your rules");
                        if AppState.game-processes-availability.id != "capability-available" || AppState.game-window-availability.id != "capability-available": Text { vertical-stretch: 0; text: @tr("Running processes: ") + Locale.text(AppState.game-processes-availability) + " · " + @tr("Active window: ") + Locale.text(AppState.game-window-availability); color: Theme.muted; wrap: word-wrap; }
                        HorizontalLayout {
                            vertical-stretch: 0; spacing: Theme.space-3xl;
                            GameAppsField {
                                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                                label: @tr("Always a game");
                                info: @tr("Game mode turns on while any of these matches. An application is matched by its ID or process name: the whole name, ignoring case, with * and ? as wildcards. Steam games have the app ID steam_app_<number>; Proton games are also found by their .exe name. A window title item matches the active window whose title contains the text.");
                                empty-text: @tr("No games added.");
                                value: SettingsEditor.process-value;
                                entries: SettingsEditor.game-processes;
                                saved(index, pattern, window-only) => { SettingsEditor.save-process(index, pattern, window-only, false); }
                                removed(index) => { SettingsEditor.delete-process(index); }
                            }
                            GameAppsField {
                                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                                exclusion: true;
                                label: @tr("Never a game");
                                info: @tr("Game mode stays off while any of these matches, even if a game or another detector would turn it on.");
                                empty-text: @tr("Nothing is excluded.");
                                value: SettingsEditor.process-value;
                                entries: SettingsEditor.excluded-processes;
                                saved(index, pattern, window-only) => { SettingsEditor.save-process(index, pattern, window-only, true); }
                                removed(index) => { SettingsEditor.delete-process(index); }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// The whole text of a command too long for the table.
export component CommandDialogOverlay inherits FocusScope {
    focus-on-tab-navigation: false;
    enabled: SettingsEditor.full-command != "";
    key-pressed(event) => { if event.text == Key.Escape { SettingsEditor.full-command = ""; return accept; } return reject; }
    if SettingsEditor.full-command != "": DialogFrame {
        title: SettingsEditor.full-command-name != "" ? SettingsEditor.full-command-name : @tr("Command");
        card-width: 720px;
        close => { SettingsEditor.full-command = ""; }
        ScrollView { viewport-width: self.visible-width; vertical-stretch: 1;
            preferred-height: full-layout.preferred-height;
            full-layout := VerticalLayout {
                full-text := TextInput {
                    text: SettingsEditor.full-command;
                    read-only: true; single-line: false; wrap: word-wrap;
                    color: Theme.text; font-family: "monospace"; font-size: Theme.font-body;
                }
            }
        }
        HorizontalLayout { spacing: Theme.space-m; alignment: end;
            Button { text: @tr("Copy"); clicked => { full-text.select-all(); full-text.copy(); NotificationCenter.send({ id: "copied" }); } }
            Button { text: @tr("Close"); primary: true; clicked => { SettingsEditor.full-command = ""; } }
        }
    }
}
