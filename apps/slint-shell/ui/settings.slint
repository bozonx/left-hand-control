import { ActionFocus } from "focus.slint";
import { ElidedText } from "controls.slint";
import { PendingKeymapAction } from "types.slint";
import { KeyboardFocus } from "focus.slint";
import { FocusRing, TextField } from "controls.slint";
import { NotificationCenter, ToastStack } from "notifications.slint";
import { ScrollView } from "scroll.slint";
import { ActionPicker, PickerOverlay } from "action-picker.slint";
import { AppState } from "app-state.slint";
import { GameModeButton } from "game-mode.slint";
import { LayerDialogOverlay, LayersEditor, LayersPage } from "layers.slint";
import { KeymapLibrary, LibraryDialogOverlay, LibraryPage, SaveSplitButton, KeymapMenu } from "library.slint";
import { MacroEditor, MacrosPage } from "macros.slint";
import { MenuEditor, MenusPage, MenuPreview } from "menus.slint";
import { RuleDialogOverlay, RulesEditor, RulesPage } from "rules.slint";
import { AppEntryDialog, AppEntryOverlay } from "conditions.slint";
import { DragDrop, PaletteDrag } from "reorder.slint";
import { CommandDialogOverlay, SettingsPage, SettingsEditor } from "settings-page.slint";
import { DeviceDialog, DeviceDialogOverlay } from "device-picker.slint";
import { ConfirmDialog, DialogFrame, IconButton, Badge, InlineEditors, MapperToggle, Divider, MenuSurface, MenuItem, NavButton, NavTab, TooltipText } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { LayerDialog, LibraryDialog, LibraryAction, MenuKind, Page, RuleDialog } from "types.slint";
import { Button } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: Theme.font-default;
    title: @tr("Tecloid");
    preferred-width: 1120px;
    preferred-height: 760px;
    /// Small enough for 1366×768 at 150% and 1920×1080 at 200% with a panel and title bar.
    out property <length> min-window-width: 640px;
    out property <length> min-window-height: 400px;
    min-width: root.min-window-width;
    max-width: Theme.unbounded;
    min-height: root.min-window-height;
    /// Header buttons show icons only in a narrow window; development builds have extra header controls.
    /// Set on resize rather than bound: the header's size feeds back into the window's layout.
    property <length> compact-below: AppState.in-development ? 1000px : 860px;
    property <bool> compact-header;
    init => { root.compact-header = root.width < root.compact-below; }
    changed width => { root.compact-header = root.width < root.compact-below; }
    changed compact-below => { root.compact-header = root.width < root.compact-below; }
    private property <bool> editor-open: KeymapLibrary.editor-open;
    changed editor-open => { KeyboardFocus.ensure-focus(); }
    in-out property <Page> page: Page.keymaps;
    forward-focus: shortcut-focus;
    private property <string> test-text;
    private property <string> focus-help;
    private property <bool> confirm-discard: false;
    private property <bool> confirm-close: false;
    in-out property <bool> settings-quit-dialog;
    property <bool> library-problem: (root.page == Page.keymaps || KeymapLibrary.editor-open) && NotificationCenter.is-problem(KeymapLibrary.status.id);
    property <bool> layers-problem: (root.page == Page.layers || root.page == Page.keyboard) && NotificationCenter.is-problem(LayersEditor.status.id);
    property <bool> rules-problem: root.page == Page.rules && NotificationCenter.is-problem(RulesEditor.status.id);
    property <bool> macros-problem: root.page == Page.macros && NotificationCenter.is-problem(MacroEditor.status.id);
    property <bool> menus-problem: root.page == Page.menus && NotificationCenter.is-problem(MenuEditor.status.id);
    property <bool> settings-problem: root.page == Page.settings && NotificationCenter.is-problem(SettingsEditor.message.id);
    /// Lasting problems only: one-off errors are toasts, mapper state is on its card.
    property <Message> problem: AppState.config-status.id == "config-unavailable" ? AppState.config-status
        : root.library-problem ? KeymapLibrary.status
        : root.layers-problem ? LayersEditor.status
        : root.rules-problem ? RulesEditor.status
        : root.macros-problem ? MacroEditor.status
        : root.menus-problem ? MenuEditor.status
        : root.settings-problem ? SettingsEditor.message : {};

    /// Ask before losing the working copy, including invalid page drafts.
    public function prepare-quit() -> bool {
        if !SettingsEditor.flush-pending() { root.navigate(Page.settings, MenuKind.emoji); root.settings-quit-dialog = true; return false; }
        let drafts-saved = KeymapLibrary.flush-drafts();
        if KeymapLibrary.dirty || !drafts-saved {
            KeymapLibrary.pending-action = PendingKeymapAction.quit;
            KeymapLibrary.clear-status();
            KeymapLibrary.dialog = LibraryDialog.unsaved;
            return false;
        }
        return true;
    }

    public function continue-settings-quit(discard: bool) {
        root.settings-quit-dialog = false;
        if discard { SettingsEditor.discard-pending(); }
        if root.prepare-quit() { KeymapLibrary.quit(); }
    }

    /// Apply all page drafts without writing the keymap to the library.
    public function flush-drafts() -> bool {
        let keymap = KeymapLibrary.flush-drafts();
        let settings = SettingsEditor.flush-pending();
        if !settings { root.navigate(Page.settings, MenuKind.emoji); }
        else if MacroEditor.has-unsaved-changes || MacroEditor.has-errors { root.navigate(Page.macros, MenuKind.emoji); }
        else if MenuEditor.has-unsaved-changes { root.navigate(Page.menus, MenuEditor.kind); }
        return keymap && settings;
    }

    public function close-keymap() {
        let drafts-saved = KeymapLibrary.flush-drafts();
        if KeymapLibrary.dirty || !drafts-saved {
            root.confirm-close = true;
        } else {
            KeymapLibrary.editor-open = false;
            if root.page != Page.settings && root.page != Page.keymaps { root.navigate(Page.keymaps, MenuKind.emoji); }
        }
    }

    public function navigate(page: Page, kind: MenuKind) {
        if !AppState.in-development && page == Page.macros { return; }
        if !InlineEditors.flush() { return; }
        DragDrop.cancel();
        if page == Page.keymaps { KeymapLibrary.refresh(); }
        if page == Page.rules { RulesEditor.refresh(); }
        if page == Page.layers || page == Page.keyboard { LayersEditor.refresh(); }
        if page == Page.menus { MenuEditor.open(kind); }
        if page != Page.keymaps && page != Page.settings { KeymapLibrary.editor-open = true; }
        root.page = page;
        KeyboardFocus.ensure-focus();
        if !KeyboardFocus.has-focus() {
            if page == Page.settings { settings-navigation.focus(); }
            else { keymaps-navigation.focus(); }
        }
    }

    property <bool> modal-open: root.settings-quit-dialog || KeyboardFocus.active || root.confirm-discard || root.confirm-close || ActionPicker.opened || RulesEditor.dialog != RuleDialog.none || LayersEditor.dialog != LayerDialog.none || LayersEditor.delete-extra >= 0
        || KeymapLibrary.save-as-open || KeymapLibrary.dialog != LibraryDialog.none
        || AppEntryDialog.editing || AppEntryDialog.removing || DeviceDialog.open || SettingsEditor.full-command != "";
    property <bool> show-active-banner: root.page != Page.keymaps && root.page != Page.settings
        && KeymapLibrary.active-error.id == ""
        && KeymapLibrary.current-label != "" && KeymapLibrary.current-label != KeymapLibrary.active-label;


    shortcut-focus := FocusScope {
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.F1 { root.focus-help = KeyboardFocus.describe(); if root.focus-help != "" { focus-help-popup.show(); } return accept; }
            if focus-help-popup.is-open && event.text == Key.Escape { focus-help-popup.close(); return accept; }
            if event.text == Key.Escape && (DragDrop.dragging || PaletteDrag.active) { DragDrop.cancel(); return accept; }
            if InlineEditors.window-active && !root.modal-open && event.modifiers.control && event.text.to-lowercase() == "s" && KeymapLibrary.editor-open {
                if KeymapLibrary.flush-drafts() && KeymapLibrary.dirty { KeymapLibrary.save-current(); }
                return accept;
            }
            return reject;
        }
    FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.modal-open;
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            main-toolbar := Rectangle {
                height: 54px;
                background: Theme.card;
                HorizontalLayout {
                    padding-left: Theme.space-xl; padding-right: Theme.space-xl; padding-top: Theme.space-m; padding-bottom: Theme.space-m; spacing: Theme.space-m;
                    HorizontalLayout {
                        accessible-role: tab-list; accessible-label: @tr("Settings"); spacing: Theme.space-m;
                    VerticalLayout { alignment: center; keymaps-navigation := NavButton { compact: root.compact-header; icon: @image-url("icons/library-big.svg"); text: @tr("Keymaps"); selected: root.page == Page.keymaps; clicked => { root.navigate(Page.keymaps, MenuKind.emoji); } } }
                    VerticalLayout { alignment: center; settings-navigation := NavButton { compact: root.compact-header; icon: @image-url("icons/settings.svg"); text: @tr("Settings"); selected: root.page == Page.settings; clicked => { root.navigate(Page.settings, MenuKind.emoji); } } }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: root.compact-header ? 0px : 120px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.space-xs;
                            if AppState.in-development && !root.compact-header: TextField { clearable: true; preferred-width: 200px; min-width: 120px; max-width: 200px; horizontal-stretch: 1; text <=> root.test-text; placeholder-text: @tr("Type to test..."); accessible-label: @tr("Type to test..."); }
                        }
                    }
                    if AppState.in-development: VerticalLayout { alignment: center; Badge {
                        min-width: 40px;
                        text: AppState.keyboard-language == "" ? "—" : AppState.keyboard-language;
                        Tooltip { TooltipText { text: @tr("Current keyboard layout in the system") + "\n" + AppState.keyboard-language; } }
                    }
                    }
                    if AppState.in-development: GameModeButton {}
                    active-keymap := Rectangle {
                        accessible-role: button;
                        accessible-label: KeymapLibrary.active-text();
                        accessible-expandable: !KeymapLibrary.automatic;
                        accessible-expanded: active-menu.is-open;
                        accessible-action-default => { if !KeymapLibrary.automatic { KeymapLibrary.refresh(); active-menu.show(); KeyboardFocus.focus-checked(); } }
                        active-focus := ActionFocus { enabled: !KeymapLibrary.automatic; opens-menu: true; activated => { KeymapLibrary.refresh(); active-menu.show(); KeyboardFocus.focus-checked(); } }
                        FocusRing { focused: active-focus.has-focus; border-radius: Theme.radius; }
                        width: root.compact-header ? 150px : 180px; height: Theme.control-height-l; border-radius: Theme.radius; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                        HorizontalLayout { padding: Theme.space-m; spacing: Theme.space-s;
                            Image { width: 14px; source: @image-url("icons/library-big.svg"); colorize: Theme.muted; }
                            ElidedText { accessible-live-region: polite; text: KeymapLibrary.active-text(); color: KeymapLibrary.active-error.id != "" ? Theme.error : Theme.text; vertical-alignment: center; }
                            if !KeymapLibrary.automatic: Image { width: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; }
                        }
                        TouchArea { enabled: !KeymapLibrary.automatic; mouse-cursor: pointer; clicked => { active-focus.focus(); KeymapLibrary.refresh(); active-menu.show(); KeyboardFocus.focus-checked(); } }
                        Tooltip { TooltipText { text: KeymapLibrary.active-text() + "\n" + (KeymapLibrary.automatic ? @tr("Current active keymap (selected automatically by switching rules)") : @tr("Current active keymap — click to switch")); } }
                    }
                    Rectangle { width: 1px; background: Theme.divider; }
                    VerticalLayout { alignment: center; MapperToggle {
                        compact: root.compact-header;
                        text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Stop") : @tr("Start");
                        running: AppState.mapper-running;
                        busy: AppState.mapper-busy;
                        enabled: AppState.mapper-supported && (AppState.mapper-running || AppState.keyboard-selected);
                        tooltip: AppState.mapper-running
                            ? @tr("Stop mapper (restore native keyboard behavior)")
                            : !AppState.keyboard-selected
                            ? @tr("Select a keyboard device in the settings to start the mapper")
                            : @tr("Start mapper to intercept keys and apply keymaps");
                        toggled => { AppState.toggle-mapper(); }
                    } }
                }
            }
            Divider {}
            if KeymapLibrary.editor-open: editor-toolbar := Rectangle {
                height: 50px + (editor-tabs.viewport-width > editor-tabs.visible-width ? Theme.scrollbar-size + Theme.scrollbar-gap : 0px);
                background: Theme.card;
                HorizontalLayout {
                    padding-left: Theme.space-xl; padding-right: Theme.space-xl; spacing: Theme.space-m;
                    Text { text: KeymapLibrary.current-label == "" ? @tr("Custom keymap") : KeymapLibrary.current-label; color: Theme.text; max-width: 200px; overflow: elide; vertical-alignment: center; Tooltip { TooltipText { text: KeymapLibrary.current-label == "" ? @tr("Custom keymap") : KeymapLibrary.current-label; } } }
                    VerticalLayout { alignment: center; SaveSplitButton {
                        enabled: KeymapLibrary.dirty || MacroEditor.has-unsaved-changes || MenuEditor.has-unsaved-changes;
                        save => { KeymapLibrary.save-current(); }
                        discard => { root.confirm-discard = true; }
                        save-as => { KeymapLibrary.open-save-as(""); }
                    } }
                    Rectangle { width: 16px; }
                    editor-tabs := ScrollView {
                        accessible-role: tab-list;
                        accessible-label: @tr("Keymap");
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: as-needed;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        min-height: 0px;
                        viewport-height: self.visible-height;
                        HorizontalLayout {
                            spacing: Theme.space-2xs; alignment: start;
                            NavTab { icon: @image-url("icons/keyboard.svg"); text: @tr("Triggers") + (KeymapLibrary.rules-dirty ? " •" : ""); selected: root.page == Page.rules; tab-stop: root.page == Page.rules || root.page == Page.keymaps || root.page == Page.settings; clicked => { root.navigate(Page.rules, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/layers.svg"); text: @tr("Layers") + (KeymapLibrary.layers-dirty ? " •" : ""); selected: root.page == Page.keyboard || root.page == Page.layers; clicked => { root.navigate(Page.layers, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/smile.svg"); text: @tr("Emoji") + (KeymapLibrary.emoji-dirty ? " •" : ""); selected: root.page == Page.menus && MenuEditor.kind == MenuKind.emoji; clicked => { root.navigate(Page.menus, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/zap.svg"); text: @tr("Quick actions") + (KeymapLibrary.quick-dirty ? " •" : ""); selected: root.page == Page.menus && MenuEditor.kind == MenuKind.quick; clicked => { root.navigate(Page.menus, MenuKind.quick); } }
                            if AppState.in-development: NavTab { icon: @image-url("icons/list-ordered.svg"); text: @tr("Macros") + ((KeymapLibrary.macros-dirty || MacroEditor.has-errors) ? " •" : ""); selected: root.page == Page.macros; clicked => { root.navigate(Page.macros, MenuKind.emoji); } }
                        }
                    }
                    VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close keymap"); clicked => { root.close-keymap(); } } }
                }
            }
            if KeymapLibrary.editor-open: Divider {}
            if root.show-active-banner: Rectangle {
                background: Theme.card;
                HorizontalLayout {
                    padding-left: Theme.space-xl; padding-right: Theme.space-xl; padding-top: Theme.space-s; padding-bottom: Theme.space-s; spacing: Theme.space-m;
                    Text {
                        text: KeymapLibrary.active-label == ""
                            ? @tr("You are editing “{}”; no keymap is active.", KeymapLibrary.current-label)
                            : @tr("You are editing “{}”, but “{}” is active.", KeymapLibrary.current-label, KeymapLibrary.active-label);
                        color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                    if !KeymapLibrary.automatic: Button { text: @tr("Make active"); clicked => { KeymapLibrary.activate-current(); } }
                }
            }
            if root.show-active-banner: Divider {}
            VerticalLayout {
                accessible-role: tab-panel;
                accessible-label: root.page == Page.keymaps ? @tr("Keymaps") : root.page == Page.settings ? @tr("Settings") : root.page == Page.rules ? @tr("Triggers") : root.page == Page.macros ? @tr("Macros") : root.page == Page.menus ? (MenuEditor.kind == MenuKind.emoji ? @tr("Emoji") : @tr("Quick actions")) : @tr("Layers");
                vertical-stretch: 1;
                padding: Theme.page-padding;
                // Pages scroll to the window edge; their content keeps the bottom gap (PageContent).
                padding-bottom: 0px;
                spacing: Theme.space-l;
                if root.problem.id != "": Text { accessible-live-region: assertive; text: Locale.text(root.problem); color: NotificationCenter.is-warning(root.problem.id) ? Theme.warning : Theme.error; wrap: word-wrap; max-height: 96px; overflow: elide; }
                if root.page == Page.keymaps: LibraryPage { compact: root.compact-header; }
                if root.page == Page.settings: SettingsPage {}
                if root.page == Page.rules: RulesPage {}
                if root.page == Page.layers || root.page == Page.keyboard: LayersPage { }
                if AppState.in-development && root.page == Page.macros: MacrosPage {}
                if root.page == Page.menus: MenusPage {}
            }
        }
    }
    focus-help-popup := PopupWindow {
        width: min(Theme.text-tooltip, root.width - 64px) + 2 * Theme.space-xs;
        x: (root.width - self.width) / 2; y: 64px;
        forward-focus: help-focus;
        MenuSurface {
            help-focus := FocusScope {
                accessible-role: groupbox;
                accessible-label: root.focus-help;
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Return || event.text == " " { focus-help-popup.close(); return accept; }
                    return reject;
                }
                Text { width: min(Theme.text-tooltip, root.width - 64px); text: root.focus-help; color: Theme.text; wrap: word-wrap; }
            }
        }
    }
    active-menu := PopupWindow {
        x: active-keymap.absolute-position.x; y: active-keymap.absolute-position.y + active-keymap.height + Theme.menu-offset; width: 240px;
        KeymapMenu {
            height-limit: max(50px, min(320px, root.height - active-keymap.height - active-keymap.absolute-position.y - 24px));
            for name[index] in KeymapLibrary.names: MenuItem {
                text: name; checked: name == KeymapLibrary.active-label;
                clicked => { active-menu.close(); KeymapLibrary.action(index, LibraryAction.activate); }
            }
        }
    }
    if root.confirm-discard || root.confirm-close: ConfirmDialog {
        width: 100%; height: 100%;
        title: @tr("Discard keymap changes?");
        body: @tr("Unsaved changes to this keymap will be lost.");
        confirm-text: @tr("Discard");
        cancel => { root.confirm-discard = false; root.confirm-close = false; }
        confirm => {
            InlineEditors.revision += 1; KeymapLibrary.discard-current();
            if root.confirm-close && !KeymapLibrary.dirty { KeymapLibrary.editor-open = false; if root.page != Page.settings && root.page != Page.keymaps { root.navigate(Page.keymaps, MenuKind.emoji); } }
            root.confirm-discard = false; root.confirm-close = false;
        }
    }
    if KeymapLibrary.dialog == LibraryDialog.conflict: DialogFrame {
        title: @tr("Keymap changed on disk");
        close => { KeymapLibrary.cancel-dialog(); }
        Text {
            text: @tr("The file of “{}” was changed by another program after you opened it. Your edits are kept until you choose what to do.", KeymapLibrary.current-label);
            color: Theme.text; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: end;
            Button { text: @tr("Cancel"); clicked => { KeymapLibrary.cancel-dialog(); } }
            Button {
                text: @tr("Load from disk");
                clicked => {
                    // Reloading drops the edits, so a pending switch may proceed.
                    KeymapLibrary.dialog = LibraryDialog.none;
                    InlineEditors.revision += 1; KeymapLibrary.discard-current();
                    KeymapLibrary.finish-save();
                }
            }
            // Overwriting discards the changes made on disk, so the safe choice is the primary one.
            Button { text: @tr("Overwrite"); clicked => { KeymapLibrary.overwrite-current(); KeymapLibrary.finish-save(); } }
            Button {
                text: @tr("Save as new…"); primary: true;
                clicked => {
                    // Keep a pending switch: it continues once the copy is saved.
                    KeymapLibrary.dialog = LibraryDialog.none;
                    KeymapLibrary.open-save-as(KeymapLibrary.suggest-name(KeymapLibrary.current-label));
                }
            }
        }
    }
    if root.settings-quit-dialog: DialogFrame {
        card-width: 760px;
        card-height: 340px;
        title: @tr("Settings could not be saved");
        close => { root.settings-quit-dialog = false; }
        quit-body := ScrollView {
            min-height: 0px; vertical-stretch: 1;
            viewport-width: self.visible-width;
            viewport-height: quit-text.preferred-height;
            quit-text := VerticalLayout {
                width: quit-body.visible-width;
                spacing: Theme.space-m;
                Text { text: @tr("Retry saving, or discard unsaved settings and continue quitting."); color: Theme.text; wrap: word-wrap; }
                Text { text: Locale.text(SettingsEditor.message); color: Theme.error; wrap: word-wrap; }
            }
        }
        GridLayout { spacing: Theme.space-m;
            Button { row: 0; col: 0; text: @tr("Cancel"); clicked => { root.settings-quit-dialog = false; } }
            Button { row: root.width < 760px ? 1 : 0; col: root.width < 760px ? 0 : 1; text: @tr("Discard settings and continue"); clicked => {
                root.continue-settings-quit(true);
            } }
            Button { row: root.width < 760px ? 2 : 0; col: root.width < 760px ? 0 : 2; text: @tr("Retry"); primary: true; clicked => {
                root.continue-settings-quit(false);
            } }
        }
    }
    LibraryDialogOverlay {}
    RuleDialogOverlay {}
    LayerDialogOverlay {}
    AppEntryOverlay { width: 100%; height: 100%; }
    CommandDialogOverlay {}
    if DeviceDialog.open: DeviceDialogOverlay {
        error: SettingsEditor.message;
        discovery-error: SettingsEditor.device-discovery-error;
        loading: SettingsEditor.devices-loading;
        mouse: DeviceDialog.mouse;
        choices: DeviceDialog.mouse ? SettingsEditor.mouse-devices : SettingsEditor.input-devices;
        current: DeviceDialog.mouse ? SettingsEditor.mouse-device-path : SettingsEditor.keyboard-device-path;
        manual-allowed: !AppState.is-windows;
        enabled: AppState.mapper-supported && !AppState.mapper-busy;
        refresh => { SettingsEditor.refresh-devices(); }
        close => { DeviceDialog.open = false; }
        chosen(path) => {
            if path != self.current {
                let saved = DeviceDialog.mouse ? SettingsEditor.select-mouse(path) : SettingsEditor.select-device(path);
                DeviceDialog.open = !saved;
            } else {
                DeviceDialog.open = false;
            }
        }
    }
    if root.page == Page.menus && MenuEditor.preview-visible: MenuPreview { width: 100%; height: 100%; }
    if ActionPicker.opened: PickerOverlay {}
    ToastStack {
        stack-height-limit: parent.height - 40px;
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: min(420px, parent.width - 40px);
    }
    }
}
