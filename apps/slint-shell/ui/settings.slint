import { ActionPicker, PickerOverlay } from "action-picker.slint";
import { AppState } from "app-state.slint";
import { KeyboardPage } from "keys.slint";
import { LayerDialogOverlay, LayersEditor, LayersPage } from "layers.slint";
import { LayoutLibrary, LibraryDialogOverlay, LibraryPage, SaveSplitButton } from "library.slint";
import { MacroEditor, MacrosPage } from "macros.slint";
import { MenuEditor, MenusPage } from "menus.slint";
import { RuleDialogOverlay, RulesEditor, RulesPage } from "rules.slint";
import { SettingsPage } from "settings-page.slint";
import { InlineEditors } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale } from "i18n.slint";
import { LayerDialog, LibraryDialog, MenuKind, Page, RuleDialog } from "types.slint";
import { Button, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: 14px;
    title: @tr("Left Hand Control");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 700px;
    in-out property <Page> page: Page.layouts;

    public function navigate(page: Page, kind: MenuKind) {
        if page == Page.layouts { LayoutLibrary.refresh(); }
        if page == Page.menus { MenuEditor.open(kind); }
        root.page = page;
    }

    property <bool> modal-open: ActionPicker.opened || RulesEditor.dialog != RuleDialog.none || LayersEditor.dialog != LayerDialog.none
        || LayoutLibrary.save-as-open || LayoutLibrary.dialog != LibraryDialog.none;
    property <bool> show-active-banner: root.page != Page.layouts && root.page != Page.settings && !LayoutLibrary.automatic
        && LayoutLibrary.current-label != "" && LayoutLibrary.current-label != LayoutLibrary.active-label;

    FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.modal-open;
        VerticalBox {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                height: 54px;
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                    Button { text: @tr("Layouts"); primary: root.page == Page.layouts; clicked => { root.navigate(Page.layouts, MenuKind.emoji); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Stop") : @tr("Start");
                        enabled: !AppState.mapper-busy;
                        clicked => { AppState.toggle-mapper(); }
                    }
                    Text { text: LayoutLibrary.active-label; color: AppState.mapper-running ? Theme.text : Theme.muted; min-width: 0px; preferred-width: 100px; max-width: 140px; overflow: elide; vertical-alignment: center; }
                    Text { text: AppState.keyboard-language; color: Theme.text; vertical-alignment: center; }
                    Text { text: @tr("Game mode"); color: AppState.game-active ? Theme.error : Theme.muted; vertical-alignment: center; }
                    Button { text: @tr("Settings"); primary: root.page == Page.settings; clicked => { root.navigate(Page.settings, MenuKind.emoji); } }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle {
                height: 52px;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                    Text { text: LayoutLibrary.current-label == "" ? @tr("Custom layout") : LayoutLibrary.current-label; color: Theme.text; max-width: 200px; overflow: elide; vertical-alignment: center; }
                    SaveSplitButton {
                        enabled: LayoutLibrary.dirty;
                        save => { LayoutLibrary.save-current(); }
                        discard => { InlineEditors.revision += 1; LayoutLibrary.discard-current(); MacroEditor.refresh(); MenuEditor.refresh(); }
                        save-as => { LayoutLibrary.save-as-name = ""; LayoutLibrary.save-as-open = true; }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        viewport-height: self.visible-height;
                        HorizontalLayout {
                            spacing: 6px;
                            Button { icon: @image-url("icons/settings-2.svg"); colorize-icon: true; text: @tr("Rules"); primary: root.page == Page.rules; clicked => { root.navigate(Page.rules, MenuKind.emoji); } }
                            Button { icon: @image-url("icons/keyboard.svg"); colorize-icon: true; text: @tr("Layers"); primary: root.page == Page.keyboard || root.page == Page.layers; clicked => { root.navigate(Page.layers, MenuKind.emoji); } }
                            Button { icon: @image-url("icons/clock.svg"); colorize-icon: true; text: @tr("Macros"); primary: root.page == Page.macros; clicked => { root.navigate(Page.macros, MenuKind.emoji); } }
                            Button { icon: @image-url("icons/zap.svg"); colorize-icon: true; text: @tr("Quick actions"); primary: root.page == Page.menus && MenuEditor.kind == MenuKind.quick; clicked => { root.navigate(Page.menus, MenuKind.quick); } }
                            Button { icon: @image-url("icons/smile.svg"); colorize-icon: true; text: @tr("Emoji"); primary: root.page == Page.menus && MenuEditor.kind == MenuKind.emoji; clicked => { root.navigate(Page.menus, MenuKind.emoji); } }
                            Button { icon: @image-url("icons/terminal.svg"); colorize-icon: true; text: @tr("Commands") + (AppState.commands-need-approval ? " •" : ""); primary: root.page == Page.menus && MenuEditor.kind == MenuKind.commands; clicked => { root.navigate(Page.menus, MenuKind.commands); } }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.show-active-banner: Rectangle {
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
                    Text {
                        text: LayoutLibrary.active-label == ""
                            ? @tr("You are editing “{}”; no layout is active.", LayoutLibrary.current-label)
                            : @tr("You are editing “{}”, but “{}” is active.", LayoutLibrary.current-label, LayoutLibrary.active-label);
                        color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                    Button { text: @tr("Make active"); clicked => { LayoutLibrary.activate-current(); } }
                }
            }
            if root.show-active-banner: Rectangle { height: 1px; background: Theme.border; }
            VerticalLayout {
                vertical-stretch: 1;
                padding-top: 20px; padding-bottom: 20px;
                padding-left: 20px;
                padding-right: 20px;
                spacing: 12px;
                if root.page == Page.keyboard || root.page == Page.layers: HorizontalLayout {
                    spacing: 8px;
                    Button { text: @tr("Base keyboard"); primary: root.page == Page.keyboard; clicked => { root.navigate(Page.keyboard, MenuKind.emoji); } }
                    Button { text: @tr("Layers"); primary: root.page == Page.layers; clicked => { root.navigate(Page.layers, MenuKind.emoji); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.page == Page.keyboard: KeyboardPage {}
                if root.page == Page.layouts: LibraryPage {}
                if root.page == Page.settings: HorizontalLayout { alignment: center; SettingsPage { preferred-width: 1000px; max-width: 1000px; } }
                if root.page == Page.rules: RulesPage {}
                if root.page == Page.layers: LayersPage {}
                if root.page == Page.macros: MacrosPage {}
                if root.page == Page.menus: MenusPage {}
                if AppState.config-status.id == "config-unavailable": Text { text: Locale.text(AppState.config-status); color: Theme.error; wrap: word-wrap; }
                if AppState.backend-error.id != "": Text { text: Locale.text(AppState.backend-error); color: Theme.error; wrap: word-wrap; }
            }
        }
    }
    LibraryDialogOverlay {}
    RuleDialogOverlay {}
    LayerDialogOverlay {}
    if ActionPicker.opened: PickerOverlay {}
}
