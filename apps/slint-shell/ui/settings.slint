import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { QuickGrid } from "quick-grid.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, ListView } from "std-widgets.slint";

export struct ActionRow { id: int, label: string, label-en: string }
export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: 14px;
    title: @tr("Left Hand Control");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 700px;
    in-out property <int> page: 0;
    in property <[string]> layout-names;
    in-out property <int> selected-layout: -1;
    in-out property <string> layout-name;
    in property <string> layout-description;
    in property <string> layout-status;
    callback refresh-layouts();
    callback select-layout(int);
    callback create-layout(string);
    callback save-layout();
    callback load-layout();
    callback delete-layout();
    in property <[string]> keys;
    in property <[string]> assignments;
    in property <[ActionRow]> actions;
    in-out property <int> selected-key: -1;
    in-out property <bool> editing: false;
    in-out property <int> kind: 0;
    in-out property <string> value;
    in-out property <string> query;
    in-out property <int> category: 0;
    in-out property <int> selected-action: -1;
    in-out property <bool> capturing: false;
    in-out property <length> catalog-scroll-y;
    in property <Message> validation;
    in property <Message> status;
    in property <Message> backend-error;
    in property <Message> config-status;
    in property <[string]> input-devices;
    in-out property <int> selected-device: -1;
    callback select-device(int);
    callback show-popup(string);
    callback toggle-mapper();
    callback edit-key(int);
    callback change-kind(int);
    callback validate();
    callback filter();
    callback pick-action(int);
    callback navigate-action(int);
    callback update-action();
    callback capture(string, bool, bool, bool, bool);
    callback save();
    callback cancel();
    in-out property <bool> grid-open: false;
    in property <[string]> quick-items;
    callback move-quick(int, int);
    callback rename-quick(int, string);
    callback preferences(bool, bool);
    public function focus-editor() { modal-focus.focus(); }
    public function restore-focus() { keyboard-focus.focus(); }
    public function begin-capture() { root.capturing = true; capture-scope.focus(); }

    capture-scope := FocusScope {
        focus-on-tab-navigation: false;
        height: 0px;
        key-pressed(event) => {
            if root.capturing {
                root.capture(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                return accept;
            }
            return reject;
        }
        key-released(event) => { if !root.capturing { modal-focus.focus(); } return accept; }
    }
    keyboard-focus := FocusScope {
        enabled: !root.editing;
        key-pressed(event) => {
            if event.text == Key.Return { root.edit-key(max(0, root.selected-key)); return accept; }
            if event.text == Key.RightArrow { root.selected-key = mod(root.selected-key + 1, 80); return accept; }
            if event.text == Key.LeftArrow { root.selected-key = mod(root.selected-key + 79, 80); return accept; }
            return reject;
        }
    }
    background-scope := FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.editing;
        if !root.editing: VerticalBox {
            padding: 24px;
            spacing: 16px;
            HorizontalBox {
                spacing: 8px;
                Button { text: @tr("Keyboard"); clicked => { root.page = 0; root.grid-open = false; } }
                Button { text: @tr("Action grid"); clicked => { root.page = 0; root.grid-open = true; } }
                Button { text: @tr("Layouts"); clicked => { root.page = 1; root.refresh-layouts(); } }
                Button { text: @tr("Settings"); clicked => { root.page = 2; } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: Theme.dark ? @tr("☀ Light") : @tr("☾ Dark"); clicked => { root.preferences(!Theme.dark, Locale.english); } }
                Button { text: Locale.english ? "Русский" : "English"; clicked => { root.preferences(Theme.dark, !Locale.english); } }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.page == 0: VerticalBox {
                spacing: 8px;
                Text { color: Theme.text; text: @tr("Keyboard layout"); font-size: 26px; font-weight: 700; }
                Text { color: Theme.muted; text: @tr("Select a key to assign an action."); }
                Text { color: Theme.muted; text: Locale.text(root.config-status); }
            }
            if root.page == 1: VerticalBox {
                spacing: 12px;
                Text { color: Theme.text; text: @tr("Layouts"); font-size: 26px; font-weight: 700; }
                Text { color: Theme.muted; text: @tr("Save the current layout or select a file from your library."); }
                HorizontalBox {
                    spacing: 8px;
                    LineEdit { text <=> root.layout-name; placeholder-text: @tr("New layout name"); }
                    Button { text: @tr("Create empty"); clicked => { root.create-layout(root.layout-name); } }
                    Button { text: @tr("Save current"); clicked => { root.save-layout(); } }
                    Button { text: @tr("Refresh"); clicked => { root.refresh-layouts(); } }
                }
                Rectangle {
                    background: Theme.card;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    ListView {
                        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                        for name[index] in root.layout-names: Rectangle {
                            height: 42px;
                            background: root.selected-layout == index ? Theme.accent : row-touch.has-hover ? Theme.hover : Theme.card;
                            Text { x: 12px; text: name; color: Theme.text; vertical-alignment: center; }
                            row-touch := TouchArea { clicked => { root.select-layout(index); } }
                        }
                    }
                }
                Text { text: root.layout-description; color: Theme.muted; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: @tr("Load selected"); enabled: root.selected-layout >= 0; clicked => { root.load-layout(); } }
                    Button { text: @tr("Save current to selected"); enabled: root.selected-layout >= 0; clicked => { root.save-layout(); } }
                    Button { text: @tr("Delete selected"); enabled: root.selected-layout >= 0; clicked => { root.delete-layout(); } }
                }
                Text { text: root.layout-status; color: Theme.muted; wrap: word-wrap; }
            }
            if root.page == 2: VerticalBox {
                spacing: 14px;
                Text { color: Theme.text; text: @tr("Settings"); font-size: 26px; font-weight: 700; }
                Rectangle { background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px; height: 150px;
                    VerticalBox { padding: 16px; spacing: 10px;
                        Text { text: @tr("Mapper"); color: Theme.text; font-size: 18px; font-weight: 600; }
                        Text { text: Locale.text(root.config-status); color: Theme.muted; }
                        HorizontalBox {
                            Text { text: @tr("Keyboard device"); color: Theme.text; vertical-alignment: center; }
                            ComboBox { model: root.input-devices; current-index: root.selected-device; selected(value) => { root.select-device(self.current-index); } }
                            Button { text: @tr("Toggle mapper"); clicked => { root.toggle-mapper(); } }
                        }
                    }
                }
                Rectangle { background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px; height: 110px;
                    VerticalBox { padding: 16px; spacing: 10px;
                        Text { text: @tr("Appearance and language"); color: Theme.text; font-size: 18px; font-weight: 600; }
                        HorizontalBox {
                            Button { text: Theme.dark ? @tr("Dark") : @tr("Light"); clicked => { root.preferences(!Theme.dark, Locale.english); } }
                            ComboBox { model: ["Русский", "English"]; current-index: Locale.english ? 1 : 0; selected(value) => { root.preferences(Theme.dark, self.current-index == 1); } }
                        }
                    }
                }
                Text { text: Locale.text(root.backend-error); color: Theme.error; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
            }
            if root.page == 0 && !root.grid-open: VerticalLayout {
                spacing: 6px;
                for row in 5: HorizontalLayout {
                    spacing: 5px;
                    for col in 16: Rectangle {
                        height: 66px;
                        border-radius: 6px;
                        border-width: root.selected-key == row * 16 + col ? 2px : 1px;
                        border-color: root.selected-key == row * 16 + col ? Theme.accent : Theme.border;
                        background: key-touch.has-hover ? Theme.hover : Theme.card;
                        VerticalLayout {
                            padding: 5px;
                            Text { text: root.keys[row * 16 + col]; color: Theme.text; font-size: 12px; }
                            Text { text: root.assignments[row * 16 + col]; color: Theme.muted; font-size: 10px; overflow: elide; }
                        }
                        key-touch := TouchArea { clicked => { root.edit-key(row * 16 + col); } }
                    }
                }
            }
            if root.page == 0 && root.grid-open: QuickGrid {
                items: root.quick-items;
                move-item(from, to) => { root.move-quick(from, to); }
                rename-item(index, value) => { root.rename-quick(index, value); }
            }
            Text { text: Locale.text(root.status); color: Theme.text; }
            Text { text: Locale.text(root.backend-error); color: Theme.error; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                Button { text: @tr("Emoji"); clicked => { root.show-popup("emoji"); } }
                Button { text: @tr("Quick actions"); clicked => { root.show-popup("quick"); } }
                Button { text: @tr("Toggle mapper"); clicked => { root.toggle-mapper(); } }
                ComboBox {
                    model: ["Русский", "English — longer interface labels"];
                    current-index: Locale.english ? 1 : 0;
                    selected(value) => { root.preferences(Theme.dark, self.current-index == 1); }
                }
            }
        }
    }
    modal-focus := FocusScope {
        focus-on-tab-navigation: false;
        enabled: root.editing;
        key-pressed(event) => {
            if root.capturing { return reject; }
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Return && root.validation.id == "" { root.save(); return accept; }
            return reject;
        }
        if root.editing: Rectangle {
            background: #00000099;
            TouchArea { }
            Rectangle {
                x: 32px; y: 24px;
                width: parent.width - 64px; height: parent.height - 48px;
                background: Theme.surface;
                border-radius: 12px;
                VerticalBox {
                    padding: 24px; spacing: 12px;
                    Text { text: @tr("Key «") + root.keys[root.selected-key] + "»"; color: Theme.text; font-size: 24px; }
                    Text { text: @tr("Draft — saving applies the action to this key only"); color: Theme.muted; }
                    ComboBox {
                        enabled: !root.capturing;
                        model: [@tr("Text"), @tr("Delay (ms)"), @tr("System action"), @tr("Keyboard shortcut")];
                        current-index <=> root.kind;
                        selected(value) => { root.change-kind(self.current-index); }
                    }
                    if root.kind == 0 || root.kind == 1: LineEdit {
                        text <=> root.value;
                        placeholder-text: root.kind == 0 ? @tr("Enter text, for example Привет 👋") : @tr("Integer from 1 to 10000");
                        edited => { root.validate(); }
                        accepted => { if !root.capturing && root.validation.id == "" { root.save(); } }
                    }
                    if root.kind == 2: ComboBox {
                        model: [@tr("Copy"), @tr("Paste"), @tr("Next window")];
                        current-index: root.value == "Ctrl+KeyV" ? 1 : root.value == "Alt+Tab" ? 2 : 0;
                        selected(value) => { root.value = self.current-index == 0 ? "Ctrl+KeyC" : self.current-index == 1 ? "Ctrl+KeyV" : "Alt+Tab"; root.validate(); }
                    }
                    if root.kind == 3: HorizontalBox {
                        Text { text: root.value == "" ? @tr("No shortcut assigned") : root.value; color: Theme.text; }
                        Button {
                            text: root.capturing ? @tr("Press a shortcut…") : @tr("Capture shortcut");
                            clicked => { root.begin-capture(); }
                        }
                        Button { text: @tr("Stop capture"); enabled: root.capturing; clicked => { root.capturing = false; } }
                    }
                    Text { text: Locale.text(root.validation); color: Theme.error; height: 22px; }
                    HorizontalBox {
                        LineEdit { enabled: !root.capturing; text <=> root.query; placeholder-text: @tr("Search 500 actions…"); edited => { root.filter(); } }
                        ComboBox {
                            enabled: !root.capturing;
                            model: [@tr("All categories"), @tr("Text"), @tr("Delay"), @tr("System"), @tr("Shortcuts")];
                            current-index <=> root.category;
                            selected(value) => { root.filter(); }
                        }
                    }
                    Text { text: @tr("Found: ") + root.actions.length + @tr(" · select an entry to fill the draft"); color: Theme.muted; }
                    catalog-keys := FocusScope {
                        enabled: !root.capturing;
                        vertical-stretch: 1;
                        min-height: 100px;
                        key-pressed(event) => {
                            if event.text == Key.UpArrow { root.navigate-action(-1); return accept; }
                            if event.text == Key.DownArrow { root.navigate-action(1); return accept; }
                            return reject;
                        }
                        ListView {
                            vertical-stretch: 1;
                            enabled: !root.capturing;
                            viewport-width: self.visible-width;
                            viewport-y <=> root.catalog-scroll-y;
                            for action in root.actions: Rectangle {
                                height: 36px;
                                background: root.selected-action == action.id ? Theme.accent : action-touch.has-hover ? Theme.hover : Theme.card;
                                Text { x: 12px; text: Locale.english ? action.label-en : action.label; color: Theme.text; vertical-alignment: center; }
                                action-touch := TouchArea { clicked => { root.pick-action(action.id); catalog-keys.focus(); } }
                            }
                        }
                    }
                    HorizontalBox {
                        Button { text: @tr("Update the selected catalog entry"); enabled: root.selected-action >= 0 && !root.capturing; clicked => { root.update-action(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                        Button { text: @tr("Save"); enabled: root.validation.id == "" && !root.capturing; clicked => { root.save(); } }
                    }
                }
            }
        }
    }
}
