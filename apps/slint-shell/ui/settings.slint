import { NotificationCenter, ToastStack } from "notifications.slint";
import { ScrollView } from "scroll.slint";
import { ActionPicker, PickerOverlay } from "action-picker.slint";
import { AppState } from "app-state.slint";
import { GameModeButton } from "game-mode.slint";
import { LayerDialogOverlay, LayersEditor, LayersPage } from "layers.slint";
import { LayoutLibrary, LibraryDialogOverlay, LibraryPage, SaveSplitButton } from "library.slint";
import { MacroEditor, MacrosPage } from "macros.slint";
import { MenuEditor, MenusPage } from "menus.slint";
import { RuleDialogOverlay, RulesEditor, RulesPage } from "rules.slint";
import { DragDrop } from "reorder.slint";
import { SettingsPage, SettingsEditor } from "settings-page.slint";
import { ConfirmDialog, IconButton, Badge, InlineEditors, MapperToggle, NavButton, NavTab } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { LayerDialog, LibraryDialog, LibraryAction, MenuKind, Page, RuleDialog } from "types.slint";
import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: 14px;
    title: @tr("Left Hand Control");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 940px;
    max-width: 100000px;
    min-height: 700px;
    in-out property <Page> page: Page.layouts;
    forward-focus: shortcut-focus;
    private property <string> test-text;
    private property <bool> confirm-discard: false;
    private property <bool> confirm-close: false;
    property <bool> shell-problem: NotificationCenter.is-problem(AppState.status.id);
    property <bool> library-problem: NotificationCenter.is-problem(LayoutLibrary.status.id);
    property <bool> layers-problem: NotificationCenter.is-problem(LayersEditor.status.id);
    property <bool> rules-problem: NotificationCenter.is-problem(RulesEditor.status.id);
    property <bool> macros-problem: NotificationCenter.is-problem(MacroEditor.status.id);
    property <bool> menus-problem: NotificationCenter.is-problem(MenuEditor.status.id);
    property <bool> settings-problem: NotificationCenter.is-problem(SettingsEditor.message.id);
    property <Message> problem: AppState.backend-error.id != "" ? AppState.backend-error
        : AppState.config-status.id == "config-unavailable" ? AppState.config-status
        : root.shell-problem ? AppState.status
        : root.library-problem ? LayoutLibrary.status
        : root.layers-problem ? LayersEditor.status
        : root.rules-problem ? RulesEditor.status
        : root.macros-problem ? MacroEditor.status
        : root.menus-problem ? MenuEditor.status
        : root.settings-problem ? SettingsEditor.message : {};

    public function close-layout() {
        InlineEditors.commit-revision += 1;
        MacroEditor.flush-pending();
        if LayoutLibrary.dirty || MacroEditor.has-errors {
            root.confirm-close = true;
        } else {
            LayoutLibrary.editor-open = false;
            root.navigate(Page.layouts, MenuKind.emoji);
        }
    }

    public function navigate(page: Page, kind: MenuKind) {
        InlineEditors.commit-revision += 1;
        DragDrop.reset();
        if page == Page.layouts { LayoutLibrary.refresh(); }
        if page == Page.menus { MenuEditor.open(kind); }
        if page != Page.layouts && page != Page.settings { LayoutLibrary.editor-open = true; }
        root.page = page;
        shortcut-focus.focus();
    }

    property <bool> modal-open: root.confirm-discard || root.confirm-close || ActionPicker.opened || RulesEditor.dialog != RuleDialog.none || LayersEditor.dialog != LayerDialog.none || LayersEditor.delete-extra >= 0
        || LayoutLibrary.save-as-open || LayoutLibrary.dialog != LibraryDialog.none;
    property <bool> show-active-banner: root.page != Page.layouts && root.page != Page.settings && !LayoutLibrary.automatic
        && LayoutLibrary.current-label != "" && LayoutLibrary.current-label != LayoutLibrary.active-label;

    changed modal-open => { if !root.modal-open { shortcut-focus.focus(); } }

    shortcut-focus := FocusScope {
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if InlineEditors.window-active && !root.modal-open && event.modifiers.control && event.text.to-lowercase() == "s" && LayoutLibrary.editor-open {
                InlineEditors.commit-revision += 1; MacroEditor.flush-pending();
                if LayoutLibrary.dirty { LayoutLibrary.save-current(); }
                return accept;
            }
            return reject;
        }
    FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.modal-open;
        VerticalBox {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                height: 54px;
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                    VerticalLayout { alignment: center; NavButton { icon: @image-url("icons/keyboard.svg"); text: @tr("Layouts"); selected: root.page == Page.layouts; clicked => { root.navigate(Page.layouts, MenuKind.emoji); } } }
                    VerticalLayout { alignment: center; NavButton { icon: @image-url("icons/settings-2.svg"); text: @tr("Settings"); selected: root.page == Page.settings; clicked => { root.navigate(Page.settings, MenuKind.emoji); } } }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 120px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            LineEdit { preferred-width: 200px; min-width: 120px; max-width: 200px; horizontal-stretch: 1; text <=> root.test-text; placeholder-text: @tr("Type to test..."); }
                        }
                    }
                    VerticalLayout { alignment: center; Badge {
                        min-width: 40px;
                        text: AppState.keyboard-language == "" ? "—" : AppState.keyboard-language;
                        Tooltip { Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 4px; HorizontalLayout { padding: 8px; Text { text: @tr("Current keyboard layout in the system") + "\n" + AppState.keyboard-language; color: Theme.text; } } } }
                    }
                    }
                    GameModeButton {}
                    active-layout := Rectangle {
                        width: 180px; height: 36px; border-radius: 6px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                        HorizontalLayout { padding: 8px; spacing: 6px;
                            Image { width: 14px; source: @image-url("icons/keyboard.svg"); colorize: Theme.muted; }
                            Text { text: LayoutLibrary.active-label == "" ? @tr("No active layout") : @tr("Active: {}", LayoutLibrary.active-label); color: Theme.text; overflow: elide; vertical-alignment: center; }
                            if !LayoutLibrary.automatic: Image { width: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; }
                        }
                        TouchArea { enabled: !LayoutLibrary.automatic; mouse-cursor: pointer; clicked => { LayoutLibrary.refresh(); active-menu.show(); } }
                        Tooltip { Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 4px; HorizontalLayout { padding: 8px; Text { text: LayoutLibrary.automatic ? @tr("Current active layout (automatic)") : @tr("Current active layout — click to switch"); color: Theme.text; } } } }
                    }
                    Rectangle { width: 1px; background: Theme.divider; }
                    VerticalLayout { alignment: center; MapperToggle {
                        text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Stop") : @tr("Start");
                        running: AppState.mapper-running;
                        busy: AppState.mapper-busy;
                        toggled => { AppState.toggle-mapper(); }
                    } }
                }
            }
            Rectangle { height: 1px; background: Theme.divider; }
            if LayoutLibrary.editor-open: Rectangle {
                height: 50px + (editor-tabs.viewport-width > editor-tabs.visible-width ? Theme.scrollbar-size + Theme.scrollbar-gap : 0px);
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 8px;
                    Text { text: LayoutLibrary.current-label == "" ? @tr("Custom layout") : LayoutLibrary.current-label; color: Theme.text; max-width: 200px; overflow: elide; vertical-alignment: center; }
                    VerticalLayout { alignment: center; SaveSplitButton {
                        enabled: LayoutLibrary.dirty;
                        save => { LayoutLibrary.save-current(); }
                        discard => { root.confirm-discard = true; }
                        save-as => { LayoutLibrary.save-as-name = ""; LayoutLibrary.save-as-open = true; }
                    } }
                    Rectangle { width: 16px; }
                    editor-tabs := ScrollView {
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: as-needed;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        min-height: 0px;
                        viewport-height: self.visible-height;
                        HorizontalLayout {
                            spacing: 2px; alignment: start;
                            NavTab { icon: @image-url("icons/settings-2.svg"); text: @tr("Triggers") + (LayoutLibrary.rules-dirty ? " •" : ""); selected: root.page == Page.rules; clicked => { root.navigate(Page.rules, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/keyboard.svg"); text: @tr("Layers") + (LayoutLibrary.layers-dirty ? " •" : ""); selected: root.page == Page.keyboard || root.page == Page.layers; clicked => { root.navigate(Page.layers, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/smile.svg"); text: @tr("Emoji") + (LayoutLibrary.emoji-dirty ? " •" : ""); selected: root.page == Page.menus && MenuEditor.kind == MenuKind.emoji; clicked => { root.navigate(Page.menus, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/zap.svg"); text: @tr("Quick actions") + (LayoutLibrary.quick-dirty ? " •" : ""); selected: root.page == Page.menus && MenuEditor.kind == MenuKind.quick; clicked => { root.navigate(Page.menus, MenuKind.quick); } }
                            NavTab { icon: @image-url("icons/clock.svg"); text: @tr("Macros") + ((LayoutLibrary.macros-dirty || MacroEditor.has-errors) ? " •" : ""); selected: root.page == Page.macros; clicked => { root.navigate(Page.macros, MenuKind.emoji); } }
                        }
                    }
                    VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close layout"); clicked => { root.close-layout(); } } }
                }
            }
            if LayoutLibrary.editor-open: Rectangle { height: 1px; background: Theme.divider; }
            if root.show-active-banner: Rectangle {
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
                    Text {
                        text: LayoutLibrary.active-label == ""
                            ? @tr("You are editing “{}”; no layout is active.", LayoutLibrary.current-label)
                            : @tr("You are editing “{}”, but “{}” is active.", LayoutLibrary.current-label, LayoutLibrary.active-label);
                        color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                    Button { text: @tr("Make active"); clicked => { LayoutLibrary.activate-current(); } }
                }
            }
            if root.show-active-banner: Rectangle { height: 1px; background: Theme.divider; }
            VerticalLayout {
                vertical-stretch: 1;
                padding: Theme.page-padding;
                spacing: 12px;
                if root.problem.id != "": Text { text: Locale.text(root.problem); color: NotificationCenter.is-warning(root.problem.id) ? Theme.warning : Theme.error; wrap: word-wrap; max-height: 96px; overflow: elide; }
                if root.page == Page.layouts: LibraryPage {}
                if root.page == Page.settings: SettingsPage {}
                if root.page == Page.rules: RulesPage {}
                if root.page == Page.layers || root.page == Page.keyboard: LayersPage {}
                if root.page == Page.macros: MacrosPage {}
                if root.page == Page.menus: MenusPage {}
            }
        }
    }
    active-menu := PopupWindow {
        x: active-layout.absolute-position.x; y: 52px; width: 240px;
        Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 8px;
            VerticalLayout { padding: 6px; spacing: 4px;
                for name[index] in LayoutLibrary.names: Button {
                    text: name; primary: name == LayoutLibrary.active-label;
                    clicked => { active-menu.close(); LayoutLibrary.select(index); LayoutLibrary.action(LibraryAction.activate); }
                }
            }
        }
    }
    if root.confirm-discard || root.confirm-close: ConfirmDialog {
        width: 100%; height: 100%;
        title: @tr("Discard layout changes?");
        body: @tr("Unsaved changes to this layout will be lost.");
        confirm-text: @tr("Discard");
        cancel => { root.confirm-discard = false; root.confirm-close = false; }
        confirm => {
            InlineEditors.revision += 1; LayoutLibrary.discard-current(); MacroEditor.refresh(); MenuEditor.refresh();
            if root.confirm-close && !LayoutLibrary.dirty { LayoutLibrary.editor-open = false; root.navigate(Page.layouts, MenuKind.emoji); }
            root.confirm-discard = false; root.confirm-close = false;
        }
    }
    LibraryDialogOverlay {}
    RuleDialogOverlay {}
    LayerDialogOverlay {}
    if ActionPicker.opened: PickerOverlay {}
    ToastStack {
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: min(420px, parent.width - 40px);
    }
    }
}
