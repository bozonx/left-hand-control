import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { QuickGrid } from "quick-grid.slint";
import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, ListView, CheckBox, ScrollView } from "std-widgets.slint";

export struct ActionRow { id: int, label: string, label-en: string }
export struct ProcessRow { name: string, only-active: bool, blacklist: bool }
export struct RuleRow { key: string, action: string, enabled: bool }
export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: 14px;
    title: @tr("Left Hand Control");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 940px;
    min-height: 700px;
    in-out property <int> page: 0;
    in property <[string]> layout-names;
    in-out property <int> selected-layout: -1;
    in-out property <string> layout-name;
    in property <string> layout-description;
    in property <string> layout-status;
    callback refresh-layouts();
    callback select-layout(int);
    callback create-layout(string);
    callback save-layout();
    callback load-layout();
    callback delete-layout();
    in property <[RuleRow]> rule-rows;
    in-out property <int> selected-rule: -1;
    in-out property <string> rule-key;
    in-out property <string> rule-layer;
    in-out property <string> new-rule-layer-name;
    callback create-rule-layer(string);
    in-out property <string> rule-tap;
    in-out property <string> rule-hold;
    in-out property <bool> rule-swallow-tap: false;
    in-out property <bool> rule-swallow-hold: false;
    in-out property <string> rule-double-tap;
    in-out property <string> rule-game-mode;
    in-out property <string> rule-layouts;
    in-out property <string> rule-apps-include;
    in-out property <string> rule-apps-exclude;
    in-out property <string> rule-isolate;
    in-out property <string> rule-hold-for;
    in-out property <string> rule-hold-timeout;
    in-out property <string> rule-double-timeout;
    in-out property <bool> rule-enabled: true;
    in property <string> rule-status;
    callback refresh-rules();
    callback select-rule(int);
    callback add-rule();
    callback remove-rule();
    callback move-rule(int);
    callback edit-rule(int, string);
    in-out property <int> appearance-index: 0;
    in-out property <int> locale-index: 0;
    in-out property <bool> launch-on-startup: false;
    in-out property <int> tap-decision-index: 0;
    in-out property <string> hold-timeout;
    in-out property <string> double-tap-timeout;
    in-out property <string> macro-pause;
    in-out property <string> modifier-delay;
    in-out property <bool> use-gamemoded: true;
    in-out property <bool> use-fullscreen: false;
    in property <[ProcessRow]> process-matchers;
    in-out property <string> process-name;
    in-out property <bool> process-only-active: false;
    in-out property <bool> process-blacklist: false;
    in-out property <int> selected-process: -1;
    in-out property <int> text-mode-index: 0;
    in-out property <string> ydotool-path;
    in-out property <string> xdotool-path;
    in-out property <string> mouse-device-path;
    in property <[string]> mouse-devices;
    in property <[string]> mouse-paths;
    in-out property <int> selected-mouse: 0;
    in property <string> settings-dir;
    in property <string> layouts-dir;
    in property <string> platform-summary;
    in property <Message> settings-message;
    callback save-settings();
    callback settings-saved(bool, bool);
    callback refresh-devices();
    callback add-process();
    callback select-process(int);
    callback update-process();
    callback delete-process();
    in property <[string]> keys;
    in property <[string]> assignments;
    in property <[ActionRow]> actions;
    in-out property <int> selected-key: -1;
    in-out property <bool> editing: false;
    in-out property <int> kind: 0;
    in-out property <string> value;
    in-out property <string> query;
    in-out property <int> category: 0;
    in-out property <int> selected-action: -1;
    in-out property <bool> capturing: false;
    in-out property <length> catalog-scroll-y;
    in property <Message> validation;
    in property <Message> status;
    in property <Message> backend-error;
    in property <Message> config-status;
    in property <[string]> input-devices;
    in-out property <int> selected-device: -1;
    callback select-device(int);
    callback show-popup(string);
    callback toggle-mapper();
    callback edit-key(int);
    callback change-kind(int);
    callback validate();
    callback filter();
    callback pick-action(int);
    callback navigate-action(int);
    callback update-action();
    callback capture(string, bool, bool, bool, bool);
    callback save();
    callback cancel();
    in-out property <bool> grid-open: false;
    in property <[string]> quick-items;
    callback move-quick(int, int);
    callback rename-quick(int, string);
    callback preferences(bool, bool);
    public function focus-editor() { modal-focus.focus(); }
    public function restore-focus() { keyboard-focus.focus(); }
    public function begin-capture() { root.capturing = true; capture-scope.focus(); }

    capture-scope := FocusScope {
        focus-on-tab-navigation: false;
        height: 0px;
        key-pressed(event) => {
            if root.capturing {
                root.capture(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                return accept;
            }
            return reject;
        }
        key-released(event) => { if !root.capturing { modal-focus.focus(); } return accept; }
    }
    keyboard-focus := FocusScope {
        enabled: !root.editing;
        key-pressed(event) => {
            if event.text == Key.Return { root.edit-key(max(0, root.selected-key)); return accept; }
            if event.text == Key.RightArrow { root.selected-key = mod(root.selected-key + 1, 80); return accept; }
            if event.text == Key.LeftArrow { root.selected-key = mod(root.selected-key + 79, 80); return accept; }
            return reject;
        }
    }
    background-scope := FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.editing;
        if !root.editing: VerticalBox {
            padding: 24px;
            spacing: 16px;
            HorizontalBox {
                spacing: 8px;
                Button { text: @tr("Keyboard"); clicked => { root.page = 0; root.grid-open = false; } }
                Button { text: @tr("Action grid"); clicked => { root.page = 0; root.grid-open = true; } }
                Button { text: @tr("Layouts"); clicked => { root.page = 1; root.refresh-layouts(); } }
                Button { text: @tr("Rules"); clicked => { root.page = 3; root.refresh-rules(); } }
                Button { text: @tr("Settings"); clicked => { root.page = 2; } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: Theme.dark ? @tr("☀ Light") : @tr("☾ Dark"); clicked => { root.preferences(!Theme.dark, Locale.english); } }
                Button { text: Locale.english ? "Русский" : "English"; clicked => { root.preferences(Theme.dark, !Locale.english); } }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.page == 0: VerticalBox {
                spacing: 8px;
                Text { color: Theme.text; text: @tr("Keyboard layout"); font-size: 26px; font-weight: 700; }
                Text { color: Theme.muted; text: @tr("Select a key to assign an action."); }
                Text { color: Theme.muted; text: Locale.text(root.config-status); }
            }
            if root.page == 1: VerticalBox {
                spacing: 12px;
                Text { color: Theme.text; text: @tr("Layouts"); font-size: 26px; font-weight: 700; }
                Text { color: Theme.muted; text: @tr("Save the current layout or select a file from your library."); }
                HorizontalBox {
                    spacing: 8px;
                    LineEdit { text <=> root.layout-name; placeholder-text: @tr("New layout name"); }
                    Button { text: @tr("Create empty"); clicked => { root.create-layout(root.layout-name); } }
                    Button { text: @tr("Save current"); clicked => { root.save-layout(); } }
                    Button { text: @tr("Refresh"); clicked => { root.refresh-layouts(); } }
                }
                Rectangle {
                    background: Theme.card;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 8px;
                    vertical-stretch: 1;
                    ListView {
                        x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                        for name[index] in root.layout-names: Rectangle {
                            height: 42px;
                            background: root.selected-layout == index ? Theme.accent : row-touch.has-hover ? Theme.hover : Theme.card;
                            Text { x: 12px; text: name; color: Theme.text; vertical-alignment: center; }
                            row-touch := TouchArea { clicked => { root.select-layout(index); } }
                        }
                    }
                }
                Text { text: root.layout-description; color: Theme.muted; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: @tr("Load selected"); enabled: root.selected-layout >= 0; clicked => { root.load-layout(); } }
                    Button { text: @tr("Save current to selected"); enabled: root.selected-layout >= 0; clicked => { root.save-layout(); } }
                    Button { text: @tr("Delete selected"); enabled: root.selected-layout >= 0; clicked => { root.delete-layout(); } }
                }
                Text { text: root.layout-status; color: Theme.muted; wrap: word-wrap; }
            }
            if root.page == 2: VerticalBox {
                spacing: 10px;
                Text { color: Theme.text; text: @tr("Settings"); font-size: 26px; font-weight: 700; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;
                        Rectangle {
                            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                            VerticalBox { padding: 16px; spacing: 10px;
                                Text { text: @tr("Mapper"); color: Theme.text; font-size: 18px; font-weight: 600; }
                                Text { text: Locale.text(root.config-status); color: Theme.muted; }
                                HorizontalBox { spacing: 8px;
                                    Text { text: @tr("Keyboard device"); color: Theme.text; vertical-alignment: center; }
                                    ComboBox { model: root.input-devices; current-index: root.selected-device; selected(value) => { root.select-device(self.current-index); } }
                                    Button { text: @tr("Refresh devices"); clicked => { root.refresh-devices(); } }
                                    Button { text: @tr("Toggle mapper"); clicked => { root.toggle-mapper(); } }
                                }
                                HorizontalBox { spacing: 8px;
                                    Text { text: @tr("Mouse device path"); color: Theme.text; vertical-alignment: center; }
                                    ComboBox { model: root.mouse-devices; current-index <=> root.selected-mouse; selected(value) => { root.mouse-device-path = root.mouse-paths[self.current-index]; } }
                                    LineEdit { text <=> root.mouse-device-path; placeholder-text: @tr("Optional device path"); }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                            VerticalBox { padding: 16px; spacing: 10px;
                                Text { text: @tr("General"); color: Theme.text; font-size: 18px; font-weight: 600; }
                                HorizontalBox { spacing: 8px;
                                    Text { text: @tr("Appearance"); color: Theme.text; vertical-alignment: center; }
                                    ComboBox { model: [@tr("System"), @tr("Light"), @tr("Dark")]; current-index <=> root.appearance-index; }
                                    Text { text: @tr("Language"); color: Theme.text; vertical-alignment: center; }
                                    ComboBox { model: [@tr("Automatic"), "English", "Русский"]; current-index <=> root.locale-index; }
                                }
                                CheckBox { text: @tr("Launch on startup"); checked <=> root.launch-on-startup; }
                            }
                        }
                        Rectangle {
                            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                            VerticalBox { padding: 16px; spacing: 10px;
                                Text { text: @tr("Key behavior"); color: Theme.text; font-size: 18px; font-weight: 600; }
                                HorizontalBox { spacing: 8px;
                                    Text { text: @tr("Tap decision"); color: Theme.text; vertical-alignment: center; }
                                    ComboBox { model: [@tr("Permissive hold"), @tr("Hold on other key press")]; current-index <=> root.tap-decision-index; }
                                }
                                HorizontalBox { spacing: 8px;
                                    Text { text: @tr("Hold timeout (ms)"); color: Theme.text; vertical-alignment: center; }
                                    LineEdit { text <=> root.hold-timeout; }
                                    Text { text: @tr("Double tap timeout (ms)"); color: Theme.text; vertical-alignment: center; }
                                    LineEdit { text <=> root.double-tap-timeout; }
                                }
                                HorizontalBox { spacing: 8px;
                                    Text { text: @tr("Macro step pause (ms)"); color: Theme.text; vertical-alignment: center; }
                                    LineEdit { text <=> root.macro-pause; }
                                    Text { text: @tr("Modifier delay (ms)"); color: Theme.text; vertical-alignment: center; }
                                    LineEdit { text <=> root.modifier-delay; }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                            VerticalBox { padding: 16px; spacing: 10px;
                                Text { text: @tr("Game mode"); color: Theme.text; font-size: 18px; font-weight: 600; }
                                HorizontalBox { spacing: 8px;
                                    CheckBox { text: @tr("Use GameMode daemon"); checked <=> root.use-gamemoded; }
                                    CheckBox { text: @tr("Detect fullscreen"); checked <=> root.use-fullscreen; }
                                }
                                Text { text: @tr("Process rules"); color: Theme.text; font-weight: 600; }
                                for item[index] in root.process-matchers: Rectangle {
                                    height: 30px; background: root.selected-process == index ? Theme.accent : Theme.card;
                                    Text { x: 8px; text: (item.blacklist ? @tr("Exclude: ") : @tr("Include: ")) + item.name; color: Theme.text; vertical-alignment: center; }
                                    TouchArea { clicked => { root.select-process(index); } }
                                }
                                HorizontalBox { spacing: 8px;
                                    LineEdit { text <=> root.process-name; placeholder-text: @tr("Process name"); }
                                    CheckBox { text: @tr("Active window only"); checked <=> root.process-only-active; }
                                    CheckBox { text: @tr("Exclude"); checked <=> root.process-blacklist; }
                                }
                                HorizontalBox { spacing: 8px;
                                    Button { text: @tr("Add process"); clicked => { root.add-process(); } }
                                    Button { text: @tr("Update selected"); enabled: root.selected-process >= 0; clicked => { root.update-process(); } }
                                    Button { text: @tr("Remove selected"); enabled: root.selected-process >= 0; clicked => { root.delete-process(); } }
                                }
                            }
                        }
                        Rectangle {
                            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                            VerticalBox { padding: 16px; spacing: 10px;
                                Text { text: @tr("Linux text injection"); color: Theme.text; font-size: 18px; font-weight: 600; }
                                ComboBox { model: ["libei", "libei-pure", "keycode", "clipboard", "ydotool", "xdotool"]; current-index <=> root.text-mode-index; }
                                if root.text-mode-index == 4: LineEdit { text <=> root.ydotool-path; placeholder-text: @tr("ydotool path"); }
                                if root.text-mode-index == 5: LineEdit { text <=> root.xdotool-path; placeholder-text: @tr("xdotool path"); }
                            }
                        }
                        Rectangle {
                            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                            VerticalBox { padding: 16px; spacing: 8px;
                                Text { text: @tr("Configuration and system"); color: Theme.text; font-size: 18px; font-weight: 600; }
                                Text { text: root.platform-summary; color: Theme.muted; }
                                Text { text: @tr("Settings directory: ") + root.settings-dir; color: Theme.muted; wrap: word-wrap; }
                                Text { text: @tr("Layouts directory: ") + root.layouts-dir; color: Theme.muted; wrap: word-wrap; }
                            }
                        }
                    }
                }
                HorizontalBox { spacing: 8px;
                    Text { text: Locale.text(root.settings-message); color: Theme.muted; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Save settings"); clicked => { root.save-settings(); } }
                }
            }
            if root.page == 3: VerticalBox {
                spacing: 10px;
                Text { text: @tr("Rules"); color: Theme.text; font-size: 26px; font-weight: 700; }
                Text { text: @tr("Changes are saved automatically to the current layout."); color: Theme.muted; }
                HorizontalBox { spacing: 8px;
                    Button { text: @tr("Add rule"); clicked => { root.add-rule(); } }
                    Button { text: @tr("Remove"); enabled: root.selected-rule >= 0; clicked => { root.remove-rule(); } }
                    Button { text: @tr("Move up"); enabled: root.selected-rule > 0; clicked => { root.move-rule(-1); } }
                    Button { text: @tr("Move down"); enabled: root.selected-rule >= 0 && root.selected-rule < root.rule-rows.length - 1; clicked => { root.move-rule(1); } }
                }
                HorizontalBox { spacing: 12px;
                    Rectangle { width: 290px; background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                        ListView { x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                            for rule[index] in root.rule-rows: Rectangle { height: 40px;
                                background: root.selected-rule == index ? Theme.accent : rule-touch.has-hover ? Theme.hover : Theme.card;
                                Text { x: 8px; width: parent.width - 16px; text: (rule.enabled ? "" : "○ ") + (rule.key == "" ? @tr("Draft") : rule.key) + " → " + rule.action; color: Theme.text; overflow: elide; vertical-alignment: center; }
                                rule-touch := TouchArea { clicked => { root.select-rule(index); } }
                            }
                        }
                    }
                    if root.selected-rule >= 0: ScrollView { horizontal-stretch: 1;
                        VerticalLayout { padding: 12px; spacing: 8px;
                            CheckBox { text: @tr("Enabled"); checked <=> root.rule-enabled; toggled => { root.edit-rule(0, root.rule-enabled ? "true" : "false"); } }
                            Text { text: @tr("Trigger key"); color: Theme.text; }
                            LineEdit { text <=> root.rule-key; edited => { root.edit-rule(1, root.rule-key); } }
                            Text { text: @tr("Layer ID (empty for base layer)"); color: Theme.text; }
                            LineEdit { text <=> root.rule-layer; edited => { root.edit-rule(2, root.rule-layer); } }
                            HorizontalBox { spacing: 8px;
                                LineEdit { text <=> root.new-rule-layer-name; placeholder-text: @tr("New layer name"); }
                                Button { text: @tr("Create layer"); clicked => { root.create-rule-layer(root.new-rule-layer-name); } }
                            }
                            Text { text: @tr("Tap action"); color: Theme.text; }
                            CheckBox { text: @tr("Swallow tap"); checked <=> root.rule-swallow-tap; toggled => { root.edit-rule(14, root.rule-swallow-tap ? "true" : "false"); } }
                            LineEdit { enabled: !root.rule-swallow-tap; text <=> root.rule-tap; edited => { root.edit-rule(3, root.rule-tap); } }
                            Text { text: @tr("Hold action"); color: Theme.text; }
                            CheckBox { text: @tr("Swallow hold"); checked <=> root.rule-swallow-hold; toggled => { root.edit-rule(15, root.rule-swallow-hold ? "true" : "false"); } }
                            LineEdit { enabled: !root.rule-swallow-hold; text <=> root.rule-hold; edited => { root.edit-rule(4, root.rule-hold); } }
                            Text { text: @tr("Double tap action"); color: Theme.text; }
                            LineEdit { text <=> root.rule-double-tap; edited => { root.edit-rule(5, root.rule-double-tap); } }
                            Text { text: @tr("Game mode condition"); color: Theme.text; }
                            LineEdit { text <=> root.rule-game-mode; edited => { root.edit-rule(6, root.rule-game-mode); } }
                            Text { text: @tr("Layout conditions (comma separated)"); color: Theme.text; }
                            LineEdit { text <=> root.rule-layouts; edited => { root.edit-rule(7, root.rule-layouts); } }
                            Text { text: @tr("App whitelist (comma separated)"); color: Theme.text; }
                            LineEdit { text <=> root.rule-apps-include; edited => { root.edit-rule(8, root.rule-apps-include); } }
                            Text { text: @tr("App blacklist (comma separated)"); color: Theme.text; }
                            LineEdit { text <=> root.rule-apps-exclude; edited => { root.edit-rule(9, root.rule-apps-exclude); } }
                            Text { text: @tr("Isolate"); color: Theme.text; }
                            LineEdit { text <=> root.rule-isolate; edited => { root.edit-rule(10, root.rule-isolate); } }
                            Text { text: @tr("Hold for"); color: Theme.text; }
                            LineEdit { text <=> root.rule-hold-for; edited => { root.edit-rule(11, root.rule-hold-for); } }
                            Text { text: @tr("Hold timeout (ms)"); color: Theme.text; }
                            LineEdit { text <=> root.rule-hold-timeout; edited => { root.edit-rule(12, root.rule-hold-timeout); } }
                            Text { text: @tr("Double tap timeout (ms)"); color: Theme.text; }
                            LineEdit { text <=> root.rule-double-timeout; edited => { root.edit-rule(13, root.rule-double-timeout); } }
                        }
                    }
                }
                Text { text: root.rule-status; color: Theme.muted; wrap: word-wrap; }
            }
            if root.page == 0 && !root.grid-open: VerticalLayout {
                spacing: 6px;
                for row in 5: HorizontalLayout {
                    spacing: 5px;
                    for col in 16: Rectangle {
                        height: 66px;
                        border-radius: 6px;
                        border-width: root.selected-key == row * 16 + col ? 2px : 1px;
                        border-color: root.selected-key == row * 16 + col ? Theme.accent : Theme.border;
                        background: key-touch.has-hover ? Theme.hover : Theme.card;
                        VerticalLayout {
                            padding: 5px;
                            Text { text: root.keys[row * 16 + col]; color: Theme.text; font-size: 12px; }
                            Text { text: root.assignments[row * 16 + col]; color: Theme.muted; font-size: 10px; overflow: elide; }
                        }
                        key-touch := TouchArea { clicked => { root.edit-key(row * 16 + col); } }
                    }
                }
            }
            if root.page == 0 && root.grid-open: QuickGrid {
                items: root.quick-items;
                move-item(from, to) => { root.move-quick(from, to); }
                rename-item(index, value) => { root.rename-quick(index, value); }
            }
            Text { text: Locale.text(root.status); color: Theme.text; }
            Text { text: Locale.text(root.backend-error); color: Theme.error; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
            HorizontalBox {
                Button { text: @tr("Emoji"); clicked => { root.show-popup("emoji"); } }
                Button { text: @tr("Quick actions"); clicked => { root.show-popup("quick"); } }
                Button { text: @tr("Toggle mapper"); clicked => { root.toggle-mapper(); } }
                ComboBox {
                    model: ["Русский", "English — longer interface labels"];
                    current-index: Locale.english ? 1 : 0;
                    selected(value) => { root.preferences(Theme.dark, self.current-index == 1); }
                }
            }
        }
    }
    modal-focus := FocusScope {
        focus-on-tab-navigation: false;
        enabled: root.editing;
        key-pressed(event) => {
            if root.capturing { return reject; }
            if event.text == Key.Escape { root.cancel(); return accept; }
            if event.text == Key.Return && root.validation.id == "" { root.save(); return accept; }
            return reject;
        }
        if root.editing: Rectangle {
            background: #00000099;
            TouchArea { }
            Rectangle {
                x: 32px; y: 24px;
                width: parent.width - 64px; height: parent.height - 48px;
                background: Theme.surface;
                border-radius: 12px;
                VerticalBox {
                    padding: 24px; spacing: 12px;
                    Text { text: @tr("Key «") + root.keys[root.selected-key] + "»"; color: Theme.text; font-size: 24px; }
                    Text { text: @tr("Draft — saving applies the action to this key only"); color: Theme.muted; }
                    ComboBox {
                        enabled: !root.capturing;
                        model: [@tr("Text"), @tr("Delay (ms)"), @tr("System action"), @tr("Keyboard shortcut")];
                        current-index <=> root.kind;
                        selected(value) => { root.change-kind(self.current-index); }
                    }
                    if root.kind == 0 || root.kind == 1: LineEdit {
                        text <=> root.value;
                        placeholder-text: root.kind == 0 ? @tr("Enter text, for example Привет 👋") : @tr("Integer from 1 to 10000");
                        edited => { root.validate(); }
                        accepted => { if !root.capturing && root.validation.id == "" { root.save(); } }
                    }
                    if root.kind == 2: ComboBox {
                        model: [@tr("Copy"), @tr("Paste"), @tr("Next window")];
                        current-index: root.value == "Ctrl+KeyV" ? 1 : root.value == "Alt+Tab" ? 2 : 0;
                        selected(value) => { root.value = self.current-index == 0 ? "Ctrl+KeyC" : self.current-index == 1 ? "Ctrl+KeyV" : "Alt+Tab"; root.validate(); }
                    }
                    if root.kind == 3: HorizontalBox {
                        Text { text: root.value == "" ? @tr("No shortcut assigned") : root.value; color: Theme.text; }
                        Button {
                            text: root.capturing ? @tr("Press a shortcut…") : @tr("Capture shortcut");
                            clicked => { root.begin-capture(); }
                        }
                        Button { text: @tr("Stop capture"); enabled: root.capturing; clicked => { root.capturing = false; } }
                    }
                    Text { text: Locale.text(root.validation); color: Theme.error; height: 22px; }
                    HorizontalBox {
                        LineEdit { enabled: !root.capturing; text <=> root.query; placeholder-text: @tr("Search 500 actions…"); edited => { root.filter(); } }
                        ComboBox {
                            enabled: !root.capturing;
                            model: [@tr("All categories"), @tr("Text"), @tr("Delay"), @tr("System"), @tr("Shortcuts")];
                            current-index <=> root.category;
                            selected(value) => { root.filter(); }
                        }
                    }
                    Text { text: @tr("Found: ") + root.actions.length + @tr(" · select an entry to fill the draft"); color: Theme.muted; }
                    catalog-keys := FocusScope {
                        enabled: !root.capturing;
                        vertical-stretch: 1;
                        min-height: 100px;
                        key-pressed(event) => {
                            if event.text == Key.UpArrow { root.navigate-action(-1); return accept; }
                            if event.text == Key.DownArrow { root.navigate-action(1); return accept; }
                            return reject;
                        }
                        ListView {
                            vertical-stretch: 1;
                            enabled: !root.capturing;
                            viewport-width: self.visible-width;
                            viewport-y <=> root.catalog-scroll-y;
                            for action in root.actions: Rectangle {
                                height: 36px;
                                background: root.selected-action == action.id ? Theme.accent : action-touch.has-hover ? Theme.hover : Theme.card;
                                Text { x: 12px; text: Locale.english ? action.label-en : action.label; color: Theme.text; vertical-alignment: center; }
                                action-touch := TouchArea { clicked => { root.pick-action(action.id); catalog-keys.focus(); } }
                            }
                        }
                    }
                    HorizontalBox {
                        Button { text: @tr("Update the selected catalog entry"); enabled: root.selected-action >= 0 && !root.capturing; clicked => { root.update-action(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                        Button { text: @tr("Save"); enabled: root.validation.id == "" && !root.capturing; clicked => { root.save(); } }
                    }
                }
            }
        }
    }
}
