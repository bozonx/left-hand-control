import { KeyboardFocus } from "focus.slint";
import { TextField } from "controls.slint";
import { NotificationCenter, ToastStack } from "notifications.slint";
import { ScrollView } from "scroll.slint";
import { ActionPicker, PickerOverlay } from "action-picker.slint";
import { AppState } from "app-state.slint";
import { GameModeButton } from "game-mode.slint";
import { LayerDialogOverlay, LayersEditor, LayersPage } from "layers.slint";
import { LayoutLibrary, LibraryDialogOverlay, LibraryPage, SaveSplitButton } from "library.slint";
import { MacroEditor, MacrosPage } from "macros.slint";
import { MenuEditor, MenusPage } from "menus.slint";
import { RuleDialogOverlay, RulesEditor, RulesPage } from "rules.slint";
import { AppEntryDialog, AppEntryOverlay } from "conditions.slint";
import { DragDrop, PaletteDrag } from "reorder.slint";
import { CommandDialogOverlay, SettingsPage, SettingsEditor } from "settings-page.slint";
import { DeviceDialog, DeviceDialogOverlay } from "device-picker.slint";
import { ConfirmDialog, DialogFrame, IconButton, Badge, InlineEditors, MapperToggle, Divider, MenuSurface, MenuItem, NavButton, NavTab, TooltipText } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { LayerDialog, LibraryDialog, LibraryAction, MenuKind, Page, RuleDialog } from "types.slint";
import { Button } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: Theme.font-default;
    title: @tr("Left Hand Control");
    preferred-width: 1120px;
    preferred-height: 760px;
    /// Small enough for 1366×768 at 150% and 1920×1080 at 200% with a panel and title bar.
    out property <length> min-window-width: 640px;
    out property <length> min-window-height: 400px;
    min-width: root.min-window-width;
    max-width: Theme.unbounded;
    min-height: root.min-window-height;
    /// Header buttons show icons only in a narrow window; development builds have extra header controls.
    /// Set on resize rather than bound: the header's size feeds back into the window's layout.
    property <length> compact-below: AppState.in-development ? 1000px : 860px;
    property <bool> compact-header;
    init => { root.compact-header = root.width < root.compact-below; }
    changed width => { root.compact-header = root.width < root.compact-below; }
    changed compact-below => { root.compact-header = root.width < root.compact-below; }
    in-out property <Page> page: Page.layouts;
    forward-focus: shortcut-focus;
    private property <string> test-text;
    private property <string> focus-help;
    private property <bool> confirm-discard: false;
    private property <bool> confirm-close: false;
    property <bool> library-problem: NotificationCenter.is-problem(LayoutLibrary.status.id);
    property <bool> layers-problem: NotificationCenter.is-problem(LayersEditor.status.id);
    property <bool> rules-problem: NotificationCenter.is-problem(RulesEditor.status.id);
    property <bool> macros-problem: NotificationCenter.is-problem(MacroEditor.status.id);
    property <bool> menus-problem: NotificationCenter.is-problem(MenuEditor.status.id);
    property <bool> settings-problem: NotificationCenter.is-problem(SettingsEditor.message.id);
    /// Lasting problems only: one-off errors are toasts, mapper state is on its card.
    property <Message> problem: AppState.config-status.id == "config-unavailable" ? AppState.config-status
        : root.library-problem ? LayoutLibrary.status
        : root.layers-problem ? LayersEditor.status
        : root.rules-problem ? RulesEditor.status
        : root.macros-problem ? MacroEditor.status
        : root.menus-problem ? MenuEditor.status
        : root.settings-problem ? SettingsEditor.message : {};

    /// Quit is allowed only after all page drafts have been applied.
    public function flush-drafts() -> bool {
        let layout = LayoutLibrary.flush-drafts();
        let settings = SettingsEditor.flush-pending();
        if !settings { root.navigate(Page.settings, MenuKind.emoji); }
        else if MacroEditor.has-unsaved-changes || MacroEditor.has-errors { root.navigate(Page.macros, MenuKind.emoji); }
        else if MenuEditor.has-unsaved-changes { root.navigate(Page.menus, MenuEditor.kind); }
        return layout && settings;
    }

    public function close-layout() {
        let drafts-saved = LayoutLibrary.flush-drafts();
        if LayoutLibrary.dirty || !drafts-saved {
            root.confirm-close = true;
        } else {
            LayoutLibrary.editor-open = false;
            if root.page != Page.settings && root.page != Page.layouts { root.navigate(Page.layouts, MenuKind.emoji); }
        }
    }

    public function navigate(page: Page, kind: MenuKind) {
        if !AppState.in-development && (page == Page.menus || page == Page.macros) { return; }
        if !InlineEditors.flush() { return; }
        DragDrop.cancel();
        if page == Page.layouts { LayoutLibrary.refresh(); }
        if page == Page.menus { MenuEditor.open(kind); }
        if page != Page.layouts && page != Page.settings { LayoutLibrary.editor-open = true; }
        root.page = page;
        if !KeyboardFocus.has-focus() {
            if page == Page.settings { settings-navigation.focus(); }
            else { layouts-navigation.focus(); }
        }
    }

    property <bool> modal-open: KeyboardFocus.active || root.confirm-discard || root.confirm-close || ActionPicker.opened || RulesEditor.dialog != RuleDialog.none || LayersEditor.dialog != LayerDialog.none || LayersEditor.delete-extra >= 0
        || LayoutLibrary.save-as-open || LayoutLibrary.dialog != LibraryDialog.none
        || AppEntryDialog.editing || AppEntryDialog.removing || DeviceDialog.open || SettingsEditor.full-command != "";
    property <bool> show-active-banner: root.page != Page.layouts && root.page != Page.settings && !LayoutLibrary.automatic
        && LayoutLibrary.current-label != "" && LayoutLibrary.current-label != LayoutLibrary.active-label;


    shortcut-focus := FocusScope {
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        capture-key-pressed(event) => {
            if event.text == Key.F1 { root.focus-help = KeyboardFocus.describe(); if root.focus-help != "" { focus-help-popup.show(); } return accept; }
            if focus-help-popup.is-open && event.text == Key.Escape { focus-help-popup.close(); return accept; }
            if event.text == Key.Escape && (DragDrop.dragging || PaletteDrag.active) { DragDrop.cancel(); return accept; }
            if InlineEditors.window-active && event.text == Key.Escape {
                if ActionPicker.opened {
                    if ActionPicker.capturing { return reject; }
                    ActionPicker.dismiss-picker(); return accept;
                }
                if DeviceDialog.open { DeviceDialog.open = false; return accept; }
                if SettingsEditor.full-command != "" { SettingsEditor.full-command = ""; return accept; }
                if AppEntryDialog.editing || AppEntryDialog.removing { AppEntryDialog.close(); return accept; }
                if LayersEditor.delete-extra >= 0 { LayersEditor.delete-extra = -1; return accept; }
                if LayersEditor.dialog != LayerDialog.none { LayersEditor.dialog = LayerDialog.none; return accept; }
                if RulesEditor.dialog != RuleDialog.none { RulesEditor.dialog = RuleDialog.none; return accept; }
                if LayoutLibrary.save-as-open { LayoutLibrary.save-as-open = false; return accept; }
                if LayoutLibrary.dialog != LibraryDialog.none { LayoutLibrary.cancel-dialog(); return accept; }
                if root.confirm-discard || root.confirm-close { root.confirm-discard = false; root.confirm-close = false; return accept; }
            }
            if InlineEditors.window-active && !root.modal-open && event.modifiers.control && event.text.to-lowercase() == "s" && LayoutLibrary.editor-open {
                if LayoutLibrary.flush-drafts() && LayoutLibrary.dirty { LayoutLibrary.save-current(); }
                return accept;
            }
            return reject;
        }
    FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.modal-open;
        VerticalLayout {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                height: 54px;
                background: Theme.card;
                HorizontalLayout {
                    accessible-role: tab-list; accessible-label: @tr("Settings");
                    padding-left: Theme.space-xl; padding-right: Theme.space-xl; padding-top: Theme.space-m; padding-bottom: Theme.space-m; spacing: Theme.space-m;
                    VerticalLayout { alignment: center; layouts-navigation := NavButton { compact: root.compact-header; icon: @image-url("icons/keyboard.svg"); text: @tr("Layouts"); selected: root.page == Page.layouts; clicked => { root.navigate(Page.layouts, MenuKind.emoji); } } }
                    VerticalLayout { alignment: center; settings-navigation := NavButton { compact: root.compact-header; icon: @image-url("icons/settings-2.svg"); text: @tr("Settings"); selected: root.page == Page.settings; clicked => { root.navigate(Page.settings, MenuKind.emoji); } } }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: root.compact-header ? 0px : 120px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.space-xs;
                            if AppState.in-development && !root.compact-header: TextField { clearable: true; preferred-width: 200px; min-width: 120px; max-width: 200px; horizontal-stretch: 1; text <=> root.test-text; placeholder-text: @tr("Type to test..."); accessible-label: @tr("Type to test..."); }
                        }
                    }
                    if AppState.in-development: VerticalLayout { alignment: center; Badge {
                        min-width: 40px;
                        text: AppState.keyboard-language == "" ? "—" : AppState.keyboard-language;
                        Tooltip { TooltipText { text: @tr("Current keyboard layout in the system") + "\n" + AppState.keyboard-language; } }
                    }
                    }
                    if AppState.in-development: GameModeButton {}
                    active-layout := Rectangle {
                        accessible-role: button;
                        accessible-label: LayoutLibrary.active-label == "" ? @tr("No active layout") : @tr("Active: {}", LayoutLibrary.active-label);
                        accessible-expandable: !LayoutLibrary.automatic;
                        accessible-expanded: active-menu.is-open;
                        accessible-action-default => { if !LayoutLibrary.automatic { LayoutLibrary.refresh(); active-menu.show(); } }
                        active-focus := FocusScope {
                            enabled: !LayoutLibrary.automatic;
                            key-pressed(event) => {
                                if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow { LayoutLibrary.refresh(); active-menu.show(); return accept; }
                                return reject;
                            }
                        }
                        Rectangle { border-width: active-focus.has-focus ? 2px : 0px; border-color: Theme.focus; border-radius: Theme.radius; }
                        width: root.compact-header ? 150px : 180px; height: Theme.control-height-l; border-radius: Theme.radius; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                        HorizontalLayout { padding: Theme.space-m; spacing: Theme.space-s;
                            Image { width: 14px; source: @image-url("icons/keyboard.svg"); colorize: Theme.muted; }
                            Text { accessible-live-region: polite; text: LayoutLibrary.active-label == "" ? @tr("No active layout") : @tr("Active: {}", LayoutLibrary.active-label); color: Theme.text; overflow: elide; vertical-alignment: center; }
                            if !LayoutLibrary.automatic: Image { width: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; }
                        }
                        TouchArea { enabled: !LayoutLibrary.automatic; mouse-cursor: pointer; clicked => { active-focus.focus(); LayoutLibrary.refresh(); active-menu.show(); } }
                        Tooltip { TooltipText { text: LayoutLibrary.automatic ? @tr("Current active layout (selected automatically by switching rules)") : @tr("Current active layout — click to switch"); } }
                    }
                    Rectangle { width: 1px; background: Theme.divider; }
                    VerticalLayout { alignment: center; MapperToggle {
                        compact: root.compact-header;
                        text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Stop") : @tr("Start");
                        running: AppState.mapper-running;
                        busy: AppState.mapper-busy;
                        enabled: AppState.mapper-supported && (AppState.mapper-running || AppState.keyboard-selected);
                        tooltip: AppState.mapper-running
                            ? @tr("Stop mapper (restore native keyboard behavior)")
                            : !AppState.keyboard-selected
                            ? @tr("Select a keyboard device in the settings to start the mapper")
                            : @tr("Start mapper to intercept keys and apply layouts");
                        toggled => { AppState.toggle-mapper(); }
                    } }
                }
            }
            Divider {}
            if LayoutLibrary.editor-open: Rectangle {
                height: 50px + (editor-tabs.viewport-width > editor-tabs.visible-width ? Theme.scrollbar-size + Theme.scrollbar-gap : 0px);
                background: Theme.card;
                HorizontalLayout {
                    padding-left: Theme.space-xl; padding-right: Theme.space-xl; spacing: Theme.space-m;
                    Text { text: LayoutLibrary.current-label == "" ? @tr("Custom layout") : LayoutLibrary.current-label; color: Theme.text; max-width: 200px; overflow: elide; vertical-alignment: center; }
                    VerticalLayout { alignment: center; SaveSplitButton {
                        enabled: LayoutLibrary.dirty || MacroEditor.has-unsaved-changes || MenuEditor.has-unsaved-changes;
                        save => { LayoutLibrary.save-current(); }
                        discard => { root.confirm-discard = true; }
                        save-as => { LayoutLibrary.save-as-name = ""; LayoutLibrary.save-as-open = true; }
                    } }
                    Rectangle { width: 16px; }
                    editor-tabs := ScrollView {
                        accessible-role: tab-list;
                        accessible-label: @tr("Layout");
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: as-needed;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        min-height: 0px;
                        viewport-height: self.visible-height;
                        HorizontalLayout {
                            spacing: Theme.space-2xs; alignment: start;
                            NavTab { icon: @image-url("icons/settings-2.svg"); text: @tr("Triggers") + (LayoutLibrary.rules-dirty ? " •" : ""); selected: root.page == Page.rules; clicked => { root.navigate(Page.rules, MenuKind.emoji); } }
                            NavTab { icon: @image-url("icons/keyboard.svg"); text: @tr("Layers") + (LayoutLibrary.layers-dirty ? " •" : ""); selected: root.page == Page.keyboard || root.page == Page.layers; clicked => { root.navigate(Page.layers, MenuKind.emoji); } }
                            if AppState.in-development: NavTab { icon: @image-url("icons/smile.svg"); text: @tr("Emoji") + (LayoutLibrary.emoji-dirty ? " •" : ""); selected: root.page == Page.menus && MenuEditor.kind == MenuKind.emoji; clicked => { root.navigate(Page.menus, MenuKind.emoji); } }
                            if AppState.in-development: NavTab { icon: @image-url("icons/zap.svg"); text: @tr("Quick actions") + (LayoutLibrary.quick-dirty ? " •" : ""); selected: root.page == Page.menus && MenuEditor.kind == MenuKind.quick; clicked => { root.navigate(Page.menus, MenuKind.quick); } }
                            if AppState.in-development: NavTab { icon: @image-url("icons/clock.svg"); text: @tr("Macros") + ((LayoutLibrary.macros-dirty || MacroEditor.has-errors) ? " •" : ""); selected: root.page == Page.macros; clicked => { root.navigate(Page.macros, MenuKind.emoji); } }
                        }
                    }
                    VerticalLayout { alignment: center; IconButton { icon: @image-url("icons/x.svg"); label: @tr("Close layout"); clicked => { root.close-layout(); } } }
                }
            }
            if LayoutLibrary.editor-open: Divider {}
            if root.show-active-banner: Rectangle {
                background: Theme.card;
                HorizontalLayout {
                    padding-left: Theme.space-xl; padding-right: Theme.space-xl; padding-top: Theme.space-s; padding-bottom: Theme.space-s; spacing: Theme.space-m;
                    Text {
                        text: LayoutLibrary.active-label == ""
                            ? @tr("You are editing “{}”; no layout is active.", LayoutLibrary.current-label)
                            : @tr("You are editing “{}”, but “{}” is active.", LayoutLibrary.current-label, LayoutLibrary.active-label);
                        color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                    Button { text: @tr("Make active"); clicked => { LayoutLibrary.activate-current(); } }
                }
            }
            if root.show-active-banner: Divider {}
            VerticalLayout {
                accessible-role: tab-panel;
                accessible-label: root.page == Page.layouts ? @tr("Layouts") : root.page == Page.settings ? @tr("Settings") : root.page == Page.rules ? @tr("Triggers") : root.page == Page.macros ? @tr("Macros") : root.page == Page.menus ? (MenuEditor.kind == MenuKind.emoji ? @tr("Emoji") : @tr("Quick actions")) : @tr("Layers");
                vertical-stretch: 1;
                padding: Theme.page-padding;
                // Pages scroll to the window edge; their content keeps the bottom gap (PageContent).
                padding-bottom: 0px;
                spacing: Theme.space-l;
                if root.problem.id != "": Text { accessible-live-region: assertive; text: Locale.text(root.problem); color: NotificationCenter.is-warning(root.problem.id) ? Theme.warning : Theme.error; wrap: word-wrap; max-height: 96px; overflow: elide; }
                if root.page == Page.layouts: LibraryPage {}
                if root.page == Page.settings: SettingsPage {}
                if root.page == Page.rules: RulesPage {}
                if root.page == Page.layers || root.page == Page.keyboard: LayersPage {}
                if AppState.in-development && root.page == Page.macros: MacrosPage {}
                if AppState.in-development && root.page == Page.menus: MenusPage {}
            }
        }
    }
    focus-help-popup := PopupWindow {
        width: min(Theme.text-tooltip, root.width - 64px) + 2 * Theme.space-xs;
        x: (root.width - self.width) / 2; y: 64px;
        forward-focus: help-focus;
        MenuSurface {
            help-focus := FocusScope {
                accessible-role: groupbox;
                accessible-label: root.focus-help;
                key-pressed(event) => {
                    if event.text == Key.Escape || event.text == Key.Return || event.text == " " { focus-help-popup.close(); return accept; }
                    return reject;
                }
                Text { width: min(Theme.text-tooltip, root.width - 64px); text: root.focus-help; color: Theme.text; wrap: word-wrap; }
            }
        }
    }
    active-menu := PopupWindow {
        x: active-layout.absolute-position.x; y: active-layout.absolute-position.y + active-layout.height + Theme.menu-offset; width: 240px;
        MenuSurface {
            for name[index] in LayoutLibrary.names: MenuItem {
                text: name; checked: name == LayoutLibrary.active-label;
                clicked => { active-menu.close(); LayoutLibrary.select(index); LayoutLibrary.action(LibraryAction.activate); }
            }
        }
    }
    if root.confirm-discard || root.confirm-close: ConfirmDialog {
        width: 100%; height: 100%;
        title: @tr("Discard layout changes?");
        body: @tr("Unsaved changes to this layout will be lost.");
        confirm-text: @tr("Discard");
        cancel => { root.confirm-discard = false; root.confirm-close = false; }
        confirm => {
            InlineEditors.revision += 1; LayoutLibrary.discard-current();
            if root.confirm-close && !LayoutLibrary.dirty { LayoutLibrary.editor-open = false; if root.page != Page.settings && root.page != Page.layouts { root.navigate(Page.layouts, MenuKind.emoji); } }
            root.confirm-discard = false; root.confirm-close = false;
        }
    }
    if LayoutLibrary.dialog == LibraryDialog.conflict: DialogFrame {
        title: @tr("Layout changed on disk");
        close => { LayoutLibrary.cancel-dialog(); }
        Text {
            text: @tr("The file of “{}” was changed by another program after you opened it. Your edits are kept until you choose what to do.", LayoutLibrary.current-label);
            color: Theme.text; wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-m;
            alignment: end;
            Button { text: @tr("Cancel"); clicked => { LayoutLibrary.cancel-dialog(); } }
            Button {
                text: @tr("Load from disk");
                clicked => {
                    LayoutLibrary.cancel-dialog();
                    InlineEditors.revision += 1; LayoutLibrary.discard-current();
                }
            }
            Button {
                text: @tr("Save as new…");
                clicked => {
                    LayoutLibrary.cancel-dialog();
                    LayoutLibrary.save-as-name = LayoutLibrary.suggest-name(LayoutLibrary.current-label);
                    LayoutLibrary.save-as-open = true;
                }
            }
            Button { text: @tr("Overwrite"); primary: true; clicked => { LayoutLibrary.overwrite-current(); } }
        }
    }
    LibraryDialogOverlay {}
    RuleDialogOverlay {}
    LayerDialogOverlay {}
    AppEntryOverlay { width: 100%; height: 100%; }
    CommandDialogOverlay {}
    if DeviceDialog.open: DeviceDialogOverlay {
        mouse: DeviceDialog.mouse;
        choices: DeviceDialog.mouse ? SettingsEditor.mouse-devices : SettingsEditor.input-devices;
        current: DeviceDialog.mouse ? SettingsEditor.mouse-device-path : SettingsEditor.keyboard-device-path;
        manual-allowed: !AppState.is-windows;
        enabled: AppState.mapper-supported && !AppState.mapper-busy;
        refresh => { SettingsEditor.refresh-devices(); }
        close => { DeviceDialog.open = false; }
        chosen(path) => {
            if path != self.current {
                if DeviceDialog.mouse { SettingsEditor.select-mouse(path); } else { SettingsEditor.select-device(path); }
                if SettingsEditor.message.id == "" { AppState.devices-changed(); }
            }
            DeviceDialog.open = false;
        }
    }
    if ActionPicker.opened: PickerOverlay {}
    ToastStack {
        stack-height-limit: parent.height - 40px;
        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;
        width: min(420px, parent.width - 40px);
    }
    }
}
