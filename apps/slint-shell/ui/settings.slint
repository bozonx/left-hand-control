import { ScrollView } from "scroll.slint";
import { ActionPicker, PickerOverlay } from "action-picker.slint";
import { AppState } from "app-state.slint";
import { GameModeButton } from "game-mode.slint";
import { LayerDialogOverlay, LayersEditor, LayersPage } from "layers.slint";
import { LayoutLibrary, LibraryDialogOverlay, LibraryPage, SaveSplitButton } from "library.slint";
import { MacroEditor, MacrosPage } from "macros.slint";
import { MenuEditor, MenusPage } from "menus.slint";
import { RuleDialogOverlay, RulesEditor, RulesPage } from "rules.slint";
import { DragDrop } from "reorder.slint";
import { SettingsPage, SettingsEditor } from "settings-page.slint";
import { Badge, InlineEditors, IconButton } from "controls.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { LayerDialog, LibraryDialog, LibraryAction, MenuKind, Page, RuleDialog } from "types.slint";
import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    background: Theme.surface;
    default-font-size: 14px;
    title: @tr("Left Hand Control");
    preferred-width: 1120px;
    preferred-height: 760px;
    min-width: 940px;
    max-width: 100000px;
    min-height: 700px;
    in-out property <Page> page: Page.layouts;
    private property <string> test-text;

    public function navigate(page: Page, kind: MenuKind) {
        InlineEditors.commit-revision += 1;
        DragDrop.reset();
        if page == Page.layouts { LayoutLibrary.refresh(); }
        if page == Page.menus { MenuEditor.open(kind); }
        root.page = page;
    }

    property <bool> modal-open: ActionPicker.opened || RulesEditor.dialog != RuleDialog.none || LayersEditor.dialog != LayerDialog.none || LayersEditor.delete-extra >= 0
        || LayoutLibrary.save-as-open || LayoutLibrary.dialog != LibraryDialog.none;
    property <bool> show-active-banner: root.page != Page.layouts && root.page != Page.settings && !LayoutLibrary.automatic
        && LayoutLibrary.current-label != "" && LayoutLibrary.current-label != LayoutLibrary.active-label;

    FocusScope {
        focus-on-tab-navigation: false;
        enabled: !root.modal-open;
        VerticalBox {
            padding: 0px;
            spacing: 0px;
            Rectangle {
                height: 54px;
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                    Button { text: @tr("Layouts"); primary: root.page == Page.layouts; clicked => { root.navigate(Page.layouts, MenuKind.emoji); } }
                    Button { text: @tr("Settings"); primary: root.page == Page.settings; clicked => { root.navigate(Page.settings, MenuKind.emoji); } }
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 180px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            LineEdit { preferred-width: 200px; min-width: 120px; max-width: 200px; horizontal-stretch: 1; text <=> root.test-text; placeholder-text: @tr("Type to test..."); }
                        }
                    }
                    VerticalLayout { alignment: center; Badge {
                        text: AppState.keyboard-language == "" ? "—" : AppState.keyboard-language;
                        Tooltip { Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 4px; HorizontalLayout { padding: 8px; Text { text: @tr("Current keyboard layout in the system"); color: Theme.text; } } } }
                    }
                    }
                    GameModeButton {}
                    active-layout := Rectangle {
                        width: 180px; height: 36px; border-radius: 6px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                        HorizontalLayout { padding: 8px; spacing: 6px;
                            Image { width: 14px; source: @image-url("icons/keyboard.svg"); colorize: Theme.muted; }
                            Text { text: LayoutLibrary.active-label == "" ? @tr("No active layout") : @tr("Active: {}", LayoutLibrary.active-label); color: Theme.text; overflow: elide; vertical-alignment: center; }
                            if !LayoutLibrary.automatic: Image { width: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.muted; }
                        }
                        TouchArea { enabled: !LayoutLibrary.automatic; mouse-cursor: pointer; clicked => { LayoutLibrary.refresh(); active-menu.show(); } }
                        Tooltip { Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 4px; HorizontalLayout { padding: 8px; Text { text: LayoutLibrary.automatic ? @tr("Current active layout (automatic)") : @tr("Current active layout — click to switch"); color: Theme.text; } } } }
                    }
                    Button {
                        text: AppState.mapper-busy ? @tr("Please wait…") : AppState.mapper-running ? @tr("Stop") : @tr("Start");
                        primary: true;
                        icon: AppState.mapper-running ? @image-url("icons/square.svg") : @image-url("icons/play.svg");
                        colorize-icon: true;
                        enabled: !AppState.mapper-busy;
                        clicked => { AppState.toggle-mapper(); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle {
                height: 58px + (editor-tabs.viewport-width > editor-tabs.visible-width ? Theme.scrollbar-size + Theme.scrollbar-gap : 0px);
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 8px; padding-bottom: 8px; spacing: 8px;
                    Text { text: LayoutLibrary.current-label == "" ? @tr("Custom layout") : LayoutLibrary.current-label; color: Theme.text; max-width: 200px; overflow: elide; vertical-alignment: center; }
                    SaveSplitButton {
                        enabled: LayoutLibrary.dirty;
                        save => { LayoutLibrary.save-current(); }
                        discard => { InlineEditors.revision += 1; LayoutLibrary.discard-current(); MacroEditor.refresh(); MenuEditor.refresh(); }
                        save-as => { LayoutLibrary.save-as-name = ""; LayoutLibrary.save-as-open = true; }
                    }
                    editor-tabs := ScrollView {
                        vertical-scrollbar-policy: always-off;
                        horizontal-scrollbar-policy: as-needed;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        min-height: 0px;
                        viewport-height: self.visible-height;
                        HorizontalLayout {
                            spacing: 8px; alignment: center;
                            IconButton { height: 38px; icon: @image-url("icons/settings-2.svg"); text: @tr("Rules") + (LayoutLibrary.rules-dirty ? " •" : ""); primary: root.page == Page.rules; clicked => { root.navigate(Page.rules, MenuKind.emoji); } }
                            IconButton { height: 38px; icon: @image-url("icons/keyboard.svg"); text: @tr("Layers") + (LayoutLibrary.layers-dirty ? " •" : ""); primary: root.page == Page.keyboard || root.page == Page.layers; clicked => { root.navigate(Page.layers, MenuKind.emoji); } }
                            IconButton { height: 38px; icon: @image-url("icons/smile.svg"); text: @tr("Emoji") + (LayoutLibrary.emoji-dirty ? " •" : ""); primary: root.page == Page.menus && MenuEditor.kind == MenuKind.emoji; clicked => { root.navigate(Page.menus, MenuKind.emoji); } }
                            IconButton { height: 38px; icon: @image-url("icons/zap.svg"); text: @tr("Quick actions") + (LayoutLibrary.quick-dirty ? " •" : ""); primary: root.page == Page.menus && MenuEditor.kind == MenuKind.quick; clicked => { root.navigate(Page.menus, MenuKind.quick); } }
                            IconButton { height: 38px; icon: @image-url("icons/clock.svg"); text: @tr("Macros") + ((LayoutLibrary.macros-dirty || MacroEditor.has-errors) ? " •" : ""); primary: root.page == Page.macros; clicked => { root.navigate(Page.macros, MenuKind.emoji); } }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.show-active-banner: Rectangle {
                background: Theme.card;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; padding-top: 6px; padding-bottom: 6px; spacing: 8px;
                    Text {
                        text: LayoutLibrary.active-label == ""
                            ? @tr("You are editing “{}”; no layout is active.", LayoutLibrary.current-label)
                            : @tr("You are editing “{}”, but “{}” is active.", LayoutLibrary.current-label, LayoutLibrary.active-label);
                        color: Theme.muted; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                    }
                    Button { text: @tr("Make active"); clicked => { LayoutLibrary.activate-current(); } }
                }
            }
            if root.show-active-banner: Rectangle { height: 1px; background: Theme.border; }
            VerticalLayout {
                vertical-stretch: 1;
                padding: Theme.page-padding;
                spacing: 12px;
                if root.page == Page.layouts: LibraryPage {}
                if root.page == Page.settings: SettingsPage {}
                if root.page == Page.rules: RulesPage {}
                if root.page == Page.layers || root.page == Page.keyboard: LayersPage {}
                if root.page == Page.macros: MacrosPage {}
                if root.page == Page.menus: MenusPage {}
            }
        }
    }
    property <Message> toast;
    function notify(message: Message) {
        if message.id != "" && message.id != "library-saved" && message.id != "layer-saved" && message.id != "rule-saved" && message.id != "action-saved" && message.id != "settings-saved" && message.id != "device-saved" && message.id != "config-saved" {
            root.toast = message;
            toast-timer.restart();
        }
    }
    property <Message> config-notification: AppState.config-status;
    changed config-notification => { if AppState.config-status.id == "config-unavailable" || AppState.config-status.id == "config-external-change" { root.notify(AppState.config-status); } }
    property <Message> shell-status: AppState.status;
    changed shell-status => { if AppState.status.id == "select-input-device" || AppState.status.id == "saved-mapper-not-updated" || ((AppState.status.id == "mapper-running" || AppState.status.id == "mapper-stopped") && AppState.status.arg != "") { root.notify(AppState.status); } }
    property <Message> notification-0: LayersEditor.status;
    changed notification-0 => { root.notify(LayersEditor.status); }
    property <Message> notification-1: RulesEditor.status;
    changed notification-1 => { root.notify(RulesEditor.status); }
    property <Message> notification-2: LayoutLibrary.status;
    changed notification-2 => { root.notify(LayoutLibrary.status); }
    property <Message> notification-3: MacroEditor.status;
    changed notification-3 => { root.notify(MacroEditor.status); }
    property <Message> notification-4: MenuEditor.status;
    changed notification-4 => { root.notify(MenuEditor.status); }
    property <Message> notification-5: SettingsEditor.message;
    changed notification-5 => { root.notify(SettingsEditor.message); }
    property <Message> notification-6: AppState.backend-error;
    changed notification-6 => { root.notify(AppState.backend-error); }
    toast-timer := Timer { interval: 6000ms; running: false; triggered => { root.toast = { id: "", arg: "", count: 0 }; self.stop(); } }
    active-menu := PopupWindow {
        x: active-layout.absolute-position.x; y: 52px; width: 240px;
        Rectangle { background: Theme.card; border-width: 1px; border-color: Theme.border; border-radius: 8px;
            VerticalLayout { padding: 6px; spacing: 4px;
                for name[index] in LayoutLibrary.names: Button {
                    text: name; primary: name == LayoutLibrary.active-label;
                    clicked => { active-menu.close(); LayoutLibrary.select(index); LayoutLibrary.action(LibraryAction.activate); }
                }
            }
        }
    }
    LibraryDialogOverlay {}
    RuleDialogOverlay {}
    LayerDialogOverlay {}
    if ActionPicker.opened: PickerOverlay {}
    if root.toast.id != "": Rectangle {
        x: parent.width - self.width - 20px; y: parent.height - self.height - 20px;
        width: 420px; height: toast-layout.preferred-height;
        background: Theme.card; border-color: Theme.error; border-width: 1px; border-radius: 8px;
        toast-layout := HorizontalLayout { padding: 16px; spacing: 12px;
            Text { text: Locale.text(root.toast); color: Theme.error; wrap: word-wrap; horizontal-stretch: 1; }
            Button { text: "×"; clicked => { root.toast = { id: "", arg: "", count: 0 }; } }
        }
    }
}
