import { Message } from "i18n.slint";
import { GameModeControl } from "types.slint";

/// Shell state shown on several pages: mapper, runtime context and the
/// messages that are not tied to one page.
export global AppState {
    in property <bool> in-development;
    in property <bool> mapper-running;
    in property <bool> mapper-busy;
    /// A keyboard device is chosen, so the mapper can start.
    in property <bool> keyboard-selected;
    /// Why the mapper failed to start or stopped; empty when it is fine.
    in property <Message> mapper-error;
    /// Whole minutes the mapper has been running; -1 when stopped.
    in property <int> mapper-uptime: -1;
    /// After the mapper stopped by itself: whole minutes it ran and
    /// minutes since it stopped; -1 otherwise.
    in property <int> mapper-ran: -1;
    in property <int> mapper-stopped-ago: -1;
    in property <bool> game-active;
    in property <bool> game-state-available;
    in property <GameModeControl> game-control: GameModeControl.auto;
    in property <Message> game-status;
    in property <Message> game-auto-status;
    in property <Message> game-daemon-availability;
    in property <Message> game-fullscreen-availability;
    in property <Message> game-processes-availability;
    in property <Message> game-window-availability;
    /// Known-game sources; "capability-unsupported" hides a source on this OS.
    in property <Message> game-steam-availability;
    in property <Message> game-lutris-availability;
    in property <Message> game-heroic-availability;
    in property <Message> game-umu-availability;
    in property <Message> game-gamescope-availability;
    in property <Message> game-category-availability;
    in property <Message> game-bar-availability;
    /// Tool window detection needs but cannot find, e.g. "kdotool".
    in property <string> game-missing-tool;
    in property <string> keyboard-language;
    in property <bool> is-linux;
    in property <bool> is-windows;
    /// This OS has a mapper backend.
    in property <bool> mapper-supported;
    /// Launch on startup can be registered on this OS.
    in property <bool> autostart-supported;
    in property <Message> status;
    in property <Message> backend-error;
    in property <Message> config-status;
    callback toggle-mapper();
    /// Restart a running mapper after its devices changed.
    callback restart-mapper();
    /// Open the settings tab where the keyboard device is chosen.
    callback open-keyboard-settings();
    callback set-game-control(GameModeControl);
}
