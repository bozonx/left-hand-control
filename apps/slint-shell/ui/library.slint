import { DragDrop, DragHandle, DropMarker } from "reorder.slint";
import { ScrollView } from "scroll.slint";
import { ButtonGroup, InfoTip, InlineTextField, InlineTextArea, ItemStyle, IconButton, ConfirmDialog } from "controls.slint";
import { ConditionChoices, ConditionsForm } from "conditions.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { GameCondition, LayoutSource, LibraryAction, LibraryDialog, NameIssue, PendingLayoutAction } from "types.slint";
import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, Palette, TextEdit, VerticalBox } from "std-widgets.slint";

export struct LayoutSummary { rules: int, layers: int, emoji-pages: int, action-pages: int, macros: int, commands: int }

/// One automatic-mode rule. `target` indexes `names`; -1 means no layout.
/// `shadowed-by` is the earlier rule that always matches first, or -1;
/// `unknown-languages` lists languages the system does not have.
export struct AutoRuleView { game: GameCondition, list: string, target: int, missing: bool, enabled: bool, shadowed-by: int, unknown-languages: string }

/// The layout library and the working copy being edited.
export global LayoutLibrary {
    in property <[string]> names;
    in property <[string]> descriptions;
    in property <[LayoutSummary]> summaries;
    /// Automatic mode: ordered rules, the default (-1 is off), the rule
    /// that applies now (-1 is the default) and rules per layout.
    in property <[AutoRuleView]> auto-rules;
    in property <int> auto-default: -1;
    in property <bool> auto-default-missing;
    in property <int> auto-matched: -1;
    in property <[int]> rule-counts;
    /// Game mode detection works, so game-mode conditions can match.
    in property <bool> game-detection: true;
    /// Layout whose rules are highlighted in the rules panel, or -1.
    in-out property <int> highlight-target: -1;
    in-out property <int> selected: -1;
    in property <Message> status;
    in-out property <bool> automatic;
    /// Fields of the selected layout (details dialog).
    in-out property <string> name;
    in-out property <string> description;
    /// Rule being edited in the rule dialog; `rule-index` -1 is a new rule.
    in-out property <int> rule-index: -1;
    in-out property <int> rule-target: -1;
    in-out property <GameCondition> rule-game;
    in-out property <string> rule-layouts;
    in-out property <string> rule-apps;
    in-out property <LibraryDialog> dialog: LibraryDialog.none;
    in-out property <string> create-name;
    in-out property <string> create-description;
    in-out property <LayoutSource> create-source: LayoutSource.empty;
    in-out property <int> create-copy-index: 0;
    in-out property <LayoutSource> pending-create-source: LayoutSource.empty;
    in-out property <int> pending-create-copy-index: 0;
    in-out property <PendingLayoutAction> pending-action: PendingLayoutAction.none;
    /// Working copy: the library layout it came from and whether it changed.
    in property <string> current-label;
    in-out property <string> active-label;
    in property <bool> dirty;
    in property <bool> rules-dirty;
    in property <bool> layers-dirty;
    in property <bool> macros-dirty;
    in property <bool> quick-dirty;
    in property <bool> emoji-dirty;
    in property <bool> commands-dirty;
    in-out property <bool> save-as-open;
    in-out property <string> save-as-name;

    callback refresh();
    callback select(int);
    callback set-automatic(bool);
    callback action(LibraryAction);
    pure callback suggest-name(string) -> string;
    pure callback name-issue(string) -> NameIssue;
    callback create(string, string, LayoutSource, int);
    callback set-description(int, string);
    callback rename(int, string);
    callback reorder(int, int);
    callback row-position(int, length, length);
    callback drag-target(int, length) -> int;
    callback discard-current();
    callback activate-current();
    /// Replace the working copy with the selected layout.
    callback load();
    callback delete();
    /// Remember the library file of the working copy as its saved state.
    callback reset-context();
    /// Recompute `current-label` and `dirty`.
    callback refresh-context();
    callback save-current();
    callback save-as(string);
    /// Fill the rule dialog fields for rule `index` (-1: new rule using `target`).
    callback load-rule(int, int);
    callback save-rule();
    callback delete-rule(int);
    callback move-rule(int, int);
    callback set-auto-default(int);
    callback set-rule-enabled(int, bool);
    /// Add the ready-made rule "no layout while game mode is on".
    callback add-game-rule();

    pure function create-base(source: LayoutSource) -> string {
        if source == LayoutSource.author { return @tr("Ivan K layout"); }
        if source == LayoutSource.copy && self.create-copy-index < self.names.length {
            return @tr("{} (copy)", self.names[self.create-copy-index]);
        }
        return @tr("New layout");
    }
    function proceed-open-create(source: LayoutSource, copy-index: int) {
        self.create-source = source;
        self.create-copy-index = max(0, copy-index);
        self.create-description = "";
        self.create-name = self.suggest-name(self.create-base(source));
        self.dialog = LibraryDialog.create;
    }
    public function open-create(source: LayoutSource, copy-index: int) {
        self.pending-create-source = source;
        self.pending-create-copy-index = copy-index;
        self.guard-switch(PendingLayoutAction.create);
    }
    public function submit-create() {
        if self.name-issue(self.create-name) != NameIssue.ok { return; }
        self.create(self.create-name, self.create-description, self.create-source, self.create-copy-index);
    }
    public function continue-pending() {
        let action = self.pending-action;
        self.pending-action = PendingLayoutAction.none;
        if action == PendingLayoutAction.edit { self.dialog = LibraryDialog.none; self.load(); }
        if action == PendingLayoutAction.create {
            self.proceed-open-create(self.pending-create-source, self.pending-create-copy-index);
        }
    }
    // Replacing the working copy discards its unsaved edits, so ask first.
    function guard-switch(action: PendingLayoutAction) {
        self.pending-action = action;
        if self.dirty && !(action == PendingLayoutAction.edit && self.names[self.selected] == self.current-label) {
            self.dialog = LibraryDialog.unsaved;
        } else {
            self.continue-pending();
        }
    }
    public function save-and-continue() {
        self.save-current();
        if !self.dirty { self.continue-pending(); }
    }
    public function edit(index: int) {
        self.select(index);
        self.guard-switch(PendingLayoutAction.edit);
    }
    public function cancel-dialog() {
        self.dialog = LibraryDialog.none;
        self.pending-action = PendingLayoutAction.none;
    }
    public function open-rule(index: int, target: int) {
        ConditionChoices.refresh();
        self.load-rule(index, target);
    }
    /// Layout a new rule starts with: the default, else the first layout.
    public pure function new-rule-target() -> int {
        return self.auto-default >= 0 ? self.auto-default : self.names.length > 0 ? 0 : -1;
    }
    pure function game-text(game: GameCondition) -> string {
        return game == GameCondition.on ? @tr("game mode on") : game == GameCondition.off ? @tr("game mode off") : "";
    }
    public pure function rule-text(game: GameCondition, list: string) -> string {
        if self.game-text(game) == "" && list == "" { return @tr("Always"); }
        return self.game-text(game) != "" && list != "" ? self.game-text(game) + " · " + list : self.game-text(game) + list;
    }
    public pure function target-text(target: int) -> string {
        return target >= 0 && target < self.names.length ? self.names[target] : @tr("No layout");
    }
}

component LayoutMenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();
    height: 32px;
    border-radius: 4px;
    background: enabled && (touch.has-hover || focus.has-focus) ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Text {
        x: 12px; width: parent.width - 24px; height: parent.height;
        text: root.text; color: root.danger ? Theme.error : Theme.text;
        opacity: root.enabled ? 1 : 0.45;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component SaveSplitButton inherits Rectangle {
    in property <bool> enabled: true;
    callback save();
    callback save-as();
    callback discard();
    width: 72px;
    height: 38px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.card;
        clip: true;
        HorizontalLayout {
            spacing: 0px;
            save-btn := Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                background: root.enabled ? Theme.link.transparentize(touch-save.has-hover ? 0.7 : 0.85) : transparent;
                accessible-role: button;
                accessible-label: @tr("Save");
                accessible-enabled: root.enabled;
                accessible-action-default => { if root.enabled { root.save(); } }
                HorizontalLayout { padding-left: 10px; padding-right: 8px; spacing: 6px; alignment: center;
                    VerticalLayout { alignment: center; Image { width: 18px; height: 18px; source: @image-url("icons/save.svg"); colorize: root.enabled ? Theme.link : Theme.muted; } }
                    VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.enabled ? Theme.link : transparent; } }
                }
                focus-save := FocusScope {
                    enabled: root.enabled;
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " { root.save(); return accept; }
                        return reject;
                    }
                }
                touch-save := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => { root.save(); }
                }
            }
            Rectangle {
                width: 1px;
                height: parent.height;
                background: Theme.divider;
            }
            chevron-btn := Rectangle {
                width: 26px;
                height: parent.height;
                background: touch-chevron.has-hover || focus-chevron.has-focus ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: @tr("Save as…");
                accessible-action-default => { save-menu.show(); }
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    source: @image-url("icons/chevron-down.svg");
                    colorize: Theme.text;
                }
                focus-chevron := FocusScope {
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " { save-menu.show(); return accept; }
                        return reject;
                    }
                }
                touch-chevron := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { save-menu.show(); }
                }
            }
        }
    }

    save-menu := PopupWindow {
        x: 0px;
        y: parent.height + 4px;
        width: 240px;
        Rectangle {
            background: Theme.card;
            border-color: Theme.border;
            border-width: 1px;
            border-radius: 8px;
            VerticalBox {
                padding: 4px;
                spacing: 0px;
                LayoutMenuItem {
                    text: @tr("Save as…");
                    clicked => {
                        save-menu.close();
                        root.save-as();
                    }
                }
                LayoutMenuItem { text: @tr("Reset current changes"); enabled: root.enabled; clicked => { save-menu.close(); root.discard(); } }
            }
        }
    }
}

/// Button choosing a library layout or "Off" (-1).
component TargetPicker inherits Rectangle {
    in property <int> target: -1;
    in property <bool> missing;
    callback picked(int);
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover || focus.has-focus ? Theme.hover : Theme.card;
    accessible-role: combobox;
    accessible-label: @tr("Layout");
    accessible-value: label.text;
    accessible-action-default => { menu.show(); }
    HorizontalLayout { padding-left: 10px; padding-right: 8px; spacing: 6px;
        label := Text {
            horizontal-stretch: 1;
            text: root.missing ? @tr("Layout not found") : LayoutLibrary.target-text(root.target);
            color: root.missing ? Theme.error : root.target < 0 ? Theme.muted : Theme.text;
            font-weight: root.target >= 0 ? 600 : 400;
            overflow: elide; vertical-alignment: center;
        }
        VerticalLayout { alignment: center;
            Image { width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.text; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { menu.show(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        y: root.height + 4px;
        width: max(root.width, 220px);
        Rectangle {
            background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
            VerticalBox { padding: 4px; spacing: 0px;
                LayoutMenuItem { text: @tr("No layout (keys as is)"); clicked => { menu.close(); root.picked(-1); } }
                Rectangle { height: 1px; background: Theme.divider; }
                for name[index] in LayoutLibrary.names: LayoutMenuItem { text: name; clicked => { menu.close(); root.picked(index); } }
            }
        }
    }
}

component AutoRuleRow inherits Rectangle {
    in property <AutoRuleView> rule;
    in property <int> index;
    in property <int> count;
    in property <bool> matched;
    property <bool> highlighted: LayoutLibrary.highlight-target >= 0 && LayoutLibrary.highlight-target == root.rule.target;
    border-radius: 6px;
    border-width: root.highlighted ? 2px : 1px;
    border-color: root.matched ? Theme.accent : root.highlighted ? Theme.link : Theme.divider;
    background: root.matched ? Theme.accent.transparentize(0.88) : touch.has-hover ? Theme.hover : transparent;
    height: row.preferred-height;
    accessible-role: button;
    accessible-label: @tr("Rule {}", root.index + 1) + ": " + LayoutLibrary.rule-text(root.rule.game, root.rule.list) + " → " + LayoutLibrary.target-text(root.rule.target);
    accessible-action-default => { LayoutLibrary.open-rule(root.index, root.rule.target); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { LayoutLibrary.open-rule(root.index, root.rule.target); } }
    row := HorizontalLayout { padding: 8px; spacing: 6px;
        VerticalLayout { alignment: start;
            DragHandle { group: 2; index: root.index; count: root.count; dropped(from, to) => { LayoutLibrary.move-rule(from, to); } }
        }
        VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 2px;
            opacity: root.rule.enabled ? 1 : 0.5;
            Text { text: (root.index + 1) + ". " + LayoutLibrary.rule-text(root.rule.game, root.rule.list); color: Theme.text; wrap: word-wrap; }
            HorizontalLayout { spacing: 4px; alignment: start;
                Text { text: "→"; color: Theme.muted; }
                Text {
                    text: root.rule.missing ? @tr("Layout not found") : LayoutLibrary.target-text(root.rule.target);
                    color: root.rule.missing ? Theme.error : root.rule.target < 0 ? Theme.muted : Theme.text;
                    font-weight: root.rule.target >= 0 ? 600 : 400;
                    overflow: elide;
                }
            }
            if root.rule.enabled && root.rule.shadowed-by >= 0: Text {
                text: @tr("Never applies: rule {} always matches first.", root.rule.shadowed-by + 1);
                color: Theme.warning; font-size: 12px; wrap: word-wrap;
            }
            if root.rule.enabled && root.rule.game != GameCondition.any && !LayoutLibrary.game-detection: Text {
                text: @tr("Game mode detection is off, so this rule never matches.");
                color: Theme.warning; font-size: 12px; wrap: word-wrap;
            }
            if root.rule.enabled && root.rule.unknown-languages != "": Text {
                text: @tr("Not among the system languages: {}", root.rule.unknown-languages);
                color: Theme.warning; font-size: 12px; wrap: word-wrap;
            }
        }
        VerticalLayout { alignment: start;
            CheckBox {
                accessible-label: @tr("Rule enabled");
                checked: root.rule.enabled;
                toggled => { LayoutLibrary.set-rule-enabled(root.index, self.checked); }
            }
        }
    }
    DropMarker { width: parent.width; group: 2; index: root.index; row-y: root.y; row-height: root.height; }
}

/// Automatic mode rules shown next to the library.
component AutoRulesPanel inherits Rectangle {
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.divider;
    VerticalLayout { padding: 14px; spacing: 10px;
        HorizontalLayout { spacing: 6px; vertical-stretch: 0;
            Text { text: @tr("Automatic switching"); color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
            VerticalLayout { alignment: center;
                InfoTip { text: @tr("Rules are checked from top to bottom; the first enabled one whose conditions match chooses the layout. If none matches, the default is used. “No layout” leaves the keyboard unprocessed, for example in an application where the layout gets in the way."); }
            }
        }
        Text {
            vertical-stretch: 0;
            text: LayoutLibrary.auto-matched >= 0 && LayoutLibrary.auto-matched < LayoutLibrary.auto-rules.length
                ? @tr("Now: {} (rule {}: {})", LayoutLibrary.active-label == "" ? @tr("No layout") : LayoutLibrary.active-label, LayoutLibrary.auto-matched + 1,
                    LayoutLibrary.rule-text(LayoutLibrary.auto-rules[LayoutLibrary.auto-matched].game, LayoutLibrary.auto-rules[LayoutLibrary.auto-matched].list))
                : @tr("Now: {} (default)", LayoutLibrary.active-label == "" ? @tr("No layout") : LayoutLibrary.active-label);
            color: Theme.accent; wrap: word-wrap;
        }
        ScrollView { viewport-width: self.visible-width;
            vertical-stretch: 1;
            VerticalLayout { spacing: 6px; alignment: start;
                if LayoutLibrary.auto-rules.length == 0: VerticalLayout { spacing: 8px;
                    Text {
                        text: @tr("No rules yet: the default layout is always used. Start with a common rule:");
                        color: Theme.muted; wrap: word-wrap;
                    }
                    HorizontalLayout { alignment: start;
                        Button { text: @tr("No layout in games"); clicked => { LayoutLibrary.add-game-rule(); } }
                    }
                    HorizontalLayout { alignment: start;
                        Button { text: @tr("No layout in an application…"); clicked => { LayoutLibrary.open-rule(-1, -1); } }
                    }
                }
                for rule[index] in LayoutLibrary.auto-rules: AutoRuleRow {
                    rule: rule; index: index; count: LayoutLibrary.auto-rules.length;
                    matched: LayoutLibrary.auto-matched == index;
                }
            }
        }
        HorizontalLayout { alignment: start; vertical-stretch: 0;
            Button { text: @tr("Add rule"); icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-rule(-1, LayoutLibrary.new-rule-target()); } }
        }
        Rectangle { height: 1px; background: Theme.divider; vertical-stretch: 0; }
        Rectangle {
            vertical-stretch: 0;
            border-radius: 6px;
            height: default-row.preferred-height;
            border-width: 1px;
            border-color: LayoutLibrary.auto-matched < 0 ? Theme.accent : transparent;
            background: LayoutLibrary.auto-matched < 0 ? Theme.accent.transparentize(0.88) : transparent;
            default-row := VerticalLayout { padding: 8px; spacing: 6px;
                Text { text: @tr("Otherwise (default)"); color: Theme.text; font-weight: 600; }
                TargetPicker {
                    target: LayoutLibrary.auto-default;
                    missing: LayoutLibrary.auto-default-missing;
                    picked(index) => { LayoutLibrary.set-auto-default(index); }
                }
                if LayoutLibrary.auto-default < 0 && !LayoutLibrary.auto-default-missing: Text {
                    text: @tr("When no rule matches, the keyboard works without processing.");
                    color: Theme.muted; font-size: 12px; wrap: word-wrap;
                }
            }
        }
    }
}

export component LibraryPage inherits VerticalBox {
    padding: 0px;
    spacing: 12px;
    private property <int> drag-from: -1;
    private property <int> drag-over: -1;
    HorizontalLayout {
        vertical-stretch: 0;
        spacing: 32px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: @tr("Mode"); color: Theme.text; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                InfoTip {
                    text: @tr("Single: the layout you make active works everywhere.") + "\n\n"
                        + @tr("Automatic: the layout is chosen by switching rules for the application, system language or game mode.");
                }
            }
            ButtonGroup {
                labels: [@tr("Single"), @tr("Auto")];
                selected-index: LayoutLibrary.automatic ? 1 : 0;
                selected(index) => { if (index == 1) != LayoutLibrary.automatic { LayoutLibrary.set-automatic(index == 1); } }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Create layout") + ":"; color: Theme.text; vertical-alignment: center; }
            Button { text: @tr("New"); primary: false; icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.empty, 0); } }
            Button { text: @tr("Based on Ivan K layout"); icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.author, 0); } }
        }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            if LayoutLibrary.names.length == 0: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center; spacing: 12px;
                    Text { text: @tr("No layouts yet"); color: Theme.text; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                    Text { text: @tr("Start from the author's Ivan K layout or from an empty one."); color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout { alignment: center; spacing: 8px;
                        Button { text: @tr("Create empty"); clicked => { LayoutLibrary.open-create(LayoutSource.empty, 0); } }
                        Button { text: @tr("Based on Ivan K layout"); icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.author, 0); } }
                    }
                }
            }
            if LayoutLibrary.names.length > 0: ScrollView { viewport-width: self.visible-width; drag-scroll: true;
                vertical-stretch: 1;
                VerticalLayout { padding: 0px; spacing: 0px;
                    for name[index] in LayoutLibrary.names: card := Rectangle {
                        property <bool> active: LayoutLibrary.active-label == name;
                        property <bool> current: LayoutLibrary.current-label == name;
                        property <bool> auto: LayoutLibrary.automatic;
                        height: max(132px, card-content.preferred-height + 10px);
                        init => { LayoutLibrary.row-position(index, self.y, self.height); }
                        changed y => { LayoutLibrary.row-position(index, self.y, self.height); }
                        changed height => { LayoutLibrary.row-position(index, self.y, self.height); }
                        Rectangle {
                        height: parent.height - 10px; width: parent.width;
                                background: Theme.card;
                        border-radius: 8px;
                        border-width: DragDrop.dragging && DragDrop.group == 0 && DragDrop.target == index ? 2px : card.active ? 2px : 1px;
                        border-color: card.active || (DragDrop.dragging && DragDrop.group == 0 && DragDrop.target == index) ? Theme.accent : Theme.divider;
                        TouchArea { double-clicked => { LayoutLibrary.edit(index); } }
                        card-content := HorizontalLayout { padding: 16px; spacing: 20px;
                            VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: 10px;
                                HorizontalLayout { spacing: 8px; vertical-stretch: 0;
                                    InlineTextField { min-width: 0px; text: name; text-size: 17px; text-weight: 600; label: @tr("Layout name"); saved(value) => { LayoutLibrary.rename(index, value); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    if card.auto && LayoutLibrary.auto-default == index: Text { text: @tr("Default"); color: Theme.accent; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                                    if card.auto && LayoutLibrary.rule-counts[index] > 0: Rectangle {
                                        property <bool> on: LayoutLibrary.highlight-target == index;
                                        width: badge.preferred-width + 12px;
                                        border-radius: 4px;
                                        background: self.on ? Theme.link.transparentize(0.85) : badge-touch.has-hover ? Theme.hover : transparent;
                                        accessible-role: button;
                                        accessible-label: badge.text;
                                        accessible-action-default => { LayoutLibrary.highlight-target = self.on ? -1 : index; }
                                        badge := Text {
                                            text: @tr("In {n} rule" | "In {n} rules" % LayoutLibrary.rule-counts[index]);
                                            color: parent.on ? Theme.link : Theme.muted; font-size: 13px; vertical-alignment: center;
                                        }
                                        badge-touch := TouchArea { mouse-cursor: pointer; clicked => { LayoutLibrary.highlight-target = parent.on ? -1 : index; } }
                                    }
                                }
                                InlineTextArea { text: LayoutLibrary.descriptions[index]; placeholder: @tr("Add a description…"); label: @tr("Description"); text-color: Theme.muted; saved(value) => { LayoutLibrary.set-description(index, value); } }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout { spacing: 8px; alignment: start; vertical-stretch: 0;
                                    DragHandle { group: 0; index: index; count: LayoutLibrary.names.length; dropped(from, to) => { LayoutLibrary.reorder(from, to); } }
                                    if card.active: Text { text: @tr("Active"); color: Theme.accent; font-weight: 600; vertical-alignment: center; }
                                    if !card.auto && !card.active: Button { text: @tr("Activate"); clicked => { LayoutLibrary.select(index); LayoutLibrary.action(LibraryAction.activate); } }
                                    if card.current: Text { text: LayoutLibrary.dirty ? @tr("Open for editing (unsaved)") : @tr("Open for editing"); color: Theme.text; vertical-alignment: center; }
                                    if !card.current: Button { text: @tr("Edit layout"); clicked => { LayoutLibrary.edit(index); } }
                                    Rectangle {
                                        width: 44px; height: 36px;
                                        Button {
                                            width: parent.width; height: parent.height; text: "…";
                                            clicked => { LayoutLibrary.select(index); more-menu.show(); }
                                        }
                                        more-menu := PopupWindow {
                                            x: parent.width - self.width; y: parent.height;
                                            width: 240px;
                                            Rectangle {
                                                background: Theme.card; border-color: Theme.border; border-width: 1px; border-radius: 8px;
                                                VerticalBox { padding: 4px; spacing: 0px;
                                                    LayoutMenuItem { text: @tr("Duplicate…"); clicked => { more-menu.close(); LayoutLibrary.open-create(LayoutSource.copy, index); } }
                                                    Rectangle { height: 1px; background: Theme.divider; }
                                                    LayoutMenuItem { text: @tr("Delete…"); clicked => { more-menu.close(); LayoutLibrary.dialog = LibraryDialog.delete; } }
                                                }
                                            }
                                        }
                                    }
                                    if card.auto: Button { text: @tr("Add rule…"); clicked => { LayoutLibrary.open-rule(-1, index); } }
                                }
                            }
                            VerticalLayout { width: 220px; spacing: 8px; alignment: start;
                                property <LayoutSummary> summary: LayoutLibrary.summaries[index];
                                if summary.rules + summary.layers + summary.emoji-pages + summary.action-pages + summary.macros + summary.commands == 0: Text { text: @tr("Empty layout"); color: Theme.muted; font-size: 13px; }
                                if summary.rules > 0: Text { text: @tr("{n} rule" | "{n} rules" % summary.rules); color: Theme.muted; font-size: 13px; }
                                if summary.layers > 0: Text { text: @tr("{n} layer" | "{n} layers" % summary.layers); color: Theme.muted; font-size: 13px; }
                                if summary.emoji-pages > 0: Text { text: @tr("{n} emoji page" | "{n} emoji pages" % summary.emoji-pages); color: Theme.muted; font-size: 13px; }
                                if summary.action-pages > 0: Text { text: @tr("{n} action page" | "{n} action pages" % summary.action-pages); color: Theme.muted; font-size: 13px; }
                                if summary.macros > 0: Text { text: @tr("{n} macro" | "{n} macros" % summary.macros); color: Theme.muted; font-size: 13px; }
                                // Commands run shell scripts, so they stand out when reviewing a layout.
                                if summary.commands > 0: HorizontalLayout { spacing: 6px; alignment: start;
                                    Image { width: 14px; height: 14px; y: (parent.height - self.height) / 2; source: @image-url("icons/triangle-alert.svg"); colorize: Theme.warning; }
                                    Text { text: @tr("{n} command" | "{n} commands" % summary.commands); color: Theme.warning; font-size: 13px; font-weight: 600; }
                                }
                            }
                        }
                        }
                        DropMarker { width: parent.width; group: 0; index: index; row-y: card.y; row-height: card.height; }
                    }
                }
            }
        }
        if LayoutLibrary.automatic: AutoRulesPanel { width: 340px; }
    }
}

export component LibraryDialogOverlay inherits Rectangle {
    if LayoutLibrary.dialog != LibraryDialog.none && LayoutLibrary.dialog != LibraryDialog.delete && LayoutLibrary.dialog != LibraryDialog.delete-rule: Rectangle {
        background: #00000099;
        TouchArea { }
        FocusScope {
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape { LayoutLibrary.cancel-dialog(); return accept; }
                return reject;
            }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 620px;
            height: LayoutLibrary.dialog == LibraryDialog.rule ? min(root.height - 48px, 700px)
                : LayoutLibrary.dialog == LibraryDialog.create ? 420px
                : LayoutLibrary.dialog == LibraryDialog.unsaved ? 210px
                : 210px;
            background: Theme.card; border-radius: 12px;
            VerticalBox { padding: 24px; spacing: 12px;
                Text {
                    text: LayoutLibrary.dialog == LibraryDialog.create ? @tr("New layout")
                        : LayoutLibrary.dialog == LibraryDialog.rule ? (LayoutLibrary.rule-index < 0 ? @tr("New rule") : @tr("Rule {}", LayoutLibrary.rule-index + 1))
                        : @tr("Unsaved changes");
                    color: Theme.text; font-size: 22px;
                }
                if LayoutLibrary.dialog == LibraryDialog.create: VerticalBox { padding: 0px; spacing: 10px;
                    Text { text: @tr("Name"); color: Theme.text; }
                    LineEdit {
                        text <=> LayoutLibrary.create-name;
                        placeholder-text: @tr("New layout name");
                        init => { self.focus(); self.select-all(); }
                        accepted => { LayoutLibrary.submit-create(); }
                    }
                    if LayoutLibrary.name-issue(LayoutLibrary.create-name) == NameIssue.taken || LayoutLibrary.name-issue(LayoutLibrary.create-name) == NameIssue.invalid: Text {
                        text: LayoutLibrary.name-issue(LayoutLibrary.create-name) == NameIssue.taken ? @tr("A layout with this name already exists.") : @tr("The name contains characters that cannot be used in a file name.");
                        color: Theme.error; wrap: word-wrap;
                    }
                    Text { text: @tr("Description (optional)"); color: Theme.text; }
                    TextEdit { text <=> LayoutLibrary.create-description; height: 120px; }
                }
                if LayoutLibrary.dialog == LibraryDialog.rule: ScrollView {
                    viewport-width: self.visible-width;
                    vertical-stretch: 1;
                    VerticalLayout { spacing: 12px;
                        Text { text: @tr("Use layout"); color: Theme.text; font-weight: 600; }
                        TargetPicker { target: LayoutLibrary.rule-target; picked(index) => { LayoutLibrary.rule-target = index; } }
                        Text { text: @tr("When"); color: Theme.text; font-weight: 600; }
                        ConditionsForm { game <=> LayoutLibrary.rule-game; languages <=> LayoutLibrary.rule-layouts; applications <=> LayoutLibrary.rule-apps; }
                        Text { text: @tr("All filled conditions must match. A rule without conditions always matches."); color: Theme.muted; wrap: word-wrap; }
                    }
                }
                if LayoutLibrary.dialog == LibraryDialog.unsaved: Text {
                    text: LayoutLibrary.current-label == ""
                        ? @tr("The layout you are editing has not been saved to the library. Its changes will be lost.")
                        : @tr("“{}” has unsaved changes. Save them before switching?", LayoutLibrary.current-label);
                    color: Theme.text; wrap: word-wrap;
                }
                if LayoutLibrary.status.id != "" && LayoutLibrary.status.id != "library-saved": Text { text: Locale.text(LayoutLibrary.status); color: Theme.error; wrap: word-wrap; }
                if LayoutLibrary.dialog != LibraryDialog.rule: Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    if LayoutLibrary.dialog == LibraryDialog.rule && LayoutLibrary.rule-index >= 0: Button {
                        text: @tr("Delete rule"); icon: @image-url("icons/trash-2.svg"); colorize-icon: true;
                        clicked => { LayoutLibrary.dialog = LibraryDialog.delete-rule; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { LayoutLibrary.cancel-dialog(); } }
                    if LayoutLibrary.dialog == LibraryDialog.create: Button { text: @tr("Create"); primary: true; enabled: LayoutLibrary.name-issue(LayoutLibrary.create-name) == NameIssue.ok; clicked => { LayoutLibrary.submit-create(); } }
                    if LayoutLibrary.dialog == LibraryDialog.rule: Button { text: @tr("Save"); primary: true; clicked => { LayoutLibrary.save-rule(); } }
                    if LayoutLibrary.dialog == LibraryDialog.unsaved: Button { text: @tr("Discard changes"); clicked => { LayoutLibrary.continue-pending(); } }
                    if LayoutLibrary.dialog == LibraryDialog.unsaved && LayoutLibrary.current-label != "": Button {
                        text: @tr("Save and continue"); primary: true;
                        clicked => { LayoutLibrary.save-and-continue(); }
                    }
                }
            }
        }
        }
    }
    if LayoutLibrary.dialog == LibraryDialog.delete: ConfirmDialog {
        title: @tr("Delete layout?");
        error: LayoutLibrary.status.id == "library-saved" ? "" : Locale.text(LayoutLibrary.status);
        body: @tr("“{}” will be deleted. This cannot be undone.", LayoutLibrary.names[LayoutLibrary.selected])
            + (LayoutLibrary.rule-counts[LayoutLibrary.selected] > 0
                ? " " + @tr("Its {n} automatic rule will be deleted too." | "Its {n} automatic rules will be deleted too." % LayoutLibrary.rule-counts[LayoutLibrary.selected])
                : "")
            + (LayoutLibrary.auto-default == LayoutLibrary.selected ? " " + @tr("Automatic mode will use no layout by default.") : "");
        confirm-text: @tr("Delete");
        cancel => { LayoutLibrary.cancel-dialog(); }
        confirm => { LayoutLibrary.delete(); }
    }
    if LayoutLibrary.dialog == LibraryDialog.delete-rule: ConfirmDialog {
        title: @tr("Delete rule {}?", LayoutLibrary.rule-index + 1);
        error: LayoutLibrary.status.id == "library-saved" ? "" : Locale.text(LayoutLibrary.status);
        body: @tr("The rule will be deleted. This cannot be undone.");
        confirm-text: @tr("Delete");
        cancel => { LayoutLibrary.dialog = LibraryDialog.rule; }
        confirm => { LayoutLibrary.delete-rule(LayoutLibrary.rule-index); }
    }
    if LayoutLibrary.save-as-open: Rectangle {
        background: #00000099;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 480px; height: 220px; background: Theme.card; border-radius: 12px;
            VerticalBox {
                padding: 24px; spacing: 12px;
                Text { text: @tr("Save layout as…"); color: Theme.text; font-size: 22px; }
                VerticalBox { padding: 0px; spacing: 4px;
                    Text { text: @tr("Layout name"); color: Theme.text; }
                    LineEdit { text <=> LayoutLibrary.save-as-name; accessible-label: @tr("Layout name"); accepted => { LayoutLibrary.save-as(LayoutLibrary.save-as-name); } }
                }
                Text { text: Locale.text(LayoutLibrary.status); color: Theme.error; wrap: word-wrap; }
                HorizontalBox { vertical-stretch: 0;
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Cancel"); clicked => { LayoutLibrary.save-as-open = false; } }
                    Button { text: @tr("Save"); enabled: LayoutLibrary.save-as-name != ""; clicked => { LayoutLibrary.save-as(LayoutLibrary.save-as-name); } }
                }
            }
        }
    }
}
