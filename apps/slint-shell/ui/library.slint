import { DragGroups, DragHandle, DropMarker } from "reorder.slint";
import { PageContent, ScrollView } from "scroll.slint";
import { ButtonGroup, FormField, InfoTip, InlineTextField, InlineTextArea, IconButton, ConfirmDialog, Divider, MenuSurface, MenuItem, DialogFrame, PageLayout, TooltipText, Card, CardTitle } from "controls.slint";
import { ConditionChoices, ConditionsForm } from "conditions.slint";
import { AppState } from "app-state.slint";
import { Theme } from "theme.slint";
import { Locale, Message } from "i18n.slint";
import { GameCondition, LayoutSource, LibraryAction, LibraryDialog, PendingLayoutAction } from "types.slint";
import { Button, CheckBox, ComboBox, Palette, TextEdit } from "std-widgets.slint";


export struct LayoutSummary { rules: int, layers: int, emoji-pages: int, action-pages: int, macros: int, commands: int }

export struct LayoutRow { id: string, name: string, description: string, summary: LayoutSummary, rule-count: int, loaded: bool, error: Message }

/// One automatic-mode rule. `target` indexes `names`; -1 means no layout.
/// `shadowed-by` is the earlier rule that always matches first, or -1;
/// `unknown-languages` lists languages the system does not have;
/// `excluded` lists the window patterns that block the rule.
export struct AutoRuleView { game: GameCondition, list: string, excluded: string, target: int, missing: bool, enabled: bool, shadowed-by: int, unknown-languages: string }

/// The layout library and the working copy being edited.
export global LayoutLibrary {
    in property <[LayoutRow]> rows;
    in-out property <int> metadata-revision;
    out property <[string]> names: self.row-names(self.rows);
    pure callback row-names([LayoutRow]) -> [string];
    /// Automatic mode: ordered rules, the default (-1 is off), the rule
    /// that applies now (-1 is the default) and rules per layout.
    in property <[AutoRuleView]> auto-rules;
    in property <int> auto-default: -1;
    in property <bool> auto-default-missing;
    in property <int> auto-matched: -1;
    /// Game mode detection works, so game-mode conditions can match.
    in property <bool> game-detection: true;
    /// Layout whose rules are highlighted in the rules panel, or -1.
    in-out property <int> highlight-target: -1;
    in-out property <int> selected: -1;
    in property <Message> status;
    in-out property <bool> automatic;
    /// Fields of the selected layout (details dialog).
    in-out property <string> name;
    in-out property <string> description;
    /// Rule being edited in the rule dialog; `rule-index` -1 is a new rule.
    in-out property <int> rule-index: -1;
    in-out property <int> rule-target: -1;
    in-out property <GameCondition> rule-game;
    in-out property <string> rule-layouts;
    in-out property <string> rule-apps;
    in-out property <string> rule-excluded;
    in-out property <LibraryDialog> dialog: LibraryDialog.none;
    in-out property <string> create-name;
    in-out property <string> create-description;
    /// Layouts shipped with the application, offered as templates.
    in property <[string]> bundled-names;
    in-out property <LayoutSource> create-source: LayoutSource.empty;
    /// Index of the source in `names` (copy) or `bundled-names` (bundled).
    in-out property <int> create-copy-index: 0;
    in-out property <LayoutSource> pending-create-source: LayoutSource.empty;
    in-out property <int> pending-create-copy-index: 0;
    in-out property <PendingLayoutAction> pending-action: PendingLayoutAction.none;
    /// Whether the working copy is currently open in the editor.
    in-out property <bool> editor-open: false;
    /// Working copy: the library layout it came from and whether it changed.
    in property <string> current-label;
    in-out property <string> active-label;
    in property <bool> dirty;
    in property <bool> rules-dirty;
    in property <bool> layers-dirty;
    in property <bool> macros-dirty;
    in property <bool> quick-dirty;
    in property <bool> emoji-dirty;
    in property <bool> commands-dirty;
    in-out property <bool> save-as-open;
    in-out property <string> save-as-name;

    callback refresh();
    callback select(int);
    callback set-automatic(bool);
    callback action(LibraryAction);
    pure callback suggest-name-value(string, [string]) -> string;
    public pure function suggest-name(base: string) -> string { return self.suggest-name-value(base, self.names); }
    /// Why `name` cannot be used for a layout; `except` is the layout being renamed, or "".
    pure callback name-error-value(name: string, except: string, names: [string]) -> Message;
    public pure function name-error(name: string, except: string) -> Message { return self.name-error-value(name, except, self.names); }
    callback create(string, string, LayoutSource, int);
    callback set-description(int, string) -> bool;
    callback rename(int, string) -> bool;
    callback reorder(int, int);
    callback discard-current();
    callback activate-current();
    /// Replace the working copy with the selected layout.
    callback load();
    callback delete();
    /// Remember the library file of the working copy as its saved state.
    callback reset-context();
    /// Recompute `current-label` and `dirty`.
    callback refresh-context();
    callback save-current();
    callback flush-drafts() -> bool;
    callback discard-drafts();
    /// Save the working copy over a library file changed elsewhere.
    callback overwrite-current();
    callback save-as(string);
    /// Fill the rule dialog fields for rule `index` (-1: new rule using `target`).
    callback load-rule(int, int);
    callback save-rule();
    callback delete-rule(int);
    callback move-rule(int, int);
    callback set-auto-default(int);
    callback set-rule-enabled(int, bool);
    /// Add the ready-made rule "no layout while game mode is on".
    callback add-game-rule();

    pure function create-base(source: LayoutSource) -> string {
        if source == LayoutSource.bundled && self.create-copy-index < self.bundled-names.length {
            return self.bundled-names[self.create-copy-index];
        }
        if source == LayoutSource.copy && self.create-copy-index < self.names.length {
            return @tr("{} (copy)", self.names[self.create-copy-index]);
        }
        return @tr("New layout");
    }
    function proceed-open-create(source: LayoutSource, copy-index: int) {
        self.create-source = source;
        self.create-copy-index = max(0, copy-index);
        self.create-description = "";
        self.create-name = self.suggest-name(self.create-base(source));
        self.dialog = LibraryDialog.create;
    }
    public function open-create(source: LayoutSource, copy-index: int) {
        self.pending-create-source = source;
        self.pending-create-copy-index = copy-index;
        self.guard-switch(PendingLayoutAction.create);
    }
    public function submit-create() {
        if self.name-error(self.create-name, "").id != "" { return; }
        self.create(self.create-name, self.create-description, self.create-source, self.create-copy-index);
    }
    public function continue-pending() {
        let action = self.pending-action;
        self.pending-action = PendingLayoutAction.none;
        if action != PendingLayoutAction.none { self.discard-drafts(); }
        if action == PendingLayoutAction.edit { self.dialog = LibraryDialog.none; self.load(); }
        if action == PendingLayoutAction.create {
            self.proceed-open-create(self.pending-create-source, self.pending-create-copy-index);
        }
    }
    // Replacing the working copy discards its unsaved edits, so ask first.
    function guard-switch(action: PendingLayoutAction) {
        let drafts-saved = self.flush-drafts();
        self.pending-action = action;
        if !drafts-saved || (self.dirty && !(action == PendingLayoutAction.edit && self.names[self.selected] == self.current-label)) {
            self.dialog = LibraryDialog.unsaved;
        } else {
            self.continue-pending();
        }
    }
    public function save-and-continue() {
        if !self.flush-drafts() { return; }
        self.save-current();
        if !self.dirty { self.continue-pending(); }
    }
    public function edit(index: int) {
        self.select(index);
        self.guard-switch(PendingLayoutAction.edit);
    }
    public function cancel-dialog() {
        self.dialog = LibraryDialog.none;
        self.pending-action = PendingLayoutAction.none;
    }
    public function open-rule(index: int, target: int) {
        ConditionChoices.refresh();
        self.load-rule(index, target);
    }
    /// Layout a new rule starts with: the default, else the first layout.
    public pure function new-rule-target() -> int {
        return self.auto-default >= 0 ? self.auto-default : self.names.length > 0 ? 0 : -1;
    }
    pure function game-text(game: GameCondition) -> string {
        if !AppState.in-development { return ""; }
        return game == GameCondition.on ? @tr("game mode on") : game == GameCondition.off ? @tr("game mode off") : "";
    }
    public pure function rule-text(game: GameCondition, list: string) -> string {
        if self.game-text(game) == "" && list == "" { return @tr("Always"); }
        return self.game-text(game) != "" && list != "" ? self.game-text(game) + " · " + list : self.game-text(game) + list;
    }
    public pure function target-text(target: int) -> string {
        return target >= 0 && target < self.names.length ? self.names[target] : @tr("No layout");
    }
}

export component SaveSplitButton inherits Rectangle {
    in property <bool> enabled: true;
    callback save();
    callback save-as();
    callback discard();
    width: 72px;
    height: 38px;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.card;
        clip: true;
        HorizontalLayout {
            spacing: 0px;
            save-btn := Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                background: root.enabled ? Theme.accent.transparentize(touch-save.has-hover ? 0.7 : 0.85) : transparent;
                border-width: focus-save.has-focus ? 2px : 0px;
                border-color: Theme.focus;
                accessible-role: button;
                accessible-label: @tr("Save (Ctrl+S)");
                Tooltip { TooltipText { text: @tr("Save (Ctrl+S)"); } }
                accessible-enabled: root.enabled;
                accessible-action-default => { if root.enabled { root.save(); } }
                HorizontalLayout { padding-left: Theme.space-m-plus; padding-right: Theme.space-m; spacing: Theme.space-s; alignment: center;
                    VerticalLayout { alignment: center; Image { width: 18px; height: 18px; source: @image-url("icons/save.svg"); colorize: root.enabled ? Theme.accent : Theme.muted; } }
                    VerticalLayout { alignment: center; Rectangle { width: 6px; height: 6px; border-radius: self.height / 2; background: root.enabled ? Theme.accent : transparent; } }
                }
                focus-save := FocusScope {
                    enabled: root.enabled;
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " { root.save(); return accept; }
                        return reject;
                    }
                }
                touch-save := TouchArea {
                    enabled: root.enabled;
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => { root.save(); }
                }
            }
            Rectangle {
                width: 1px;
                height: parent.height;
                background: Theme.divider;
            }
            chevron-btn := Rectangle {
                width: 26px;
                height: parent.height;
                background: touch-chevron.has-hover || focus-chevron.has-focus ? Theme.hover : transparent;
                border-width: focus-chevron.has-focus ? 2px : 0px;
                border-color: Theme.focus;
                accessible-role: button;
                accessible-label: @tr("Save as or reset changes");
                accessible-action-default => { save-menu.show(); }
                Tooltip { TooltipText { text: @tr("Save as or reset changes"); } }
                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    source: @image-url("icons/chevron-down.svg");
                    colorize: Theme.text;
                }
                focus-chevron := FocusScope {
                    key-pressed(event) => {
                        if event.text == "\n" || event.text == " " { save-menu.show(); return accept; }
                        return reject;
                    }
                }
                touch-chevron := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { save-menu.show(); }
                }
            }
        }
    }

    save-menu := PopupWindow {
        x: 0px;
        y: parent.height + Theme.menu-offset;
        width: 240px;
        MenuSurface {
            MenuItem { text: @tr("Save as…"); clicked => { save-menu.close(); root.save-as(); } }
            MenuItem { text: @tr("Reset current changes"); enabled: root.enabled; clicked => { save-menu.close(); root.discard(); } }
        }
    }
}

/// Button choosing a library layout or "Off" (-1).
component TargetPicker inherits Rectangle {
    in property <int> target: -1;
    in property <bool> missing;
    callback picked(int);
    // Closing the popup destroys the repeated item's parent in Live Preview.
    // Continue in the surviving picker's context instead (Slint issue #6426).
    function choose(index: int) {
        menu.close();
        root.picked(index);
    }
    height: Theme.control-height;
    border-radius: Theme.radius;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.focus : Theme.border;
    background: touch.has-hover || focus.has-focus ? Theme.hover : Theme.surface;
    accessible-role: combobox;
    accessible-label: @tr("Layout");
    accessible-value: label.text;
    accessible-action-default => { menu.show(); }
    HorizontalLayout { padding-left: Theme.space-m-plus; padding-right: Theme.space-m; spacing: Theme.space-s;
        label := Text {
            horizontal-stretch: 1;
            text: root.missing ? @tr("Layout not found") : LayoutLibrary.target-text(root.target);
            color: root.missing ? Theme.error : root.target < 0 ? Theme.muted : Theme.text;
            font-weight: root.target >= 0 ? 600 : 400;
            overflow: elide; vertical-alignment: center;
        }
        VerticalLayout { alignment: center;
            Image { width: 12px; height: 12px; source: @image-url("icons/chevron-down.svg"); colorize: Theme.text; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " { menu.show(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { menu.show(); } }
    menu := PopupWindow {
        y: root.height + Theme.menu-offset;
        width: max(root.width, 220px);
        MenuSurface {
            MenuItem { text: @tr("No layout (keys as is)"); clicked => { root.choose(-1); } }
            Divider {}
            for name[index] in LayoutLibrary.names: MenuItem { text: name; clicked => { root.choose(index); } }
        }
    }
}

component AutoRuleRow inherits Rectangle {
    action-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { LayoutLibrary.open-rule(root.index, root.rule.target); return accept; }
            return reject;
        }
    }
    Rectangle { border-width: action-focus.has-focus ? 2px : 0px; border-color: Theme.focus; border-radius: Theme.radius; }
    in property <AutoRuleView> rule;
    in property <int> index;
    in property <int> count;
    in property <bool> matched;
    property <bool> highlighted: LayoutLibrary.highlight-target >= 0 && LayoutLibrary.highlight-target == root.rule.target;
    border-radius: Theme.radius;
    border-width: root.highlighted ? 2px : 1px;
    border-color: root.matched ? Theme.accent : root.highlighted ? Theme.accent : Theme.divider;
    background: root.matched ? Theme.accent.transparentize(0.88) : touch.has-hover ? Theme.hover : transparent;
    height: row.preferred-height;
    accessible-role: button;
    accessible-label: @tr("Rule {}", root.index + 1) + ": " + LayoutLibrary.rule-text(root.rule.game, root.rule.list) + " → " + LayoutLibrary.target-text(root.rule.target);
    accessible-action-default => { LayoutLibrary.open-rule(root.index, root.rule.target); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { LayoutLibrary.open-rule(root.index, root.rule.target); } }
    row := HorizontalLayout { padding: Theme.space-m; spacing: Theme.space-s;
        VerticalLayout { alignment: start;
            DragHandle { group: DragGroups.library-rules; index: root.index; count: root.count; dropped(from, to) => { LayoutLibrary.move-rule(from, to); } }
        }
        VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: Theme.space-2xs;
            HorizontalLayout { spacing: Theme.space-xs; alignment: start;
                Text {
                    text: root.rule.missing ? @tr("Layout not found") : LayoutLibrary.target-text(root.rule.target);
                    color: root.rule.missing ? Theme.error : root.rule.target < 0 ? Theme.muted : Theme.text;
                    font-weight: root.rule.target >= 0 ? 600 : 400;
                    overflow: elide;
                }
            }
            Text { text: LayoutLibrary.rule-text(root.rule.game, root.rule.list); color: Theme.muted; wrap: word-wrap; }
            if root.rule.excluded != "": HorizontalLayout { spacing: Theme.space-xs; alignment: start;
                VerticalLayout { alignment: center;
                    Image { width: 14px; height: 14px; source: @image-url("icons/ban.svg"); colorize: Theme.error; }
                }
                Text { text: root.rule.excluded; color: Theme.muted; wrap: word-wrap; }
            }
            if root.rule.enabled && root.rule.shadowed-by >= 0: Text {
                text: @tr("Never applies: rule {} always matches first.", root.rule.shadowed-by + 1);
                color: Theme.warning; font-size: Theme.font-body; wrap: word-wrap;
            }
            if AppState.in-development && root.rule.enabled && root.rule.game != GameCondition.any && !LayoutLibrary.game-detection: Text {
                text: @tr("Game mode detection is off, so this rule never matches.");
                color: Theme.warning; font-size: Theme.font-body; wrap: word-wrap;
            }
            if root.rule.enabled && root.rule.unknown-languages != "": Text {
                text: @tr("Not among the system languages: {}", root.rule.unknown-languages);
                color: Theme.warning; font-size: Theme.font-body; wrap: word-wrap;
            }
        }
        VerticalLayout { alignment: start;
            CheckBox {
                accessible-label: @tr("Rule enabled");
                checked: root.rule.enabled;
                toggled => { LayoutLibrary.set-rule-enabled(root.index, self.checked); }
            }
        }
    }
    DropMarker { cross-size: parent.width; group: DragGroups.library-rules; index: root.index; row-start: root.y; row-size: root.height; }
}

/// Shared entry point for common and custom automatic rules.
component AddRuleButton inherits Rectangle {
    in property <bool> compact: false;
    height: button.preferred-height;
    width: button.preferred-width;
    button := Button {
        text: root.compact ? "" : @tr("Add rule");
        icon: @image-url("icons/plus.svg");
        accessible-label: @tr("Add rule");
        clicked => { LayoutLibrary.open-rule(-1, LayoutLibrary.new-rule-target()); }
    }
}

/// Automatic mode rules shown next to the library.
component AutoRulesPanel inherits Card {
    VerticalLayout { padding: Theme.space-l-plus; spacing: Theme.space-m-plus;
        HorizontalLayout { spacing: Theme.space-s; vertical-stretch: 0;
            CardTitle { text: @tr("Automatic switching rules"); min-width: 0px; wrap: word-wrap; vertical-alignment: center; }
            VerticalLayout { alignment: center;
                InfoTip { text: @tr("Rules are checked from top to bottom; the first enabled one whose conditions match chooses the layout. If none matches, the default is used. “No layout” leaves the keyboard unprocessed, for example in an application where the layout gets in the way."); }
            }
            Rectangle { horizontal-stretch: 1; }
            AddRuleButton { compact: true; }
        }
        ScrollView { viewport-width: self.visible-width; drag-scroll: true;
            vertical-stretch: 1;
            VerticalLayout { spacing: Theme.space-s; alignment: start;
                if LayoutLibrary.auto-rules.length == 0: VerticalLayout { spacing: Theme.space-m;
                    Text { text: @tr("No rules"); color: Theme.text; font-weight: Theme.weight-semibold; }
                    Text {
                        text: @tr("The default layout is always used.");
                        color: Theme.muted; wrap: word-wrap;
                    }
                    HorizontalLayout { alignment: start;
                        AddRuleButton {}
                    }
                }
                for rule[index] in LayoutLibrary.auto-rules: AutoRuleRow {
                    rule: rule; index: index; count: LayoutLibrary.auto-rules.length;
                    matched: LayoutLibrary.auto-matched == index;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.divider; vertical-stretch: 0; }
        Rectangle {
            vertical-stretch: 0;
            border-radius: Theme.radius;
            height: default-row.preferred-height;
            border-width: 1px;
            border-color: transparent;
            background: transparent;
            default-row := VerticalLayout { padding: Theme.space-m; spacing: Theme.space-s;
                Text { text: @tr("Otherwise (default)"); color: Theme.text; font-weight: Theme.weight-semibold; }
                TargetPicker {
                    target: LayoutLibrary.auto-default;
                    missing: LayoutLibrary.auto-default-missing;
                    picked(index) => { LayoutLibrary.set-auto-default(index); }
                }
                if LayoutLibrary.auto-default < 0 && !LayoutLibrary.auto-default-missing: Text {
                    text: @tr("When no rule matches, the keyboard works without processing.");
                    color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap;
                }
            }
        }
    }
}

/// One numbered step of the first-run setup card; a done step shows a check.
component SetupStep inherits HorizontalLayout {
    in property <int> number;
    in property <string> title;
    in property <bool> done;
    spacing: Theme.space-l;
    VerticalLayout { alignment: center;
        Rectangle {
            width: Theme.icon-button-size; height: Theme.icon-button-size; border-radius: self.height / 2;
            background: root.done ? Theme.success.transparentize(0.8) : Theme.selected;
            accessible-role: none;
            if root.done: Image { width: 16px; source: @image-url("icons/check.svg"); colorize: Theme.success; }
            if !root.done: Text { text: root.number; color: Theme.accent; font-weight: Theme.weight-semibold; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    Text { text: root.title; color: root.done ? Theme.muted : Theme.text; font-size: Theme.font-subtitle; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; min-width: 160px; }
    @children
}

export component LibraryPage inherits PageLayout {
    // The first-run card covers the missing keyboard itself; the warning is for an
    // existing setup that lost its device.
    if !AppState.keyboard-selected && LayoutLibrary.names.length > 0: Rectangle {
        vertical-stretch: 0;
        background: Theme.warning.transparentize(0.88);
        border-radius: Theme.radius-large;
        border-width: 1px;
        border-color: Theme.warning;
        HorizontalLayout {
            padding: Theme.space-l; spacing: Theme.space-l;
            Text { text: @tr("No keyboard is selected, so the mapper cannot start."); color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
            VerticalLayout { alignment: center; Button { text: @tr("Choose a keyboard"); clicked => { AppState.open-keyboard-settings(); } } }
        }
    }
    if LayoutLibrary.names.length > 0: HorizontalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-4xl;
        if AppState.in-development: HorizontalLayout {
            spacing: Theme.space-s;
            Text { text: @tr("Mode"); color: Theme.text; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                InfoTip {
                    text: @tr("Single: the layout you make active works everywhere.") + "\n\n"
                        + (AppState.in-development ? @tr("Automatic: the layout is chosen by switching rules for the application, system language or game mode.") : "") + "\n\n"
                        + @tr("The app:activateLayout1…5 actions activate the layout at that position in this list: reordering the list changes which layout a key activates. In Auto mode they switch to Single mode.");
                }
            }
            ButtonGroup {
                labels: [@tr("Single"), @tr("Auto")];
                selected-index: LayoutLibrary.automatic ? 1 : 0;
                selected(index) => { if (index == 1) != LayoutLibrary.automatic { LayoutLibrary.set-automatic(index == 1); } }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        HorizontalLayout {
            spacing: Theme.space-m;
            Text { text: @tr("Add layout: "); color: Theme.text; vertical-alignment: center; }
            Button { text: @tr("Blank"); primary: false; icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.empty, 0); } }
            for name[index] in LayoutLibrary.bundled-names: Button { text: name; icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.bundled, index); } }
        }
    }
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: Theme.space-l;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            if LayoutLibrary.names.length == 0: Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout { alignment: center;
                        Card {
                            max-width: 560px; horizontal-stretch: 1;
                            VerticalLayout { padding: Theme.space-3xl; spacing: Theme.space-xl;
                                Text { text: @tr("Getting started"); color: Theme.text; font-size: Theme.font-heading; font-weight: Theme.weight-semibold; }
                                SetupStep {
                                    number: 1; done: AppState.keyboard-selected;
                                    title: AppState.keyboard-selected ? @tr("Keyboard selected") : @tr("Choose the keyboard to remap");
                                    VerticalLayout { alignment: center; Button { text: AppState.keyboard-selected ? @tr("Change") : @tr("Choose a keyboard"); primary: !AppState.keyboard-selected; clicked => { AppState.open-keyboard-settings(); } } }
                                }
                                SetupStep {
                                    number: 2; title: @tr("Add a layout");
                                    HorizontalLayout { spacing: Theme.space-m; alignment: end;
                                        for name[index] in LayoutLibrary.bundled-names: VerticalLayout { alignment: center; Button { text: name; primary: AppState.keyboard-selected; icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.bundled, index); } } }
                                        VerticalLayout { alignment: center; Button { text: @tr("Blank"); icon: @image-url("icons/plus.svg"); colorize-icon: true; clicked => { LayoutLibrary.open-create(LayoutSource.empty, 0); } } }
                                    }
                                }
                                SetupStep { number: 3; title: @tr("Press Start at the top to apply it"); }
                            }
                        }
                    }
                }
            }
            if LayoutLibrary.names.length > 0: ScrollView { viewport-width: self.visible-width; drag-scroll: true;
                vertical-stretch: 1;
                PageContent { spacing: 0px;
                    for row[index] in LayoutLibrary.rows: card := Rectangle {
                        property <string> name: row.name;
                        property <bool> active: LayoutLibrary.active-label == name;
                        property <bool> current: LayoutLibrary.editor-open && LayoutLibrary.current-label == name;
                        property <bool> auto: LayoutLibrary.automatic;
                        height: max(132px, card-content.preferred-height + 10px);
                        Rectangle {
                        height: parent.height - 10px; width: parent.width;
                                background: Theme.card;
                        border-radius: Theme.radius-large;
                        border-width: card.active ? 2px : 1px;
                        border-color: card.active ? Theme.accent : Theme.divider;
                        TouchArea { double-clicked => { LayoutLibrary.edit(index); } }
                        card-content := HorizontalLayout { padding: Theme.space-xl; spacing: Theme.space-2xl;
                            VerticalLayout { horizontal-stretch: 1; min-width: 0px; spacing: Theme.space-m-plus;
                                HorizontalLayout { spacing: Theme.space-m; vertical-stretch: 0;
                                    Text { text: (index + 1) + "."; color: Theme.muted; font-size: Theme.font-subtitle; font-weight: Theme.weight-semibold; vertical-alignment: center; accessible-role: none; }
                                    InlineTextField { min-width: 0px; text: name; text-size: Theme.font-subtitle; text-weight: Theme.weight-semibold; label: @tr("Layout name"); validate(value) => { return LayoutLibrary.name-error(value, name); } saved(value) => { return LayoutLibrary.rename(index, value); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    if card.auto && LayoutLibrary.auto-default == index: Text { text: @tr("Default"); color: Theme.accent; font-size: Theme.font-medium; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                                    if card.auto && row.rule-count > 0: Rectangle {
                                        property <bool> on: LayoutLibrary.highlight-target == index;
                                        width: badge.preferred-width + 12px;
                                        border-radius: Theme.radius-small;
                                        background: self.on ? Theme.accent.transparentize(0.85) : badge-touch.has-hover ? Theme.hover : transparent;
                                        accessible-role: button;
                                        accessible-label: badge.text;
                                        accessible-action-default => { LayoutLibrary.highlight-target = self.on ? -1 : index; }
                                        badge := Text {
                                            text: @tr("In {n} rule" | "In {n} rules" % row.rule-count);
                                            color: parent.on ? Theme.accent : Theme.muted; font-size: Theme.font-medium; vertical-alignment: center;
                                        }
                                        badge-focus := FocusScope {
                                            key-pressed(event) => {
                                                if event.text == Key.Return || event.text == " " { LayoutLibrary.highlight-target = LayoutLibrary.highlight-target == index ? -1 : index; return accept; }
                                                return reject;
                                            }
                                        }
                                        Rectangle { border-width: badge-focus.has-focus ? 2px : 0px; border-color: Theme.focus; border-radius: Theme.radius-small; }
                                        badge-touch := TouchArea { mouse-cursor: pointer; clicked => { LayoutLibrary.highlight-target = parent.on ? -1 : index; } }
                                    }
                                }
                                if !row.loaded: Text { text: @tr("Please wait…"); color: Theme.muted; }
                                if row.error.id != "": Text { text: Locale.text(row.error); color: Theme.error; wrap: word-wrap; }
                                if row.loaded: InlineTextArea { text: row.description; placeholder: @tr("Add a description…"); label: @tr("Description"); text-color: Theme.muted; saved(value) => { return LayoutLibrary.set-description(index, value); } }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout { spacing: Theme.space-m; alignment: start; vertical-stretch: 0;
                                    DragHandle { group: DragGroups.layouts; index: index; count: LayoutLibrary.names.length; dropped(from, to) => { LayoutLibrary.reorder(from, to); } }
                                    if card.active: Text { text: @tr("Active"); color: Theme.accent; font-weight: Theme.weight-semibold; vertical-alignment: center; }
                                    if !card.auto && !card.active: Button { text: @tr("Activate"); icon: @image-url("icons/play.svg"); colorize-icon: true; clicked => { LayoutLibrary.select(index); LayoutLibrary.action(LibraryAction.activate); } }
                                    if card.current: Text { text: LayoutLibrary.dirty ? @tr("Open for editing (unsaved)") : @tr("Open for editing"); color: Theme.text; vertical-alignment: center; }
                                    if !card.current: Button { text: @tr("Edit layout"); icon: @image-url("icons/pencil.svg"); colorize-icon: true; clicked => { LayoutLibrary.edit(index); } }
                                    Rectangle {
                                        width: 44px; height: Theme.control-height-l;
                                        Button {
                                            width: parent.width; height: parent.height; text: "…";
                                            clicked => { LayoutLibrary.select(index); more-menu.show(); }
                                        }
                                        more-menu := PopupWindow {
                                            x: parent.width - self.width; y: parent.height + Theme.menu-offset;
                                            width: 240px;
                                            MenuSurface {
                                                MenuItem { text: @tr("Duplicate…"); has-icon: true; icon: @image-url("icons/copy.svg"); clicked => { more-menu.close(); LayoutLibrary.open-create(LayoutSource.copy, index); } }
                                                Divider {}
                                                MenuItem { text: @tr("Delete…"); has-icon: true; icon: @image-url("icons/trash-2.svg"); danger: true; clicked => { more-menu.close(); LayoutLibrary.dialog = LibraryDialog.delete; } }
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout { width: 220px; spacing: Theme.space-m; alignment: start;
                                visible: row.loaded && row.error.id == "";
                                property <LayoutSummary> summary: row.summary;
                                if summary.rules + summary.layers + (AppState.in-development ? summary.emoji-pages + summary.action-pages + summary.macros + summary.commands : 0) == 0: Text { text: @tr("Empty layout"); color: Theme.muted; font-size: Theme.font-medium; }
                                if summary.rules > 0: Text { text: @tr("{n} rule" | "{n} rules" % summary.rules); color: Theme.muted; font-size: Theme.font-medium; }
                                if summary.layers > 0: Text { text: @tr("{n} layer" | "{n} layers" % summary.layers); color: Theme.muted; font-size: Theme.font-medium; }
                                if AppState.in-development && summary.emoji-pages > 0: Text { text: @tr("{n} emoji page" | "{n} emoji pages" % summary.emoji-pages); color: Theme.muted; font-size: Theme.font-medium; }
                                if AppState.in-development && summary.action-pages > 0: Text { text: @tr("{n} action page" | "{n} action pages" % summary.action-pages); color: Theme.muted; font-size: Theme.font-medium; }
                                if AppState.in-development && summary.macros > 0: Text { text: @tr("{n} macro" | "{n} macros" % summary.macros); color: Theme.muted; font-size: Theme.font-medium; }
                                // Commands run shell scripts, so they stand out when reviewing a layout.
                                if AppState.in-development && summary.commands > 0: HorizontalLayout { spacing: Theme.space-s; alignment: start;
                                    Text { text: @tr("{n} command" | "{n} commands" % summary.commands); color: Theme.warning; font-size: Theme.font-medium; font-weight: Theme.weight-semibold; }
                                }
                            }
                        }
                        }
                        DropMarker { cross-size: parent.width; group: DragGroups.layouts; index: index; row-start: card.y; row-size: card.height; }
                    }
                }
            }
        }
        if AppState.in-development && LayoutLibrary.automatic: VerticalLayout { width: 340px; padding-bottom: Theme.page-padding; AutoRulesPanel {} }
    }
}

export component LibraryDialogOverlay inherits Rectangle {
    if LayoutLibrary.dialog != LibraryDialog.none && LayoutLibrary.dialog != LibraryDialog.delete && LayoutLibrary.dialog != LibraryDialog.delete-rule && LayoutLibrary.dialog != LibraryDialog.conflict: DialogFrame {
        title: LayoutLibrary.dialog == LibraryDialog.create ? @tr("New layout")
            : LayoutLibrary.dialog == LibraryDialog.rule ? (LayoutLibrary.rule-index < 0 ? @tr("New rule") : @tr("Rule {}", LayoutLibrary.rule-index + 1))
            : @tr("Unsaved changes");
        card-width: 620px;
        card-height: LayoutLibrary.dialog == LibraryDialog.create ? 420px : 0px;
        close => { LayoutLibrary.cancel-dialog(); }
        if LayoutLibrary.dialog == LibraryDialog.create: VerticalLayout { padding: 0px; spacing: Theme.space-m-plus;
            FormField {
                label: @tr("Name"); placeholder: @tr("New layout name"); autofocus: true;
                text <=> LayoutLibrary.create-name;
                error: LayoutLibrary.name-error(LayoutLibrary.create-name, "");
                accepted => { LayoutLibrary.submit-create(); }
            }
            Text { text: @tr("Description (optional)"); color: Theme.text; }
            TextEdit { text <=> LayoutLibrary.create-description; height: 120px; }
        }
        if LayoutLibrary.dialog == LibraryDialog.rule: ScrollView {
            viewport-width: self.visible-width;
            vertical-stretch: 1;
            // The dialog grows with the form up to the window height, then scrolls.
            preferred-height: rule-form.preferred-height;
            min-height: 120px;
            rule-form := VerticalLayout { spacing: Theme.space-xl; alignment: start;
                VerticalLayout { spacing: Theme.space-m;
                    Text { text: @tr("Use layout"); color: Theme.text; font-weight: Theme.weight-semibold; }
                    TargetPicker { target: LayoutLibrary.rule-target; picked(index) => { LayoutLibrary.rule-target = index; } }
                }
                VerticalLayout { spacing: Theme.space-xs;
                    Text { text: @tr("When"); color: Theme.text; font-weight: Theme.weight-semibold; }
                    Text { text: @tr("All filled conditions must match. A rule without conditions always matches."); color: Theme.muted; wrap: word-wrap; }
                }
                ConditionsForm { game <=> LayoutLibrary.rule-game; languages <=> LayoutLibrary.rule-layouts; applications <=> LayoutLibrary.rule-apps; show-exclusions: true; excluded <=> LayoutLibrary.rule-excluded; }
            }
        }
        if LayoutLibrary.dialog == LibraryDialog.unsaved: Text {
            text: LayoutLibrary.current-label == ""
                ? @tr("The layout you are editing has not been saved to the library. Its changes will be lost.")
                : @tr("“{}” has unsaved changes. Save them before switching?", LayoutLibrary.current-label);
            color: Theme.text; wrap: word-wrap;
        }
        if LayoutLibrary.status.id != "" && LayoutLibrary.status.id != "library-saved": Text { text: Locale.text(LayoutLibrary.status); color: Theme.error; wrap: word-wrap; }
        if LayoutLibrary.dialog != LibraryDialog.rule: Rectangle { vertical-stretch: 1; }
        HorizontalLayout { padding: Theme.space-m; spacing: Theme.space-m;
            if LayoutLibrary.dialog == LibraryDialog.rule && LayoutLibrary.rule-index >= 0: Button {
                text: @tr("Delete rule"); icon: @image-url("icons/trash-2.svg"); colorize-icon: true;
                clicked => { LayoutLibrary.dialog = LibraryDialog.delete-rule; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { LayoutLibrary.cancel-dialog(); } }
            if LayoutLibrary.dialog == LibraryDialog.create: Button { text: @tr("Create"); primary: true; enabled: LayoutLibrary.name-error(LayoutLibrary.create-name, "").id == ""; clicked => { LayoutLibrary.submit-create(); } }
            if LayoutLibrary.dialog == LibraryDialog.rule: Button { text: @tr("Save"); primary: true; clicked => { LayoutLibrary.save-rule(); } }
            if LayoutLibrary.dialog == LibraryDialog.unsaved: Button { text: @tr("Discard changes"); clicked => { LayoutLibrary.continue-pending(); } }
            if LayoutLibrary.dialog == LibraryDialog.unsaved && LayoutLibrary.current-label != "": Button {
                text: @tr("Save and continue"); primary: true;
                clicked => { LayoutLibrary.save-and-continue(); }
            }
        }
    }
    if LayoutLibrary.dialog == LibraryDialog.delete: ConfirmDialog {
        title: @tr("Delete layout?");
        error: LayoutLibrary.status.id == "library-saved" ? "" : Locale.text(LayoutLibrary.status);
        body: @tr("“{}” will be deleted. This cannot be undone.", LayoutLibrary.names[LayoutLibrary.selected])
            + (LayoutLibrary.rows[LayoutLibrary.selected].rule-count > 0
                ? " " + @tr("Its {n} automatic rule will be deleted too." | "Its {n} automatic rules will be deleted too." % LayoutLibrary.rows[LayoutLibrary.selected].rule-count)
                : "")
            + (LayoutLibrary.auto-default == LayoutLibrary.selected ? " " + @tr("Automatic mode will use no layout by default.") : "");
        confirm-text: @tr("Delete");
        cancel => { LayoutLibrary.cancel-dialog(); }
        confirm => { LayoutLibrary.delete(); }
    }
    if LayoutLibrary.dialog == LibraryDialog.delete-rule: ConfirmDialog {
        title: @tr("Delete rule {}?", LayoutLibrary.rule-index + 1);
        error: LayoutLibrary.status.id == "library-saved" ? "" : Locale.text(LayoutLibrary.status);
        body: @tr("The rule will be deleted. This cannot be undone.");
        confirm-text: @tr("Delete");
        cancel => { LayoutLibrary.dialog = LibraryDialog.rule; }
        confirm => { LayoutLibrary.delete-rule(LayoutLibrary.rule-index); }
    }
    if LayoutLibrary.save-as-open: DialogFrame {
        title: @tr("Save layout as…");
        card-width: 480px;
        close => { LayoutLibrary.save-as-open = false; }
        FormField {
            label: @tr("Layout name"); autofocus: true;
            text <=> LayoutLibrary.save-as-name;
            error: LayoutLibrary.name-error(LayoutLibrary.save-as-name, "");
            accepted => { if LayoutLibrary.name-error(LayoutLibrary.save-as-name, "").id == "" { LayoutLibrary.save-as(LayoutLibrary.save-as-name); } }
        }
        Text { text: Locale.text(LayoutLibrary.status); color: Theme.error; wrap: word-wrap; }
        HorizontalLayout { padding: Theme.space-m; spacing: Theme.space-m; vertical-stretch: 0;
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Cancel"); clicked => { LayoutLibrary.save-as-open = false; } }
            Button { text: @tr("Save"); enabled: LayoutLibrary.name-error(LayoutLibrary.save-as-name, "").id == ""; clicked => { LayoutLibrary.save-as(LayoutLibrary.save-as-name); } }
        }
    }
}
