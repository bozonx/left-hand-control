import { Palette } from "std-widgets.slint";
export global Theme {
    in-out property <bool> dark: true;
    out property <color> surface: dark ? #202531 : #f5f7fc;
    out property <color> text: dark ? #f0f3fa : #182030;
    out property <color> muted: dark ? #c2c9d6 : #485568;
    out property <color> accent: dark ? #476bb0 : #b7d0fa;
    out property <color> hover: dark ? #3e526e : #dbe6f7;
    out property <color> card: dark ? #242d3c : #ffffff;
    out property <color> border: dark ? #626b7b : #8794a8;
    out property <color> error: dark ? #ffb4ab : #a52222;
    public function apply() { Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light; }
}
export global Locale {
    in-out property <bool> english: false;
    public pure function error(value: string) -> string {
        if value == "Введите непустой текст" { return @tr("Enter non-empty text"); }
        if value == "Пауза: целое число от 1 до 10000 мс" { return @tr("Delay: an integer from 1 to 10000 ms"); }
        if value == "Выберите системное действие" { return @tr("Select a system action"); }
        if value == "Захватите сочетание клавиш" { return @tr("Capture a keyboard shortcut"); }
        return value;
    }
}
