{
  "version": 1,
  "meta": {
    "name": "Left Hand Control",
    "author": "Ivan K",
    "keymapVersion": "1"
  },
  "layers": [
    {
      "id": "navigation",
      "keys": {
        "MetaLeft": "Ctrl+KeyX",
        "AltLeft": "Delete",
        "Space": "Backspace",
        "KeyQ": "builtin:insertEmptyLineAbove",
        "KeyW": "Ctrl+Backspace",
        "KeyE": "Ctrl+Delete",
        "KeyR": "builtin:pasteOnNewLineAbove",
        "KeyT": "Ctrl+Home",
        "KeyY": "Home",
        "KeyU": "builtin:goToNextLineEnd",
        "KeyI": "builtin:goToPreviousLineEnd",
        "KeyO": "End",
        "KeyP": "builtin:goTo5LinesUp",
        "BracketLeft": null,
        "KeyA": "tecloid:showEmojiMenu1",
        "KeyS": "builtin:duplicateLine",
        "KeyD": "Ctrl+KeyD",
        "KeyF": "builtin:copyLineText",
        "KeyG": "builtin:cutLineText",
        "KeyH": "ArrowLeft",
        "KeyJ": "ArrowDown",
        "KeyK": "ArrowUp",
        "KeyL": "ArrowRight",
        "Semicolon": "builtin:insertSpaceAfterNextChar",
        "Quote": null,
        "KeyZ": "builtin:insertEmptyLineBelow",
        "KeyX": "builtin:cutWord",
        "KeyC": "builtin:copyWord",
        "KeyV": "builtin:pasteOnNewLineBelow",
        "KeyB": "Ctrl+End",
        "KeyN": "Ctrl+ArrowLeft",
        "KeyM": "builtin:goToNextLineStart",
        "Comma": "builtin:goToPreviousLineStart",
        "Period": "Ctrl+ArrowRight",
        "Slash": "builtin:goTo5LinesDown"
      }
    },
    {
      "id": "select",
      "keys": {
        "CapsLock": "CapsLock",
        "AltLeft": "Ctrl+Enter",
        "Digit1": "sys:switchToKeyboardLayout1",
        "Digit2": "sys:switchToKeyboardLayout2",
        "Digit3": "sys:switchToKeyboardLayout3",
        "Digit4": "sys:switchToKeyboardLayout4",
        "Digit5": "sys:switchToKeyboardLayout5",
        "Digit6": "sys:switchToKeyboardLayout6",
        "Digit7": "sys:switchToKeyboardLayout7",
        "Digit8": "sys:switchToKeyboardLayout8",
        "Digit9": "sys:switchToKeyboardLayout9",
        "Digit0": "sys:switchToKeyboardLayout10",
        "KeyQ": "Ctrl+KeyZ",
        "KeyW": "builtin:cutToLineStart",
        "KeyE": "builtin:cutToLineEnd",
        "KeyR": "PageDown",
        "KeyT": "PageUp",
        "KeyY": "Shift+Home",
        "KeyU": "Shift+PageDown",
        "KeyI": "Shift+PageUp",
        "KeyO": "Shift+End",
        "KeyP": "builtin:select5LinesUp",
        "BracketLeft": null,
        "KeyA": "Ctrl+Slash",
        "KeyS": "builtin:copyToLineStart",
        "KeyD": "builtin:copyToLineEnd",
        "KeyF": "builtin:selectLineText",
        "KeyG": "builtin:cutLine",
        "KeyH": "Shift+ArrowLeft",
        "KeyJ": "Shift+ArrowDown",
        "KeyK": "Shift+ArrowUp",
        "KeyL": "Shift+ArrowRight",
        "Semicolon": "builtin:selectWord",
        "Quote": null,
        "KeyZ": null,
        "KeyX": "builtin:replaceToLineStartWithClipboard",
        "KeyC": "builtin:replaceToLineEndWithClipboard",
        "KeyV": "builtin:replaceLineTextWithClipboard",
        "KeyB": "builtin:replaceWordWithClipboard",
        "KeyN": "Ctrl+Shift+ArrowLeft",
        "KeyM": "Shift+PageDown",
        "Comma": "Shift+PageUp",
        "Period": "Ctrl+Shift+ArrowRight",
        "Slash": "builtin:select5LinesDown"
      }
    },
    {
      "id": "symbols",
      "keys": {
        "KeyQ": "text:<",
        "KeyW": "text:{",
        "KeyE": "text:[",
        "KeyR": "text:(",
        "KeyT": "text:|",
        "KeyY": "text:^",
        "KeyU": "Digit7",
        "KeyI": "Digit8",
        "KeyO": "Digit9",
        "KeyP": "text:+",
        "BracketLeft": null,
        "KeyA": "text:#",
        "KeyS": "text::",
        "KeyD": "text:!",
        "KeyF": "text:?",
        "KeyG": "text:&",
        "KeyH": "text:*",
        "KeyJ": "Digit4",
        "KeyK": "Digit5",
        "KeyL": "Digit6",
        "Semicolon": "text:=",
        "Quote": "text:%",
        "KeyZ": "text:$",
        "KeyX": "text:`",
        "KeyC": "text:'",
        "KeyV": "text:\"",
        "KeyB": "text:@",
        "KeyN": "Digit0",
        "KeyM": "Digit1",
        "Comma": "Digit2",
        "Period": "Digit3",
        "Slash": "text:/",
        "ShiftRight": "text:_"
      }
    },
    {
      "id": "f-keys",
      "keys": {
        "KeyQ": "text:>",
        "KeyW": "text:}",
        "KeyE": "text:]",
        "KeyR": "text:)",
        "KeyT": "text:☝️",
        "KeyY": "F12",
        "KeyU": "F7",
        "KeyI": "F8",
        "KeyO": "F9",
        "KeyP": "text:👍",
        "BracketLeft": "text:👎",
        "KeyA": "text:№",
        "KeyS": "text:;",
        "KeyD": "text:‼️",
        "KeyF": "text:❓",
        "KeyG": "text:❌",
        "KeyH": "F11",
        "KeyJ": "F4",
        "KeyK": "F5",
        "KeyL": "F6",
        "Semicolon": "text:≠",
        "Quote": "text:⚡",
        "KeyZ": "text:€",
        "KeyX": "text:~",
        "KeyC": "text:⏩",
        "KeyV": "text:✅",
        "KeyB": "text:ℹ️",
        "KeyN": "F10",
        "KeyM": "F1",
        "Comma": "F2",
        "Period": "F3",
        "Slash": "text:\\"
      }
    },
    {
      "id": "desktop",
      "keys": {
        "Tab": { "action": "Alt+Tab", "holdModifiers": true },
        "CapsLock": { "action": "Meta+Tab", "holdModifiers": true },
        "Backspace": "sys:turnOffScreen",
        "MetaLeft": "Ctrl+Alt+Shift+KeyV",
        "ShiftLeft": "sys:switchToKeyboardLayout4",
        "Digit1": "Meta+Digit1",
        "Digit2": "Meta+Digit2",
        "Digit3": "Meta+Digit3",
        "Digit4": "Meta+Digit4",
        "Digit5": "Meta+Digit5",
        "Digit6": "Meta+Digit6",
        "Digit7": "Meta+Digit7",
        "Digit8": "Meta+Digit8",
        "Digit9": "Meta+Digit9",
        "Digit0": "Meta+Digit0",
        "KeyQ": "Ctrl+Alt+Shift+KeyF",
        "KeyW": "Ctrl+KeyA",
        "KeyE": "Ctrl+Alt+Shift+KeyS",
        "KeyR": "Ctrl+Alt+Shift+KeyW",
        "KeyT": "sys:toggleWindowKeepAbove",
        "KeyY": "sys:closeWindow",
        "KeyU": "sys:maximizeWindow",
        "KeyI": "sys:minimizeWindow",
        "KeyO": "ZoomIn",
        "KeyP": "ZoomOut",
        "BracketLeft": "sys:showAppLauncher",
        "KeyA": "sys:switchToDesktop4",
        "KeyS": "sys:switchToDesktop3",
        "KeyD": "sys:switchToDesktop2",
        "KeyF": "sys:switchToDesktop1",
        "KeyG": "sys:moveWindowToNextDesktop",
        "KeyH": "Meta+ArrowLeft",
        "KeyJ": "Meta+ArrowUp",
        "KeyK": "Meta+ArrowDown",
        "KeyL": "Meta+ArrowRight",
        "Semicolon": "sys:maximizeWindowVertically",
        "Quote": "kde:kwin/Window Maximize Horizontal",
        "KeyZ": "sys:switchToKeyboardLayout3",
        "KeyX": "sys:switchToKeyboardLayout2",
        "KeyC": "sys:switchToKeyboardLayout1",
        "KeyV": "Meta+KeyV",
        "KeyB": "PrintScreen",
        "KeyN": "BrightnessDown",
        "KeyM": "BrightnessUp",
        "Comma": "AudioVolumeDown",
        "Period": "AudioVolumeUp",
        "Slash": "AudioVolumeMute",
        "ShiftRight": "MicrophoneMuteToggle"
      }
    }
  ],
  "rules": [
    {
      "key": "Tab",
      "hold": {
        "layer": "select"
      }
    },
    {
      "key": "CapsLock",
      "tap": "Ctrl+KeyV",
      "hold": {
        "layer": "navigation",
        "timeoutMs": 180
      }
    },
    {
      "key": "ShiftLeft",
      "tap": "Ctrl+KeyC",
      "doubleTap": {
        "action": "Ctrl+KeyX"
      },
      "tapDecision": "holdOnOtherKeyPress"
    },
    {
      "key": "ControlLeft",
      "tap": "Ctrl+Alt+Shift+KeyQ",
      "hold": {
        "action": "AltLeft"
      }
    },
    {
      "key": "MetaLeft",
      "tap": "tecloid:showQuickMenu1",
      "hold": {
        "action": "ControlLeft",
        "timeoutMs": 350
      }
    },
    {
      "key": "AltLeft",
      "tap": "Enter",
      "hold": {
        "layer": "desktop"
      }
    },
    {
      "key": "AltRight",
      "tap": "text:,",
      "doubleTap": {
        "action": "text:."
      },
      "hold": {
        "layer": "symbols"
      }
    },
    {
      "key": "ContextMenu",
      "tap": "text:.",
      "hold": {
        "layer": "f-keys"
      }
    },
    {
      "key": "ControlRight",
      "tap": "MetaLeft",
      "hold": {
        "action": "MetaLeft"
      }
    },
    {
      "key": "ShiftRight",
      "tap": "text:-",
      "tapDecision": "holdOnOtherKeyPress"
    }
  ],
  "quickMenuPages": [
    {
      "id": "snippets",
      "name": "Snippets",
      "cells": {
        "KeyQ": {
          "name": "Works on my machine",
          "action": "text:Works on my machine. Which version / OS are you on?"
        },
        "KeyW": {
          "name": "Good morning",
          "action": "text:Good morning!"
        },
        "KeyE": {
          "name": "Have a nice day",
          "action": "text:Have a nice day!"
        },
        "KeyR": {
          "name": "Thanks",
          "action": "text:Thanks!"
        },
        "KeyT": {
          "name": "Sorry for the inconvenience",
          "action": "text:I'm sorry for the inconvenience."
        },
        "KeyA": {
          "name": "Fix grammar",
          "action": "text:Fix grammar and wording, keep the meaning and tone."
        },
        "KeyS": {
          "name": "More detail",
          "action": "text:Explain this in more detail."
        },
        "KeyD": {
          "name": "Do it all",
          "action": "text:Do it all as you suggested."
        },
        "KeyF": {
          "name": "Continue",
          "action": "text:Continue."
        },
        "KeyG": {
          "name": "Ask first",
          "action": "text:Before you start, ask me any clarifying questions."
        },
        "KeyZ": {
          "name": "Best regards",
          "action": "text:Best regards,\n"
        },
        "KeyX": {
          "name": "Looking forward to hearing",
          "action": "text:Looking forward to hearing from you."
        },
        "KeyC": {
          "name": "Any questions",
          "action": "text:Please let me know if you have any questions."
        },
        "KeyV": {
          "name": "Could you please",
          "action": "text:Could you please "
        },
        "KeyB": {
          "name": "I'll be back",
          "action": "text:Give me a few minutes, I'll get back to you."
        }
      }
    },
    {
      "id": "system",
      "name": "System",
      "cells": {
        "KeyQ": {
          "name": "Sleep",
          "action": "Sleep"
        },
        "KeyW": {
          "name": "Screen off",
          "action": "sys:turnOffScreen"
        },
        "KeyE": {
          "name": "Mute",
          "action": "AudioVolumeMute"
        },
        "KeyR": {
          "name": "Mute microphone",
          "action": "MicrophoneMuteToggle"
        },
        "KeyT": {
          "name": "Airplane Mode",
          "action": "AirplaneMode"
        },
        "KeyA": {
          "name": "Play / pause",
          "action": "MediaPlayPause"
        },
        "KeyS": {
          "name": "PrintScreen",
          "action": "PrintScreen"
        },
        "KeyD": {
          "name": "Overview",
          "action": "sys:showOverview"
        },
        "KeyF": {
          "name": "Fullscreen",
          "action": "F11"
        },
        "KeyG": {
          "name": "Touchpad Toggle",
          "action": "TouchpadToggle"
        },
        "KeyZ": {
          "name": "Brightness Down",
          "action": "BrightnessDown"
        },
        "KeyX": {
          "name": "Brightness Up",
          "action": "BrightnessUp"
        },
        "KeyC": {
          "name": "Volume Down",
          "action": "AudioVolumeDown"
        },
        "KeyV": {
          "name": "Volume Up",
          "action": "AudioVolumeUp"
        },
        "KeyB": {
          "name": "Keyboard Backlight Toggle",
          "action": "KeyboardBacklightToggle"
        }
      }
    }
  ],
