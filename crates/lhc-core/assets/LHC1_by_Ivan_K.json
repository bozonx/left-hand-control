{
  "schemaVersion": 1,
  "layers": [
    {
      "id": "navigation",
      "keys": {
        "MetaLeft": "Ctrl+KeyX",
        "AltLeft": "Delete",
        "Space": "Backspace",
        "KeyQ": "builtin:moveLineDown",
        "KeyW": "Ctrl+Backspace",
        "KeyE": "Ctrl+Delete",
        "KeyR": "builtin:pasteAtLineAbove",
        "KeyT": "Ctrl+Home",
        "KeyY": "Home",
        "KeyU": "builtin:downEnd",
        "KeyI": "builtin:upEnd",
        "KeyO": "End",
        "KeyP": "builtin:up5Times",
        "BracketLeft": null,
        "KeyA": "app:showEmojiMenu1",
        "KeyS": "builtin:duplicateLine",
        "KeyD": "Ctrl+KeyD",
        "KeyF": "builtin:copyLine",
        "KeyG": "builtin:cutLineContent",
        "KeyH": "ArrowLeft",
        "KeyJ": "ArrowDown",
        "KeyK": "ArrowUp",
        "KeyL": "ArrowRight",
        "Semicolon": "builtin:rightSpace",
        "Quote": null,
        "KeyZ": "builtin:emptyLineBelow",
        "KeyX": "builtin:cutWordRightCenter",
        "KeyC": "builtin:copyWordAfterCenter",
        "KeyV": "builtin:pasteAtLineBottom",
        "KeyB": "Ctrl+End",
        "KeyN": "Ctrl+ArrowLeft",
        "KeyM": "builtin:downHome",
        "Comma": "builtin:upHome",
        "Period": "Ctrl+ArrowRight",
        "Slash": "builtin:down5Times"
      }
    },
    {
      "id": "select",
      "keys": {
        "CapsLock": "CapsLock",
        "AltLeft": "Ctrl+Enter",
        "Digit1": "sys:switchLayout1",
        "Digit2": "sys:switchLayout2",
        "Digit3": "sys:switchLayout3",
        "Digit4": "sys:switchLayout4",
        "Digit5": "sys:switchLayout5",
        "Digit6": "sys:switchLayout6",
        "Digit7": "sys:switchLayout7",
        "Digit8": "sys:switchLayout8",
        "Digit9": "sys:switchLayout9",
        "Digit0": "sys:switchLayout10",
        "KeyQ": "Ctrl+KeyZ",
        "KeyW": "builtin:cutToStart",
        "KeyE": "builtin:cutToEnd",
        "KeyR": "PageDown",
        "KeyT": "PageUp",
        "KeyY": "Shift+Home",
        "KeyU": "Shift+PageDown",
        "KeyI": "Shift+PageUp",
        "KeyO": "Shift+End",
        "KeyP": "builtin:select5LinesUp",
        "BracketLeft": null,
        "KeyA": "Ctrl+Slash",
        "KeyS": "builtin:copyToStart",
        "KeyD": "builtin:copyToEnd",
        "KeyF": "builtin:selectWholeLine",
        "KeyG": "builtin:cutAndRemoveLine",
        "KeyH": "Shift+ArrowLeft",
        "KeyJ": "Shift+ArrowDown",
        "KeyK": "Shift+ArrowUp",
        "KeyL": "Shift+ArrowRight",
        "Semicolon": "builtin:selectWordRightCenter",
        "Quote": null,
        "KeyZ": null,
        "KeyX": "builtin:replaceToStartWithBuffer",
        "KeyC": "builtin:replaceToEndWithBuffer",
        "KeyV": "builtin:replaceLineWidthBuffer",
        "KeyB": "builtin:replaceWordWidthBuffer",
        "KeyN": "Ctrl+Shift+ArrowLeft",
        "KeyM": "Shift+PageDown",
        "Comma": "Shift+PageUp",
        "Period": "Ctrl+Shift+ArrowRight",
        "Slash": "builtin:select5LinesDown"
      }
    },
    {
      "id": "symbols",
      "keys": {
        "KeyQ": "text:<",
        "KeyW": "text:{",
        "KeyE": "text:[",
        "KeyR": "text:(",
        "KeyT": "text:|",
        "KeyY": "text:^",
        "KeyU": "Digit7",
        "KeyI": "Digit8",
        "KeyO": "Digit9",
        "KeyP": "text:+",
        "BracketLeft": null,
        "KeyA": "text:#",
        "KeyS": "text::",
        "KeyD": "text:!",
        "KeyF": "text:?",
        "KeyG": "text:&",
        "KeyH": "text:*",
        "KeyJ": "Digit4",
        "KeyK": "Digit5",
        "KeyL": "Digit6",
        "Semicolon": "text:=",
        "Quote": "text:%",
        "KeyZ": "text:$",
        "KeyX": "text:`",
        "KeyC": "text:'",
        "KeyV": "text:\"",
        "KeyB": "text:@",
        "KeyN": "Digit0",
        "KeyM": "Digit1",
        "Comma": "Digit2",
        "Period": "Digit3",
        "Slash": "text:/",
        "ShiftRight": "text:_"
      }
    },
    {
      "id": "f-keys",
      "keys": {
        "KeyQ": "text:>",
        "KeyW": "text:}",
        "KeyE": "text:]",
        "KeyR": "text:)",
        "KeyT": "text:☝️",
        "KeyY": "F12",
        "KeyU": "F7",
        "KeyI": "F8",
        "KeyO": "F9",
        "KeyP": "text:👍",
        "BracketLeft": "text:👎",
        "KeyA": "text:№",
        "KeyS": "text:;",
        "KeyD": "text:‼️",
        "KeyF": "text:❓",
        "KeyG": "text:❌",
        "KeyH": "F11",
        "KeyJ": "F4",
        "KeyK": "F5",
        "KeyL": "F6",
        "Semicolon": "text:≠",
        "Quote": "text:⚡",
        "KeyZ": "text:€",
        "KeyX": "text:~",
        "KeyC": "text:⏩",
        "KeyV": "text:✅",
        "KeyB": "text:ℹ️",
        "KeyN": "F10",
        "KeyM": "F1",
        "Comma": "F2",
        "Period": "F3",
        "Slash": "text:\\"
      }
    },
    {
      "id": "desktop",
      "holdModifiers": [
        "Tab",
        "CapsLock"
      ],
      "keys": {
        "Tab": "Alt+Tab",
        "CapsLock": "Meta+Tab",
        "Backspace": "sys:screenOff",
        "Space": "Ctrl+Alt+Shift+KeyV",
        "ShiftLeft": "sys:switchLayout4",
        "Digit1": "Meta+Digit1",
        "Digit2": "Meta+Digit2",
        "Digit3": "Meta+Digit3",
        "Digit4": "Meta+Digit4",
        "Digit5": "Meta+Digit5",
        "Digit6": "Meta+Digit6",
        "Digit7": "Meta+Digit7",
        "Digit8": "Meta+Digit8",
        "Digit9": "Meta+Digit9",
        "Digit0": "Meta+Digit0",
        "KeyQ": "Ctrl+Alt+Shift+KeyF",
        "KeyW": "Ctrl+KeyA",
        "KeyE": "Ctrl+Alt+Shift+KeyS",
        "KeyR": "Ctrl+Alt+Shift+KeyW",
        "KeyT": "sys:windowKeepAbove",
        "KeyY": "sys:windowClose",
        "KeyU": "sys:windowMaximize",
        "KeyI": "sys:windowMinimize",
        "KeyO": "ZoomIn",
        "KeyP": "ZoomOut",
        "BracketLeft": "sys:appLauncher",
        "KeyA": "sys:switchDesktop4",
        "KeyS": "sys:switchDesktop3",
        "KeyD": "sys:switchDesktop2",
        "KeyF": "sys:switchDesktop1",
        "KeyG": "kde:kwin/Window to Next Desktop",
        "KeyH": "Meta+ArrowLeft",
        "KeyJ": "Meta+ArrowUp",
        "KeyK": "Meta+ArrowDown",
        "KeyL": "Meta+ArrowRight",
        "Semicolon": "kde:kwin/Window Maximize Vertical",
        "Quote": "kde:kwin/Window Maximize Horizontal",
        "KeyZ": "sys:switchLayout3",
        "KeyX": "sys:switchLayout2",
        "KeyC": "sys:switchLayout1",
        "KeyV": "Meta+KeyV",
        "KeyB": "PrintScreen",
        "KeyN": "BrightnessDown",
        "KeyM": "BrightnessUp",
        "Comma": "AudioVolumeDown",
        "Period": "AudioVolumeUp",
        "Slash": "AudioVolumeMute",
        "ShiftRight": "MicrophoneMuteToggle"
      }
    }
  ],
  "rules": [
    {
      "key": "Tab",
      "hold": {
        "layer": "select"
      }
    },
    {
      "key": "CapsLock",
      "tap": "Ctrl+KeyV",
      "hold": {
        "layer": "navigation",
        "timeoutMs": 180
      }
    },
    {
      "key": "ShiftLeft",
      "tap": "Ctrl+KeyC",
      "doubleTap": {
        "action": "Ctrl+KeyX"
      }
    },
    {
      "key": "ControlLeft",
      "tap": "app:showQuickMenu1",
      "hold": {
        "keys": "AltLeft"
      }
    },
    {
      "key": "MetaLeft",
      "tap": "Escape",
      "hold": {
        "keys": "ControlLeft"
      }
    },
    {
      "key": "AltLeft",
      "tap": "Enter",
      "hold": {
        "layer": "desktop"
      }
    },
    {
      "key": "AltRight",
      "tap": "text:,",
      "doubleTap": {
        "action": "text:."
      },
      "hold": {
        "layer": "symbols"
      }
    },
    {
      "key": "ControlRight",
      "tap": "text:.",
      "hold": {
        "layer": "f-keys"
      }
    },
    {
      "key": "ShiftRight",
      "tap": "text:-"
    }
  ],
  "quickActionPages": [
    {
      "id": "system",
      "name": "System",
      "cells": {
        "KeyQ": {
          "name": "Sleep",
          "action": "Sleep"
        },
        "KeyW": {
          "name": "Lock screen",
          "action": "LockScreen"
        },
        "KeyE": {
          "name": "Screen off",
          "action": "sys:screenOff"
        },
        "KeyR": {
          "name": "Mute",
          "action": "AudioVolumeMute"
        },
        "KeyT": {
          "name": "Mute microphone",
          "action": "MicrophoneMuteToggle"
        },
        "KeyA": {
          "name": "Grid view",
          "action": "kde:kwin/Grid View"
        },
        "KeyS": {
          "name": "Overview",
          "action": "sys:overview"
        },
        "KeyD": {
          "name": "Show desktop",
          "action": "sys:showDesktop"
        },
        "KeyF": {
          "name": "Fullscreen",
          "action": "kde:kwin/Window Fullscreen"
        },
        "KeyG": {
          "name": "Play / pause",
          "action": "MediaPlay"
        },
        "KeyZ": {
          "name": "Brightness Down",
          "action": "BrightnessDown"
        },
        "KeyX": {
          "name": "Brightness Up",
          "action": "BrightnessUp"
        },
        "KeyC": {
          "name": "Volume Down",
          "action": "AudioVolumeDown"
        },
        "KeyV": {
          "name": "Volume Up",
          "action": "AudioVolumeUp"
        },
        "KeyB": {
          "name": "Touchpad Toggle",
          "action": "TouchpadToggle"
        }
      }
    },
    {
      "id": "texts",
      "name": "Texts",
      "cells": {
        "KeyQ": {
          "name": "Works on my machine",
          "action": "text:Works on my machine. Which version / OS are you on?"
        },
        "KeyW": {
          "name": "Nice day",
          "action": "text:Have a nice day!"
        },
        "KeyE": {
          "name": "Good morning",
          "action": "text:Good morning!"
        },
        "KeyR": {
          "name": "Thanks",
          "action": "text:Thanks!"
        },
        "KeyT": {
          "name": "Sorry for the inconvenience",
          "action": "text:I'm sorry for the inconvenience."
        },
        "KeyA": {
          "name": "Fix grammar",
          "action": "text:Fix grammar and wording, keep the meaning and tone."
        },
        "KeyS": {
          "name": "More detail",
          "action": "text:Explain this in more detail."
        },
        "KeyD": {
          "name": "Do it all",
          "action": "text:Do it all as you suggested."
        },
        "KeyF": {
          "name": "Continue",
          "action": "text:Continue."
        },
        "KeyG": {
          "name": "Ask first",
          "action": "text:Before you start, ask me any clarifying questions."
        },
        "KeyZ": {
          "name": "Best regards",
          "action": "text:Best regards,\n"
        },
        "KeyX": {
          "name": "Looking forward to hearing",
          "action": "text:Looking forward to hearing from you."
        },
        "KeyC": {
          "name": "Any questions",
          "action": "text:Please let me know if you have any questions."
        },
        "KeyV": {
          "name": "Could you please",
          "action": "text:Could you please "
        },
        "KeyB": {
          "name": "I'll be back",
          "action": "text:Give me a few minutes, I'll get back to you."
        }
      }
    }
  ],
